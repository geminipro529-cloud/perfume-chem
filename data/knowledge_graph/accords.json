{
  "_meta": {
    "description": "Master registry of perfume accords, fragrance families, and accord types",
    "sources": [
      "Michael Edwards Fragrance Wheel",
      "Jean-Claude Ellena — Perfume: The Alchemy of Scent",
      "Edmond Roudnitska — L'Esthétique en Question",
      "Jean Carles — A Method of Creation in Perfumery",
      "Paul Jellinek — The Practice of Modern Perfumery",
      "Steffen Arctander — Perfume & Flavor Materials of Natural Origin",
      "Robert R. Calkin & J. Stephan Jellinek — Perfumery: Principles and Practice",
      "Charles Sell — The Chemistry of Fragrances (RSC)"
    ],
    "version": "1.0",
    "created": "2026-03-27"
  },

  "fragrance_families": {
    "_note": "Top-level families from Michael Edwards Fragrance Wheel + classical perfumery canon",

    "floral": {
      "description": "Built around flower notes — the largest family in perfumery",
      "jellinek_quadrant": "lower_left",
      "roudnitska_dominant_roles": ["noblesse", "eclat"],
      "sub_families": {
        "soliflore": {
          "description": "Single flower dominates — rose, jasmine, tuberose, lily, violet",
          "core_materials": ["Rose Absolute", "Jasmine Absolute", "Tuberose Absolute", "Hydroxycitronellal", "Alpha Isomethyl Ionone"],
          "benchmark_perfumes": ["Frédéric Malle Une Rose", "Serge Lutens A la Nuit", "Dior J'adore"]
        },
        "floral_bouquet": {
          "description": "Multiple flowers blended — the classic feminine form",
          "core_materials": ["Rose", "Jasmine", "Ylang Ylang", "Lily of the Valley", "Iris"],
          "benchmark_perfumes": ["Chanel No. 5", "Joy by Jean Patou", "Guerlain L'Heure Bleue"]
        },
        "white_floral": {
          "description": "Indolic, narcotic, heady white flowers — tuberose, gardenia, jasmine",
          "core_materials": ["Tuberose Absolute", "Jasmine Absolute", "Indole", "Methyl Anthranilate", "Hedione"],
          "benchmark_perfumes": ["Fracas", "Carnal Flower", "Tom Ford Tubéreuse Nue"]
        },
        "floral_green": {
          "description": "Flowers with green leaf and stem facets",
          "core_materials": ["Galbanum", "Violet Leaf", "Cis-3-Hexenol", "Hydroxycitronellal"],
          "benchmark_perfumes": ["Chanel No. 19", "Vent Vert", "Eau de Campagne"]
