# RULE: Optimize for the name, not just the numbers. The formula name is the north star.
# Numerical gates are floors to meet, not ceilings to chase.
# When optimizing, the original brief/bottle name is the target.
# Root runner environment
# Used when starting the API from repo root with:
#   python run_api_server.py
#
# This repo currently has no committed `models/` directory.
# Create one yourself or point these paths somewhere else on disk.

AI_PROVIDER=deepseek

# DeepSeek Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI (fallback)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Cerebras
CEREBRAS_API_KEY=your-cerebras-api-key-here
CEREBRAS_MODEL=llama3.1-8b

# Baseten
BASETEN_API_KEY=your-baseten-api-key-here
BASETEN_MODEL_ID=your-baseten-model-id-here

# Hugging Face remote API
HF_API_KEY=your-huggingface-token-here
HF_MODEL=NousResearch/Hermes-3-Llama-3.1-8B
HF_BASE_URL=https://api-inference.huggingface.co/v1/

# Hugging Face local Transformers model
# Point to a folder that contains config/tokenizer/weights files.
# Example:
# HF_LOCAL_MODEL_PATH=models/llama3_8b_chat_uncensored
HF_LOCAL_MODEL_PATH=

# Ollama model name, served by your Ollama instance
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=hf.co/DavidAU/DeepSeek-MOE-4X8B-R1-Distill-Llama-3.1-Deep-Thinker-Uncensored-24B-GGUF

# llama.cpp local GGUF file
# Point to one GGUF file, not a directory.
# Example:
# LLAMA_CPP_MODEL_PATH=D:/models/OpenAi-GPT-oss-20b.gguf
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_N_CTX=2048
LLAMA_CPP_N_GPU_LAYERS=0
LLAMA_CPP_SEED=-1
LLAMA_CPP_VERBOSE=False
