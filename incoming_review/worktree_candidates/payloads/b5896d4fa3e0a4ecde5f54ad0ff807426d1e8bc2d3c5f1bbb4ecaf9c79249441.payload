from engine.knowledge.perfume_knowledge import evaluate_pyramid_balance
from engine.name_utils import normalize_name
from engine.optimizer.perfumer_logic import evaluate_perfumer_logic
from engine.pipeline.formula_state import build_formula_state
from engine.pipeline.gates import (
    ReleaseGateConfig,
    _apply_guideline_policy,
    _check_skeleton,
    _gate_family_drift_detector,
    _gate_perfume_knowledge,
    _gate_reference_temporal_relationships,
    _result,
    _status_from_gates,
    gate_formula,
)
from engine.pipeline.simulator import simulate_formula


def _formula(ingredients, dilutions=None, name="Test Formula"):
    total = sum(ingredients.values()) or 1.0
    return {
        "number": 1,
        "name": name,
        "ingredients_ul": ingredients,
        "dilutions": dilutions or {},
        "ingredients_pct": {k: v / total * 100 for k, v in ingredients.items()},
        "body": name,
    }


def test_guideline_policy_demotes_advisory_failures_to_warnings():
    gate = _result("literature_compliance", "FAIL", "too strict")
    normalized = _apply_guideline_policy(gate)

    assert normalized.status == "WARN"
    assert normalized.data["original_status"] == "FAIL"
    assert _status_from_gates([normalized]) == "WARN"


def test_perfumer_logic_routes_registered_nonlegacy_brief_to_its_archetype():
    formula = _formula(
        {
            "Iso E Super": 1800.0,
            "Hedione": 900.0,
            "Ethylene Brassylate": 600.0,
            "Dihydro Beta Ionone": 300.0,
        },
        name="Woody Floral Musk",
    )

    report = evaluate_perfumer_logic(formula, brief="woody_floral_musk")

    assert report.brief == "woody_floral_musk.classic"
    assert all(check.name != "perfumer_logic_brief" for check in report.checks)


def test_jellinek_classification_spells_ambrettolide_correctly():
    assert gates_module._JELLINEK_CLASSES["ambrettolide"] == "erogenic"


def test_guideline_policy_keeps_hard_blockers_failing():
    gate = _result("safety_ifra_allergen", "FAIL", "unsafe")
    normalized = _apply_guideline_policy(gate)

    assert normalized.status == "FAIL"
    assert _status_from_gates([normalized]) == "FAIL"


@pytest.mark.parametrize(
    "archetype",
    ["creed_aventus.reference", "sukhum_35.thai_aventus_adjacent"],
)
def test_guideline_policy_keeps_named_target_knowledge_failure_blocking(archetype):
    gate = _result("perfume_knowledge", "FAIL", "fruit relationship failed")
    normalized = _apply_guideline_policy(
        gate,
        ReleaseGateConfig(family_archetype=archetype),
    )

    assert normalized.status == "FAIL"
    assert _status_from_gates([normalized]) == "FAIL"


@pytest.mark.parametrize(
    "config",
    [
        ReleaseGateConfig(family_archetype="missing.named_reference"),
        ReleaseGateConfig(brief="missing_named_reference"),
    ],
)
def test_explicit_unknown_family_target_is_a_hard_failure(config):
    result = _gate_family_drift_detector(
        _formula({"Iso E Super": 6000.0}),
        config,
    )
    normalized = _apply_guideline_policy(result, config)

    assert result.status == "FAIL"
    assert normalized.status == "FAIL"
    assert (
        "unknown family archetype" in result.detail
        or "unresolved explicit brief" in result.detail
    )


def test_perfume_knowledge_uses_top_heart_and_drydown_frame_oav_maps(monkeypatch):
    state = build_formula_state(
        {"Hexyl Acetate": 1000.0, "Iso E Super": 5000.0},
        {},
    )
    simulation = tuple(
        simulate_formula(
            {"Hexyl Acetate": 1000.0, "Iso E Super": 5000.0},
            {},
            initial_state=state,
        )
    )
    captured: dict[str, dict[str, float]] = {}
    target_keys: dict[str, str] = {}
    target_overrides: dict[str, dict] = {}

    class _Evaluation:
        status = "optimal"
        overall_fit = 1.0

        def __init__(self, window: str):
            self.window = window

        def as_dict(self):
            return {"time_window": self.window, "status": self.status}

    def _capture(material_oavs, _material_families, _family, time_window, **kwargs):
        captured[time_window] = dict(material_oavs)
        target_keys[time_window] = kwargs["target_key"]
        target_overrides[time_window] = kwargs["target_override"]
        return _Evaluation(time_window)

    monkeypatch.setattr(
        "engine.pipeline.gates.evaluate_oav_family_targets",
        _capture,
    )

    _gate_perfume_knowledge(
        state,
        ReleaseGateConfig(family_archetype="creed_aventus.reference"),
        simulation,
    )

    expected_frames = {
        "top": next(frame for frame in simulation if frame.label == "top"),
        "heart": next(frame for frame in simulation if frame.label == "heart"),
        "base": next(frame for frame in simulation if frame.label == "drydown"),
    }
    for target_window, frame in expected_frames.items():
        expected = {
            material.name: float(material.oav or 0.0)
            for material in frame.state.materials
            if (material.oav or 0.0) > 0.0
        }
        assert captured[target_window] == expected
        assert target_keys[target_window] == "creed_aventus.reference"
        assert set(target_overrides[target_window]) == {"top", "heart", "base"}

    assert captured["top"]["Hexyl Acetate"] > captured["heart"]["Hexyl Acetate"]
    assert captured["heart"]["Hexyl Acetate"] > captured["base"]["Hexyl Acetate"]


def test_dhi_dotted_archetype_activates_only_its_2011_skeleton():
    state = build_formula_state(
        {
            "Dihydro Beta Ionone": 1200.0,
            "Lavender EO": 900.0,
            "Ambrettolide": 900.0,
            "Cedarwood Virginia": 1500.0,
            "Vetiver EO": 1500.0,
        },
        {},
    )
    config = ReleaseGateConfig(family_archetype="iris_coumarin_amber.dhi2011")

    result = _check_skeleton("dior_homme_intense", state, config)
    unrelated = _check_skeleton("dior_homme_cologne", state, config)

    assert result.status == "PASS"
    assert result.detail != "not applicable"
    assert "iris + lavender + ambrette_proxy + virginia_cedar + vetiver" in result.detail
    assert unrelated.status == "PASS"
    assert unrelated.detail == "not applicable"


def test_sukhum_temporal_gate_fails_persistent_fruit_and_citrus_relationships():
    ingredients = {
        "Damascone Beta": 100.0,
        "Methyl Pamplemousse": 100.0,
        "Iso E Super": 1000.0,
    }
    state = build_formula_state(ingredients, {})
    simulation = tuple(
        simulate_formula(
            ingredients,
            {},
            initial_state=state,
        )
    )

    result = _gate_reference_temporal_relationships(
        state,
        simulation,
        ReleaseGateConfig(family_archetype="sukhum_35.thai_aventus_adjacent"),
    )

    assert result.status == "FAIL"
    assert result.data["family_archetype"] == "sukhum_35.thai_aventus_adjacent"
    assert result.data["model_authority"] == "heuristic_temporal_oav_design_guardrail"
    assert result.data["measured_headspace"] is False
    assert all(
        check["quantitative_authority"] == "INTERNAL_UNCALIBRATED_GUARDRAILS"
        and check["measured_reference_headspace"] is False
        for check in result.data["checks"]
    )
    failed_names = {
        check["name"]
        for check in result.data["checks"]
        if check["status"] == "FAIL"
    }
    assert "s35_opening_fruit_not_over_citrus" in failed_names
    assert "s35_fruit_release_by_heart" in failed_names
    assert "s35_citrus_release_by_heart" in failed_names


def test_gate_blocks_opaque_preblend_by_default():
    formula = _formula(
        {"Hedione": 3000.0, "Iso E Super": 2000.0, "Cardamom FTEC": 1000.0},
        name="Aromatic Fougere",
    )
    report = gate_formula(
        formula,
        ReleaseGateConfig(expected_concentrate_ul=6000.0, brief="generic"),
    )

    gates = {g.gate: g for g in report.gates}
    assert gates["opaque_preblends"].status == "FAIL"
    assert report.status == "FAIL"


def test_gate_builds_exactly_one_receipt_and_keeps_g15_parent_unbound(monkeypatch):
    parent = _formula(
        {"Hedione": 3000.0, "Iso E Super": 3000.0},
        dilutions={"Hedione": 1.0, "Iso E Super": 1.0},
        name="Receipt Parent",
    )
    parent["formula_uid"] = "receipt-parent-v1"
    formula = _formula(
        {"Hedione": 3000.0, "Iso E Super": 3000.0},
        dilutions={"Hedione": 1.0, "Iso E Super": 1.0},
        name="Receipt Child",
    )
    formula["formula_uid"] = "receipt-child-v2"
    formula["parent_formula_uid"] = parent["formula_uid"]

    receipt_calls = []
    state_calls = []
    original_receipt_builder = gates_module.build_formula_dose_receipt
    original_state_builder = gates_module.build_formula_state

    def record_receipt(*args, **kwargs):
        receipt = original_receipt_builder(*args, **kwargs)
        receipt_calls.append(receipt)
        return receipt

    def record_state(*args, **kwargs):
        state = original_state_builder(*args, **kwargs)
        state_calls.append((dict(kwargs), state))
        return state

    monkeypatch.setattr(gates_module, "build_formula_dose_receipt", record_receipt)
    monkeypatch.setattr(gates_module, "build_formula_state", record_state)

    report = gate_formula(
        formula,
        ReleaseGateConfig(
            expected_concentrate_ul=6000.0,
            brief="generic",
            audit_enabled=False,
        ),
        parent_formula=parent,
    )
    payload = report.as_dict()

    def receipt_payload_count(value):
        if isinstance(value, dict):
            return int(value.get("schema") == "formula-dose-receipt-v1") + sum(
                receipt_payload_count(item) for item in value.values()
            )
        if isinstance(value, list):
            return sum(receipt_payload_count(item) for item in value)
        return 0

    receipt_checks = [
        check
        for check in report.preflight["checks"]
        if check.get("check_name") == "formula_dose_receipt"
    ]
    bound_state_calls = [call for call in state_calls if call[0].get("dose_receipt_sha256")]
    unbound_state_calls = [call for call in state_calls if not call[0].get("dose_receipt_sha256")]

    assert len(receipt_calls) == 1
    assert report.dose_receipt is receipt_calls[0]
    assert report.formula_state.dose_receipt_sha256 == report.dose_receipt.receipt_sha256
    assert len(receipt_checks) == 1
    assert receipt_checks[0]["status"] == "PASS"
    assert receipt_payload_count(payload) == 1
    assert len(bound_state_calls) == 1
    assert len(unbound_state_calls) == 1
    parent_kwargs, parent_state = unbound_state_calls[0]
    assert "dose_receipt_status" not in parent_kwargs
    assert parent_state.dose_receipt_sha256 == ""
    assert parent_state.dose_receipt_status == "UNBOUND"
    assert "g15_oav_firewall" in gates_module.HARD_BLOCKING_GATES


