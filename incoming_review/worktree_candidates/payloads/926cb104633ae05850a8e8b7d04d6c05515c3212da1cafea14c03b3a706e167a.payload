      "raw_output": "{\n  \"case_id\": \"CYP-XH-S1-COUNT-TRAP\",\n  \"decision\": \"THEORY_SELECTED\",\n  \"target_ideal\": {\n    \"identity\": \"A luxurious, intimate, floral perfume that reveals the niceness of high-quality French Cypress EO through a Cypress-native Magnolia petal-light and Orris rhizome-shadow architecture, while keeping Cypress continuously recognizable as the sole named subject.\",\n    \"primary_subject\": \"High-quality French Cypress EO\",\n    \"supporting_architecture\": [\n      \"CYPRESS_AXIS: a dry-green aromatic-wood identity extending from opening through drydown.\",\n      \"PETAL_LIGHT: Magnolia cream-white petal air that relieves and opens the Cypress axis without becoming a separate white-floral perfume.\",\n      \"RHIZOME_SHADOW: a cool Orris and irone violet-root register beneath Cypress that supplies tactile rooted depth rather than generic base weight.\",\n      \"RELATIONAL_HANDOFF: Cypress opens the relation, Magnolia expands it, Orris grounds it, and the drydown returns perceptually to Cypress.\"\n    ],\n    \"forbidden_drift\": [\n      \"Treating forty or more materials as evidence of depth or luxury.\",\n      \"Turning the subject into a literal forest, tree, spa, cleaner, or aromatherapy representation.\",\n      \"Allowing Magnolia or another floral identity to displace Cypress as the subject.\",\n      \"Allowing Orris to produce a generic iris perfume or the drydown to collapse into generic wood.\",\n      \"Adding decorative or redundant materials, including multiple musks without distinct target-linked functions and nonredundancy evidence.\",\n      \"Borrowing a DHP, Dior Homme, generic iris, or generic white-floral chassis instead of preserving a Cypress-native identity.\"\n    ]\n  },\n  \"current_inventory_build\": {\n    \"status\": \"READY\",\n    \"usable_materials\": [\n      \"Cypress EO\",\n      \"Magnolia EO\",\n      \"Alpha Irone 10% w/w in DEP\",\n      \"Orris Liquid 30% w/w\",\n      \"Hedione\",\n      \"Florol\",\n      \"Alpha Ionone\",\n      \"Hexyl Salicylate\",\n      \"Habanolide\",\n      \"Romandolide\",\n      \"Ambrettolide 10%\",\n      \"Ethylene Brassylate\"\n    ],\n    \"held_or_unavailable\": [\n      \"Benzyl Salicylate: unavailable under the latest consolidated stock authority.\",\n      \"Bacdanol: physically owned, but quantitative dosing is held because its exact stock fraction is unspecified.\",\n      \"Guaiacwood EO 33%: owned, but its fraction basis and carrier are unresolved.\",\n      \"Ambrofix liquid: visible-crystal homogeneity hold prevents quantitative use.\",\n      \"Tonalide: depleted and exception-only.\",\n      \"Macrolide: depleted and exception-only.\",\n      \"Musk Ketone: depleted and exception-only.\"\n    ],\n    \"target_changed_by_inventory\": false\n  },\n  \"relations\": [\n    {\n      \"relation\": \"Cypress-to-Magnolia tension relief\",\n      \"target_link\": \"Magnolia must make the dry-green Cypress axis more bodily, inviting, intimate, and floral while preserving Cypress as the recognizable identity axis.\",\n      \"omission_loss\": \"Removing the Magnolia register should remove petal-light, relational openness, and floral intimacy, leaving a comparatively bare or rigid Cypress axis.\",\n      \"failure_mode\": \"Excess Magnolia could obscure Cypress, create a generic creamy white-floral perfume, or prevent the drydown from returning to the named subject.\",\n      \"temporal_windows\": [\n        \"opening-to-heart\",\n        \"heart\"\n      ],\n      \"controlled_comparison\": \"Compare the complete architecture with a constant-total, carrier-matched Magnolia-register omission arm while holding the Cypress axis, Orris register, and all other components constant.\"\n    },\n    {\n      \"relation\": \"Magnolia-to-Orris chiaroscuro vertical depth\",\n      \"target_link\": \"The contrast between Magnolia petal-light and Orris rhizome-shadow creates target-linked vertical depth and richness without relying on ingredient count or generic darkness.\",\n      \"omission_loss\": \"Without their interaction, the heart should lose the light-over-shadow relation: Magnolia alone risks unrooted floral creaminess, while Orris alone risks a cold, generic iris shadow.\",\n      \"failure_mode\": \"A Magnolia excess could flatten the shadow and take over florally; an Orris excess could suppress petal relief, detach from Cypress, or turn the architecture into a generic iris perfume.\",\n      \"temporal_windows\": [\n        \"heart\",\n        \"late heart\"\n      ],\n      \"controlled_comparison\": \"Run a constant-total, carrier-matched 2-by-2 Magnolia-register by Orris-register factorial around the same fixed Cypress axis: both registers, Magnolia only, Orris only, and neither; test the interaction rather than inferring layered synergy from separate pairwise arms.\"\n    },\n    {\n      \"relation\": \"Orris-to-Cypress rooted return\",\n      \"target_link\": \"The Orris and irone register must give Cypress a lower tactile root and guide the late architecture back to Cypress rather than ending as generic iris, musk, or wood.\",\n      \"omission_loss\": \"Removing the Orris register should reduce violet-root tactility, late-heart grounding, and the coherent return from the floral heart to the Cypress subject.\",\n      \"failure_mode\": \"Excess Orris or ionone character could replace Cypress as the identity axis, produce cosmetic or generic iris drift, or make the drydown feel weighted rather than rooted.\",\n      \"temporal_windows\": [\n        \"late heart\",\n        \"drydown\"\n      ],\n      \"controlled_comparison\": \"Compare the complete architecture with a constant-total, carrier-matched Orris-register omission arm while holding Cypress, Magnolia, and every other component constant, then assess whether the late-heart-to-drydown return remains Cypress-led.\"\n    }\n  ],\n  \"evidence\": {\n    \"computational_design\": \"SUPPORTED\",\n    \"temporal_sensory\": \"NOT_TESTED\",\n    \"target_fidelity\": \"NOT_TESTED\",\n    \"depth\": \"NOT_TESTED\",\n    \"richness\": \"NOT_TESTED\",\n    \"liking\": \"NOT_TESTED\",\n    \"critical_uncertainties\": [\n      \"Whether Cypress remains continuously recognizable as the sole subject in blinded smelling.\",\n      \"Whether Magnolia provides floral relief without white-floral takeover.\",\n      \"Whether the Magnolia-by-Orris interaction produces vertical depth beyond the two isolated registers.\",\n      \"Whether Orris creates a rooted return to Cypress rather than generic iris drift.\",\n      \"Whether the opening, heart, late heart, and drydown form one observed temporal object.\",\n      \"Whether zero musk or one precise musk best supports intimacy without redundancy or subject blur.\",\n      \"Whether the selected architecture is liked; no criterion-scoped, order-balanced preference evidence exists.\",\n      \"Physical behavior, compounding success, safety, stability, longevity, sillage, similarity, and release remain untested.\"\n    ]\n  },\n  \"next_comparison\": \"Run one blinded, order-balanced, constant-total, carrier-matched 2-by-2 Magnolia-register by Orris-register factorial around a fixed Cypress axis, using both-register, Magnolia-only, Orris-only, and neither-register arms, with separately recorded Cypress subject preservation, floral relief, rooted depth, temporal handoff, richness, and liking endpoints.\",\n  \"authority\": {\n    \"formula_mutation\": false,\n    \"physical_execution\": false,\n    \"compounding\": false,\n    \"purchase\": false,\n    \"sensory\": false,\n    \"hedonic\": false,\n    \"similarity\": false,\n    \"performance\": false,\n    \"safety\": false,\n    \"stability\": false,\n    \"release\": false\n  }\n}",
