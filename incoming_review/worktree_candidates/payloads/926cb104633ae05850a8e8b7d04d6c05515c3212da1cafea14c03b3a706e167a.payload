      "raw_output": "{\n  \"case_id\": \"CYP-XH-S1-COUNT-TRAP\",\n  \"decision\": \"THEORY_SELECTED\",\n  \"target_ideal\": {\n    \"identity\": \"A luxurious, intimate, floral Cypress composition with high-quality French Cypress EO kept unmistakably central, abstracted away from literal forest realism through floral diffusion, iris-toned contouring, and a refined skin-musk foundation; depth is defined by target-linked temporal and relational structure rather than a minimum material count.\",\n    \"primary_subject\": \"High-quality French Cypress EO\",\n    \"supporting_architecture\": [\n      \"Cypress subject register linked into a magnolia-floral halo\",\n      \"Hedione-Florol diffusion register extending the floralized Cypress subject\",\n      \"Irone-ionone-orris contour register mediating between Cypress austerity and floral intimacy\",\n      \"Hexyl Salicylate connective register smoothing floral, woody, and musk transitions\",\n      \"Layered clean-to-skin musk register providing persistence, intimacy, and temporal depth without obscuring Cypress\"\n    ],\n    \"forbidden_drift\": [\n      \"Literal conifer forest, aromatherapy, or household-cleaner realism\",\n      \"Magnolia or floral diffusion replacing Cypress as the primary subject\",\n      \"Powdery iris or violet character taking over the composition\",\n      \"Musk mass flattening Cypress identity into generic clean softness\",\n      \"Ingredient-count inflation being treated as evidence of depth, richness, luxury, or quality\"\n    ]\n  },\n  \"current_inventory_build\": {\n    \"status\": \"READY\",\n    \"usable_materials\": [\n      \"Cypress EO\",\n      \"Magnolia EO\",\n      \"Alpha Irone 10% w/w in DEP\",\n      \"Orris Liquid 30% w/w\",\n      \"Hedione\",\n      \"Florol\",\n      \"Alpha Ionone\",\n      \"Hexyl Salicylate\",\n      \"Habanolide\",\n      \"Romandolide\",\n      \"Ambrettolide 10%\",\n      \"Ethylene Brassylate\"\n    ],\n    \"held_or_unavailable\": [],\n    \"target_changed_by_inventory\": false\n  },\n  \"relations\": [\n    {\n      \"relation\": \"Magnolia EO and the Hedione-Florol diffusion register floralize the Cypress EO subject by extending its lift and radiance into an abstract floral halo.\",\n      \"target_link\": \"This relation is required to make Cypress luxurious and floral without converting the target into a literal forest.\",\n      \"omission_loss\": \"Cypress becomes more austere, linear, and naturalistic, losing the requested floral luminosity and polished abstraction.\",\n      \"failure_mode\": \"Excess floral diffusion or Magnolia dominance can displace Cypress and create a generic magnolia-floral composition.\",\n      \"temporal_windows\": [\n        \"Opening: Cypress remains immediately identifiable inside floral lift\",\n        \"Early heart: Magnolia and diffusion materials widen the subject without taking ownership\",\n        \"Heart: Floral radiance recedes gradually while preserving a Cypress-centered trajectory\"\n      ],\n      \"controlled_comparison\": \"At constant total, compare the complete Cypress-to-floral bridge against an arm in which the Magnolia EO, Hedione, and Florol bridge is omitted and its total contribution is replaced proportionally by the unchanged non-floral matrix.\"\n    },\n    {\n      \"relation\": \"Alpha Irone 10% w/w in DEP, Orris Liquid 30% w/w, and Alpha Ionone contour the Cypress-to-floral transition through cool iris-violet facets and controlled powdery texture.\",\n      \"target_link\": \"This register supplies intimate refinement and dimensional contour between Cypress dryness and the floral halo.\",\n      \"omission_loss\": \"The architecture loses its refined intermediate register, leaving a more abrupt Cypress-floral-musk stack with reduced perceived articulation.\",\n      \"failure_mode\": \"Irone, orris, or ionone excess can create powdery violet takeover and obscure the Cypress subject.\",\n      \"temporal_windows\": [\n        \"Early heart: A restrained iris-violet contour appears beneath the floralized Cypress\",\n        \"Heart: The contour mediates Cypress into the musk foundation\",\n        \"Drydown: Only a trace of refined powdery texture remains\"\n      ],\n      \"controlled_comparison\": \"At constant total, compare the full iris-contour register against an omission arm in which its total contribution is replaced proportionally by the unchanged Cypress-floral-musk matrix.\"\n    },\n    {\n      \"relation\": \"Hexyl Salicylate connects the floral diffusion, iris contour, woody Cypress subject, and musk foundation by smoothing register boundaries.\",\n      \"target_link\": \"The connective role is required for continuity and richness through relationships rather than through indiscriminate material accumulation.\",\n      \"omission_loss\": \"Transitions become more segmented, exposing a floral top-heart above a comparatively detached woody-musky base.\",\n      \"failure_mode\": \"Excess connective salicylate can blur the architecture, mute Cypress definition, or make the floral body feel broad and generic.\",\n      \"temporal_windows\": [\n        \"Early heart: Floral and Cypress registers remain continuous\",\n        \"Heart-to-drydown transition: Iris, wood, and musk hand off without a perceptible gap\"\n      ],\n      \"controlled_comparison\": \"At constant total, compare Hexyl Salicylate present against a matched omission arm whose removed contribution is replaced proportionally across the otherwise identical matrix.\"\n    },\n    {\n      \"relation\": \"Habanolide, Romandolide, Ambrettolide 10%, and Ethylene Brassylate form a differentiated musk foundation that carries the floralized Cypress from clean diffusion toward intimate skin warmth.\",\n      \"target_link\": \"The musk progression provides intimacy, persistence, and temporal depth while allowing Cypress to remain the subject.\",\n      \"omission_loss\": \"The composition loses drydown continuity, skin intimacy, and the clean-to-warm temporal progression supporting the subject.\",\n      \"failure_mode\": \"An oversized or poorly differentiated musk foundation can flatten the composition, suppress Cypress, and produce generic laundry-clean or undifferentiated musky softness.\",\n      \"temporal_windows\": [\n        \"Heart: Habanolide and Romandolide support clean diffusion beneath Cypress\",\n        \"Late heart: Musk facets broaden without masking the subject\",\n        \"Drydown: Ambrettolide 10% and Ethylene Brassylate sustain intimate skin warmth and continuity\"\n      ],\n      \"controlled_comparison\": \"At constant total musk contribution, compare the differentiated four-material musk progression against a simplified single-musk control while holding Cypress and every non-musk register unchanged.\"\n    }\n  ],\n  \"evidence\": {\n    \"computational_design\": \"SUPPORTED\",\n    \"temporal_sensory\": \"NOT_TESTED\",\n    \"target_fidelity\": \"NOT_TESTED\",\n    \"depth\": \"NOT_TESTED\",\n    \"richness\": \"NOT_TESTED\",\n    \"liking\": \"NOT_TESTED\",\n    \"critical_uncertainties\": [\n      \"Whether Cypress remains perceptually primary across opening, heart, and drydown\",\n      \"Whether the floral bridge abstracts Cypress without producing Magnolia takeover\",\n      \"Whether the iris contour adds refinement without powdery violet takeover\",\n      \"Whether the differentiated musk foundation creates intimacy and temporal depth without flattening the subject\",\n      \"Whether the relation-complete architecture is perceived as deeper, richer, more luxurious, or better liked than a count-inflated alternative\"\n    ]\n  },\n  \"next_comparison\": \"Run a blinded, carrier-matched, constant-total comparison between the relation-complete compact architecture and a count-inflated control matched as closely as possible for Cypress level and major register totals; evaluate Cypress subject continuity, non-forest abstraction, temporal depth, richness, luxury, and liking separately.\",\n  \"authority\": {\n    \"formula_mutation\": false,\n    \"physical_execution\": false,\n    \"compounding\": false,\n    \"purchase\": false,\n    \"sensory\": false,\n    \"hedonic\": false,\n    \"similarity\": false,\n    \"performance\": false,\n    \"safety\": false,\n    \"stability\": false,\n    \"release\": false\n  }\n}",
