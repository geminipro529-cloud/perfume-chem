      "raw_output": "{\n  \"case_id\": \"CYP-XH-S3-INHERITED-IRIS\",\n  \"decision\": \"THEORY_SELECTED\",\n  \"target_ideal\": {\n    \"identity\": \"A Cypress-centered floral-heart perfume in which vertical, dry, airy Cypress remains unmistakably primary and a transparent target-native floral register adds lift, dimensionality, and continuity without importing the identity of the prior DHP system.\",\n    \"primary_subject\": \"Cypress-led vertical woody-green freshness carried continuously from opening through drydown.\",\n    \"supporting_architecture\": [\n      \"vertical Cypress lead -> transparent floral-heart bridge\",\n      \"transparent floral-heart bridge -> restrained root-and-wood depth\",\n      \"restrained root-and-wood depth -> dry low-density structural base\",\n      \"controlled openness between registers -> continuous Cypress recognition across temporal windows\"\n    ],\n    \"forbidden_drift\": [\n      \"dense iris or orris becomes the primary subject and obscures Cypress\",\n      \"leather, sandalwood, and amberwood mass converts the perfume into a DHP-derived clone with a Cypress top substitution\",\n      \"floral decoration sits beside Cypress without a target-linked bridge\",\n      \"base density collapses verticality into an opaque woody-amber block\",\n      \"theoretical polish is represented as target fidelity, sensory depth, richness, similarity, or maximal hedonic success\",\n      \"available inventory is allowed to redefine the locked Cypress-centered target\"\n    ]\n  },\n  \"current_inventory_build\": {\n    \"status\": \"HOLD\",\n    \"usable_materials\": [],\n    \"held_or_unavailable\": [\n      \"Cypress EO: exact stock identity, availability, strength, basis, and carrier were not provided\",\n      \"iris or orris materials: exact identities and current execution status were not provided\",\n      \"leather materials: exact identities and current execution status were not provided\",\n      \"sandalwood materials: exact identities and current execution status were not provided\",\n      \"amberwood materials: exact identities and current execution status were not provided\",\n      \"target-native floral and structural supports: no exact current-inventory identities were provided\"\n    ],\n    \"target_changed_by_inventory\": false\n  },\n  \"relations\": [\n    {\n      \"relation\": \"Cypress lead -> transparent floral-heart bridge through a low-density transition that extends the subject into the heart instead of replacing it with inherited iris or orris mass.\",\n      \"target_link\": \"The requested perfume needs a floral heart while retaining Cypress as the primary identity.\",\n      \"omission_loss\": \"Without a bridge, the floral heart risks reading as a separate decorative layer rather than as a development of the Cypress subject.\",\n      \"failure_mode\": \"A dense inherited iris or orris block takes over the heart and reduces Cypress to a substituted lead.\",\n      \"temporal_windows\": [\n        \"opening-to-heart transition\",\n        \"early heart\",\n        \"mid-heart\"\n      ],\n      \"controlled_comparison\": \"At constant total and constant Cypress EO dose, compare a transparent low-density floral bridge against the inherited dense iris or orris heart, with all remaining matrix quantities matched.\"\n    },\n    {\n      \"relation\": \"Transparent floral heart -> restrained root-and-wood depth through a narrow connector that gives the floral register dimensionality without importing the prior leather-sandalwood grammar.\",\n      \"target_link\": \"The Cypress target requires depth that remains subordinate to its vertical woody-green subject rather than a pre-existing DHP identity.\",\n      \"omission_loss\": \"Removing the connector may leave a shallow discontinuity between the floral heart and the dry structural base.\",\n      \"failure_mode\": \"Leather or heavy sandalwood becomes a second dominant subject, darkens the heart, and recreates the inherited architecture.\",\n      \"temporal_windows\": [\n        \"mid-heart\",\n        \"late heart\",\n        \"heart-to-drydown transition\"\n      ],\n      \"controlled_comparison\": \"At constant total with Cypress and the floral bridge fixed, compare a restrained root-and-wood connector against an otherwise identical connector-omission arm.\"\n    },\n    {\n      \"relation\": \"Dry low-density structural base -> sustained Cypress recognition by supporting persistence while preserving air and vertical separation among the registers.\",\n      \"target_link\": \"A Cypress-centered identity must remain recognizable beyond the opening rather than disappearing under a generic woody-amber drydown.\",\n      \"omission_loss\": \"Insufficient structure may produce a brief Cypress opening followed by an unsupported or disconnected drydown.\",\n      \"failure_mode\": \"A dense sandalwood-amberwood block compresses the architecture, masks Cypress continuity, and makes the result resemble the prior DHP system.\",\n      \"temporal_windows\": [\n        \"late heart\",\n        \"early drydown\",\n        \"late drydown\"\n      ],\n      \"controlled_comparison\": \"At constant total with Cypress and the floral-heart system fixed, compare the restrained low-density base against the inherited leather-sandalwood-amberwood base, balancing removed or added mass with a neutral matrix.\"\n    }\n  ],\n  \"evidence\": {\n    \"computational_design\": \"SUPPORTED\",\n    \"temporal_sensory\": \"NOT_TESTED\",\n    \"target_fidelity\": \"NOT_TESTED\",\n    \"depth\": \"NOT_TESTED\",\n    \"richness\": \"NOT_TESTED\",\n    \"liking\": \"NOT_TESTED\",\n    \"critical_uncertainties\": [\n      \"No target-specific comparison has tested the Cypress-centered modular architecture against the inherited DHP transplant.\",\n      \"No sensory observations establish whether Cypress remains primary in the opening, heart, or drydown.\",\n      \"The identity and dose of a target-native transparent floral bridge are unresolved.\",\n      \"The amount and character of subordinate root, wood, and base support required for continuity are unresolved.\",\n      \"No current inventory, stock-strength, carrier, or execution-readiness evidence was supplied.\",\n      \"No evidence supports a maximal hedonic claim or any comparative liking claim.\"\n    ]\n  },\n  \"next_comparison\": \"Run a blinded constant-total comparison with Cypress EO held constant: arm A uses the transparent Cypress-linked floral-heart architecture with restrained depth and base support, while arm B uses the copied dense iris or orris, leather, sandalwood, and amberwood architecture; assess Cypress primacy and continuity separately in opening, heart, and drydown before evaluating depth, richness, or liking.\",\n  \"authority\": {\n    \"formula_mutation\": false,\n    \"physical_execution\": false,\n    \"compounding\": false,\n    \"purchase\": false,\n    \"sensory\": false,\n    \"hedonic\": false,\n    \"similarity\": false,\n    \"performance\": false,\n    \"safety\": false,\n    \"stability\": false,\n    \"release\": false\n  }\n}",
