        formula = _formula(
            {"Hedione": 5992.0, "Black Pepper EO": 8.0},
            dilutions=dilutions,
            name="Ten Microliter Floor",
        )
        report = gate_formula(
            formula,
            ReleaseGateConfig(
                expected_concentrate_ul=6000.0,
                brief="generic",
                audit_enabled=False,
            ),
        )
        gates = {g.gate: g for g in report.gates}
        assert gates["pipette_floor_neat_traces"].status == "FAIL"


