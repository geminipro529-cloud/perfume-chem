    assert result.data["findings"][0]["material"] == "Indole"


def test_musk_intelligence_bridge_uses_current_trio_schema():
    state = build_formula_state(
        {"Iso E Super": 5000.0, "Ethylene Brassylate": 1000.0},
        {},
        batch_volume_ml=30.0,
        temperature_K=305.0,
    )

    result = _gate_musk_intelligence(state, ReleaseGateConfig(audit_enabled=False))

    assert result.status == "PASS"
    assert result.data["woody_infrastructure_trio"] == {
        "norlimbanol_pct": 0.5,
        "vertofix_coeur_pct": 1.0,
        "iso_e_super_pct": 3.0,
    }
