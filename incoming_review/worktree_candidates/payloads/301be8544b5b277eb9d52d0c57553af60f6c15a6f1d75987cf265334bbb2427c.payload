def test_character_shift_bridge_reports_real_near_cliff_material():
    state = build_formula_state(
        {"Indole": 30.0, "Hedione": 5970.0},
        {},
        batch_volume_ml=30.0,
        temperature_K=305.0,
    )

    result = _gate_character_shifts(state, ReleaseGateConfig(audit_enabled=False))

    assert result.status == "WARN"
