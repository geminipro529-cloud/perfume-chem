  "objective_scoring_contract": {
    "decision_states": [
      "PROPOSED",
      "NO_CHANGE",
      "HOLD",
      "COMPLETE",
      "INCOMPLETE",
      "VALIDATED",
      "WITHHELD",
      "DIAGNOSTIC"
    ],
    "maximum_next_actions": 1,
    "score_explanation_length": false,
    "reward_unsupported_authority": false
  },
  "module_packets": {
    "architectural_delta": {
      "operating_contract": [
        "Lock target identity, exclusions, functional layers, and desired transitions before consulting inventory.",
        "Choose zero or one omission, addition, or ratio intervention only when it tests one target-linked nonredundant function at constant total.",
        "Ingredient count, prestige, ownership, and supplier prose are not evidence of depth, richness, target fit, or hedonism.",
        "Keep the evidence-faithful ideal architecture distinct from the execution-time current-inventory build and reparse the complete authoritative inventory before execution.",
        "Zero citrus is valid; Neroli 10% is support-only unless orange blossom or Neroli is explicitly central.",
        "Zero or one precise musk is the default; a multi-material exception requires distinct functions and isolated n-ary arms.",
        "Tonalide, Macrolide, and Musk Ketone remain excluded unless the locked target makes an explicit design exception."
      ],
      "authority_boundary": [
        "No formula mutation, physical execution, compounding, purchase, sensory, hedonic, safety, publication, or release authority.",
        "A computationally proposed arm remains unexecuted until exact stock, dose, carrier, sample, and protocol lineage exist."
      ],
      "evidence_refs": [
        "engine/perception/architectural_delta.py@sha256:9392528676e1856cab096287ab8e1e68ee9d1352b0ed9f2fe4e20b6d36a060bb",
        "configs/solforge/research_source_seeds_v1.json@sha256:6abb753047a37619a2940e65868ef9e0b86a4e2c2f355b732a4e94eb23a8d030",
        "architectural-delta-v7-fresh-corpus"
      ]
    },
    "temporal_sensory_ledger": {
      "operating_contract": [
        "Bind every observation to protocol, sample, assessor, repeat, timepoint, endpoint, realized sequence, position, and schedule lineage.",
        "Canonical duplicates are unresolved evidence and missing cells remain missing; never average duplicates or interpolate observations.",
        "Freeze the criterion, measurement mode, sample contrast, time window, direction, effect threshold, agreement threshold, and minimum paired count before analysis.",
        "Compute change within the same assessor and repeat, and compare samples with paired difference-in-change rather than unpaired endpoint medians.",
        "Audit realized presentation order separately from the planned Williams or counterbalanced schedule.",
        "Discrete ratings, TDS single dominance, and TCATA concurrent attribute selection are non-interchangeable measurement modes.",
        "Admit within-sniff timing only when apparatus, airflow, clock, trigger, and timing protocol are explicitly qualified."
      ],
      "authority_boundary": [
        "Predicted volatility, OAV, or composition cannot populate a perceived cell or establish a temporal sensory result.",
        "No formula, physical execution, sensory success, liking, stability, safety, publication, or release authority."
      ],
      "evidence_refs": [
        "engine/sensory/ledger.py@sha256:03b5742e8e66dcf1cc27a94b3e5c4484899ee08893b1b34e006d8890805d0f9f",
        "configs/solforge/research_source_seeds_v1.json@sha256:6abb753047a37619a2940e65868ef9e0b86a4e2c2f355b732a4e94eb23a8d030",
        "temporal-ledger-v3-v7-fresh-corpus"
      ]
    },
    "hedonic_preference_learner": {
      "operating_contract": [
        "Fit target fidelity, depth, richness, integration, and liking only as separate exact-scope criteria.",
        "Bind every item label to one exact formula build, physical sample, dose or sampling receipt, evaluation context, protocol, assessor scope, repeat, timepoint, substrate, and order record.",
        "Retain ties as indifference evidence and exclude them only from directional fitting.",
        "Require a connected comparison graph, adequate directional evidence, deterministic assessor-cluster resampling, untouched held-out groups, and proper-score improvement over a declared baseline.",
        "Diagnose assessor heterogeneity, first-position effects, order imbalance, carryover, temporal crossover, and nontransitivity rather than collapsing them into one beauty score.",
        "Withhold scope-mismatched, disconnected, identity-confounded, leaking, sparse, order-confounded, or baseline-failing fits.",
        "Recommend at most one deterministic next pair only when the current decision remains unresolved."
      ],
      "authority_boundary": [
        "No composition-derived liking, prestige-derived preference, synthetic beauty score, or transfer beyond the exact bound population and context.",
        "No formula, purchase, physical execution, sensory success, safety, publication, or release authority."
      ],
      "evidence_refs": [
        "engine/preference.py@sha256:dcfb241209665267d3628a88f3029defaec402bc9da80dc823581b2c077b8f60",
        "engine/preference_davidson.py@sha256:ad008d052d1de4ae62109f3abefa41ea7bb1533dcad2c76b33dd6f3a3cd4b1cd",
        "engine/preference_validation.py@sha256:992bf59e6f2f79c8201c32d035319b45b62be663e29bafde24035134f3be0fa4",
        "engine/hedonic_evidence.py@sha256:1a1d148abb2f0a7ca33a6771727b106f42b12ccfc69c0aefbbfe4185f474933f",
        "hedonic-preference-v3-v7-fresh-corpus"
      ]
    }
  },
  "cases": [
    {
      "case_id": "V7-ARC-S01",
      "module_id": "architectural_delta",
      "phase": "SCREEN",
      "role": "POSITIVE",
      "target_identity": "A carved cool-orris and dry-wood architecture with cedar grain, vetiver-root depth, a transparent aperture, and a dark mineral tail; never sweet amber bulk.",
      "facts": [
        "The ideal architecture freezes five functions: cool orris face, dry cedar grain, vetiver-root depth, transparent aperture, and dark mineral residue.",
        "The current 100.0-part build covers four functions but has an observed discontinuity between vetiver root and cedar grain.",
        "One candidate ratio arm moves 0.40 part from the transparent spacer into a dry root-to-grain bridge while keeping the total at 100.0 parts.",
        "Two alternative additions supply only sweet amber residue already covered by the base and are removed as redundant.",
        "The comparison is base versus the single ratio arm with every other material, stock basis, carrier, and total held constant."
      ],
      "inventory_state": {
        "authority": "V5_PLUS_USER_OVERLAY_REPARSE_REQUIRED_AT_EXECUTION",
        "ideal_candidate_status": "DESIGN_AVAILABLE",
        "physical_execution": "NOT_AUTHORIZED"
      },
      "expected_decision": "PROPOSED: run only the constant-total root-to-grain ratio arm.",
      "critical_error": "Adding both redundant amber candidates or claiming the arm already improves perceived depth.",
      "claim_ceiling": "COMPUTATIONAL_EXPERIMENT_DESIGN_ONLY",
      "evidence_payload": {
        "base_total_parts": 100.0,
        "candidate_total_parts": 100.0,
        "candidate_interventions_after_filter": [
          "RATIO_ROOT_TO_GRAIN"
        ],
        "rejected_candidates": [
          "SWEET_AMBER_DUPLICATE_1",
          "SWEET_AMBER_DUPLICATE_2"
        ]
      },
      "objective_expectation": {
        "expected_state": "PROPOSED",
        "required_reason_codes": [
          "TARGET_FUNCTION_GAP",
          "ONE_NONREDUNDANT_CONSTANT_TOTAL_ARM"
        ],
        "required_calculations": {
          "admissible_nonredundant_intervention_count": 1,
          "base_total_parts": 100.0,
          "candidate_total_parts": 100.0
        },
        "maximum_next_actions": 1,
        "authority_all_false": true,
        "critical_error_codes": [
          "MULTIPLE_INTERVENTIONS_OR_SENSORY_PROMOTION"
        ]
      }
    },
