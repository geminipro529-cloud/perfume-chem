          {"assessor": "P3", "A_from": 2, "A_to": 5, "B_from": 3, "B_to": 4},
          {"assessor": "P4", "A_from": 4, "A_to": 7, "B_from": 5, "B_to": 5}
        ]
      },
      "objective_expectation": {
