name: Perfume-Chem Verification

on:
  pull_request:
    branches: [master]
  push:
    branches: [master]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: perfume-chem-ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    env:
      OPENAI_API_KEY: test-key
      SECRET_KEY: test-only-secret-key-with-at-least-32-bytes
      PYTHONUTF8: "1"

    steps:
      - name: Checkout exact revision
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false

      - name: Set up Python 3.11
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.11"

      - name: Install pinned Poetry
        run: python -m pip install "poetry==2.4.1"

      - name: Validate and install the locked environment
        working-directory: backend
        run: |
          poetry check --lock
          poetry install --with dev --sync

      - name: Lint backend
        working-directory: backend
        run: poetry run ruff check app

      - name: Type-check backend
        working-directory: backend
        run: poetry run mypy app --ignore-missing-imports

      - name: Test backend
        working-directory: backend
        run: poetry run pytest --cov=app --cov-report=term

      - name: Audit installed third-party dependencies
        working-directory: backend
        run: poetry run pip-audit --local --skip-editable

      - name: Run the full project acceptance verifier
        working-directory: backend
        run: poetry run python ../scripts/pipeline_audit.py project-verify --json

  container-build:
    needs: verify
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout exact revision
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false

      - name: Set up Python 3.11
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.11"

      - name: Build the production image
        run: docker build --file backend/Dockerfile --tag "perfume-chem:${GITHUB_SHA}" .

      - name: Smoke-test normal container startup
        run: >-
          python -m engine.project_verification docker-smoke
          --image "perfume-chem:${GITHUB_SHA}"
          --timeout-seconds 90
