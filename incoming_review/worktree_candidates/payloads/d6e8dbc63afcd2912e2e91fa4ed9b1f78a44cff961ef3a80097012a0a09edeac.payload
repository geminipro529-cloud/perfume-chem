import hashlib
from pathlib import Path

from engine.pipeline.gates import ReleaseGateConfig, gate_formula
from engine.pipeline.formula_state import build_formula_state
from engine.pipeline.preflight import run_release_preflight
from scripts.verify_formula_workflow import parse_formula_markdown


PROJECT_ROOT = Path(__file__).resolve().parents[1]
FORMULA_PATH = (
    PROJECT_ROOT / "formulas" / "La_Rose_Monolithe_DHP2025_30mL_Parfum.md"
)


def _formula() -> dict:
    formulas = parse_formula_markdown(FORMULA_PATH)
    assert len(formulas) == 1
    return formulas[0]


def test_la_rose_monolithe_is_a_single_7500_ul_rose_formula():
    formula = _formula()

    assert formula["family_archetype"] == "floral_soliflore.rose_reference"
    assert sum(formula["ingredients_ul"].values()) == 7_500.0
    assert min(formula["ingredients_ul"].values()) >= 10.0
    assert formula["dilutions"]["Rose de Mai Absolute"] == 0.10
    assert formula["ingredients_ul"]["Ambrox Super"] == 60.0
    assert formula["dilutions"]["Ambrox Super"] == 0.33
    assert formula["ingredients_ul"]["Diethyl Phthalate"] == 140.0
    assert "Ambrofix" not in formula["ingredients_ul"]
    assert (
        formula["dilutions"]["Rose Essential Oil (Rosa Damascena, India)"]
        == 0.10
    )
    assert formula["ingredients_ul"]["Geranyl Acetate"] == 30.0
    assert formula["ingredients_ul"]["Phenethyl Alcohol (PEA)"] == 1_170.0
    assert formula["ingredients_ul"]["Benzyl Benzoate"] == 300.0
    assert formula["ingredients_ul"]["Cedarwood oil Virginia"] == 40.0
    assert formula["ingredients_ul"]["Azarbre"] == 20.0
    assert formula["dilutions"]["Azarbre"] == 0.10
    assert "Polysantol" not in formula["ingredients_ul"]


def test_la_rose_monolithe_keeps_one_exact_musk_and_no_identity_drifts():
    names = {name.casefold() for name in _formula()["ingredients_ul"]}

    owned_musks = {
        "galaxolide",
        "tonalide",
        "habanolide",
        "zenolide",
        "romandolide",
        "exaltolide",
        "macrolide",
        "ambrettolide",
        "musk ketone",
        "ethylene brassylate",
    }
    assert names & owned_musks == {"romandolide"}
    assert names.isdisjoint(
        {
            "neroli eo",
            "iso e super",
            "patchouli eo",
            "vanillin",
            "ethyl vanillin",
            "tonkarome",
            "oud",
            "leather fo",
            "alpha irone",
            "musk ketone",
            "tonalide",
            "macrolide",
        }
    )


def test_la_rose_monolithe_contains_execution_and_evidence_sections():
    text = FORMULA_PATH.read_text(encoding="utf-8")

    for section in (
        "## TARGET / IDEAL FORMULA",
        "## CURRENT-INVENTORY BUILD",
        "## Missing-Chemical Impact Gate",
        "## Purchase / Preparation Recommendation",
        "## Controlled Blinded Test Plan",
        "## Claim Ceiling",
    ):
        assert section in text


def test_la_rose_monolithe_is_bound_to_the_current_inventory_bytes():
    formula = _formula()
    expected = hashlib.sha256((PROJECT_ROOT / "inventory.txt").read_bytes()).hexdigest().upper()

    assert formula["inventory_path"] == "../inventory.txt"
    assert formula["inventory_sha256"] == expected


def test_la_rose_monolithe_missing_gate_reflects_owned_geranyl_acetate():
    text = FORMULA_PATH.read_text(encoding="utf-8")
    missing_gate = text.split("## Missing-Chemical Impact Gate", 1)[1].split(
        "## Purchase / Preparation Recommendation", 1
    )[0]

    assert "| Citronellyl Acetate |" in missing_gate
    assert "| Geranyl Acetate |" not in missing_gate
    assert "Geranyl Acetate" in _formula()["ingredients_ul"]


def test_la_rose_monolithe_target_and_blind_plan_use_the_layered_background():
    text = FORMULA_PATH.read_text(encoding="utf-8")
    target = text.split("## TARGET / IDEAL FORMULA", 1)[1].split(
        "## CURRENT-INVENTORY BUILD", 1
    )[0]
    blind = text.split("## Controlled Blinded Test Plan", 1)[1].split(
        "## Claim Ceiling", 1
    )[0]

    assert "| Polysantol |" not in target
    assert "| Cedarwood oil Virginia |" in target
    assert "| Azarbre |" in target
    assert "T2 — Cedar-only background" in blind
    assert "T3 — Background omission" in blind
    assert "10 µL Azarbre 10% w/w in DEP" in blind
    assert "20 µL Cedarwood oil Virginia" in blind


def test_la_rose_monolithe_uses_exact_rose_archetype_oav_targets():
    formula = _formula()
    report = gate_formula(
        formula,
        ReleaseGateConfig(
            brief="generic",
            family_archetype=formula["family_archetype"],
            expected_concentrate_ul=7_500.0,
            audit_enabled=False,
        ),
    )
    gate = next(row for row in report.gates if row.gate == "perfume_knowledge")

    assert gate.data["oav_target_scope"] == "exact_archetype"
    assert gate.data["oav_target_key"] == "floral_soliflore.rose_reference"
    assert gate.data["oav_targets"]["top"]["targets"] == {
        "rose": 260,
        "floral": 600,
        "citrus": 150,
    }
    assert "green" not in gate.data["oav_targets"]["top"]["targets"]
    assert "muguet" not in gate.data["oav_targets"]["heart"]["targets"]


def test_la_rose_monolithe_records_azarbre_prep_and_rejected_rose_eo_hold():
    formula = _formula()
    state = build_formula_state(
        formula["ingredients_ul"], formula["dilutions"], batch_volume_ml=30.0
    )

    report = run_release_preflight(formula, state).as_dict()
    stock = next(
        check
        for check in report["checks"]
        if check["check_name"] == "inventory_stock_contract"
    )

    assert stock["status"] == "FAIL"
    assert stock["data"]["issues"] == [
        {
            "material": "Azarbre",
            "reason": "stock_fraction_mismatch",
            "formula_dilution": 0.10,
            "inventory_dilutions": [1.0],
        },
        {
            "material": "Rose de Mai Absolute",
            "reason": "inventory_stock_unavailable",
        },
        {
            "material": "Rose Essential Oil (Rosa Damascena, India)",
            "reason": "inventory_stock_unavailable",
        },
    ]
    matched = {
        row["material"]: row for row in stock["data"]["matched_stocks"]
    }
    assert matched["Ambrox Super"] == {
        "material": "Ambrox Super",
        "inventory_name": "Ambrox Super",
        "fraction": 0.33,
        "concentration_basis": "w/v",
        "carrier": "DEP/ETHANOL",
        "authority_event_id": "",
        "source": "inventory_txt",
    }
