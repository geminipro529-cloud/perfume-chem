<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dior RC1 Recipe Library</title><style>
:root{--navy:#172536;--blue:#27445d;--paper:#fcfaf5;--amber:#c58b2a;--green:#2f6f4e;--muted:#66717c}
*{box-sizing:border-box}body{margin:0;background:#f3f1eb;color:#1e2b36;font-family:Inter,Segoe UI,Arial,sans-serif}
header{background:var(--navy);color:white;padding:24px 5vw}header h1{margin:0;font-size:28px}
main{max-width:1500px;margin:auto;padding:24px}.card{background:var(--paper);border-radius:14px;padding:20px;margin-bottom:18px;box-shadow:0 5px 18px #00000012}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.metric{background:#eaf1f6;border-radius:9px;padding:10px}
table{width:100%;border-collapse:collapse;font-size:13px}th{position:sticky;top:0;background:var(--blue);color:white;text-align:left;padding:9px}
td{border-bottom:1px solid #ddd;padding:8px;vertical-align:top}tr.stage td{background:#faf1db;font-weight:700}
.badge{display:inline-block;border-radius:999px;padding:4px 9px;background:#e3f1e7;color:var(--green);font-weight:700}
.trace{background:#faf1db}.product{background:#eee7f4}.small{font-size:12px;color:var(--muted)}
a{color:#1c5978}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}.toolbar a{background:var(--navy);color:white;padding:9px 12px;border-radius:8px;text-decoration:none}

.search{width:100%;padding:14px;border:2px solid #c58b2a;border-radius:10px;font-size:18px}
</style></head><body><header><h1>Dior RC1 Hardened Recipe Library</h1>
