  "target_identity": {
    "north_star": "La Nuit's cardamom-lavender heart wrapped in dark textile woods: Cashmeran warmth, a trace angular Kephalis stitch, smooth Azarbre, and literal cedar-vetiver grain—supple and nocturnal, never leather, oud, smoke, tobacco accord, or opaque amberwood mass.",
    "functional_architecture": [
      "cardamom-lavender recognizers remain visible above the textile layer",
      "Cashmeran supplies warm fibrous texture rather than sweetness",
      "trace Kephalis gives an angular dark stitch while Azarbre supplies the smooth seam",
      "literal cedar and vetiver keep the textile grounded in La Nuit's vertical"
    ],
    "protected_identity": [
      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "supple dark textile texture stitched into literal cedar-vetiver woods",
    "variant_socket": {
      "active_ppm_w_w": 66666.667,
      "current_raw_ul": 300,
      "target_allocation": {
        "Cashmeran increment": 8000,
        "Kephalis": 4000,
        "Azarbre": 16000,
        "Cedarwood Virginia increment": 14000,
        "Vetiver Haiti increment": 10000,
        "Hedione increment": 7666.6666,
        "Vertofix Coeur increment": 7000
      },
      "current_allocation_ul": {
        "Cashmeran (neat)": 30,
        "Kephalis": 10,
        "Azarbre": 70,
        "Cedarwood oil Virginia": 70,
        "Indian Vetiver EO (volume grade)": 50,
        "Hedione": 40,
        "Vertofix": 30
      }
    },
    "selection_rationale": [
      "Cashmeran is limited to a small increment because the chassis already has substantial textile warmth; it is not used as a generic mass builder.",
      "Kephalis is admitted at only 10 uL for an angular dark stitch, below a tobacco-accord role; Azarbre carries the larger smooth cedar-amber seam.",
      "Azarbre was selected over more Amberwood F, Timberol, or Norlimbanol because the target requires suppleness rather than a hard wall.",
      "Leather, oud, smoke, tobacco absolute, balsams, tinctures, and extra musk are excluded; EB remains the sole structural musk."
    ],
    "drift_risk": "More Kephalis, Cashmeran, leather, oud, smoke, or generic amberwood could flatten the aromatic recognizers into opaque tobacco-dark mass."
  },
