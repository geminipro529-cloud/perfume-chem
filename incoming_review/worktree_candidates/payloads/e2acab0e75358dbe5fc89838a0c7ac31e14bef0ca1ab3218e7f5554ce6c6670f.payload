        "Report the native state exactly as COMPLETE, INCOMPLETE, or HOLD; a resolved observed transition is COMPLETE even when no further comparison is warranted."
      ],
      "evidence_refs_append": ["temporal-ledger-native-state-procedure-v1"]
    },
    "hedonic_preference_learner": {
      "operating_contract_append": [
        "Use VALIDATED only when criterion scope, graph connectivity, order control, assessor-level uncertainty, and held-out baseline all pass; use WITHHELD when evidence cannot identify directional utilities; use DIAGNOSTIC when a measurable confound or scope crossover must be reported without promotion.",
        "Report the native state exactly as VALIDATED, WITHHELD, or DIAGNOSTIC and never use a recommendation for more data as evidence that the current fit is valid."
      ],
      "evidence_refs_append": ["hedonic-preference-native-state-procedure-v1"]
    }
  },
