{
  "perfume_id": "BDCP",
  "profile": {
    "perfume": "Bleu de Chanel Parfum",
    "house": "Chanel",
    "scope": "Current Parfum architecture.",
    "baseline_formula_id": "CB120-CHN-C07-259085496D",
    "baseline_rows": 71,
    "baseline_complexity": "VERY COMPLEX",
    "baseline_state": "COMPUTATIONAL CANDIDATE / ZERO EMPIRICAL SIMILARITY PASS",
    "official_summary": "Invigorating freshness opens and lingers across warm cedar and New Caledonian sandalwood throughout an intense aromatic-woody accord.",
    "target_identity": "A seamless sweep from bitter-aromatic freshness through full cedar into creamy New Caledonian sandalwood and polished musky woods.",
    "hedonic_tension": "Invigorating clarity versus dense creamy authority.",
    "source_urls": [
      "https://www.chanel.com/us/fragrance/p/107180/bleu-de-chanel-parfum-spray/"
    ],
    "authority_note": "Official architecture plus current label presence constraints; no exact molecular formula."
  },
  "art_direction": {
    "art_title": "Blue Cedar Continuum",
    "primary_motif": "Bitter aromatic freshness that travels through full cedar instead of disappearing above it.",
    "secondary_motif": "New Caledonian-style sandalwood cream, incense air and dark musky wood.",
    "foreground": "Grapefruit bitterness, aromatic clarity, cedar body and polished sandalwood.",
    "background": "Incense, moss, patchouli, mineral amber, suede shadow and musky wood aura.",
    "tension": "Invigorating clarity versus dense creamy authority.",
    "release": "Freshness is translated into aromatic wood, then into creamy sandalwood, so the perfume feels continuous rather than top-heavy.",
    "negative_space": "Incense air, floral transmission and dark shadow create depth between the cedar and sandalwood masses.",
    "recurrence": "Grapefruit bitterness reappears as a dry mineral edge around the late sandalwood.",
    "texture_progression": "bitter blue light → aromatic air → cedar grain → sandalwood cream → dark polished aura",
    "spatial_identity": "Clear bitter freshness projects first; the far field becomes polished wood while the near field retains incense and cream.",
    "late_residue": "Cedar, sandalwood, incense, mineral amber, musk, moss and a restrained suede-oud shadow.",
    "controlled_imperfection": "A trace of smoke, moss and root darkness prevents the smooth woods from becoming a showroom surface.",
    "hedonic_hypothesis": "The pleasure is seamless authority: freshness, grain, cream and darkness behave as one continuous object.",
    "forbidden": [
      "generic blue cloud",
      "citrus cliff",
      "pencil cedar",
      "buttery sandalwood monolith",
      "scratchy amberwood",
      "incense church smoke",
      "laundry musk"
    ],
    "layers": [
      [
        "I. Bitter blue light",
        "Grapefruit, bergamot, lemon, petitgrain, coriander, pepper, juniper and aldehydes create invigorating clarity."
      ],
      [
        "II. Aromatic relay",
        "Lavender, sage, rosemary, linalool, linalyl acetate, dihydromyrcenol, elemi and green traces carry freshness inward."
      ],
      [
        "III. Floral-air continuity",
        "Hedione, muguet, magnolia, Helional, cyclamen and floralozone preserve space through the heart."
      ],
      [
        "IV. Cedar body",
        "Multiple cedars, Iso E, Cedramber, Cashmeran, Kephalis, Timberol, vetiver and Vertofix create grain and mass."
      ],
      [
        "V. Sandalwood cream",
        "Sandalore, Polysantol, Ebanol, Javanol, natural sandalwood, Base X3 and Cabreuva create a fibrous creamy chord."
      ],
      [
        "VI. Dark polished aura",
        "Olibanum, labdanum, moss, patchouli, nagarmotha, oud/suede traces, ambergris materials and musks form the late identity."
      ]
    ],
    "hedonic_tuning": [
      "Freshness is supported across citrus, aromatic, green and floral-air routes so it can persist perceptually into wood.",
      "Cedar and sandalwood are separate polyphonic blocks, not one generic wood base.",
      "Amberwoods are distributed to avoid scratch and fatigue.",
      "Incense and suede are shadows, preserving sophistication without turning the scent dark or smoky."
    ]
  },
