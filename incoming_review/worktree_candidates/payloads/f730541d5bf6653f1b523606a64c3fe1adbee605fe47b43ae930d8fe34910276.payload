  "target_identity": {
    "north_star": "La Nuit's cardamom-lavender heart wrapped in dark textile woods: Cashmeran warmth, a trace angular Kephalis stitch, smooth Azarbre, and literal cedar-vetiver grain—supple and nocturnal, never leather, oud, smoke, tobacco accord, or opaque amberwood mass.",
    "functional_architecture": [
      "cardamom-lavender recognizers remain visible above the textile layer",
      "Cashmeran supplies warm fibrous texture rather than sweetness",
      "trace Kephalis gives an angular dark stitch while Azarbre supplies the smooth seam",
      "literal cedar and vetiver keep the textile grounded in La Nuit's vertical"
    ],
    "protected_identity": [
      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "supple dark textile texture stitched into literal cedar-vetiver woods",
    "variant_socket": {
      "active_ppm_w_w": 66666.667,
      "current_raw_ul": 300,
      "target_allocation": {
        "Cashmeran increment": 8000,
