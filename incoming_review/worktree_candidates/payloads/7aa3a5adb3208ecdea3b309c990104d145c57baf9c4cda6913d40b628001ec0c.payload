        },
    }
    for historical_id, expected_record in expected_history_by_id.items():
        if dict(history_by_id[historical_id]) != expected_record:
            raise InventoryAuthorityError(
                f"2026-09-04 runtime-sync historical provenance drift: {historical_id}"
            )

    predecessor_payload = load_current_user_inventory_overlay(
        PREVIOUS_USER_INVENTORY_OVERLAY_20260904_PATH,
        require_pinned_overlay=True,
    )
    predecessor_records = predecessor_payload.get("records")
    if not isinstance(predecessor_records, list):
        raise InventoryAuthorityError(
            "2026-09-04 runtime-sync predecessor has no consolidated records"
        )
    merged_records = [*predecessor_records, *delta_records]
    merged_names = [
        str(record.get("canonical_name") or "").casefold()
        for record in merged_records
    ]
    if len(merged_names) != len(set(merged_names)):
        raise InventoryAuthorityError(
            "2026-09-04 runtime-sync created duplicate canonical names"
        )
    consolidated = dict(successor_payload)
    consolidated["records"] = merged_records
    predecessor_history = predecessor_payload.get("historical_stock_records")
    if not isinstance(predecessor_history, list):
        raise InventoryAuthorityError(
            "2026-09-04 runtime-sync predecessor has no historical stock records"
        )
    consolidated["historical_stock_records"] = [
        *predecessor_history,
        *historical_records,
    ]
    return consolidated


def _load_20260904_inventory_successor(
    successor_payload: Mapping[str, Any],
) -> dict[str, Any]:
    """Validate and merge the 2026-09-04 user-authority successor."""

    predecessor = successor_payload.get("predecessor")
    source = successor_payload.get("source")
    policy = successor_payload.get("policy")
    delta_records = successor_payload.get("delta_records")
