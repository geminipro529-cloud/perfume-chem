        != "USER_CURRENT_PHYSICAL_INVENTORY_AUTHORITY"
        or successor_payload.get("effective_date") != "2026-09-04"
        or not isinstance(predecessor, Mapping)
        or not isinstance(source, Mapping)
        or not isinstance(policy, Mapping)
        or not isinstance(delta_records, list)
        or not isinstance(historical_records, list)
        or not isinstance(authority_limits, Mapping)
