    if not isinstance(predecessor_records, list):
        raise InventoryAuthorityError(
            "2026-09-04 inventory predecessor has no consolidated records"
        )
    predecessor_record_ids = [
        str(record.get("record_id") or "")
        for record in predecessor_records
        if isinstance(record, Mapping)
    ]
    if successor_payload.get("carried_forward_record_ids") != predecessor_record_ids:
        raise InventoryAuthorityError(
            "2026-09-04 inventory successor carry-forward lineage drift"
        )
    replacement_names = {
        str(name).casefold()
        for name in successor_payload["replaced_canonical_names"]
    }
    merged_records = [
        record
        for record in predecessor_records
        if str(record.get("canonical_name") or "").casefold()
        not in replacement_names
    ]
    merged_records.extend(delta_records)
    merged_names = [
        str(record.get("canonical_name") or "").casefold()
        for record in merged_records
    ]
    if len(merged_names) != len(set(merged_names)):
        raise InventoryAuthorityError(
            "2026-09-04 inventory successor created duplicate identities"
        )
    consolidated = dict(successor_payload)
    consolidated["records"] = merged_records
    return consolidated


def _load_20260901_inventory_successor(
    successor_payload: Mapping[str, Any],
) -> dict[str, Any]:
    """Validate and merge the 2026-09-01 user-authority successor."""

    predecessor = successor_payload.get("predecessor")
    source = successor_payload.get("source")
    policy = successor_payload.get("policy")
    delta_records = successor_payload.get("delta_records")
    historical_records = successor_payload.get("historical_stock_records")
    authority_limits = successor_payload.get("authority_limits")
    if (
        successor_payload.get("successor_id")
        != "INVENTORY-USER-AUTHORITY-20260901-001"
        or successor_payload.get("authority")
        != "USER_CURRENT_PHYSICAL_INVENTORY_AUTHORITY"
        or successor_payload.get("effective_date") != "2026-09-01"
        or not isinstance(predecessor, Mapping)
        or not isinstance(source, Mapping)
        or not isinstance(policy, Mapping)
        or not isinstance(delta_records, list)
        or not isinstance(historical_records, list)
        or not isinstance(authority_limits, Mapping)
    ):
        raise InventoryAuthorityError(
            "2026-09-01 user inventory successor metadata is invalid"
        )

    expected_predecessor = {
        "path": "data/governance/inventory_user_authority_overlay_20260831.json",
        "normalized_text_sha256": LEGACY_USER_INVENTORY_OVERLAY_20260831_SHA256,
        "authority": "USER_CURRENT_PHYSICAL_INVENTORY_AUTHORITY",
        "effective_date": "2026-08-31",
    }
    if dict(predecessor) != expected_predecessor:
        raise InventoryAuthorityError(
            "2026-09-01 inventory successor predecessor pin drift"
        )
    if (
        _normalized_text_sha256(LEGACY_USER_INVENTORY_OVERLAY_20260831_PATH)
        != LEGACY_USER_INVENTORY_OVERLAY_20260831_SHA256
    ):
        raise InventoryAuthorityError(
            "2026-09-01 inventory successor predecessor bytes drift"
        )

    expected_source = {
        "kind": "DIRECT_USER_CURRENT_STOCK_AND_FORMULATION_ROLE_CORRECTION",
        "source_context": "CURRENT_CODEX_TASK_DIRECT_USER_MESSAGES_2026-09-01",
        "statements": [
