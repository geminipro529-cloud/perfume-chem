"""Deterministic, evidence-limited Deep Plane runtime diagnostics.

This module operationalizes the reusable parts of the Deep Plane Perfumery
grammar: named identity, opposed but connected states, anatomy, spatial and
temporal continuity, relational complexity, inventory truth, physical-model
traceability, and controlled-experiment requirements.

It is deliberately not a formulator and never grants release authority.  Its
in-memory assessment can feed a release gate, but a completed check remains
authority-limited: calculations are computational diagnostics and do not
establish smell, liking, similarity, safety, stability, performance, physical
execution, compounding, purchase, formula execution, or release.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Mapping, Sequence


