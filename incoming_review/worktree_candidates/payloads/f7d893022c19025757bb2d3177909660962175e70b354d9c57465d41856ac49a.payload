  "conversion": {
    "equation": "raw_uL = target_stock_g * 1000 / estimated_stock_density_g_ml",
    "active_equation": "estimated_active_g = raw_uL * estimated_stock_density_g_ml / 1000 * stock_mass_fraction",
    "ppm_equation": "estimated_stock_blend_ppm_w_w = estimated_active_g / estimated_stock_blend_mass_g * 1000000",
    "rounding": "Nearest 1 uL, except Suederal nearest 0.1 uL. These are display settings, not demonstrated pipette accuracy.",
    "temperature_scope": "Approximate room-temperature 20-25 C references; mixed source temperatures, no thermal expansion correction. No validity claim for warm 30-35 C stocks.",
