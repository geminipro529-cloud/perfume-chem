{
  "perfume_id": "LANUIT",
  "profile": {
    "perfume": "YSL La Nuit de L’Homme Eau de Toilette",
    "house": "YSL",
    "scope": "Current Eau de Toilette with unresolved regional official-source conflict.",
    "baseline_formula_id": "CB120-YSL-Y08-00E9AA5C19",
    "baseline_rows": 62,
    "baseline_complexity": "COMPLEX",
    "baseline_state": "COMPUTATIONAL CANDIDATE / ZERO EMPIRICAL SIMILARITY PASS",
    "official_summary": "US page: cardamom, iris and tonka heading; cardamom, cedar and coumarin body. International page: spicy bergamot, cedar-lavender heart, vetiver base, and elsewhere bergamot-lavender-tonka.",
    "target_identity": "An intimate cardamom-led night structure with cool aromatic lift, soft floral/powder shadow and cedar-vetiver-tonka/coumarin warmth.",
    "hedonic_tension": "Restraint versus abandon, at close range rather than brute projection.",
    "source_urls": [
      "https://www.yslbeautyus.com/fragrance/mens-fragrances/la-nuit-de-lhomme/la-nuit-de-lhomme-eau-de-toilette-spray/426YSL.html",
      "https://www.yslbeauty.com/int/fragrance/fragrance-for-him/la-nuit-de-l-homme/la-nuit-de-l-homme-eau-de-toilette/426YSL.html"
    ],
    "authority_note": "Conflict must remain explicit. Iris, lavender, coumarin, tonka and vetiver cannot be silently merged into one canonical note list."
  },
  "art_direction": {
    "art_title": "Cardamom Velvet",
    "primary_motif": "Cardamom warmth glowing inside a dark cedar frame.",
    "secondary_motif": "A cool lavender-floral shadow with a low iris whisper over tonka-coumarin skin.",
    "foreground": "Cardamom, spicy bergamot, lavender shadow and dark cedar.",
    "background": "Tonka, coumarin, vetiver, resins, suede, intimate musks and a conditional iris veil.",
    "tension": "Restraint versus abandon at close range.",
    "release": "The bright cardamom is slowly absorbed by cedar and tonka until it becomes warm skin rather than a spice note.",
    "negative_space": "Hedione, muguet and restrained transparent wood preserve intimacy without making the perfume weak or opaque.",
    "recurrence": "Cardamom returns as a warm pulse at two and eight hours, no longer bright but embedded in coumarin and musk.",
    "texture_progression": "electric cardamom → cool aromatic velvet → iris haze → dark cedar → warm skin",
    "spatial_identity": "Highly legible within conversational distance, deliberately restrained in the far field.",
    "late_residue": "Cedar, tonka-coumarin, vetiver, resin, suede and soft macrocyclic musk.",
    "controlled_imperfection": "A faint smoky animalic shadow under the polished warmth creates nocturnal depth without fecal or bandage character.",
    "hedonic_hypothesis": "The sensuality is magnetic proximity: detail and warmth reward leaning closer.",
    "forbidden": [
      "cardamom toothpaste",
      "lipstick iris",
      "lavender soap",
      "syrupy tonka",
      "generic woody amber",
      "fecal animalic",
      "brute projection"
    ],
    "layers": [
      [
        "I. Cardamom ignition",
        "Cardamom, bergamot, grapefruit, pepper, coriander, ginger and aldehydes create near-field electricity."
      ],
      [
        "II. Aromatic velvet",
        "Lavender, linalool, linalyl acetate, sage and soft air materials cool and smooth the spice."
      ],
      [
        "III. Conditional iris shadow",
        "Low irone, orris and ionone geometries add softness without turning the perfume into Dior Homme."
      ],
      [
        "IV. Dark cedar frame",
        "Two cedars, Cedramber, Cashmeran, Kephalis, vetiver and patchouli create night structure."
      ],
      [
        "V. Tonka-coumarin skin",
        "Coumarin, tonka, vanilla, anisic traces, benzoin, labdanum and storax create warm sensuality."
      ],
      [
        "VI. Intimate residue",
        "Ambrettolide, Exaltolide, Zenolide, Habanolide, suede and animalic traces create close-range magnetism."
      ]
    ],
    "hedonic_tuning": [
      "Cardamom is oversized as the recognizer but supported by citrus, aromatic and resinous bridges.",
      "Iris remains a shadow and is explicitly source-conflicted, never allowed to own the fragrance.",
      "Tonka and coumarin are warm and tactile rather than syrupy.",
      "Projection is shaped spatially, not merely reduced by lowering concentration."
    ]
  },
