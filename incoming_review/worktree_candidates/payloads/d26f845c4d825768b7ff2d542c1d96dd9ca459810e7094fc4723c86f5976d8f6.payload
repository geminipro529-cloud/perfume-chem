"""Perfumer-logic gates for optimizer outputs.

Numerical optimizers can improve a scalar score while damaging the actual
perfume brief. These gates express non-negotiable perfumer grammar as explicit
pass/warn/fail checks. A FAIL should trigger another optimization pass with
adjusted constraints or weights.
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Mapping

from engine.families.registry import evaluate_family_archetype, get_archetype, infer_archetype
from engine.name_utils import normalize_name


@dataclass(frozen=True)
class LogicCheck:
    name: str
    status: str
    detail: str


@dataclass(frozen=True)
class PerfumerLogicReport:
    brief: str
    status: str
    rerun_recommended: bool
    checks: list[LogicCheck]


def _active_pct(formula: Mapping, material_names: set[str]) -> float:
    ingredients = formula.get("ingredients_pct", {})
    dilutions = formula.get("dilutions", {})
    total = 0.0
    for material, raw_pct in ingredients.items():
        if normalize_name(material) in material_names:
            total += float(raw_pct) * float(dilutions.get(material, 1.0))
    return total


def _raw_pct(formula: Mapping, material_names: set[str]) -> float:
    ingredients = formula.get("ingredients_pct", {})
    return sum(
        float(raw_pct)
        for material, raw_pct in ingredients.items()
        if normalize_name(material) in material_names
    )


def _check_floor(name: str, value: float, floor: float, unit: str = "% active") -> LogicCheck:
    if value >= floor:
        return LogicCheck(name, "PASS", f"{value:.3f}{unit} >= {floor:.3f}")
    return LogicCheck(name, "FAIL", f"{value:.3f}{unit} below {floor:.3f}")


def _check_ceiling(name: str, value: float, ceiling: float, unit: str = "% raw") -> LogicCheck:
    if value <= ceiling:
        return LogicCheck(name, "PASS", f"{value:.3f}{unit} <= {ceiling:.3f}")
    return LogicCheck(name, "FAIL", f"{value:.3f}{unit} above {ceiling:.3f}")


