def infer_brief(formula: Mapping) -> str:
    name = str(formula.get("name", "")).lower()
    body = str(formula.get("body", "")).lower()
    text = f"{name}\n{body}"
    if "layton" in text:
        return "layton_dna"
    if "fougere" in text or "fougère" in text:
        return "aromatic_fougere"
    return "generic"


def _report_from_archetype(formula: Mapping, archetype: str, fallback_brief: str) -> PerfumerLogicReport:
    spec = get_archetype(archetype)
    if spec is None:
        return _report(
            fallback_brief,
            [LogicCheck("family_archetype_known", "WARN", f"No family archetype spec for {archetype!r}.")],
        )
    evaluation = evaluate_family_archetype(formula, archetype)
    checks = [
        LogicCheck(check.name, check.status, check.detail)
        for check in evaluation.checks
    ]
    return _report(evaluation.archetype, checks)


def evaluate_layton_dna(formula: Mapping, family_archetype: str = "") -> PerfumerLogicReport:
    archetype = infer_archetype("layton_dna", family_archetype)
    return _report_from_archetype(formula, archetype, "layton_dna")


def evaluate_aromatic_fougere(formula: Mapping, family_archetype: str = "") -> PerfumerLogicReport:
    archetype = infer_archetype("aromatic_fougere", family_archetype)
    return _report_from_archetype(formula, archetype, "aromatic_fougere")


def evaluate_perfumer_logic(
    formula: Mapping,
    brief: str = "auto",
    family_archetype: str = "",
) -> PerfumerLogicReport:
    resolved = infer_brief(formula) if brief == "auto" else brief
    if family_archetype and get_archetype(family_archetype) is not None:
        return _report_from_archetype(formula, family_archetype, resolved)
    if resolved == "layton_dna":
        return evaluate_layton_dna(formula, family_archetype)
    if resolved == "aromatic_fougere":
        return evaluate_aromatic_fougere(formula, family_archetype)
    return _report("generic", [LogicCheck("perfumer_logic_brief", "WARN", "No brief-specific logic selected.")])


def _report(brief: str, checks: list[LogicCheck]) -> PerfumerLogicReport:
    has_fail = any(check.status == "FAIL" for check in checks)
    has_warn = any(check.status == "WARN" for check in checks)
    status = "FAIL" if has_fail else "WARN" if has_warn else "PASS"
    return PerfumerLogicReport(
        brief=brief,
        status=status,
        rerun_recommended=has_fail,
        checks=checks,
    )
