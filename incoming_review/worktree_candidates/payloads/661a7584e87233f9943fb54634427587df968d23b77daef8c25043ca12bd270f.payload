    assert item["diagnostics"]["composite_natural_oav"] == (
        "LITERATURE_PROXY_COMPOSITE_MODELS_APPLIED__NOT_USER_LOT_MEASUREMENTS"
    )
    assert any("Caraway composite" in gap for gap in item["missing_chemical_impact"]["gaps"])
    assert "caraway addition arm" in item["blind_test"]["comparison"]


def test_dark_textile_woods_excludes_genre_changing_shortcuts():
    names = {
        row["inventory_name"].casefold()
        for row in candidate("LN-09")["current_inventory_build"]["materials"]
    }
    for forbidden in ("leather", "oud", "tobacco", "birch tar", "cade"):
        assert all(forbidden not in name for name in names)


def test_intimate_diffusion_uses_only_eb_and_keeps_unverified_musks_out():
    item = candidate("LN-10")
    rows = item["current_inventory_build"]["materials"]
    musks = [row for row in rows if row["is_musk"]]
    assert [row["inventory_name"] for row in musks] == ["Ethylene Brassylate"]
    assert musks[0]["stock_fraction"] == 1.0
    assert musks[0]["concentration_basis"] == "w/w"
    names = {row["inventory_name"] for row in rows}
    assert names.isdisjoint({"Habanolide", "Romandolide", "Ambrettolide"})
    assert "omission control" in item["blind_test"]["comparison"]


def test_missing_chemical_receipts_remain_candidate_only_and_authority_false():
    for candidate_id in EXPECTED_IDS:
        receipt = load_json(f"impact/{candidate_id}_assessment.json")
        assert receipt["schema"] == "perfume-chem-missing-chemical-assessment-v2"
        assert receipt["target_formula_id"] == candidate_id
        assert receipt["impact_gate"]["architecture_locked"] is True
        assert receipt["impact_gate"]["auto_integrated_materials"] == []
        assert receipt["impact_gate"]["gaps"]
        assert receipt["decision"]["design_formula_complete"] is True
        assert receipt["decision"]["automatic_purchase_authority"] is False
        assert receipt["decision"]["physical_compounding_authority"] is False
        assert receipt["decision"]["sensory_finalist_authority"] is False
        assert receipt["claim_ceiling"]["physical_liking"] == "NOT TESTED"
        assert receipt["claim_ceiling"]["release"] == "NOT CLEARED"


def test_missing_chemical_index_has_one_nonexecuting_recommendation_per_candidate():
    index = load_json("reports/missing_chemical_impact_index.json")
    assert index["schema"] == "perfume-chem-ysl-impact-index-v2"
    assert index["pipette_rule"] == "ALL_RAW_STOCK_DOSES_AT_OR_ABOVE_10_UL"
    assert tuple(row["candidate_id"] for row in index["candidates"]) == EXPECTED_IDS
    for row in index["candidates"]:
        assert row["purchase_preparation_state"]
        assert row["minimum_raw_stock_dose_ul"] >= 10.0
        assert row["physical_execution_authorized"] is False
        assert row["purchase_authority"] is False
        assert "USE_CURRENT_STOCK" not in json.dumps(row)


def test_screening_summary_binds_all_twenty_native_runs_without_score_ranking():
    summary = load_json("reports/screening_summary.json")
    assert summary["schema"] == "perfume-chem-ysl-screening-summary-v2"
    assert summary["candidate_order"] == list(EXPECTED_IDS)
    assert summary["ranking_policy"] == "NO_TOTAL_SCORE_RANKING"
    assert summary["runtime_snapshot"]["stable_after_batch"] is True
    assert summary["runtime_snapshot"]["temperature_K"] == 305.0
    assert summary["batch_result"]["candidate_count"] == 20
    assert summary["batch_result"]["overall_fail_count"] == 0
    assert summary["batch_result"]["pipette_floor_pass_count"] == 20
    hash_payload = dict(summary)
    recorded_hash = hash_payload.pop("summary_sha256")
    canonical = json.dumps(
        hash_payload,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode()
    assert hashlib.sha256(canonical).hexdigest() == recorded_hash

    rows = summary["candidates"]
    assert tuple(row["candidate_id"] for row in rows) == EXPECTED_IDS
    for row in rows:
        assert math.isclose(row["parsed_subtotal_ul"], 4500.0)
        assert row["temperature_K"] == 305.0
        assert row["oav_authority"]["headspace_basis"] == (
            "MODELED_ACTIVE_CONCENTRATE_SCREEN"
        )
        assert row["oav_authority"]["model_class"] == "HEURISTIC_NOT_MEASURED"
        assert row["oav_authority"]["sensory_authority"] is False
        assert row["gate_counts"]["FAIL"] == 0
        assert row["overall_gate_status"] == "WARN"
        assert row["pipette_floor"] == {
            "status": "PASS",
            "minimum_raw_stock_ul": 10.0,
            "all_current_rows_at_or_above_floor": True,
        }
        assert row["finalist_eligibility"]["status"].startswith("HOLD")
        assert set(row["note_distribution"]) == {"top", "heart", "base"}
        assert [window["label"] for window in row["time_windows"]] == [
            "opening",
            "top",
            "heart",
            "late_heart",
            "drydown",
        ]
        assert row["headspace_table"]
        assert all(
            {
                "material",
                "dilution",
                "raw_ul",
                "active_ul",
                "mw_g_mol",
                "mole_fraction_pct",
                "vp_pa",
                "gamma",
                "vapor_ppm",
                "odt_ppm",
                "oav",
                "note",
            }.issubset(material)
            for material in row["headspace_table"]
        )
        diagnostics = candidate(row["candidate_id"])["diagnostics"]
        assert diagnostics["screening_summary_sha256"] == summary["summary_sha256"]
        assert diagnostics["parser_preflight"]["formula_definition_sha256"] == row[
            "formula_definition_sha256"
        ]
        assert diagnostics["pipeline_release_gate"].startswith("WARN__")
        assert diagnostics["sensory_authority"] is False


def test_screening_headspace_covers_every_current_material_and_composite_natural():
    summary = load_json("reports/screening_summary.json")
    for summary_row in summary["candidates"]:
        expected_names = {
            row["inventory_name"]
            for row in candidate(summary_row["candidate_id"])["current_inventory_build"][
                "materials"
            ]
        }
        headspace = summary_row["headspace_table"]
        assert {row["material"] for row in headspace} == expected_names
        for row in headspace:
            assert row["odt_ppm"] > 0
            assert row["oav"] >= 0
            assert row["oav_model_source"]
            assert row["odt_source"]
            if any(token in row["material"].casefold() for token in (" eo", "oil", "absolute")):
                assert row["oav_model_source"].startswith("literature_proxy:")
                assert row["odt_source"].startswith("derived_effective:")


def test_climate_screen_uses_celsius_conversion_and_preserves_authority_ceiling():
    summary = load_json("reports/screening_summary.json")
    for row in summary["candidates"]:
        climate = row["climate_diagnostic"]
        assert row["temperature_K"] == 305.0
        assert math.isclose(climate["modeled_temperature_c"], 31.85, abs_tol=1e-9)
        assert math.isclose(
            climate["vp_factor_vs_22c"], 2.2026261497956656, rel_tol=1e-12
        )
        assert climate["authority"] == (
            "CLAUSIUS_CLAPEYRON_WORKING_MODEL_NOT_MEASURED"
        )
        assert row["oav_authority"]["sensory_authority"] is False


def test_all_twenty_candidates_have_required_final_sections():
    required = {
        "target_identity",
        "target_ideal",
        "current_inventory_build",
        "missing_chemical_impact",
        "purchase_preparation",
        "diagnostics",
        "blind_test",
        "claim_ceiling",
    }
    for candidate_id in EXPECTED_IDS:
        assert required.issubset(candidate(candidate_id))


def test_unmeasured_claims_remain_held_for_every_candidate():
    for candidate_id in EXPECTED_IDS:
        ceiling = candidate(candidate_id)["claim_ceiling"]
        assert ceiling["physical_liking"] == "NOT TESTED"
        assert ceiling["sensory_similarity"] == "NOT TESTED"
        assert ceiling["stability"] == "NOT TESTED"
        assert ceiling["safety"] == "NOT CLEARED"
        assert ceiling["measured_headspace"] == "NOT TESTED"
        assert ceiling["release"] == "NOT CLEARED"


def test_blind_protocol_is_balanced_replicated_and_authority_false():
    protocol = load_json("testing/blind_protocol.json")
    assert protocol["schema"] == "perfume-chem-ysl-blind-protocol-v1"
    assert protocol["status"] == "PROTOCOL_ONLY_NOT_EXECUTED"
    assert protocol["time_cells"] == ["0_min", "5_min", "30_min", "2_hr", "4_hr"]
    assert protocol["mandatory_arms"] == ["LH-04", "LN-01", "LN-05"]
    assert protocol["conditional_rescreen_priorities"] == ["LH-05", "LN-02"]
    assert protocol["blinding"]["codes"] == "RANDOM_NONSEMANTIC"
    assert protocol["blinding"]["key_storage"] == "SEPARATE_FROM_ASSESSORS"
    assert protocol["order_control"]["balanced_order"] is True
    assert protocol["sample_control"] == {
        "equal_odorant_active_mass_concentration": True,
        "equal_applied_mass": True,
        "equal_application_method": True,
        "carrier_matched": True,
    }
    assert protocol["replication"]["minimum_true_replicates_for_advancement"] >= 2
    assert protocol["replication"]["independent_batch_preparation"] is True
    assert protocol["authority"] == {
        "protocol_execution": False,
        "physical_liking": False,
        "sensory_similarity": False,
        "stability": False,
        "safety": False,
        "release": False,
    }


def test_blind_protocol_has_all_phase_one_pairs_and_tie_aware_phase_two():
    protocol = load_json("testing/blind_protocol.json")
    phase_one = protocol["phases"]["phase_1_family_controlled_screen"]
    pairs = {(row["control"], row["variant"]) for row in phase_one["pairs"]}
    assert pairs == {
        *{("LH-01", candidate_id) for candidate_id in LH_CHILD_IDS},
        *{("LN-01", candidate_id) for candidate_id in LN_CHILD_IDS},
    }
    phase_two = protocol["phases"]["phase_2_family_comparison"]
    assert phase_two["status"] == "LOCKED_PENDING_PHASE_1_AND_AUTHORITY_REPAIR"
    assert phase_two["lhomme_arms"] == [
        "LH-01",
        "TOP_TWO_ELIGIBLE_LH_VARIANTS_POST_PHASE_1",
        "SOL-LH-FROZEN",
    ]
    assert phase_two["la_nuit_arms"] == [
        "LN-01",
        "TOP_TWO_ELIGIBLE_LN_VARIANTS_POST_PHASE_1",
        "SOL-LN-FROZEN",
    ]
    assert protocol["decision_rules"]["ties"] == "RETAIN_AS_TIE_OR_INCONCLUSIVE"
    assert protocol["decision_rules"]["missing_cells"] == "DO_NOT_IMPUTE"


def test_missing_chemical_microtrial_template_is_constant_total_and_nonexecuting():
    protocol = load_json("testing/blind_protocol.json")
    templates = protocol["missing_chemical_microtrial_templates"]
    assert templates
    for template in templates:
        assert template["arm_types"] == ["CONTROL", "ADDITION", "OMISSION", "RATIO"]
        assert template["constant_total"] is True
        assert template["carrier_matched"] is True
        assert template["minimum_true_replicates"] >= 2
        assert template["expected_cells_locked_before_observation"] is True
        assert template["execution_authorized"] is False
        assert template["tie_or_missing_result"] in {"HOLD", "INCONCLUSIVE"}


def test_final_index_and_readme_list_every_candidate_in_order():
    readme = (STUDY / "README.md").read_text(encoding="utf-8")
    final_index = (STUDY / "reports" / "final_index.md").read_text(encoding="utf-8")
    for text in (readme, final_index):
        positions = [
            text.index(f"candidates/{candidate_id}.json")
            for candidate_id in EXPECTED_IDS
        ]
        assert positions == sorted(positions)
        for candidate_id in EXPECTED_IDS:
            assert f"candidates/{candidate_id}.json" in text or (
                f"../candidates/{candidate_id}.json" in text
            )
            assert f"impact/{candidate_id}_assessment.json" in text or (
                f"../impact/{candidate_id}_assessment.json" in text
            )
    assert "TARGET / IDEAL" in readme
    assert "CURRENT-INVENTORY BUILD" in readme
    assert "NOT TESTED" in readme


def test_manifest_binds_final_handoff_artifacts_and_frozen_baselines():
    manifest = load_json("study_manifest.json")
    bindings = manifest["artifact_bindings"]
    required = {
        "inventory_overlay",
        "current_inventory_overlay_2026_08_28",
        "evidence_ledger",
        "blind_protocol",
        "screening_summary",
        "missing_chemical_impact_index",
        "sol_comparison",
        "final_index",
        "readme",
        "apple_pie_ap_t1_v3",
        "sol_lhomme_source_snapshot",
        "sol_la_nuit_source_snapshot",
    }
    assert required.issubset(bindings)
    for key in required:
        binding = bindings[key]
        path = STUDY / binding["path"]
        assert path.is_file()
        assert hashlib.sha256(path.read_bytes()).hexdigest().upper() == binding["sha256"]
    assert bindings["sol_lhomme_source_snapshot"]["sha256"] == (
        "44ABA8B5153D26A8AFA5CD07B20974EAAF66A5D659FEECC13D59EEF6F917E0FD"
    )
    assert bindings["sol_la_nuit_source_snapshot"]["sha256"] == (
        "254A73B6B45420CF89034FC5C2CAABCAACE9A197BE315C31E9958E4A5CFDAEBB"
    )


def test_blind_protocol_defines_matched_xhigh_program_lift_benchmark():
    protocol = load_json("testing/blind_protocol.json")
    benchmark = protocol["engineering_benchmark"]

    assert benchmark["status"] == "PROTOCOL_ONLY_NOT_EXECUTED"
    assert [arm["arm_id"] for arm in benchmark["arms"]] == [
        "A_XHIGH_ALONE",
        "B_XHIGH_CURRENT_PROGRAM",
        "C_XHIGH_UPGRADED_PROGRAM",
        "D_ULTRA_UPGRADED_PROGRAM_OPTIONAL",
    ]
    assert benchmark["causal_contrasts"] == {
        "program_lift": "C_XHIGH_UPGRADED_PROGRAM minus A_XHIGH_ALONE and B_XHIGH_CURRENT_PROGRAM",
        "model_lift": "D_ULTRA_UPGRADED_PROGRAM_OPTIONAL minus C_XHIGH_UPGRADED_PROGRAM",
    }
    assert benchmark["matched_controls"]["same_inventory_bytes"] is True
    assert benchmark["matched_controls"]["same_time_budget"] is True
    assert benchmark["matched_controls"]["same_prompt_and_target_contract"] is True
    assert benchmark["pilot"]["briefs"] == [
        "ysl_lhomme",
        "ysl_la_nuit_de_lhomme",
        "unrelated_family_control",
    ]
    assert benchmark["pilot"]["independent_runs_per_brief_per_arm"] == 3
    assert "time_to_first_executable_formula_seconds" in benchmark["metrics"][
        "engineering"
    ]
    assert "identity_retaining_paired_preference" in benchmark["metrics"][
        "sensory"
    ]
    assert benchmark["claim_ceiling"] == (
        "Engineering measurements can compare speed, validity, and cost. Only future "
        "controlled blinded observations can compare identity-retaining preference or liking."
    )


def test_blind_protocol_binds_executable_receipts_and_structured_contrasts():
    protocol = load_json("testing/blind_protocol.json")
    benchmark = protocol["engineering_benchmark"]
    arms = {row["arm_id"]: row for row in benchmark["arms"]}
    contract = benchmark["receipt_contract"]

    assert arms["A_XHIGH_ALONE"]["required"] is True
    assert arms["B_XHIGH_CURRENT_PROGRAM"]["required"] is True
    assert arms["C_XHIGH_UPGRADED_PROGRAM"]["required"] is True
    assert arms["D_ULTRA_UPGRADED_PROGRAM_OPTIONAL"]["required"] is False
    for arm_id in (
        "A_XHIGH_ALONE",
        "B_XHIGH_CURRENT_PROGRAM",
        "C_XHIGH_UPGRADED_PROGRAM",
    ):
        assert arms[arm_id]["model"] == "gpt-5.6-sol"
        assert arms[arm_id]["reasoning_effort"] == "xhigh"
    assert arms["D_ULTRA_UPGRADED_PROGRAM_OPTIONAL"]["model"] == "gpt-5.6-sol"
    assert (
        arms["D_ULTRA_UPGRADED_PROGRAM_OPTIONAL"]["reasoning_effort"]
        == "ultra"
    )
    assert contract["schema"] == "perfume-chem.matched-benchmark-receipts.v1"
    assert {
        "prompt_contract_sha256",
        "inventory_sha256",
        "stock_basis_sha256",
        "evaluation_pipeline_sha256",
        "concentrate_ul",
        "temperature_K",
        "time_budget_seconds",
        "output_schema",
    }.issubset(contract["matched_fields"])
    assert contract["metric_directions"]["wall_clock_seconds"] == "lower"
    assert contract["metric_directions"]["cache_hit_rate"] == "higher"
    assert contract["metric_units"]["wall_clock_seconds"] == "seconds"
    assert contract["metric_units"]["cache_hit_rate"] == "fraction_0_1"
    assert contract["metric_units"]["model_or_provider_cost"] == "usd"
    assert contract["positive_fields"] == [
        "concentrate_ul",
        "temperature_K",
        "time_budget_seconds",
    ]
    assert benchmark["causal_contrast_pairs"] == [
        {
            "contrast_id": "program_vs_alone",
            "baseline_arm_id": "A_XHIGH_ALONE",
            "candidate_arm_id": "C_XHIGH_UPGRADED_PROGRAM",
        },
        {
            "contrast_id": "program_vs_current",
            "baseline_arm_id": "B_XHIGH_CURRENT_PROGRAM",
            "candidate_arm_id": "C_XHIGH_UPGRADED_PROGRAM",
        },
        {
            "contrast_id": "model_lift_optional",
            "baseline_arm_id": "C_XHIGH_UPGRADED_PROGRAM",
            "candidate_arm_id": "D_ULTRA_UPGRADED_PROGRAM_OPTIONAL",
            "optional": True,
        },
    ]


def test_blind_protocol_realism_learning_requires_repeated_blinded_evidence():
    protocol = load_json("testing/blind_protocol.json")
    learning = protocol["realism_learning"]

    assert learning["status"] == "PROTOCOL_ONLY_NOT_EXECUTED"
    assert learning["minimum_distinct_formulas_for_rule_review"] == 2
    assert learning["minimum_independent_batches_for_rule_review"] == 2
    assert learning["identity_retention_required"] is True
    assert learning["blinding_required_for_rule_review"] is True
    assert learning["automatic_optimizer_mutation"] is False
    assert learning["single_formula_generalization"] == "FORBIDDEN"
    assert learning["apple_pie_facets"] == [
        "fresh_apple_flesh_and_peel",
        "cooked_apple_filling",
        "browned_pastry_crust",
        "butter_or_fat_impression",
        "spice_integration",
        "layer_transition",
    ]
