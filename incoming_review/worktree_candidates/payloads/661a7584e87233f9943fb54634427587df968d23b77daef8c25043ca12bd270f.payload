def test_lavender_heart_uses_natural_and_molecular_registers_without_musk_padding():
    rows = {
        row["inventory_name"]: row
        for row in candidate("LN-04")["current_inventory_build"]["materials"]
    }
    assert rows["Lavender EO High Altitude"]["odorant_active_ppm_w_w"] > rows[
        "Spike Lavender EO"
    ]["odorant_active_ppm_w_w"]
    assert rows["Linalool"]["odorant_active_ppm_w_w"] > 0
    assert rows["Linalyl Acetate"]["odorant_active_ppm_w_w"] > 0
    assert sum(bool(row["is_musk"]) for row in rows.values()) == 1


def test_immortelle_nuit_preserves_executable_stock_basis_and_omits_uncovered_naturals():
    item = candidate("LN-05")
    rows = {
        row["inventory_name"]: row
        for row in item["current_inventory_build"]["materials"]
    }
    for name in ("Immortelle Absolute (10% in DPG)", "Maple Lactone (20%)"):
        assert rows[name]["stock_status"].startswith("VERIFY_FIRST")
        assert rows[name]["concentration_basis"] == "UNRECORDED_PERCENT_BASIS"
    assert "Helichrysum EO" not in rows
    assert "Hay Absolute (10%)" not in rows
    assert item["diagnostics"]["composite_natural_oav"] == (
        "LITERATURE_PROXY_COMPOSITE_MODELS_APPLIED__NOT_USER_LOT_MEASUREMENTS"
    )
    assert all("neroli" not in name.casefold() for name in rows)
    assert all("tincture" not in name.casefold() for name in rows)


