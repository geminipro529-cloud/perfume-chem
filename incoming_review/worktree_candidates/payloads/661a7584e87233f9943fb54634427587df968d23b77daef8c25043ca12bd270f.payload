def test_dry_coumarin_skin_omits_unverified_hay_and_defines_mass_preparation():
    item = candidate("LN-07")
    names = {
        row["inventory_name"]
        for row in item["current_inventory_build"]["materials"]
    }
    assert "Hay Absolute (10%)" not in names
    assert "Coumarin" not in names
    assert item["purchase_preparation"]["state"] == (
        "PREPARE_10_PERCENT_W_W_COUMARIN_FROM_OWNED_NEAT_FOR_OPTIONAL_CONTROL"
    )
    recommendation = item["purchase_preparation"]["recommendation"]
