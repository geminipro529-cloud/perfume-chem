import json
import hashlib
import math
from pathlib import Path

from engine.calibration.hashing import formula_hash_from_record
from engine.inventory_parser import parse_inventory, resolve_inventory_material
from scripts.evaluate_formula import parse_formula_file
from scripts.verify_formula_workflow import parse_formula_markdown


ROOT = Path(__file__).resolve().parents[2]
STUDY = ROOT / "formulas" / "ysl_twenty_variant_study"
EXPECTED_IDS = tuple(
    [f"LH-{index:02d}" for index in range(1, 11)]
    + [f"LN-{index:02d}" for index in range(1, 11)]
)
LOST_TINCTURES = {
    "Vietnamese Benzoin Styrax Tonkinensis resin ethanol tincture (20%)",
    "Turkish Storax Liquidambar Orientalis resin ethanol tincture (20%)",
}
FORBIDDEN_MUSKS = {"Tonalide", "Macrolide", "Musk Ketone"}
LH_CHILD_IDS = tuple(f"LH-{index:02d}" for index in range(2, 11))
LN_CHILD_IDS = tuple(f"LN-{index:02d}" for index in range(2, 11))
CURRENT_INVENTORY_SHA256 = hashlib.sha256(
    (ROOT / "inventory.txt").read_bytes()
).hexdigest().upper()
FROZEN_STUDY_OVERLAY_SHA256 = (
    "1562990890644EEEFF55D7F37CC0DF43B2D42915B094057CF90AC31F5A449072"
)


def load_json(relative: str) -> dict:
    with (STUDY / relative).open(encoding="utf-8") as handle:
        return json.load(handle)


def target_materials(relative: str) -> dict[str, dict]:
    target = load_json(relative)
    return {item["identity"]: item for item in target["materials"]}


def candidate(candidate_id: str) -> dict:
    return load_json(f"candidates/{candidate_id}.json")


def test_manifest_has_exact_candidate_roster():
    manifest = load_json("study_manifest.json")
    assert tuple(item["candidate_id"] for item in manifest["candidates"]) == EXPECTED_IDS
    assert len({item["candidate_id"] for item in manifest["candidates"]}) == 20


def test_inventory_overlay_records_direct_user_authority():
    overlay = load_json("evidence/inventory_overlay.json")
    by_name = {item["inventory_name"]: item for item in overlay["overrides"]}
    assert by_name["Ethylene Brassylate"]["status"] == "OWNED"
    assert by_name["Ethylene Brassylate"]["concentration_basis"] == "w/w"
    assert by_name["Ethylene Brassylate"]["stock_fraction"] == 1.0
    assert all(by_name[name]["status"] == "OUT_OF_STOCK" for name in LOST_TINCTURES)


def test_successor_overlay_applies_current_stock_authority_without_rewriting_history():
    overlay = load_json("evidence/inventory_overlay_2026-08-28.json")

    assert overlay["effective_date"] == "2026-08-28"
    assert overlay["predecessor"]["sha256"] == FROZEN_STUDY_OVERLAY_SHA256
    assert overlay["predecessor"]["diagnostic_state"] == "FROZEN_DO_NOT_REBIND"
    assert overlay["current_inventory"]["sha256"] == CURRENT_INVENTORY_SHA256

    by_name = {item["inventory_name"]: item for item in overlay["overrides"]}
    expected_exact_stocks = {
        "Ethylene Brassylate": ("neat", 1.0, "w/w", None),
        "Habanolide": ("neat", 1.0, "w/w", None),
        "Romandolide": ("neat", 1.0, "w/w", None),
        "Amber Xtreme (10% w/w in DEP)": ("solution", 0.1, "w/w", "DEP"),
        "Alpha Irone (10% w/w in DEP)": ("solution", 0.1, "w/w", "DEP"),
        "Opoponax Resinoid (50% w/w in DEP)": ("solution", 0.5, "w/w", "DEP"),
        "Myrrh EO (50% w/w in DEP)": ("solution", 0.5, "w/w", "DEP"),
        "Osmanthus Absolute (10% w/w in DPG)": ("solution", 0.1, "w/w", "DPG"),
        "Rose de Mai Absolute (10% w/w in DPG)": ("solution", 0.1, "w/w", "DPG"),
        "Osmanthus Absolute (volume grade)": ("neat_natural_mixture", 1.0, "w/w", None),
        "Lemon FCF oil Sicilian": ("neat_natural_mixture", 1.0, "w/w", None),
        "Clearwood": ("neat", 1.0, "w/w", None),
        "Alpha-Isomethyl Ionone (AIMI, Givaudan)": ("neat", 1.0, "w/w", None),
        "Neroli EO": ("neat_natural_mixture", 1.0, "w/w", None),
        "Geranyl Acetate": ("neat", 1.0, "w/w", None),
        "Red Saffron Infusion": ("as_supplied_product", 1.0, "w/w", "DPG"),
        "Cedarwood oil Virginia": ("neat_natural_mixture", 1.0, "w/w", None),
        "Red Mandarin EO": ("neat_natural_mixture", 1.0, "w/w", None),
        "Rose Essential Oil (Rosa Damascena, India)": ("solution", 0.1, "w/w", None),
    }
    for name, (stock_form, fraction, basis, carrier) in expected_exact_stocks.items():
        assert by_name[name]["status"] == "OWNED"
        assert by_name[name]["stock_form"] == stock_form
        assert by_name[name]["stock_fraction"] == fraction
        assert by_name[name]["concentration_basis"] == basis
        assert by_name[name].get("carrier") == carrier

    ambrettolide = by_name["Ambrettolide (10% w/w in DPG)"]
    assert ambrettolide["status"] == "OUT_OF_STOCK"
    assert ambrettolide["target_design_state"] == "DESIGN_AVAILABLE_PROCUREMENT_PENDING"

    polysantol = by_name["Polysantol"]
    assert polysantol["status"] == "OUT_OF_STOCK"
    assert polysantol["current_build_design_state"] == "EXCLUDE_FROM_CURRENT_BUILD"
    assert polysantol["physical_compounding_state"] == "PROCUREMENT_REQUIRED"

    ambrofix = by_name["Ambrofix"]
    assert ambrofix["status"] == "OWNED"
    assert ambrofix["stock_fraction"] == 0.0727
    assert ambrofix["concentration_basis"] == "w/w"
    assert ambrofix["carrier"] == "DEP/ETHANOL"
    assert "VERIFY_FIRST" in ambrofix["current_build_design_state"]

    aliases = {
        item["user_name"]: item["canonical_inventory_name"]
        for item in overlay["canonical_aliases"]
    }
    assert aliases == {
        "Virginian cedarwood": "Cedarwood oil Virginia",
        "Red Mandarin Oil": "Red Mandarin EO",
        "Rose Otto Oil": "Rose Essential Oil (Rosa Damascena, India)",
    }

    cinnamon = overlay["special_substitutions"][0]
    assert cinnamon["scope_formula_uid"] == "ysl20:LH-04:AP-T1:v3"
    assert cinnamon["generalizable"] is False
    assert cinnamon["direct_10_percent_stock_ul"] == 3.0
    assert cinnamon["executable_working_stock_ul"] == 10.0


def test_successor_overlay_is_directly_consumable_by_the_inventory_runtime():
    overlay_path = STUDY / "evidence" / "inventory_overlay_2026-08-28.json"
    records = parse_inventory(
        unique=False,
        include_unavailable=True,
        overlay_path=overlay_path,
    )
    by_name = {record.name: record for record in records}

    assert by_name["Ethylene Brassylate"].execution_ready is True
    assert by_name["Red Saffron Infusion"].status == "owned"
    assert by_name["Red Saffron Infusion"].carrier == "DPG"
    assert by_name["Red Saffron Infusion"].execution_ready is True
    assert by_name["Habanolide"].execution_ready is True
    assert by_name["Romandolide"].execution_ready is True
    assert by_name["Geranyl Acetate"].execution_ready is True
    assert by_name["Ambrofix"].execution_ready is False
    assert by_name["Ambrettolide"].execution_ready is False
    assert by_name["Polysantol"].status == "out_of_stock"
    assert by_name["Polysantol"].execution_ready is False
    assert by_name["Rose Essential Oil (Rosa Damascena, India)"].dilution == 0.1
    cedar = resolve_inventory_material(
        "Virginian cedarwood",
        overlay_path=overlay_path,
    )
    assert cedar is not None
    assert cedar.name == "Cedarwood oil Virginia"
    assert cedar.execution_ready is True


def test_manifest_separates_frozen_diagnostics_from_current_inventory_authority():
    manifest = load_json("study_manifest.json")
    update = manifest["post_study_authority_update"]

    assert manifest["snapshot"]["inventory_sha256"] == (
        "DC3C7FFC6E27711AA38D26BD3AEF09B7046F1834353E7171EB78729FBD2CC4EC"
    )
    assert update["effective_date"] == "2026-08-28"
    assert update["current_inventory_sha256"] == CURRENT_INVENTORY_SHA256
    assert update["frozen_candidate_diagnostics_rebound"] is False
    assert update["ap_t1_v3_dose_table_changed"] is False

    current_sources = {
        item["source_id"]: item for item in manifest["current_authority_sources"]
    }
    assert current_sources["CURRENT-AUTHORITATIVE-INVENTORY"]["sha256"] == (
        CURRENT_INVENTORY_SHA256
    )
    assert current_sources["CURRENT-INVENTORY-OVERLAY"]["path"] == (
        "evidence/inventory_overlay_2026-08-28.json"
    )


def test_evidence_ledger_records_current_inventory_and_user_correction_limits():
    ledger = load_json("evidence/evidence_ledger.json")
    local = {item["evidence_id"]: item for item in ledger["local_evidence"]}
    direct = {
        item["evidence_id"]: item for item in ledger["direct_user_stock_evidence"]
    }

    assert local["CURRENT-AUTHORITATIVE-INVENTORY-2026-08-28"]["sha256"] == (
        CURRENT_INVENTORY_SHA256
    )
    correction = direct["USR-STOCK-CORRECTION-2026-08-28"]
    assert correction["effective_date"] == "2026-08-28"
    assert correction["all_tinctures"] == "OUT_OF_STOCK"
    assert correction["ambrettolide"] == "DESIGN_AVAILABLE_PROCUREMENT_PENDING"
    assert correction["basis_unspecified"] == [
        "Opoponax Resinoid (50% in DEP)",
        "Myrrh EO (50% in DEP)",
        "Osmanthus Absolute (10% in DPG)",
        "Rose de Mai Absolute (10% in DPG)",
    ]
    assert correction["concentration_unspecified"] == ["Red Saffron Infusion"]

    ready = direct["USR-STOCK-READY-CORRECTION-2026-08-28-LATE"]
    assert ready["all_percentage_bases"] == "w/w"
    assert ready["neroli"] == "OWNED_NEAT_EXECUTION_READY"
    assert ready["geranyl_acetate"] == "OWNED_NEAT_EXECUTION_READY"
    assert ready["red_saffron_infusion"] == (
        "100_PERCENT_AS_SUPPLIED_PRODUCT_W_W_IN_DPG_EXECUTION_READY"
    )
    assert ready["ambrofix"] == "OWNED_HETEROGENEOUS_VERIFY_FIRST"

    polysantol = direct["USR-STOCK-POLYSANTOL-OUT-2026-08-28-LATE"]
    assert polysantol["polysantol"] == "OUT_OF_STOCK"
    assert polysantol["formula_effect"] == "EXCLUDE_FROM_CURRENT_BUILD"

    cinnamon = direct["USR-AP-T1-CINNAMON-SUBSTITUTION-2026-08-28"]
    assert cinnamon["scope_formula_uid"] == "ysl20:LH-04:AP-T1:v3"
    assert cinnamon["authority_limit"] == (
        "Sensory-use substitution for this dose only; not chemical, active-mass, "
        "OAV, safety, stability, or generally scalable equivalence."
    )


def test_apple_pie_ap_t1_v3_keeps_the_locked_4500_ul_dose_table():
    recipe = STUDY / "RECIPES" / "LH-04-APPLE-PIE-AP-T1-v3.md"
    rows = {}
    for line in recipe.read_text(encoding="utf-8").splitlines():
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != 7 or not cells[0].isdigit():
            continue
        rows[cells[1]] = float(cells[3].replace("**", "").replace(",", ""))

    assert rows == {
        "Iso E Super": 600.0,
        "Hedione": 420.0,
        "Indian Vetiver EO": 180.0,
        "Cedarwood EO": 450.0,
        "Sandalore": 240.0,
        "Timberol": 50.0,
        "Vertofix": 300.0,
        "Amberwood F": 20.0,
        "Ethylene Brassylate": 350.0,
        "Linalyl Acetate": 196.0,
        "Linalool": 162.0,
        "Florol": 50.0,
        "Alpha Isomethyl Ionone": 300.0,
        "Tonkarome": 248.0,
        "Ginger EO": 100.0,
        "Black Pepper EO": 10.0,
        "Cinnamaldehyde": 10.0,
        "Isobutavan": 40.0,
        "Vanillin": 20.0,
        "2-Acetyl Pyrazine": 10.0,
        "Bergamot FCF oil Sicilian": 340.0,
        "Hexyl Acetate": 90.0,
        "Grapefruit FCF oil Sicilian": 80.0,
        "Allyl Cyclohexyl Propionate": 70.0,
        "Ethyl 2-Methylbutyrate": 20.0,
        "Damascenone": 10.0,
        "Dihydromyrcenol": 104.0,
        "Lemonile": 30.0,
    }
    assert sum(rows.values()) == 4500.0
    assert min(rows.values()) == 10.0
    assert "Gamma Decalactone" not in rows
    assert {name for name in rows if "musk" in name.casefold()} == set()
    assert rows["Ethylene Brassylate"] == 350.0


def test_every_rendered_formula_declares_reference_and_inventory_authority():
    for path in sorted((STUDY / "rendered").glob("*.md")):
        formula = parse_formula_markdown(path)[0]
        assert formula["claim_mode"] == "FORMULA_HYPOTHESIS_NOT_AUTHENTICATED_RECIPE"
        assert formula["reference_contract"] in {
            "YSL_LHOMME_DOCUMENTARY_CHARACTER_TARGET",
            "YSL_LA_NUIT_DOCUMENTARY_CHARACTER_TARGET",
        }
        assert formula["reference_scope"] == "CHARACTER_ARCHITECTURE_ONLY_NOT_SIMILARITY"
        assert formula["inventory_overlay"] == "../evidence/inventory_overlay.json"


def test_current_builds_exclude_absent_or_unmodeled_materials():
    disallowed = {
        "Ethyl Linalool",
        "Basil EO (India, Ocimum Basilicum)",
        "Caraway Seed Oil (10% w/w in DPG)",
        "Helichrysum EO",
        "Hay Absolute",
    }
    for candidate_id in EXPECTED_IDS:
        names = {
            row["inventory_name"]
            for row in candidate(candidate_id)["current_inventory_build"]["materials"]
        }
        assert names.isdisjoint(disallowed), candidate_id


def test_current_builds_enforce_ten_ul_raw_stock_floor():
    for candidate_id in EXPECTED_IDS:
        rows = candidate(candidate_id)["current_inventory_build"]["materials"]
        for row in rows:
            raw_ul = row["raw_stock_ppm_w_w"] * 4500.0 / 1_000_000.0
            assert raw_ul >= 10.0 - 1e-6, (
                candidate_id,
                row["inventory_name"],
                raw_ul,
            )


def test_violet_leaf_silk_uses_precision_beta_ionone_support_stock():
    rows = candidate("LH-06")["current_inventory_build"]["materials"]
    beta = next(row for row in rows if row["inventory_name"].startswith("Beta Ionone"))

    assert beta["inventory_name"] == "Beta Ionone (0.1% in TEC)"
    assert beta["stock_fraction"] == 0.001
    assert beta["mapping_status"] == "AXIS_PRECISION_IONONE_SUPPORT"

    rendered = parse_formula_file(
        str(STUDY / "rendered" / "LH-06_Violet_Leaf_Silk_30mL_EDT.md")
    )
    rendered_beta = next(
        row for row in rendered.materials if row.name.startswith("Beta Ionone")
    )
    assert rendered_beta.dilution == 0.001


def test_family_targets_are_inventory_independent_and_normalized():
    for relative in ("families/lhomme_target.json", "families/la_nuit_target.json"):
        target = load_json(relative)
        assert target["basis"] == "active_ppm_w_w_of_concentrate"
        assert math.isclose(
            sum(row["active_ppm_w_w"] for row in target["materials"]),
            1_000_000.0,
            abs_tol=0.001,
        )
        assert all("inventory_status" not in row for row in target["materials"])


def test_family_target_hashes_socket_budget_and_single_musk_are_locked():
    for relative in ("families/lhomme_target.json", "families/la_nuit_target.json"):
        target = load_json(relative)
        hash_rows = [
            {
                "identity": row["identity"],
                "active_ppm_w_w": row["active_ppm_w_w"],
                "function": row["function"],
                "time_windows": row["time_windows"],
                "evidence_ids": row["evidence_ids"],
                "quantity_authority": row["quantity_authority"],
            }
            for row in target["materials"]
        ]
        payload = json.dumps(
            hash_rows,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode()
        assert hashlib.sha256(payload).hexdigest().upper() == target["target_sha256"]
        assert math.isclose(
            sum(
                row["active_ppm_w_w"]
                for row in target["materials"]
                if row["mobility_class"] == "module_mobile"
            )
            * 0.9,
            target["variant_socket"]["active_ppm_w_w_budget"],
            abs_tol=0.001,
        )
        assert len([row for row in target["materials"] if row.get("is_musk")]) == 1


