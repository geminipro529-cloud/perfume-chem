def test_runtime_adapters_scale_targets_without_redefining_ppm_target():
    pairs = (
        ("families/lhomme_target.json", "runtime_adapters/lhomme_target_4500ul.json"),
        ("families/la_nuit_target.json", "runtime_adapters/la_nuit_target_4500ul.json"),
    )
    for target_relative, adapter_relative in pairs:
        target = load_json(target_relative)
        adapter = load_json(adapter_relative)
        assert adapter["adapter_authority"] == "HEURISTIC_VOLUME_ADAPTER_NOT_PPM_W_W"
        assert math.isclose(adapter["total_raw_ul"], 4500.0, abs_tol=0.0001)
        assert math.isclose(
            sum(row["raw_amount"] for row in adapter["target_materials"]),
            4500.0,
            abs_tol=0.0001,
        )
        assert adapter["canonical_target_sha256"] == target["target_sha256"]
        by_identity = {row["identity"]: row for row in adapter["target_materials"]}
        for row in target["materials"]:
            expected_ul = row["active_ppm_w_w"] * 4500.0 / 1_000_000.0
            assert math.isclose(
                by_identity[row["identity"]]["active_amount_median"],
                expected_ul,
                abs_tol=0.0001,
            )


def test_envelopes_lock_exact_socket_and_protected_floors():
    pairs = (
        (
            "families/lhomme_target.json",
            "runtime_adapters/lhomme_target_4500ul.json",
            "families/lhomme_envelope.json",
        ),
        (
            "families/la_nuit_target.json",
            "runtime_adapters/la_nuit_target_4500ul.json",
            "families/la_nuit_envelope.json",
        ),
    )
    expected_keys = {
        "socket_raw_ul",
        "active_range",
        "carrier_range",
        "anchor_minimums",
        "required_roles",
        "family_caps",
        "temporal_ranges",
        "forbidden_materials",
    }
    for target_relative, adapter_relative, envelope_relative in pairs:
        target = load_json(target_relative)
        adapter = load_json(adapter_relative)
        envelope = load_json(envelope_relative)
        assert set(envelope) == expected_keys
        assert envelope["socket_raw_ul"] == 300.0
        assert set(envelope["forbidden_materials"]) == {
            "Tonalide",
            "Macrolide",
            "Musk Ketone",
        }
        target_by_identity = {row["identity"]: row for row in target["materials"]}
        adapter_by_identity = {
            row["identity"]: row for row in adapter["target_materials"]
        }
        for identity, floor_ul in envelope["anchor_minimums"].items():
            target_row = target_by_identity[identity]
            expected_floor = (
                adapter_by_identity[identity]["raw_amount"]
                * target_row["control_floor_fraction"]
            )
            assert math.isclose(floor_ul, expected_floor, abs_tol=0.0001)


def test_chassis_lock_exact_300_ul_socket_and_validate():
    for relative in ("chassis/lhomme_chassis.json", "chassis/la_nuit_chassis.json"):
        chassis = load_json(relative)
        assert chassis["validation"]["valid"] is True
        assert math.isclose(chassis["total_ul"], 4500.0, abs_tol=0.0001)
        assert math.isclose(chassis["core_total_ul"], 4200.0, abs_tol=0.0001)
        assert math.isclose(chassis["module_total_ul"], 300.0, abs_tol=0.0001)
        assert math.isclose(
            sum(row["module_raw_ul"] for row in chassis["rows"]),
            300.0,
            abs_tol=0.0001,
        )


def test_candidate_target_and_build_are_separate_and_balanced():
    for candidate_id in ("LH-01", "LN-01"):
        item = candidate(candidate_id)
        target = item["target_ideal"]["materials"]
        build = item["current_inventory_build"]["materials"]
        assert target is not build
        assert math.isclose(
            sum(row["active_ppm_w_w"] for row in target),
            1_000_000.0,
            abs_tol=0.001,
        )
        assert math.isclose(
            sum(row["raw_stock_ppm_w_w"] for row in build),
            1_000_000.0,
            abs_tol=0.001,
        )


def test_current_builds_exclude_lost_tinctures_and_exception_musks():
    for candidate_id in ("LH-01", "LN-01"):
        rows = candidate(candidate_id)["current_inventory_build"]["materials"]
        names = {row["inventory_name"] for row in rows}
        assert names.isdisjoint(LOST_TINCTURES)
        assert all("tincture" not in name.casefold() for name in names)
        assert names.isdisjoint(FORBIDDEN_MUSKS)
        assert sum(bool(row["is_musk"]) for row in rows) <= 1


def test_rendered_parent_controls_parse_exact_volume_and_rows():
    expected = {
        "LH-01": ("LH-01_Original_Fidelity_30mL_EDT.md", {"Hedione": 500.0}),
        "LN-01": (
            "LN-01_Original_2009_Fidelity_30mL_EDT.md",
            {"Hedione": 400.0},
        ),
    }
    for candidate_id, (filename, expected_rows) in expected.items():
        diagnostics = candidate(candidate_id)["diagnostics"]["parser_preflight"]
        parsed = parse_formula_file(str(STUDY / "rendered" / filename))
        by_name = {row.name: row for row in parsed.materials}
        assert parsed.concentrate_ul == 4500.0
        assert len(parsed.materials) == diagnostics["material_count"]
        assert math.isclose(
            sum(row.raw_ul for row in parsed.materials),
            4500.0,
            abs_tol=0.0001,
        )
        for name, raw_ul in expected_rows.items():
            assert by_name[name].raw_ul == raw_ul


def test_parent_control_native_definition_hashes_are_bound():
    rendered = {
        "LH-01": "LH-01_Original_Fidelity_30mL_EDT.md",
        "LN-01": "LN-01_Original_2009_Fidelity_30mL_EDT.md",
    }
    summary_rows = {
        row["candidate_id"]: row
        for row in load_json("reports/screening_summary.json")["candidates"]
    }
    for candidate_id, filename in rendered.items():
        item = candidate(candidate_id)
        rendered_path = STUDY / "rendered" / filename
        formulas = parse_formula_markdown(rendered_path)
        assert len(formulas) == 1
        parsed = formulas[0]
        diagnostics = item["diagnostics"]["parser_preflight"]
        assert sum(parsed["ingredients_ul"].values()) == 4500.0
        definition_hash = formula_hash_from_record(parsed)
        assert diagnostics["formula_definition_sha256"] == definition_hash
        assert item["source_bindings"]["formula_definition_sha256"] == definition_hash
        assert summary_rows[candidate_id]["formula_definition_sha256"] == definition_hash
        assert hashlib.sha256(rendered_path.read_bytes()).hexdigest() == diagnostics[
            "rendered_file_sha256"
        ]
        assert diagnostics["formula_uid"] == item["source_bindings"]["formula_uid"]


def test_parent_control_targets_copy_canonical_family_targets_exactly():
    bindings = {
        "LH-01": "families/lhomme_target.json",
        "LN-01": "families/la_nuit_target.json",
    }
    keys = (
        "identity",
        "active_ppm_w_w",
        "function",
        "time_windows",
        "evidence_ids",
        "quantity_authority",
    )
    for candidate_id, relative in bindings.items():
        item = candidate(candidate_id)
        canonical = load_json(relative)
        expected = [{key: row[key] for key in keys} for row in canonical["materials"]]
        assert item["target_ideal"]["materials"] == expected
        assert item["target_ideal"]["target_sha256"] == canonical["target_sha256"]


def test_lhomme_children_lock_parent_axis_and_constant_totals():
    for candidate_id in LH_CHILD_IDS:
        item = candidate(candidate_id)
        assert item["mode"] == "STYLISTIC"
        assert item["source_bindings"]["parent_formula_uid"] == "ysl20:LH-01:v2"
        assert item["source_bindings"]["lineage_type"] == "CONTROLLED_CHILD"
        assert isinstance(item["target_identity"]["primary_axis"], str)
        assert item["target_identity"]["primary_axis"].strip()
        assert math.isclose(
            item["target_identity"]["variant_socket"]["active_ppm_w_w"],
            66_666.667,
            abs_tol=0.001,
        )
        assert item["target_identity"]["variant_socket"]["current_raw_ul"] == 300.0
        assert math.isclose(
            sum(
                row["active_ppm_w_w"]
                for row in item["target_ideal"]["materials"]
            ),
            1_000_000.0,
            abs_tol=0.001,
        )
        assert math.isclose(
            sum(
                row["raw_stock_ppm_w_w"]
                for row in item["current_inventory_build"]["materials"]
            ),
            1_000_000.0,
            abs_tol=0.001,
        )


def test_lhomme_children_retain_canonical_protected_floors():
    canonical = load_json("families/lhomme_target.json")
    controlled_rows = [
        row for row in canonical["materials"] if row["mobility_class"] != "module_mobile"
    ]
    for candidate_id in LH_CHILD_IDS:
        child_rows = {
            row["identity"]: row
            for row in candidate(candidate_id)["target_ideal"]["materials"]
        }
        for control in controlled_rows:
            floor = control["active_ppm_w_w"] * control["control_floor_fraction"]
            assert child_rows[control["identity"]]["active_ppm_w_w"] >= floor


def test_lhomme_children_exclude_lost_tinctures_and_redundant_musks():
    for candidate_id in LH_CHILD_IDS:
        rows = candidate(candidate_id)["current_inventory_build"]["materials"]
        names = {row["inventory_name"] for row in rows}
        assert names.isdisjoint(LOST_TINCTURES)
        assert all("tincture" not in name.casefold() for name in names)
        assert names.isdisjoint(FORBIDDEN_MUSKS)
        assert sum(bool(row["is_musk"]) for row in rows) <= 1


def test_lhomme_child_target_and_active_totals_are_self_consistent():
    for candidate_id in LH_CHILD_IDS:
        item = candidate(candidate_id)
        target = item["target_ideal"]
        target_payload = json.dumps(
            target["materials"],
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode()
        assert hashlib.sha256(target_payload).hexdigest().upper() == target[
            "target_sha256"
        ]
        build = item["current_inventory_build"]
        assert math.isclose(
            sum(row["odorant_active_ppm_w_w"] for row in build["materials"]),
            build["total_odorant_active_ppm_w_w"],
            abs_tol=0.001,
        )


def test_lhomme_rendered_views_are_hash_bound_and_parse_exactly():
    rendered = {
        "LH-02": "LH-02_Vintage_Magnetique_30mL_EDT.md",
        "LH-03": "LH-03_Tailored_Luxe_30mL_EDT.md",
        "LH-04": "LH-04_Apple_Pie_30mL_EDT.md",
        "LH-05": "LH-05_Ginger_Cedrat_Spark_30mL_EDT.md",
        "LH-06": "LH-06_Violet_Leaf_Silk_30mL_EDT.md",
        "LH-07": "LH-07_White_Pepper_Basil_30mL_EDT.md",
        "LH-08": "LH-08_Cedar_Vetiver_Tailoring_30mL_EDT.md",
        "LH-09": "LH-09_Tonka_Sandalwood_30mL_EDT.md",
        "LH-10": "LH-10_Bangkok_Air_30mL_EDT.md",
    }
    for candidate_id, filename in rendered.items():
        item = candidate(candidate_id)
        path = STUDY / "rendered" / filename
        parsed = parse_formula_file(str(path))
        native = parse_formula_markdown(path)
        diagnostics = item["diagnostics"]["parser_preflight"]
        assert parsed.concentrate_ul == 4500.0
        assert math.isclose(sum(row.raw_ul for row in parsed.materials), 4500.0)
        assert len(native) == 1
        assert sum(native[0]["ingredients_ul"].values()) == 4500.0
        definition_hash = formula_hash_from_record(native[0])
        assert diagnostics["formula_definition_sha256"] == definition_hash
        assert item["source_bindings"]["formula_definition_sha256"] == definition_hash
        assert hashlib.sha256(path.read_bytes()).hexdigest() == diagnostics[
            "rendered_file_sha256"
        ]


def test_apple_pie_ambiguous_percentage_stocks_remain_verify_first():
    rows = {
        row["inventory_name"]: row
        for row in candidate("LH-04")["current_inventory_build"]["materials"]
    }
    for name in (
        "Ethyl 2-Methylbutyrate (0.1%)",
        "Hexyl Acetate (10%)",
        "Cinnamaldehyde (1%)",
        "Vanillin (10%)",
    ):
        assert rows[name]["stock_status"].startswith("VERIFY_FIRST")
        assert rows[name]["concentration_basis"] == "UNRECORDED_PERCENT_BASIS"


def test_ginger_cedrat_current_build_does_not_use_neroli_shortcut():
    names = {
        row["inventory_name"]
        for row in candidate("LH-05")["current_inventory_build"]["materials"]
    }
    assert all("neroli" not in name.casefold() for name in names)


def test_white_pepper_basil_records_target_only_basil_gap_without_fake_equivalence():
    item = candidate("LH-07")
    target_names = {row["identity"] for row in item["target_ideal"]["materials"]}
    current_names = {
        row["inventory_name"] for row in item["current_inventory_build"]["materials"]
    }
    assert "Basil" in target_names
    assert "Basil EO (India, Ocimum Basilicum)" not in current_names
    assert any("basil identity" in gap.casefold() for gap in item["missing_chemical_impact"]["gaps"])
    assert "omits Basil" in item["purchase_preparation"]["recommendation"]
    assert item["diagnostics"]["composite_natural_oav"] == (
        "LITERATURE_PROXY_COMPOSITE_MODELS_APPLIED__NOT_USER_LOT_MEASUREMENTS"
    )
    assert item["source_bindings"]["natural_decomposition_sha256"]


def test_bangkok_air_omits_unverified_paradisamide_and_keeps_climate_model_non_sensory():
    item = candidate("LH-10")
    rows = {
        row["inventory_name"]: row
        for row in item["current_inventory_build"]["materials"]
    }
    target_names = {row["identity"] for row in item["target_ideal"]["materials"]}
    assert "Paradisamide" in target_names
    assert "Paradisamide (10%)" not in rows
    assert all("neroli" not in name.casefold() for name in rows)
    summary_row = next(
        row
        for row in load_json("reports/screening_summary.json")["candidates"]
        if row["candidate_id"] == "LH-10"
    )
    assert summary_row["temperature_K"] == 305.0
    assert math.isclose(
        summary_row["climate_diagnostic"]["modeled_temperature_c"],
        31.85,
        abs_tol=1e-9,
    )
    assert math.isclose(
        summary_row["climate_diagnostic"]["vp_factor_vs_22c"],
        2.2026261497956656,
        rel_tol=1e-12,
    )
    assert summary_row["oav_authority"]["sensory_authority"] is False
    assert item["claim_ceiling"]["modeled_temperature_performance"] == (
        "COMPUTATIONAL_SCREEN_ONLY"
    )


def test_lhomme_children_predeclare_every_large_active_dose_change():
    parent_rows = {
        row["inventory_name"]: row["odorant_active_ppm_w_w"]
        for row in candidate("LH-01")["current_inventory_build"]["materials"]
    }
    for candidate_id in LH_CHILD_IDS:
        item = candidate(candidate_id)
        child_rows = {
            row["inventory_name"]: row["odorant_active_ppm_w_w"]
            for row in item["current_inventory_build"]["materials"]
        }
        authorized = {
            value.split("=", 1)[0]
            for value in item["source_bindings"]["active_dose_change_authorizations"]
        }
        for name in parent_rows.keys() | child_rows.keys():
            parent_active = parent_rows.get(name, 0.0)
            child_active = child_rows.get(name, 0.0)
            is_large = (parent_active == 0.0 and child_active > 0.0) or (
                parent_active > 0.0
                and child_active > 0.0
                and max(parent_active, child_active) / min(parent_active, child_active)
                >= 3.0
            )
            if is_large:
                assert name in authorized


