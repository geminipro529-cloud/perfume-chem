"""Data-driven perfume family and archetype grammar.
The registry is intentionally lightweight: it expresses perfumer-readable
anchors and drift limits in terms of raw or active concentrate percentages.
Release gates and optimizers can use the same specs without hardcoded family
thresholds scattered across the codebase.
"""

from __future__ import annotations
from dataclasses import dataclass, field
from typing import Mapping
from engine.name_utils import normalize_name


@dataclass(frozen=True, slots=True)
class GroupRule:
    name: str
    materials: tuple[str, ...]
    basis: str = "active"  # "active" or "raw"
    minimum: float | None = None
    maximum: float | None = None
    detail: str = ""

    @property
    def normalized_materials(self) -> frozenset[str]:
        return frozenset(normalize_name(material) for material in self.materials)


@dataclass(frozen=True, slots=True)
class ReferenceSourceObservation:
    """A source-bounded public observation about a named fragrance reference.

    These records preserve what an official or supplier source actually says
    without turning note-list observations into a reconstructed formula or
    measured headspace result.  Conflicting observations remain separate and
    are made explicit in ``conflict_note``.
    """

    source_url: str
    access_date: str
    concentration_label: str
    head_observations: tuple[str, ...]
    heart_observations: tuple[str, ...]
    base_observations: tuple[str, ...]
    conflict_note: str

    @property
    def source(self) -> str:
        return self.source_url

    @property
    def source_date(self) -> str:
        return self.access_date

    @property
    def concentration(self) -> str:
        return self.concentration_label

    @property
    def head(self) -> tuple[str, ...]:
        return self.head_observations

    @property
    def heart(self) -> tuple[str, ...]:
        return self.heart_observations

    @property
    def base(self) -> tuple[str, ...]:
        return self.base_observations

    @property
    def conflict(self) -> str:
        return self.conflict_note


@dataclass(frozen=True, slots=True)
class TemporalOAVRule:
    """A target-specific OAV relationship between two time-window groups.

    These are design guardrails over the pipeline's explicitly heuristic
    evaporation model.  They are not measured headspace or reference GC-MS
    claims.  Absolute OAV targets remain separate in ``ArchetypeSpec``.
    """

    name: str
    numerator_materials: tuple[str, ...]
    denominator_materials: tuple[str, ...]
    numerator_window: str
    denominator_window: str
    minimum_ratio: float | None = None
    maximum_ratio: float | None = None
    detail: str = ""
    evidence_tier: str = "DESIGN_HEURISTIC"
    source_or_derivation: str = "internal target-linked regression guardrail"
    quantitative_authority: str = "INTERNAL_UNCALIBRATED_GUARDRAILS"
    measured_reference_headspace: bool = False

    @property
    def normalized_numerator_materials(self) -> frozenset[str]:
        return frozenset(
            normalize_name(material) for material in self.numerator_materials
        )

    @property
    def normalized_denominator_materials(self) -> frozenset[str]:
        return frozenset(
            normalize_name(material) for material in self.denominator_materials
        )


@dataclass(frozen=True, slots=True)
class ArchetypeSpec:
    key: str
    family: str
    label: str
    role: str
    anchors: tuple[GroupRule, ...]
    drift_limits: tuple[GroupRule, ...]
    forbidden_materials: tuple[str, ...] = ()
    forbidden_tokens: tuple[str, ...] = ()
    oav_targets: Mapping[str, Mapping[str, float]] = field(default_factory=dict)
    temporal_oav_rules: tuple[TemporalOAVRule, ...] = ()
    repair_pool: Mapping[str, float] = field(default_factory=dict)
    novelty_reference: str = ""
    novelty_message: str = ""
    evidence_tier: str = "UNSPECIFIED"
    source_urls: tuple[str, ...] = ()
    quantitative_authority: str = "UNSPECIFIED"
    reference_observations: tuple[ReferenceSourceObservation, ...] = ()


@dataclass(frozen=True, slots=True)
class FamilyCheck:
    name: str
    status: str
    detail: str
    value: float
    rule: GroupRule | None = None


@dataclass(frozen=True, slots=True)
class FamilyEvaluation:
    archetype: str
    family: str
    label: str
    status: str
    checks: tuple[FamilyCheck, ...]
    forbidden_hits: tuple[str, ...] = ()


