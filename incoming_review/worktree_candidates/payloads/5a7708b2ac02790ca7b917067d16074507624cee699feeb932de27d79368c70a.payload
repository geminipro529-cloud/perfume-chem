def _rule(
    name: str,
    materials: tuple[str, ...],
    *,
    basis: str = "active",
    minimum=None,
    maximum=None,
    detail="",
) -> GroupRule:
    return GroupRule(
        name=name,
        materials=materials,
        basis=basis,
        minimum=minimum,
        maximum=maximum,
        detail=detail,
    )


def _reference_spec(
    *,
    key: str,
    family: str,
    label: str,
    anchors: tuple[GroupRule, ...],
    drift_limits: tuple[GroupRule, ...],
    forbidden_materials: tuple[str, ...] = OPAQUE_PREBLENDS,
    forbidden_tokens: tuple[str, ...] = (),
    oav_targets: Mapping[str, Mapping[str, float]],
    temporal_oav_rules: tuple[TemporalOAVRule, ...] = (),
    repair_pool: Mapping[str, float],
    novelty_reference: str = "",
    novelty_message: str = "",
    role: str = "reference_control",
    evidence_tier: str = "UNSPECIFIED",
    source_urls: tuple[str, ...] = (),
    quantitative_authority: str = "UNSPECIFIED",
    reference_observations: tuple[ReferenceSourceObservation, ...] = (),
) -> ArchetypeSpec:
    return ArchetypeSpec(
        key=key,
        family=family,
        label=label,
        role=role,
        anchors=anchors,
        drift_limits=drift_limits,
        forbidden_materials=forbidden_materials,
        forbidden_tokens=forbidden_tokens,
        oav_targets=oav_targets,
        temporal_oav_rules=temporal_oav_rules,
        repair_pool=repair_pool,
        novelty_reference=novelty_reference,
        novelty_message=novelty_message
        or "Reference/control archetype; familiar by design.",
        evidence_tier=evidence_tier,
        source_urls=source_urls,
        quantitative_authority=quantitative_authority,
        reference_observations=reference_observations,
    )


