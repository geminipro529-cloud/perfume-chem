# ── Inventory material check ──────────────────────────────────────────


def test_every_inventory_material_exists(conn: sqlite3.Connection) -> None:
    """Every canonical material name from inventory.txt has a row in materials.

    Uses engine.inventory_parser to get the canonical names, then checks
    that each name (or its normalized form) exists in the DB.
    """
    import re

    from engine.inventory_parser import inventory_names

    # Get all unique material names from inventory (including solvents)
    inv_names = inventory_names(
        unique=True, include_solvents=True, include_unavailable=True
    )

    # Build a set of canonical names in the DB (normalized)
    db_rows = conn.execute("SELECT canonical_name FROM materials").fetchall()
    db_norm_names = {normalize_name(row[0]) for row in db_rows}

    # Also build a set of alias normalized names
    alias_rows = conn.execute("SELECT a.alias_name FROM material_aliases a").fetchall()
    db_alias_norms = {normalize_name(row[0]) for row in alias_rows}

    missing: list[str] = []

    for name in inv_names:
        norm_name = normalize_name(name)
        if norm_name in db_norm_names:
            continue

        # Check if alias table covers it
        if norm_name in db_alias_norms:
            continue

        # Try a broader search: extract key tokens (words > 2 chars, no numbers)
        tokens = [
            t
            for t in re.split(r"[\s\-/]+", norm_name)
            if len(t) > 2 and not t.isdigit()
        ]
        found_broad = False
        for token in tokens:
            rows = conn.execute(
                "SELECT canonical_name FROM materials WHERE LOWER(canonical_name) LIKE ? LIMIT 1",
                (f"%{token}%",),
            ).fetchall()
            if rows:
                found_broad = True
                break

        if found_broad:
            continue

        # Another broad search: try stripping parenthetical content
        stripped = re.sub(r"\s*\([^)]*\)\s*", " ", norm_name).strip()
        stripped = re.sub(r"\s+", " ", stripped)
        if stripped and stripped != norm_name:
            rows = conn.execute(
                "SELECT canonical_name FROM materials WHERE LOWER(canonical_name) LIKE ? LIMIT 1",
                (f"%{stripped}%",),
            ).fetchall()
            if rows:
                continue

        missing.append(name)

    assert not missing, (
        f"Materials from inventory not found in DB ({len(missing)}):\n"
        + "\n".join(f"  '{n}' (norm='{normalize_name(n)}')" for n in missing)
    )
