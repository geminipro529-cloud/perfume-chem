# allow: SIZE_OK — integration test for KB migration

"""Tests for the perfumery knowledge base migration."""

import os
import sqlite3
import tempfile
from pathlib import Path

import pytest

from engine.name_utils import normalize_name


@pytest.fixture(scope="module")
def db_path() -> str:
    """Create a fresh database for testing."""
    from engine.kb_migrate import migrate

    tmp = tempfile.mktemp(suffix=".db", prefix="perfumery_kb_test_")
    result = migrate(tmp)
    yield result
    # Cleanup
    try:
        os.remove(result)
    except OSError:
        pass


@pytest.fixture(scope="module")
def conn(db_path: str) -> sqlite3.Connection:
    """Provide a connection to the test database."""
    conn = sqlite3.connect(db_path)
    yield conn
    conn.close()


# ── Database existence ────────────────────────────────────────────────


def test_database_exists(db_path: str) -> None:
    """After migrate(), the DB file exists."""
    assert os.path.exists(db_path), f"Database not found at {db_path}"


def test_database_with_tables(conn: sqlite3.Connection) -> None:
    """Verify all expected tables exist."""
    cur = conn.execute("SELECT name FROM sqlite_master WHERE type='table'")
    tables = {row[0] for row in cur.fetchall()}
    expected = {
        "materials",
        "material_aliases",
        "material_natural_decomposition",
        "audit_flags",
        "material_interactions",
        "family_archetypes",
        "archetype_anchors",
        "archetype_drift_limits",
        "archetype_oav_targets",
        "archetype_repair_pool",
        "pyramid_ratios",
        "oav_targets",
        "material_role_ratios",
        "cross_family_compatibility",
        "family_tokens",
        "note_tokens",
        "ifra_limits",
        "eu_allergens",
        "sensitization",
        "banned_materials",
        "character_shifts",
        "hill_params",
    }
    missing = expected - tables
    assert not missing, f"Missing tables: {missing}"


# ── Materials count ───────────────────────────────────────────────────


def test_materials_count(conn: sqlite3.Connection) -> None:
    """SELECT COUNT(*) FROM materials >= 254."""
    count = conn.execute("SELECT COUNT(*) FROM materials").fetchone()[0]
    assert count >= 254, f"Expected >= 254 materials, got {count}"


def test_materials_in_inventory_count(conn: sqlite3.Connection) -> None:
    """At least 200 in-inventory materials should exist."""
    count = conn.execute(
        "SELECT COUNT(*) FROM materials WHERE user_in_inventory = 1"
    ).fetchone()[0]
    assert count >= 200, f"Expected >= 200 in-inventory, got {count}"


# ── Specific material checks ──────────────────────────────────────────


def test_hedione_vp(conn: sqlite3.Connection) -> None:
    """SELECT vp_25c_pa FROM materials WHERE canonical_name='Hedione' returns 0.21."""
    row = conn.execute(
        "SELECT vp_25c_pa FROM materials WHERE canonical_name = ?", ("Hedione",)
    ).fetchone()
    assert row is not None, "Hedione not found in materials"
    vp = row[0]
    assert vp == 0.21, f"Expected Hedione VP=0.21, got {vp}"


def test_hedione_hc_exists(conn: sqlite3.Connection) -> None:
    """Hedione HC exists in materials."""
    count = conn.execute(
        "SELECT COUNT(*) FROM materials WHERE canonical_name = ?", ("Hedione HC",)
    ).fetchone()[0]
    assert count == 1, "Hedione HC not found in materials"


