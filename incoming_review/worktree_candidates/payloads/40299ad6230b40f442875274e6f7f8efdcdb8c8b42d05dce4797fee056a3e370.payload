# ── Natural decomposition ─────────────────────────────────────────────


def test_natural_decomposition_exists(conn: sqlite3.Connection) -> None:
    """SELECT COUNT(*) FROM material_natural_decomposition > 0."""
    count = conn.execute(
        "SELECT COUNT(*) FROM material_natural_decomposition"
    ).fetchone()[0]
    assert count > 0, "No natural decomposition data found"


def test_osmanthus_decomposition(conn: sqlite3.Connection) -> None:
    """Osmanthus absolute should have decomposition entries."""
    count = conn.execute(
        """
        SELECT COUNT(*) FROM material_natural_decomposition nd
        JOIN materials m ON nd.material_id = m.id
        WHERE m.canonical_name LIKE '%osmanthus%'
        """
    ).fetchone()[0]
    assert count > 0, "Osmanthus absolute has no decomposition entries"


# ── Family archetypes ─────────────────────────────────────────────────


def test_family_archetypes_include_native_ysl_contracts(conn: sqlite3.Connection) -> None:
    """The migrated registry includes both native YSL identity contracts."""
    rows = conn.execute("SELECT key FROM family_archetypes").fetchall()
    keys = {row[0] for row in rows}
    assert len(keys) >= 37
    assert {"ysl_lhomme", "ysl_la_nuit_de_lhomme"} <= keys


