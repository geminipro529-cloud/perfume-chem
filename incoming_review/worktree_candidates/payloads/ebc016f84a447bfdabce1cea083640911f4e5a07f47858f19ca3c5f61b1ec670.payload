    "Hexyl Salicylate": 0.3,
    "Benzyl Benzoate": 0.1,
    "Guaiacol": -0.3,
    "Nagarmotha Oil": -0.1,
    "Juniper Berry EO": 0.3,
    "Cedarwood EO": 0.2,
    "Cedarwood EO (Atlas)": 0.2,
    "Cedarwood oil Virginia": 0.1,
    "Himalayan Cedarwood EO": 0.3,
    "Petitgrain EO Paraguay": 0.4,
    "Bergamot FCF": 0.6,
    "Methyl Pamplemousse": 0.4,
    "Hexyl Acetate": 0.5,
    "Cassis Base 345B": 0.5,
    "Cardamom EO": 0.4,
    "Aldehyde C10": 0.3,
    "Damascenone": 0.7,
    "Neroli EO": 0.6,
    "Aurantiol": 0.5,
    "Jasmine Sambac": 0.6,
    "Benzyl Acetate": 0.5,
    "Indole": -0.4,
    "Rose EO": 0.8,
    "Rose Essential Oil": 0.8,
    "Alpha Irone": 0.7,
    "Ultralia": 0.6,
    "Orivone": 0.5,
    "Beta Ionone": 0.5,
    "Geosmin": 0.2,
    "Freesia HDI": 0.5,
    "Osmanthus Absolute": 0.7,
    "Vetiver EO": 0.2,
    "Vetiver EO (India)": 0.2,
    "Vetival": 0.3,
    "Oakmoss Absolute": 0.1,
    "Labdanum Resinoid": 0.3,
    "Tonka Bean Absolute": 0.5,
