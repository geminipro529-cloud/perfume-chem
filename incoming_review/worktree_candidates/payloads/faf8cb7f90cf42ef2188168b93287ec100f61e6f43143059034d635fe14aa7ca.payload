    "data/benchmarks/solforge/replacement_screen_v4/status.json",
    "data/benchmarks/solforge/replacement_screen_v4_r2/receipt.json",
    "data/benchmarks/solforge/replacement_screen_v4_r2/status.json",
    "data/benchmarks/solforge/replacement_screen_v6_r1/receipt.normalized_v2.json",
    "data/benchmarks/solforge/replacement_screen_v6_r1/status.normalized_v2.json",
}


def _manifest() -> dict[str, object]:
    return json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))


def test_manifest_freezes_append_only_aggregate_evidence_claim() -> None:
    manifest = _manifest()

    assert manifest["schema_version"] == "solforge_public_redaction_manifest_v1"
    assert manifest["mutation_policy"] == "APPEND_ONLY_NEW_MANIFEST_VERSION_REQUIRED"
    assert manifest["source_commit"] == SOURCE_COMMIT
    assert manifest["claim_state"] == CLAIM_STATE
    assert manifest["disposition"] == (
        "RAW_RECORDS_AND_SIDECARS_WITHHELD_FOR_PRIVACY"
    )

    contract = manifest["redaction_contract"]
    assert contract == {
        "sensitive_json_pointer": "$.stderr_tail",
        "reason_code": "LOCAL_USER_PROFILE_PATH",
        "restricted_source_state": "REMAINS_IN_SOURCE_WORKTREE_OR_BRANCH",
        "public_aggregate_evidence_state": "RETAINED",
        "public_raw_source_state": "WITHHELD",
        "sanitized_successor_exists": False,
        "sanitized_successor_path": None,
        "sanitized_successor_sha256": None,
        "exact_execution_provenance_available_from_public_package": False,
        "independently_replayable_from_public_package": False,
    }

    records = manifest["withheld_records"]
    assert len(records) == 8
    observed = {}
    for record in records:
        raw_path = record["logical_source_path"]
        sidecar_path = record["logical_sidecar_path"]
        for relative_path in (raw_path, sidecar_path):
            logical_path = PurePosixPath(relative_path)
            assert not logical_path.is_absolute()
            assert ".." not in logical_path.parts
            assert "\\" not in relative_path

        assert record["source_commit"] == SOURCE_COMMIT
        assert record["sensitive_json_pointer"] == "$.stderr_tail"
        assert record["reason_code"] == "LOCAL_USER_PROFILE_PATH"
        assert record["restricted_source_state"] == (
            "REMAINS_IN_SOURCE_WORKTREE_OR_BRANCH"
        )
        assert record["public_aggregate_evidence_state"] == "RETAINED"
        assert record["public_raw_source_state"] == "WITHHELD"
        assert record["sanitized_successor_exists"] is False
        assert record["sanitized_successor_path"] is None
        assert record["sanitized_successor_sha256"] is None
        assert record["claim_state"] == CLAIM_STATE

        observed[raw_path] = (
            record["original_raw_sha256"],
            sidecar_path,
            record["original_sidecar_file_sha256"],
        )

    assert observed == EXPECTED_WITHHELD_RECORDS


def test_withheld_sources_are_absent_and_aggregate_evidence_remains() -> None:
    manifest = _manifest()

    for record in manifest["withheld_records"]:
        assert not (ROOT / record["logical_source_path"]).exists()
        assert not (ROOT / record["logical_sidecar_path"]).exists()

    retained = set(manifest["retained_aggregate_evidence_paths"])
    assert retained == EXPECTED_RETAINED_AGGREGATES
    for relative_path in retained:
        assert (ROOT / relative_path).is_file()
