"""API dependency injection"""

from typing import AsyncGenerator, Optional

from fastapi import HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.config import Settings, get_settings
from app.db_session import get_session
from app.services.ai.base import BaseAIService
from app.services.ai.factory import (
    OPENAI_PROVIDER,
    AIModelDetector,
    create_ai_service,
    get_model_selector,
)


async def get_db() -> AsyncGenerator[AsyncSession, None]:
    """Get database session dependency"""
    async with get_session() as session:
        yield session


async def get_ai_service(
    model: Optional[str] = None,
    force_provider: Optional[str] = None
) -> BaseAIService:
    """
    Get the OpenAI service dependency.

    Provider and model parameters remain available for API compatibility, but
    the factory rejects every non-OpenAI provider or model before constructing
    a client.

    Args:
        model: OpenAI model name. If None, uses the configured OpenAI default.
        force_provider: Optional compatibility parameter; only ``openai`` is valid.

    Returns:
        OpenAI service instance
    """
    try:
        if force_provider and force_provider.strip().lower() != OPENAI_PROVIDER:
            raise ValueError(
                f"Unsupported AI provider '{force_provider}': only OpenAI is enabled"
            )
        if model:
            AIModelDetector.detect_provider(model)
    except ValueError as exc:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=str(exc),
        ) from exc

    settings = get_settings()
    if not settings.ENABLE_AI_SUGGESTIONS:
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            detail="AI suggestions are disabled",
        )
    if not settings.OPENAI_API_KEY.strip():
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            detail="OpenAI service is not configured",
        )

    try:
        return create_ai_service(
            model=model,
            cache=None,
            verbose=True,
            force_provider=force_provider,
        )
    except ValueError as exc:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=str(exc),
        ) from exc


def get_model_selector_dep() -> dict:
    """Get model selector configuration for UI"""
    return get_model_selector()


def get_settings_dep() -> Settings:
    """Get settings dependency"""
    return get_settings()
