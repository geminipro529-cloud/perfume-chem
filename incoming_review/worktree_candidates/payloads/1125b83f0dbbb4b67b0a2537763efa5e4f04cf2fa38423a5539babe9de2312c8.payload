{
  "schema": "perfume-chem-ysl-blind-protocol-v1",
  "protocol_id": "YSL20-BLIND-v1",
  "status": "PROTOCOL_ONLY_NOT_EXECUTED",
  "study_scope": "Twenty target-first formula hypotheses, two family controls, and two frozen Sol comparison baselines",
  "claim_ceiling": "The protocol defines future observations. It contains no physical result and authorizes no claim of liking, similarity, stability, safety, measured headspace, or release.",
  "mandatory_arms": [
    "LH-04",
    "LN-01",
    "LN-05"
  ],
  "conditional_rescreen_priorities": [
    "LH-05",
    "LN-02"
  ],
  "prerequisites": {
    "inventory_and_stock_basis": "Every dosed row must resolve to one current stock with an exact fraction basis and carrier; EB requires label or receipt verification; all lost tinctures remain excluded.",
    "data_coverage": "Character naturals require composite decomposition and every active row requires governed MW, VP, ODT, and activity-coefficient authority.",
    "safety": "NOT CLEARED; no skin application before formula-specific safety review and applicable IFRA/allergen assessment.",
    "stability": "NOT TESTED; complete carrier compatibility, solubility, and short stability screening before sensory evaluation.",
    "release_gate": "All shared HOLD conditions must be repaired and rerun from a stable runtime snapshot before any arm may be called eligible.",
    "compounding_authority": false
  },
  "blinding": {
    "codes": "RANDOM_NONSEMANTIC",
    "code_format": "Three independently generated alphanumeric characters excluding candidate numbers, names, family initials, and obvious sequences",
    "assignment_timing": "Assign only after sample preparation and container randomization",
    "key_storage": "SEPARATE_FROM_ASSESSORS",
    "key_keeper": "A person or sealed file not available to assessors until every expected cell is locked",
    "decode_rule": "Decode once per phase after missing cells, exclusions, and protocol deviations are frozen"
  },
  "sample_control": {
    "equal_odorant_active_mass_concentration": true,
    "equal_applied_mass": true,
    "equal_application_method": true,
    "carrier_matched": true
  },
  "sample_preparation": {
    "basis": "w/w after exact stock fractions, densities where required, and carrier contributions are verified",
    "comparison_concentration": "One predeclared odorant-active mass fraction shared by every coded sample in a block; the 20% Sol L'Homme source is rebased for the matched comparison rather than compared at unmatched strength.",
    "application": "Use calibrated applied mass on identical coded blotters. Skin testing is a separate later protocol and remains blocked until safety clearance.",
    "maturation": "Same sealed maturation time, temperature, headspace, container type, fill mass, and handling for all arms in one phase",
    "replicate_definition": "A true replicate is independently weighed and prepared, not a second blotter from the same vial.",
    "solvent_blank": "Include a coded carrier blank in training and contamination checks, but do not score it as a perfume arm."
  },
  "order_control": {
    "balanced_order": true,
    "method": "Williams-balanced order when complete blocks are feasible; otherwise randomize within assessor and balance first-position counts before decoding",
    "family_blocking": "Do not mix L'Homme and La Nuit arms in one adaptation block",
    "carryover_control": "Use fresh blotters and isolated holders; record contamination and order deviations before decoding"
  },
  "adaptation_control": {
    "maximum_perfume_arms_per_block": 4,
    "minimum_unscented_break_minutes_between_blocks": 20,
    "same_arm_retest": "Use a different session or day for advancing-arm replicates",
    "prohibited": [
      "forcing a decision during anosmia or fatigue",
      "revealing formula names before decoding",
      "using coffee as evidence that olfactory sensitivity is restored"
    ]
  },
  "time_cells": [
    "0_min",
    "5_min",
    "30_min",
    "2_hr",
    "4_hr"
  ],
  "replication": {
    "minimum_true_replicates_for_advancement": 2,
    "independent_batch_preparation": true,
    "repeat_sessions": "Separate sessions or days with newly randomized codes and balanced order",
    "single_assessor_scope": "Repeated personal-preference evidence only; never a population preference claim",
    "group_claim_minimum": "No group claim is authorized by this protocol; sample-size and analysis plans require separate approval before recruitment."
  },
  "scorecard": {
    "identity_first": [
      "family_recognition before name reveal",
      "protected-anchor presence",
      "family drift or genre change"
    ],
    "target_linked_complexity": [
      "depth and richness",
      "relationships among named axes and protected chassis",
      "opening-to-heart and heart-to-drydown transitions",
      "coherence without counting ingredients"
    ],
    "hedonic": [
      "personal liking on a declared ordinal scale",
      "paired preference: left, right, or no preference",
      "desire to continue smelling"
    ],
    "defect_flags": [
      "harsh",
      "muddy",
      "thin",
      "generic fresh",
      "laundry musk",
      "dessert drift",
      "curry or maple drift",
      "savory caraway",
      "cardamom loss",
      "cedar-vetiver loss"
    ],
    "rule": "Identity and named-axis fit are evaluated before hedonic preference. A high liking score cannot rescue loss of the perfume's name."
  },
  "phases": {
    "phase_0_readiness": {
      "status": "BLOCKED_PENDING_AUTHORITY_REPAIR",
      "required_receipts": [
