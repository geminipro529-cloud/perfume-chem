def test_intimate_diffusion_uses_only_eb_and_keeps_unverified_musks_out():
    item = candidate("LN-10")
    rows = item["current_inventory_build"]["materials"]
    musks = [row for row in rows if row["is_musk"]]
    assert [row["inventory_name"] for row in musks] == ["Ethylene Brassylate"]
    assert musks[0]["stock_fraction"] == 1.0
    assert musks[0]["concentration_basis"] == "w/w"
    names = {row["inventory_name"] for row in rows}
    assert names.isdisjoint({"Habanolide", "Romandolide", "Ambrettolide"})
    assert "omission control" in item["blind_test"]["comparison"]


def test_missing_chemical_receipts_remain_candidate_only_and_authority_false():
    authority_fields = (
        "formula_authority",
        "inventory_authority",
        "purchase_authority",
        "execution_authorized",
        "scientific_authority",
        "oav_authority",
        "sensory_authority",
        "safety_authority",
        "release_authority",
    )
    for candidate_id in EXPECTED_IDS:
        receipt = load_json(f"impact/{candidate_id}_assessment.json")
        assert receipt["schema"] == "perfume-chem-missing-chemical-assessment-v1"
        assert receipt["target_formula_id"] == candidate_id
        assert receipt["state"] == "CANDIDATE_ONLY"
        assert receipt["architecture_locked"] is True
        assert receipt["package_auto_integrated_materials"] == []
        assert receipt["genuinely_missing_functions"]
        assert receipt["candidates"]
        assert all(receipt[field] is False for field in authority_fields)


def test_missing_chemical_index_has_one_nonexecuting_recommendation_per_candidate():
    index = load_json("reports/missing_chemical_impact_index.json")
    assert index["schema"] == "perfume-chem-ysl-impact-index-v1"
    assert tuple(row["candidate_id"] for row in index["candidates"]) == EXPECTED_IDS
    allowed = {
        "NO_PURCHASE",
        "VERIFY_STOCK_BASIS",
        "PREPARE_W_W_STOCK_FROM_OWNED_NEAT",
        "PROCUREMENT_REVIEW",
    }
    for row in index["candidates"]:
        assert row["recommendation_state"] in allowed
        assert row["execution_authorized"] is False
        assert row["purchase_authority"] is False
        assert "USE_CURRENT_STOCK" not in json.dumps(row)


def test_screening_summary_binds_all_twenty_native_runs_without_score_ranking():
    summary = load_json("reports/screening_summary.json")
    assert summary["schema"] == "perfume-chem-ysl-screening-summary-v1"
    assert summary["candidate_order"] == list(EXPECTED_IDS)
    assert summary["ranking_policy"] == "NO_TOTAL_SCORE_RANKING"
    assert summary["runtime_snapshot"]["stable_after_batch"] is True
    assert summary["runtime_snapshot"]["before"] == summary["runtime_snapshot"]["after"]
    hash_payload = dict(summary)
    recorded_hash = hash_payload.pop("summary_sha256")
    canonical = json.dumps(
        hash_payload,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode()
    assert hashlib.sha256(canonical).hexdigest() == recorded_hash

    rows = summary["candidates"]
    assert tuple(row["candidate_id"] for row in rows) == EXPECTED_IDS
    for row in rows:
        assert math.isclose(row["parsed_subtotal_ul"], 4500.0)
        assert row["temperature_K"] == 298.15
        assert row["oav_authority"]["headspace_basis"] == (
            "MODELED_ACTIVE_CONCENTRATE_SCREEN"
        )
        assert row["oav_authority"]["model_class"] == "HEURISTIC_NOT_MEASURED"
        assert row["oav_authority"]["sensory_authority"] is False
        assert row["overall_gate_status"] == "FAIL"
        assert row["artifact_binding"]["status"] == "PERSISTED_VERIFIED"
        assert row["finalist_eligibility"]["status"].startswith("HOLD")
        assert set(row["note_distribution"]) == {"top", "heart", "base"}
        assert [window["label"] for window in row["time_windows"]] == [
            "opening",
            "top",
            "heart",
            "late_heart",
            "drydown",
        ]
        assert row["headspace_table"]
        assert all(
            {
                "material",
                "dilution",
                "raw_ul",
                "active_ul",
                "mw_g_mol",
                "mole_fraction_pct",
                "vp_pa",
                "gamma",
                "vapor_ppm",
                "odt_ppm",
                "oav",
                "note",
            }.issubset(material)
            for material in row["headspace_table"]
        )
        diagnostics = candidate(row["candidate_id"])["diagnostics"]["pipeline_298k"]
        assert diagnostics["screening_summary_sha256"] == summary["summary_sha256"]
        assert diagnostics["formula_definition_sha256"] == row[
            "formula_definition_sha256"
        ]
        assert diagnostics["overall_gate_status"] == "FAIL"
        assert diagnostics["sensory_authority"] is False


def test_screening_coverage_matrix_records_effective_odt_and_fail_closed_gaps():
    summary = load_json("reports/screening_summary.json")
    matrix = summary["coverage_matrix"]
    expected_materials = {
        row["inventory_name"]
        for candidate_id in EXPECTED_IDS
        for row in candidate(candidate_id)["current_inventory_build"]["materials"]
    }
    assert {row["material"] for row in matrix} == expected_materials
    for row in matrix:
        assert row["inventory_resolution"]["native_v5_status"]
        assert row["odt_resolution"]["definition_count"] >= 0
        assert "effective_odt_air_ppb" in row["odt_resolution"]
        assert row["core_physics_status"] in {"COVERED", "HOLD"}
        assert row["natural_composite_status"] in {
            "NOT_NATURAL",
            "COVERED_COMPOSITE_GC_O",
            "HOLD_COMPOSITE_DECOMPOSITION_MISSING",
        }
    assert any(row["core_physics_status"] == "HOLD" for row in matrix)
    assert any(
        row["natural_composite_status"]
        == "HOLD_COMPOSITE_DECOMPOSITION_MISSING"
        for row in matrix
    )


def test_bangkok_temperature_screen_preserves_formula_definition_and_authority_ceiling():
    summary = load_json("reports/screening_summary.json")
    hot = summary["temperature_sensitivity"]
    assert hot["candidate_id"] == "LH-10"
    assert hot["common_temperature_K"] == 298.15
    assert hot["hot_temperature_K"] == 308.15
    assert hot["common_formula_definition_sha256"] == hot[
        "hot_formula_definition_sha256"
    ]
    assert hot["authority"] == "MODELED_NOT_MEASURED"
    assert hot["sensory_authority"] is False
    assert hot["status"].startswith("HOLD")
    assert hot["vapor_total_scope"] == (
        "SUM_OF_RESOLVED_ROWS_ONLY_UNKNOWN_NATURALS_EXCLUDED"
    )
    assert hot["common_opening_known_vapor_ppm"] > 0
    assert hot["hot_opening_known_vapor_ppm"] > hot[
        "common_opening_known_vapor_ppm"
    ]


