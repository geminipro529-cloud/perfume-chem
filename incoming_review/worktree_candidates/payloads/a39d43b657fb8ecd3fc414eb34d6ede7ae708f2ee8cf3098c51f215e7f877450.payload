        "CURRENT_BUILD_NO_HAY__TARGET_HAY_HOLD_UNCOVERED"
    )


def test_caraway_shadow_is_small_known_basis_and_has_zero_caraway_control():
    item = candidate("LN-08")
    rows = {
        row["inventory_name"]: row
        for row in item["current_inventory_build"]["materials"]
    }
    caraway = rows["Caraway Seed Oil (10% w/w in DPG)"]
    assert caraway["stock_fraction"] == 0.1
    assert caraway["concentration_basis"] == "w/w"
    assert math.isclose(caraway["raw_stock_ppm_w_w"], 40 / 4500 * 1_000_000)
    assert math.isclose(caraway["odorant_active_ppm_w_w"], 4 / 4500 * 1_000_000)
    assert item["diagnostics"]["composite_natural_oav"] == (
        "HOLD_CARAWAY_SEED_OIL_UNCOVERED_CURRENT_RUNTIME"
    )
    assert "zero-caraway control" in item["blind_test"]["comparison"]


