def test_apple_pie_ambiguous_percentage_stocks_remain_verify_first():
    rows = {
        row["inventory_name"]: row
        for row in candidate("LH-04")["current_inventory_build"]["materials"]
    }
    for name in (
        "Ethyl 2-Methylbutyrate (0.1%)",
        "Hexyl Acetate (10%)",
        "Cinnamaldehyde (1%)",
        "Vanillin (10%)",
    ):
        assert rows[name]["stock_status"].startswith("VERIFY_FIRST")
        assert rows[name]["concentration_basis"] == "UNRECORDED_PERCENT_BASIS"


def test_ginger_cedrat_current_build_does_not_use_neroli_shortcut():
    names = {
        row["inventory_name"]
        for row in candidate("LH-05")["current_inventory_build"]["materials"]
    }
    assert all("neroli" not in name.casefold() for name in names)


def test_white_pepper_basil_records_composite_natural_hold():
    item = candidate("LH-07")
    assert (
        item["diagnostics"]["composite_natural_oav"]
        == "HOLD_BASIL_EO_UNCOVERED_CURRENT_RUNTIME"
    )
    assert item["source_bindings"]["natural_decomposition_sha256"]


def test_bangkok_air_uses_conditional_paradisamide_and_modeled_temperature_only():
    item = candidate("LH-10")
    rows = {
        row["inventory_name"]: row
        for row in item["current_inventory_build"]["materials"]
    }
    paradisamide = rows["Paradisamide (10%)"]
    assert paradisamide["stock_fraction"] == 0.1
    assert "VERIFY" in paradisamide["concentration_basis"]
    assert item["diagnostics"]["temperature_sensitivity"] == {
        "common_k": 298.15,
        "bangkok_screen_k": 308.15,
        "status": "PENDING_TASK_9_MODELED_ONLY",
    }
    assert all("neroli" not in name.casefold() for name in rows)
    assert item["claim_ceiling"]["modeled_temperature_performance"] == (
        "COMPUTATIONAL_SCREEN_ONLY"
    )


def test_lhomme_children_predeclare_every_large_active_dose_change():
    parent_rows = {
        row["inventory_name"]: row["odorant_active_ppm_w_w"]
        for row in candidate("LH-01")["current_inventory_build"]["materials"]
    }
    for candidate_id in LH_CHILD_IDS:
        item = candidate(candidate_id)
        child_rows = {
            row["inventory_name"]: row["odorant_active_ppm_w_w"]
            for row in item["current_inventory_build"]["materials"]
        }
        authorized = {
            value.split("=", 1)[0]
            for value in item["source_bindings"]["active_dose_change_authorizations"]
        }
        for name in parent_rows.keys() | child_rows.keys():
            parent_active = parent_rows.get(name, 0.0)
            child_active = child_rows.get(name, 0.0)
            is_large = (parent_active == 0.0 and child_active > 0.0) or (
                parent_active > 0.0
                and child_active > 0.0
                and max(parent_active, child_active) / min(parent_active, child_active)
                >= 3.0
            )
            if is_large:
                assert name in authorized


