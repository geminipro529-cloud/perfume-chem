def test_first_la_nuit_rendered_views_are_hash_bound_and_parse_exactly():
    rendered = {
        "LN-02": (
            "LN-02_Current_Transparent_Style_30mL_EDT.md",
            "1133662d3fc140844df69dd6c2872d0b52e540d7e9463f3dd38146181c4acd9d",
