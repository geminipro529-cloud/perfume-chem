        ),
        "LN-05": (
            "LN-05_Immortelle_Nuit_30mL_EDT.md",
            "b2d4a8c3538add63286e40cf6c97e641edb9c1b4ba104ab5ec9663c44a17960e",
        ),
        "LN-06": (
            "LN-06_Cedar_Vetiver_Vertical_30mL_EDT.md",
            "2e2f409506f875d5dacfb32cef6e5d36b744749d000d7d370dd874b4b34842a1",
        ),
        "LN-07": (
            "LN-07_Dry_Coumarin_Skin_30mL_EDT.md",
            "7cc6b17ec38e078aab3bbb75d1f3d5c1c32ae6b6ab725e24fbf8b5b58cc34e51",
        ),
        "LN-08": (
            "LN-08_Caraway_Shadow_30mL_EDT.md",
            "550c9fca5e2132b7d2461f2f55f16c759b6a3c336465d9564434b5a8392836de",
        ),
        "LN-09": (
            "LN-09_Dark_Textile_Woods_30mL_EDT.md",
            "d384894855b0cce77b69132880f8ec552c1896ddf253bc62b2282354f5d7f032",
        ),
        "LN-10": (
            "LN-10_Intimate_Diffusion_30mL_EDT.md",
            "6230b075945186792a5ddcdb19cfb5b2419955f06a2d33380b958522e480796f",
        ),
    }
    for candidate_id, (filename, definition_hash) in rendered.items():
        item = candidate(candidate_id)
        path = STUDY / "rendered" / filename
        parsed = parse_formula_file(str(path))
        native = parse_formula_markdown(path)
        diagnostics = item["diagnostics"]["parser_preflight"]
        assert parsed.concentrate_ul == 4500.0
        assert math.isclose(sum(row.raw_ul for row in parsed.materials), 4500.0)
        assert len(native) == 1
        assert sum(native[0]["ingredients_ul"].values()) == 4500.0
        assert diagnostics["formula_definition_sha256"] == definition_hash
        assert hashlib.sha256(path.read_bytes()).hexdigest().upper() == diagnostics[
            "rendered_file_sha256"
        ]
        assert diagnostics["ifra_preflight"] == "PASS"


