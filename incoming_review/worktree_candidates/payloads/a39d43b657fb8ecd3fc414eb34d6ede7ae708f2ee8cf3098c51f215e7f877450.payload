def test_blind_protocol_is_balanced_replicated_and_authority_false():
    protocol = load_json("testing/blind_protocol.json")
    assert protocol["schema"] == "perfume-chem-ysl-blind-protocol-v1"
    assert protocol["status"] == "PROTOCOL_ONLY_NOT_EXECUTED"
    assert protocol["time_cells"] == ["0_min", "5_min", "30_min", "2_hr", "4_hr"]
    assert protocol["mandatory_arms"] == ["LH-04", "LN-01", "LN-05"]
    assert protocol["conditional_rescreen_priorities"] == ["LH-05", "LN-02"]
    assert protocol["blinding"]["codes"] == "RANDOM_NONSEMANTIC"
    assert protocol["blinding"]["key_storage"] == "SEPARATE_FROM_ASSESSORS"
    assert protocol["order_control"]["balanced_order"] is True
    assert protocol["sample_control"] == {
        "equal_odorant_active_mass_concentration": True,
        "equal_applied_mass": True,
        "equal_application_method": True,
        "carrier_matched": True,
    }
    assert protocol["replication"]["minimum_true_replicates_for_advancement"] >= 2
    assert protocol["replication"]["independent_batch_preparation"] is True
    assert protocol["authority"] == {
        "protocol_execution": False,
        "physical_liking": False,
        "sensory_similarity": False,
        "stability": False,
        "safety": False,
        "release": False,
    }


def test_blind_protocol_has_all_phase_one_pairs_and_tie_aware_phase_two():
    protocol = load_json("testing/blind_protocol.json")
    phase_one = protocol["phases"]["phase_1_family_controlled_screen"]
    pairs = {(row["control"], row["variant"]) for row in phase_one["pairs"]}
    assert pairs == {
        *{("LH-01", candidate_id) for candidate_id in LH_CHILD_IDS},
        *{("LN-01", candidate_id) for candidate_id in LN_CHILD_IDS},
    }
    phase_two = protocol["phases"]["phase_2_family_comparison"]
    assert phase_two["status"] == "LOCKED_PENDING_PHASE_1_AND_AUTHORITY_REPAIR"
    assert phase_two["lhomme_arms"] == [
        "LH-01",
        "TOP_TWO_ELIGIBLE_LH_VARIANTS_POST_PHASE_1",
        "SOL-LH-FROZEN",
    ]
    assert phase_two["la_nuit_arms"] == [
        "LN-01",
        "TOP_TWO_ELIGIBLE_LN_VARIANTS_POST_PHASE_1",
        "SOL-LN-FROZEN",
    ]
    assert protocol["decision_rules"]["ties"] == "RETAIN_AS_TIE_OR_INCONCLUSIVE"
    assert protocol["decision_rules"]["missing_cells"] == "DO_NOT_IMPUTE"


def test_missing_chemical_microtrial_template_is_constant_total_and_nonexecuting():
    protocol = load_json("testing/blind_protocol.json")
    templates = protocol["missing_chemical_microtrial_templates"]
    assert templates
    for template in templates:
        assert template["arm_types"] == ["CONTROL", "ADDITION", "OMISSION", "RATIO"]
        assert template["constant_total"] is True
        assert template["carrier_matched"] is True
        assert template["minimum_true_replicates"] >= 2
        assert template["expected_cells_locked_before_observation"] is True
        assert template["execution_authorized"] is False
        assert template["tie_or_missing_result"] in {"HOLD", "INCONCLUSIVE"}


def test_final_index_and_readme_list_every_candidate_in_order():
    readme = (STUDY / "README.md").read_text(encoding="utf-8")
    final_index = (STUDY / "reports" / "final_index.md").read_text(encoding="utf-8")
    for text in (readme, final_index):
        positions = [
            text.index(f"candidates/{candidate_id}.json")
            for candidate_id in EXPECTED_IDS
        ]
        assert positions == sorted(positions)
        for candidate_id in EXPECTED_IDS:
            assert f"candidates/{candidate_id}.json" in text or (
                f"../candidates/{candidate_id}.json" in text
            )
            assert f"impact/{candidate_id}_assessment.json" in text or (
                f"../impact/{candidate_id}_assessment.json" in text
            )
    assert "TARGET / IDEAL" in readme
    assert "CURRENT-INVENTORY BUILD" in readme
    assert "NOT TESTED" in readme


def test_manifest_binds_final_handoff_artifacts_and_frozen_baselines():
    manifest = load_json("study_manifest.json")
    bindings = manifest["artifact_bindings"]
    required = {
        "blind_protocol",
        "screening_summary",
        "missing_chemical_impact_index",
        "sol_comparison",
        "final_index",
        "readme",
        "sol_lhomme_source_snapshot",
        "sol_la_nuit_source_snapshot",
    }
    assert required.issubset(bindings)
    for key in required:
        binding = bindings[key]
        path = STUDY / binding["path"]
        assert path.is_file()
        assert hashlib.sha256(path.read_bytes()).hexdigest().upper() == binding["sha256"]
    assert bindings["sol_lhomme_source_snapshot"]["sha256"] == (
        "44ABA8B5153D26A8AFA5CD07B20974EAAF66A5D659FEECC13D59EEF6F917E0FD"
    )
    assert bindings["sol_la_nuit_source_snapshot"]["sha256"] == (
        "254A73B6B45420CF89034FC5C2CAABCAACE9A197BE315C31E9958E4A5CFDAEBB"
    )
