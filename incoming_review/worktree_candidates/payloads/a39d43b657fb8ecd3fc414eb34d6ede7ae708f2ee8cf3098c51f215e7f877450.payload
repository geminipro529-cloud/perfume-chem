import json
import hashlib
import math
from pathlib import Path

from scripts.evaluate_formula import parse_formula_file
from scripts.verify_formula_workflow import parse_formula_markdown


ROOT = Path(__file__).resolve().parents[2]
STUDY = ROOT / "formulas" / "ysl_twenty_variant_study"
EXPECTED_IDS = tuple(
    [f"LH-{index:02d}" for index in range(1, 11)]
    + [f"LN-{index:02d}" for index in range(1, 11)]
)
LOST_TINCTURES = {
    "Vietnamese Benzoin Styrax Tonkinensis resin ethanol tincture (20%)",
    "Turkish Storax Liquidambar Orientalis resin ethanol tincture (20%)",
}
FORBIDDEN_MUSKS = {"Tonalide", "Macrolide", "Musk Ketone"}
LH_CHILD_IDS = tuple(f"LH-{index:02d}" for index in range(2, 11))
LN_CHILD_IDS = tuple(f"LN-{index:02d}" for index in range(2, 11))


def load_json(relative: str) -> dict:
    with (STUDY / relative).open(encoding="utf-8") as handle:
        return json.load(handle)


def target_materials(relative: str) -> dict[str, dict]:
    target = load_json(relative)
    return {item["identity"]: item for item in target["materials"]}


def candidate(candidate_id: str) -> dict:
    return load_json(f"candidates/{candidate_id}.json")


def test_manifest_has_exact_candidate_roster():
    manifest = load_json("study_manifest.json")
    assert tuple(item["candidate_id"] for item in manifest["candidates"]) == EXPECTED_IDS
    assert len({item["candidate_id"] for item in manifest["candidates"]}) == 20


def test_inventory_overlay_records_direct_user_authority():
    overlay = load_json("evidence/inventory_overlay.json")
    by_name = {item["inventory_name"]: item for item in overlay["overrides"]}
    assert by_name["Ethylene Brassylate"]["status"] == "OWNED"
    assert by_name["Ethylene Brassylate"]["concentration_basis"] == "w/w"
    assert by_name["Ethylene Brassylate"]["stock_fraction"] == 1.0
    assert all(by_name[name]["status"] == "OUT_OF_STOCK" for name in LOST_TINCTURES)


def test_family_targets_are_inventory_independent_and_normalized():
    for relative in ("families/lhomme_target.json", "families/la_nuit_target.json"):
        target = load_json(relative)
        assert target["basis"] == "active_ppm_w_w_of_concentrate"
        assert math.isclose(
            sum(row["active_ppm_w_w"] for row in target["materials"]),
            1_000_000.0,
            abs_tol=0.001,
        )
        assert all("inventory_status" not in row for row in target["materials"])


def test_family_target_hashes_socket_budget_and_single_musk_are_locked():
    for relative in ("families/lhomme_target.json", "families/la_nuit_target.json"):
        target = load_json(relative)
        hash_rows = [
            {
                "identity": row["identity"],
                "active_ppm_w_w": row["active_ppm_w_w"],
                "function": row["function"],
                "time_windows": row["time_windows"],
                "evidence_ids": row["evidence_ids"],
                "quantity_authority": row["quantity_authority"],
            }
            for row in target["materials"]
        ]
        payload = json.dumps(
            hash_rows,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode()
        assert hashlib.sha256(payload).hexdigest().upper() == target["target_sha256"]
        assert math.isclose(
            sum(
                row["active_ppm_w_w"]
                for row in target["materials"]
                if row["mobility_class"] == "module_mobile"
            )
            * 0.9,
            target["variant_socket"]["active_ppm_w_w_budget"],
            abs_tol=0.001,
        )
        assert len([row for row in target["materials"] if row.get("is_musk")]) == 1


def test_lhomme_target_preserves_documentary_anchors():
    rows = target_materials("families/lhomme_target.json")
    for required in (
        "Bergamot Oil",
        "Cedrat Oil",
        "Ginger Oil",
        "Violet Leaf",
        "Basil",
        "White Pepper",
        "Cedarwood Virginia",
        "Vetiver Haiti",
        "Tonka",
        "Sandalwood",
    ):
        assert required in rows


def test_la_nuit_target_preserves_documentary_anchors():
    rows = target_materials("families/la_nuit_target.json")
    for required in (
        "Cardamom Oil",
        "Bergamot Oil",
        "Lavender",
        "Cedarwood Virginia",
        "Vetiver Haiti",
        "Coumarin",
        "Tonka",
    ):
        assert required in rows


def test_runtime_adapters_scale_targets_without_redefining_ppm_target():
    pairs = (
        ("families/lhomme_target.json", "runtime_adapters/lhomme_target_4500ul.json"),
        ("families/la_nuit_target.json", "runtime_adapters/la_nuit_target_4500ul.json"),
    )
    for target_relative, adapter_relative in pairs:
        target = load_json(target_relative)
        adapter = load_json(adapter_relative)
        assert adapter["adapter_authority"] == "HEURISTIC_VOLUME_ADAPTER_NOT_PPM_W_W"
        assert math.isclose(adapter["total_raw_ul"], 4500.0, abs_tol=0.0001)
        assert math.isclose(
            sum(row["raw_amount"] for row in adapter["target_materials"]),
            4500.0,
            abs_tol=0.0001,
        )
        assert adapter["canonical_target_sha256"] == target["target_sha256"]
        by_identity = {row["identity"]: row for row in adapter["target_materials"]}
        for row in target["materials"]:
            expected_ul = row["active_ppm_w_w"] * 4500.0 / 1_000_000.0
            assert math.isclose(
                by_identity[row["identity"]]["active_amount_median"],
                expected_ul,
                abs_tol=0.0001,
            )


def test_envelopes_lock_exact_socket_and_protected_floors():
    pairs = (
        (
            "families/lhomme_target.json",
            "runtime_adapters/lhomme_target_4500ul.json",
            "families/lhomme_envelope.json",
        ),
        (
            "families/la_nuit_target.json",
            "runtime_adapters/la_nuit_target_4500ul.json",
            "families/la_nuit_envelope.json",
        ),
    )
    expected_keys = {
        "socket_raw_ul",
        "active_range",
        "carrier_range",
        "anchor_minimums",
        "required_roles",
        "family_caps",
        "temporal_ranges",
        "forbidden_materials",
    }
    for target_relative, adapter_relative, envelope_relative in pairs:
        target = load_json(target_relative)
        adapter = load_json(adapter_relative)
        envelope = load_json(envelope_relative)
        assert set(envelope) == expected_keys
        assert envelope["socket_raw_ul"] == 300.0
        assert set(envelope["forbidden_materials"]) == {
            "Tonalide",
            "Macrolide",
            "Musk Ketone",
        }
        target_by_identity = {row["identity"]: row for row in target["materials"]}
        adapter_by_identity = {
            row["identity"]: row for row in adapter["target_materials"]
        }
        for identity, floor_ul in envelope["anchor_minimums"].items():
            target_row = target_by_identity[identity]
            expected_floor = (
                adapter_by_identity[identity]["raw_amount"]
                * target_row["control_floor_fraction"]
            )
            assert math.isclose(floor_ul, expected_floor, abs_tol=0.0001)


def test_chassis_lock_exact_300_ul_socket_and_validate():
    for relative in ("chassis/lhomme_chassis.json", "chassis/la_nuit_chassis.json"):
        chassis = load_json(relative)
        assert chassis["validation"]["valid"] is True
        assert math.isclose(chassis["total_ul"], 4500.0, abs_tol=0.0001)
        assert math.isclose(chassis["core_total_ul"], 4200.0, abs_tol=0.0001)
        assert math.isclose(chassis["module_total_ul"], 300.0, abs_tol=0.0001)
        assert math.isclose(
            sum(row["module_raw_ul"] for row in chassis["rows"]),
            300.0,
            abs_tol=0.0001,
        )


def test_candidate_target_and_build_are_separate_and_balanced():
    for candidate_id in ("LH-01", "LN-01"):
        item = candidate(candidate_id)
        target = item["target_ideal"]["materials"]
        build = item["current_inventory_build"]["materials"]
        assert target is not build
        assert math.isclose(
            sum(row["active_ppm_w_w"] for row in target),
            1_000_000.0,
            abs_tol=0.001,
        )
        assert math.isclose(
            sum(row["raw_stock_ppm_w_w"] for row in build),
            1_000_000.0,
            abs_tol=0.001,
        )


def test_current_builds_exclude_lost_tinctures_and_exception_musks():
    for candidate_id in ("LH-01", "LN-01"):
        rows = candidate(candidate_id)["current_inventory_build"]["materials"]
        names = {row["inventory_name"] for row in rows}
        assert names.isdisjoint(LOST_TINCTURES)
        assert all("tincture" not in name.casefold() for name in names)
        assert names.isdisjoint(FORBIDDEN_MUSKS)
        assert sum(bool(row["is_musk"]) for row in rows) <= 1


def test_rendered_parent_controls_parse_exact_volume_and_rows():
    expected = {
        "LH-01_Original_Fidelity_30mL_EDT.md": {"Hedione": 500.0},
        "LN-01_Original_2009_Fidelity_30mL_EDT.md": {"Hedione": 400.0},
    }
    for filename, expected_rows in expected.items():
        parsed = parse_formula_file(str(STUDY / "rendered" / filename))
        by_name = {row.name: row for row in parsed.materials}
        assert parsed.concentrate_ul == 4500.0
        assert len(parsed.materials) == 21
        assert math.isclose(
            sum(row.raw_ul for row in parsed.materials),
            4500.0,
            abs_tol=0.0001,
        )
        for name, raw_ul in expected_rows.items():
            assert by_name[name].raw_ul == raw_ul


def test_parent_control_native_definition_hashes_are_bound():
    rendered = {
        "LH-01": (
            "LH-01_Original_Fidelity_30mL_EDT.md",
            "520924f1d02e25a68fc3740179f8d5950b07f710a7e88959f7b9000bc6c3d77b",
        ),
        "LN-01": (
            "LN-01_Original_2009_Fidelity_30mL_EDT.md",
            "45b548de985454942fa5bc11efc25cb41516febf67f1fcae9f9de87522f1a9db",
        ),
    }
    for candidate_id, (filename, definition_hash) in rendered.items():
        item = candidate(candidate_id)
        rendered_path = STUDY / "rendered" / filename
        formulas = parse_formula_markdown(rendered_path)
        assert len(formulas) == 1
        parsed = formulas[0]
        diagnostics = item["diagnostics"]["parser_preflight"]
        assert sum(parsed["ingredients_ul"].values()) == 4500.0
        assert diagnostics["formula_definition_sha256"] == definition_hash
        assert hashlib.sha256(rendered_path.read_bytes()).hexdigest().upper() == diagnostics[
            "rendered_file_sha256"
        ]
        assert diagnostics["formula_uid"] == item["source_bindings"]["formula_uid"]


def test_parent_control_targets_copy_canonical_family_targets_exactly():
    bindings = {
        "LH-01": "families/lhomme_target.json",
        "LN-01": "families/la_nuit_target.json",
    }
    keys = (
        "identity",
        "active_ppm_w_w",
        "function",
        "time_windows",
        "evidence_ids",
        "quantity_authority",
    )
    for candidate_id, relative in bindings.items():
        item = candidate(candidate_id)
        canonical = load_json(relative)
        expected = [{key: row[key] for key in keys} for row in canonical["materials"]]
        assert item["target_ideal"]["materials"] == expected
        assert item["target_ideal"]["target_sha256"] == canonical["target_sha256"]


def test_lhomme_children_lock_parent_axis_and_constant_totals():
    for candidate_id in LH_CHILD_IDS:
        item = candidate(candidate_id)
        assert item["mode"] == "STYLISTIC"
        assert item["source_bindings"]["parent_formula_uid"] == "ysl20:LH-01:v1"
        assert item["source_bindings"]["lineage_type"] == "CONTROLLED_CHILD"
        assert isinstance(item["target_identity"]["primary_axis"], str)
        assert item["target_identity"]["primary_axis"].strip()
        assert math.isclose(
            item["target_identity"]["variant_socket"]["active_ppm_w_w"],
            66_666.667,
            abs_tol=0.001,
        )
        assert item["target_identity"]["variant_socket"]["current_raw_ul"] == 300.0
        assert math.isclose(
            sum(
                row["active_ppm_w_w"]
                for row in item["target_ideal"]["materials"]
            ),
            1_000_000.0,
            abs_tol=0.001,
        )
        assert math.isclose(
            sum(
                row["raw_stock_ppm_w_w"]
                for row in item["current_inventory_build"]["materials"]
            ),
            1_000_000.0,
            abs_tol=0.001,
        )


def test_lhomme_children_retain_canonical_protected_floors():
    canonical = load_json("families/lhomme_target.json")
    controlled_rows = [
        row for row in canonical["materials"] if row["mobility_class"] != "module_mobile"
    ]
    for candidate_id in LH_CHILD_IDS:
        child_rows = {
            row["identity"]: row
            for row in candidate(candidate_id)["target_ideal"]["materials"]
        }
        for control in controlled_rows:
            floor = control["active_ppm_w_w"] * control["control_floor_fraction"]
            assert child_rows[control["identity"]]["active_ppm_w_w"] >= floor


def test_lhomme_children_exclude_lost_tinctures_and_redundant_musks():
    for candidate_id in LH_CHILD_IDS:
        rows = candidate(candidate_id)["current_inventory_build"]["materials"]
        names = {row["inventory_name"] for row in rows}
