        ),
        "LH-07": (
            "LH-07_White_Pepper_Basil_30mL_EDT.md",
            "6ad38f5522652ce36cadcdb47baf395b79cbdd436875d6c8a64635f32aee02b1",
        ),
        "LH-08": (
            "LH-08_Cedar_Vetiver_Tailoring_30mL_EDT.md",
            "bebf2ebbd9952cd31c3b69ef8986df02269b39a469f307d13aaf12835d607ffd",
        ),
        "LH-09": (
            "LH-09_Tonka_Sandalwood_30mL_EDT.md",
            "f6987220810a7c6ed4af3f2c0e6f656a8ad1a3c4b4851ffdfcedc96d8985a3e8",
        ),
        "LH-10": (
            "LH-10_Bangkok_Air_30mL_EDT.md",
            "19a806ef630c791bee3adb258d2bdd663a18264a73ee387dcf6884be4a525408",
        ),
    }
    for candidate_id, (filename, definition_hash) in rendered.items():
        item = candidate(candidate_id)
