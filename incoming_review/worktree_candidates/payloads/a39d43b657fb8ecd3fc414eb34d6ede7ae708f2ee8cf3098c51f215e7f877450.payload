def test_immortelle_nuit_preserves_stock_basis_and_composite_model_holds():
    item = candidate("LN-05")
    rows = {
        row["inventory_name"]: row
        for row in item["current_inventory_build"]["materials"]
    }
    for name in (
        "Immortelle Absolute (10% in DPG)",
        "Hay Absolute (10%)",
        "Maple Lactone (20%)",
    ):
        assert rows[name]["stock_status"].startswith("VERIFY_FIRST")
        assert rows[name]["concentration_basis"] == "UNRECORDED_PERCENT_BASIS"
    assert item["diagnostics"]["composite_natural_oav"] == (
        "HOLD_HELICHRYSUM_EO_UNCOVERED_CURRENT_RUNTIME__"
        "IMMORTELLE_ABSOLUTE_COVERED"
    )
    assert all("neroli" not in name.casefold() for name in rows)
    assert all("tincture" not in name.casefold() for name in rows)


def test_first_la_nuit_children_predeclare_every_large_active_dose_change():
    parent_rows = {
        row["inventory_name"]: row["odorant_active_ppm_w_w"]
        for row in candidate("LN-01")["current_inventory_build"]["materials"]
    }
    for candidate_id in LN_CHILD_IDS:
        item = candidate(candidate_id)
        child_rows = {
            row["inventory_name"]: row["odorant_active_ppm_w_w"]
            for row in item["current_inventory_build"]["materials"]
        }
        authorized = {
            value.split("=", 1)[0]
            for value in item["source_bindings"]["active_dose_change_authorizations"]
        }
        for name in parent_rows.keys() | child_rows.keys():
            parent_active = parent_rows.get(name, 0.0)
            child_active = child_rows.get(name, 0.0)
            is_large = (parent_active == 0.0 and child_active > 0.0) or (
                parent_active > 0.0
                and child_active > 0.0
                and max(parent_active, child_active) / min(parent_active, child_active)
                >= 3.0
            )
            if is_large:
                assert name in authorized


def test_dry_coumarin_skin_omits_unverified_hay_and_defines_mass_preparation():
