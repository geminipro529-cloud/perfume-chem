def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest().upper()


def _section(text: str, heading: str) -> str:
    start = text.index(heading)
    end = text.find("\n## ", start + len(heading))
    return text[start:] if end == -1 else text[start:end]


def _subsection(text: str, heading: str) -> str:
    start = text.index(heading)
    end = text.find("\n### ", start + len(heading))
    return text[start:] if end == -1 else text[start:end]


def _rows(section: str) -> list[tuple[str, float]]:
    found = []
    for line in section.splitlines():
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 3 or not cells[0].isdigit():
            continue
        for cell in reversed(cells[2:]):
            try:
                amount = float(cell.replace(",", ""))
            except ValueError:
                continue
            found.append((cells[1], amount))
            break
    return found


def _current_formula(path: Path) -> dict:
    parsed = parse_formula_markdown(path)
    assert len(parsed) == 1
    return parsed[0]


def _markdown_table(section: str, expected_headers: tuple[str, ...]) -> list[list[str]]:
    lines = section.splitlines()
    header_index = next(
        index
        for index, line in enumerate(lines)
        if [cell.strip() for cell in line.strip().strip("|").split("|")] == list(expected_headers)
    )
    rows: list[list[str]] = []
    for line in lines[header_index + 2:]:
        if not line.lstrip().startswith("|"):
            if rows:
                break
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if not cells or (expected_headers[0] == "#" and not cells[0].isdigit()):
            if rows:
                break
            continue
        rows.append(cells)
    return rows


def _manifest(path: Path) -> dict:
    text = path.read_text(encoding="utf-8")
    match = re.search(
        r"<!-- donor-independence-manifest:\s*(\{.*?\})\s*-->",
        text,
        re.DOTALL,
    )
    assert match, path
    return json.loads(match.group(1))


def _stock_sync(path: Path) -> dict:
    text = path.read_text(encoding="utf-8")
    match = re.search(r"<!-- current-table-stock-sync:\s*(\{.*?\})\s*-->", text, re.DOTALL)
    assert match, path
    return json.loads(match.group(1))


def _assert_formula_contract(
    path: Path,
    *,
    required: set[str],
    forbidden: set[str],
    expected_musks: set[str],
    ideal_floor: int = 58,
    module_floor: int = 10,
) -> None:
    text = path.read_text(encoding="utf-8")
    assert all(section in text for section in REQUIRED_SECTIONS)
    ideal_rows = _rows(_section(text, "## TARGET / IDEAL FORMULA"))
    assert len(ideal_rows) >= ideal_floor
    assert sum(amount for _, amount in ideal_rows) == pytest.approx(6000.0)
    formula = _current_formula(path)
    amounts = formula["ingredients_ul"]
    assert sum(amounts.values()) == pytest.approx(6000.0)
    assert min(amounts.values()) >= 10.0
    assert required <= set(amounts)
    assert (FORBIDDEN_CURRENT | forbidden).isdisjoint(amounts)
    assert MUSKS & set(amounts) == expected_musks
    assert "DPG carrier reserve" not in amounts
    dilutions = {name: formula.get("dilutions", {}).get(name, 1.0) for name in amounts}
    state = build_formula_state(amounts, dilutions=dilutions, batch_volume_ml=30.0)
    preflight = run_release_preflight(formula, state)
    availability = next(check for check in preflight.checks if check.name == "inventory_availability")
    assert availability.status == "PASS", availability.detail
    identity = next(check for check in preflight.checks if check.name == "material_identity_and_physics")
    assert identity.status == "PASS", identity.detail
    audit = audit_donor_independence(path, formula, project_root=ROOT)
    assert audit["status"] == "PASS", audit
    assert len(audit["data"]["target_modules"]) >= module_floor
    folded = text.casefold()
    assert "not tested" in folded
    assert "hold" in folded
    assert "no compounding" in folded
    assert "no release" in folded


def _assert_candidate_review_contract(path: Path) -> None:
    text = path.read_text(encoding="utf-8")
    ordered = (
        "## Authority and status", "## Target identity",
        "## Functional architecture before dosing",
        "## Spatial, temporal, textural, transition, pressure/release, and recurrence maps",
        "## Source-lineage conservation ledger", "<!-- donor-independence-manifest:",
        "## TARGET / IDEAL FORMULA", "## CURRENT-INVENTORY BUILD",
        "## Candidate-survival and omission audit", "## Inventory and stock audit",
        "## Working-stock preparation ledger", "## Missing-chemical impact gate",
        "## Future mixing order",
        "## Controlled blinded test plan", "## Pipeline Analysis", "## Claim ceiling",
    )
    section_positions = [text.index(heading) for heading in ordered]
    assert section_positions == sorted(section_positions)
    assert text.index("## Claim ceiling") > text.index("## Pipeline Analysis")

    current = _section(text, "## CURRENT-INVENTORY BUILD")
    rows = _markdown_table(current, CURRENT_ROW_HEADERS)
    assert rows
    assert [int(row[0]) for row in rows] == list(range(1, len(rows) + 1))
    assert all(len(row) == len(CURRENT_ROW_HEADERS) for row in rows)
    assert all(all(cell for cell in row) for row in rows)
    assert all(row[9] != "-" and row[10] != "-" for row in rows)
    assert all(row[11].count(";") == 0 for row in rows), "one primary owner per row"

    formula = _current_formula(path)
    audit = audit_donor_independence(path, formula, project_root=ROOT)
    headings = audit["data"]["candidate_basket_headings"]
    target_modules = audit["data"]["target_modules"]
    assert headings, "candidate body must expose nonempty basket ontology"
    assert [heading.casefold() for heading in headings] == [module.casefold() for module in target_modules]


@pytest.mark.parametrize("name,source", [
    ("dhp_2025_niche_house_v1.json", FORMULAS / "DHP_2025_Niche_House_30mL_EdP.md"),
    ("opus_v_woods_symphony_v1.json", FORMULAS / "Opus_V_Woods_Symphony_30mL_EdP.md"),
])
def test_theory_donor_signatures_bind_current_source_bytes(name: str, source: Path) -> None:
    signature = json.loads((SIGNATURES / name).read_text(encoding="utf-8"))
    assert signature["schema_version"] == "donor-signature-v1"
    assert signature["source_artifact"] == source.relative_to(ROOT).as_posix()
    assert signature["source_sha256"] == _sha256(source)
    assert signature["ordered_basket_headings"]
    assert signature["structural_materials"]


def test_lhomme_control_is_stock_corrected_constant_total_and_manifest_complete() -> None:
    text = LH_CONTROL.read_text(encoding="utf-8")
    formula = _current_formula(LH_CONTROL)
    amounts = formula["ingredients_ul"]
    assert sum(amounts.values()) == pytest.approx(6000.0)
    assert min(amounts.values()) >= 10.0
    assert len(amounts) == 53
    assert "DPG carrier reserve" not in amounts
    assert amounts["Ginger EO"] == pytest.approx(890.0)
    ginger_fraction = formula["dilutions"]["Ginger EO"]
    assert ginger_fraction == pytest.approx(0.25842697)
    assert amounts["Ginger EO"] * ginger_fraction == pytest.approx(230.0, abs=1e-5)
    assert amounts["Ginger EO"] * (1.0 - ginger_fraction) == pytest.approx(660.0, abs=1e-5)
    assert sum(
        amount * formula.get("dilutions", {}).get(name, 1.0)
        for name, amount in amounts.items()
    ) == pytest.approx(4527.72, abs=1e-5)
    assert FORBIDDEN_CURRENT.isdisjoint(amounts)
    assert MUSKS & set(amounts) == {"Romandolide"}

    temporal = _subsection(text, "### Five temporal windows")
    temporal_windows = [
        line.split("|")[1].strip()
        for line in temporal.splitlines()
        if line.rstrip().endswith("| NOT TESTED |")
    ]
    assert temporal_windows == [
        "opening, 0-5 min",
        "top, 5-30 min",
        "heart, 30-120 min",
        "late heart, 2-6 h",
        "drydown, 6-24 h",
    ]

    transitions = _subsection(text, "### Ten transition and recurrence links")
    assert [
        int(value)
        for value in re.findall(r"^\|\s*(\d+)\s*\|", transitions, re.MULTILINE)
    ] == list(range(1, 11))

    textures = _subsection(text, "### Nineteen conserved textural roles")
    texture_line = next(line for line in textures.splitlines()[1:] if line.strip())
    assert texture_line.rstrip(".").split("; ") == [
        "Polished", "waxed", "wet-cut", "crisp", "fatty", "fibrous",
        "tailored-cloth", "leafy", "metallic", "bitter", "humid", "mineral",
        "pencil-dry", "rooty", "hayed", "creamy-yielding", "textile", "slow",
        "clean-woody",
    ]

    assert (
        "nominal 33% Guaiacwood EO + 33% ethanol + 33% DEP, stated total 99%, "
        "carrier ethanol + DEP, basis unspecified, unresolved 1%, execution_ready false, "
        "quantitative HOLD"
    ) in text
    assert "2/53 materials below perceptible threshold" in text
    assert "    sub-threshold: 2" in text
    assert "  **sub** (2):" in text
    assert "FAIL material_spine_coverage" not in text
    assert "FAIL physics_data_coverage" not in text
    assert "FAIL odt_coverage" not in text
    audit = audit_donor_independence(LH_CONTROL, formula, project_root=ROOT)
    assert audit["status"] == "PASS", audit
    assert len(audit["data"]["target_modules"]) == 10
    _assert_formula_contract(
        LH_CONTROL,
        required=set(),
        forbidden=set(),
        expected_musks={"Romandolide"},
    )


