def test_lhomme_pipeline_analysis_files_match_json_and_formula() -> None:
    slugs = {
        "LH-01": "lh01-neroli-gingembre",
        "LH-02": "lh02-osmanthus-suede",
        "LH-03": "lh03-mandarine-tonka",
        "LH-04": "lh04-genievre-cedre",
        "LH-05": "lh05-pluie-violette",
    }
    for candidate in CANDIDATES:
        slug = slugs[candidate["id"]]
        run_dir = RUN_ROOT / slug
        pipeline = json.loads((run_dir / "pipeline.json").read_text(encoding="utf-8-sig"))
        expected = pipeline["analysis_markdown"].replace("\r\n", "\n").strip()
        persisted = (run_dir / "pipeline_analysis.md").read_text(encoding="utf-8-sig").replace("\r\n", "\n").strip()
        formula_text = candidate["path"].read_text(encoding="utf-8")
        assert persisted == expected
        assert expected in formula_text


def test_lhomme_verification_receipts_bind_complete_current_bundles() -> None:
    slugs = {
        "LH-01": "lh01-neroli-gingembre",
        "LH-02": "lh02-osmanthus-suede",
        "LH-03": "lh03-mandarine-tonka",
        "LH-04": "lh04-genievre-cedre",
        "LH-05": "lh05-pluie-violette",
    }
    for candidate in CANDIDATES:
        run_dir = RUN_ROOT / slugs[candidate["id"]]
        receipt = json.loads((run_dir / "verification_receipt.json").read_text(encoding="utf-8"))
        formula_path = ROOT / receipt["formula"]
        pipeline_path = ROOT / receipt["pipeline"]["path"]
        analysis_path = ROOT / receipt["analysis"]["path"]
        assert receipt["formula_sha256"] == _sha256(formula_path)
        assert receipt["formula_size_bytes"] == formula_path.stat().st_size
        assert receipt["pipeline"]["sha256"] == _sha256(pipeline_path)
        assert receipt["pipeline"]["size_bytes"] == pipeline_path.stat().st_size
        assert receipt["analysis"]["sha256"] == _sha256(analysis_path)
        assert receipt["analysis"]["size_bytes"] == analysis_path.stat().st_size
        assert receipt["analysis"]["appended_to_formula"] is True
        assert receipt["donor_independence"]["status"] == "PASS"
        assert receipt["donor_independence"]["target_basket_headings_consumed"] == 10
        formula = _current_formula(formula_path)
        assert receipt["current_rows"] == len(formula["ingredients_ul"])
        assert receipt["current_total_ul"] == pytest.approx(sum(formula["ingredients_ul"].values()))
        pipeline = json.loads(pipeline_path.read_text(encoding="utf-8"))
        statuses = [gate["status"] for gate in pipeline["formulas"][0]["gates"]]
        assert receipt["pipeline"]["gate_counts"] == {
            status: statuses.count(status) for status in ("PASS", "WARN", "FAIL")
        }


def test_lndl_control_is_stock_corrected_constant_total_and_manifest_complete() -> None:
    text = LNDL_CONTROL.read_text(encoding="utf-8")
    formula = _current_formula(LNDL_CONTROL)
    amounts = formula["ingredients_ul"]
    assert sum(amounts.values()) == pytest.approx(6000.0)
    assert min(amounts.values()) >= 10.0
    assert FORBIDDEN_CURRENT.isdisjoint(amounts)
    assert MUSKS & set(amounts) == {"Ethylene Brassylate"}
    assert "USER-REJECTED DESIGN / CLARITY" in text
    assert "not the family control" in text
    audit = audit_donor_independence(LNDL_CONTROL, formula, project_root=ROOT)
    assert audit["status"] == "PASS", audit
    assert len(audit["data"]["target_modules"]) >= 11


