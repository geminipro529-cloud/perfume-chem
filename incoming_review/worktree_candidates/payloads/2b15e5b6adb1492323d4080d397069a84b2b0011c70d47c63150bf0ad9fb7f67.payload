def test_lndl_current_stock_ledgers_match_current_table() -> None:
    for path in (LN01, LN02, LN03, LN04, LN05):
        current_rows = {
            row[1]: (row[2], row[3], row[4], row[5], row[6])
            for row in _markdown_table(_section(path.read_text(encoding="utf-8"), "## CURRENT-INVENTORY BUILD"), CURRENT_ROW_HEADERS)
        }
        sync = _stock_sync(path)
        assert set(sync) == set(current_rows)
        for material, current_tuple in current_rows.items():
            entry = sync[material]
            assert (entry["canonical_identity"], entry["stock_strength"], entry["basis"], entry["carrier"], str(entry["formula_dose_ul"])) == current_tuple


def test_lndl_modeled_subthreshold_rows_have_explicit_survival_dispositions() -> None:
    slugs = {
        LN01: "ln01-coriander-silk",
        LN02: "ln02-cinnamon-cashmere",
        LN03: "ln03-orris-santal",
        LN04: "ln04-olibanum-cedar",
        LN05: "ln05-tobacco-plum",
    }
    for path, slug in slugs.items():
        text = path.read_text(encoding="utf-8")
        pipeline = json.loads((RUN_ROOT / slug / "pipeline.json").read_text(encoding="utf-8-sig"))
        expected = {material["name"] for material in pipeline["formulas"][0]["formula_state"]["materials"] if material["oav"] < 1.0}
        rows = _markdown_table(_subsection(text, "### Modeled OAV < 1 survival dispositions"), SURVIVAL_HEADERS)
        assert {row[1] for row in rows} == expected
        current = {row[1]: row for row in _markdown_table(_section(text, "## CURRENT-INVENTORY BUILD"), CURRENT_ROW_HEADERS)}
        for row in rows:
            material, modeled_oav, disposition, rationale, omission = row[1:]
            assert float(modeled_oav) < 1.0
            assert disposition in ALLOWED_SURVIVAL_DISPOSITIONS
            assert any(tag in rationale for tag in ("MATRIX", "FIXATION", "SUBRECOGNITION", "SKIN_TEXTURE", "DATA"))
            assert "perceptible" not in rationale.casefold()
            assert "constant-total" in omission and "carrier-matched" in omission
            assert f"{current[material][6]} uL" in omission


def test_lndl_manifest_receiving_owners_are_exact_target_modules() -> None:
    for path in (LN01, LN02, LN03, LN04, LN05):
        manifest = _manifest(path)
        modules = {module.casefold() for module in manifest["target_modules"]}
        assert len(modules) >= 11
        assert len(manifest["source_dispositions"]) == 58
        for row in manifest["source_dispositions"]:
            assert row["rationale"]
            if row["disposition"] in {"KEEP", "REBASE", "EXACT REPLACEMENT"}:
                match = re.search(r"receiving owner: (.*?);", row["rationale"], flags=re.IGNORECASE)
                assert match is not None, row
                assert match.group(1).casefold() in modules, row


def test_lndl_candidates_do_not_share_a_major_volume_chassis() -> None:
    paths = (LN01, LN02, LN03, LN04, LN05)
    formulas = {path: _current_formula(path)["ingredients_ul"] for path in paths}
    common = set.intersection(*(set(formula) for formula in formulas.values()))
    assert len(common) <= 12
    assert max(sum(formula[name] for name in common) for formula in formulas.values()) / 6000.0 < 0.35
    for left_index, left in enumerate(paths):
        for right in paths[left_index + 1:]:
            left_set, right_set = set(formulas[left]), set(formulas[right])
            assert len(left_set & right_set) / len(left_set | right_set) < 0.85
            shared_raw = sum(min(formulas[left][name], formulas[right][name]) for name in left_set & right_set)
            assert shared_raw / 6000.0 < 0.50


def test_lndl_pipeline_analysis_and_receipts_bind_exact_formula_bytes() -> None:
    slugs = {LN01: "ln01-coriander-silk", LN02: "ln02-cinnamon-cashmere", LN03: "ln03-orris-santal", LN04: "ln04-olibanum-cedar", LN05: "ln05-tobacco-plum"}
    for path, slug in slugs.items():
        run_dir = RUN_ROOT / slug
        pipeline_path = run_dir / "pipeline.json"
        analysis_path = run_dir / "pipeline_analysis.md"
        receipt_path = run_dir / "verification_receipt.json"
        pipeline = json.loads(pipeline_path.read_text(encoding="utf-8-sig"))
        expected = pipeline["analysis_markdown"].replace("\r\n", "\n").strip()
        assert analysis_path.read_text(encoding="utf-8-sig").replace("\r\n", "\n").strip() == expected
        assert expected in path.read_text(encoding="utf-8")
        receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
        assert receipt["formula_sha256"] == _sha256(path)
        assert receipt["formula_size_bytes"] == path.stat().st_size
        assert receipt["pipeline"]["sha256"] == _sha256(pipeline_path)
        assert receipt["analysis"]["sha256"] == _sha256(analysis_path)
        assert receipt["donor_independence"]["status"] == "PASS"
        assert receipt["donor_independence"]["target_basket_headings_consumed"] >= 11


