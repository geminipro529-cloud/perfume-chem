    assert "current approximation includes Javanol" not in text[current_start:].casefold()


def test_lhomme_candidates_do_not_share_a_major_volume_chassis() -> None:
    formulas = [_current_formula(candidate["path"])["ingredients_ul"] for candidate in CANDIDATES]
    common = set.intersection(*(set(formula) for formula in formulas))
    assert len(common) <= 12
    common_raw_by_formula = [sum(formula[name] for name in common) for formula in formulas]
    assert max(common_raw_by_formula) / 6000.0 < 0.35


def test_formatter_uses_final_product_cat4_basis_and_emits_no_trailing_whitespace(tmp_path: Path) -> None:
    script = ROOT / "scripts" / "format_pipeline_analysis.py"

    def run(active_ul: float) -> str:
        payload = {
            "formulas": [{
                "name": "Cat4 basis fixture",
                "formula_state": {
                    "materials": [{
                        "name": "Cyclamen Aldehyde",
                        "raw_ul": active_ul,
                        "active_ul": active_ul,
                        "oav": 10.0,
                        "note": "heart",
                        "vp_pa": 1.0,
                        "vapor_ppm": 1.0,
                        "odt_ppm": 0.1,
                        "moles": 0.001,
                        "mole_fraction": 0.01,
                        "gamma": 1.0,
                        "mw": 180.0,
                        "role": "watery floral",
                        "ifra_limit_pct": 0.62,
                        "evaporation_fraction_4h": 0.5,
                    }],
                    "total_active_ul": 4500.0,
                    "batch_volume_ml": 30.0,
                    "note_distribution": {"top": 0.0, "heart": 100.0, "base": 0.0},
                    "total_vapor_ppm": 1.0,
                },
                "time_series": [],
                "gates": [],
                "overall_status": "HOLD",
            }]
        }
        input_path = tmp_path / f"fixture-{active_ul}.json"
        input_path.write_text(json.dumps(payload), encoding="utf-8")
        result = subprocess.run(
            [sys.executable, str(script), "--input", str(input_path)],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout

    below = run(30.0)  # 0.10% of final 30 mL; old concentrate-basis bug read 0.667%.
    above = run(180.0)  # 0.60% of final 30 mL; inside the 90%-of-limit warning zone.
    assert "near/above Cat4 limit" not in below
    assert "near/above Cat4 limit" in above
    assert all(line == line.rstrip() for line in below.splitlines())
    assert "{role:30s}" not in script.read_text(encoding="utf-8")


