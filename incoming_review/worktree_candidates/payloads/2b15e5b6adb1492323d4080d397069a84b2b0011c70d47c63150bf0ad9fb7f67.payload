def test_working_stock_ledgers_match_current_table_dose_and_carrier() -> None:
    expected = {
        LH01: {"Basil EO (India, Ocimum Basilicum)": ("10%", "DPG", "20")},
        LH03: {
            "Citral": ("10%", "DPG", "20"),
            "Basil EO (India, Ocimum Basilicum)": ("10%", "DPG", "20"),
            "Alpha Ionone": ("10%", "DEP", "20"),
        },
        LH04: {
            "Citral": ("10%", "DPG", "20"),
            "Alpha Ionone": ("10%", "DEP", "20"),
            "Basil EO (India, Ocimum Basilicum)": ("10%", "DPG", "100"),
        },
        LH05: {"Suederal": ("10%", "unverified carrier", "150")},
    }
    for path, required in expected.items():
        text = path.read_text(encoding="utf-8")
        current_rows = {
            row[1]: (row[3], row[5], row[6])
            for row in _markdown_table(_section(text, "## CURRENT-INVENTORY BUILD"), CURRENT_ROW_HEADERS)
        }
        ledger_rows = {
            material: (entry["stock_strength"], entry["carrier"], str(entry["formula_dose_ul"]))
            for material, entry in _stock_sync(path).items()
        }
        for material, expected_tuple in required.items():
            assert current_rows[material] == expected_tuple
            assert ledger_rows[material] == expected_tuple


def test_every_modeled_subthreshold_current_row_has_an_executable_survival_disposition() -> None:
    slugs = {
        LH01: "lh01-neroli-gingembre",
        LH02: "lh02-osmanthus-suede",
        LH03: "lh03-mandarine-tonka",
        LH04: "lh04-genievre-cedre",
        LH05: "lh05-pluie-violette",
    }
    for path, slug in slugs.items():
        text = path.read_text(encoding="utf-8")
        pipeline = json.loads((RUN_ROOT / slug / "pipeline.json").read_text(encoding="utf-8-sig"))
        materials = pipeline["formulas"][0]["formula_state"]["materials"]
        expected = {material["name"] for material in materials if material["oav"] < 1.0}
        rows = _markdown_table(
            _subsection(text, "### Modeled OAV < 1 survival dispositions"),
            SURVIVAL_HEADERS,
        )
        assert {row[1] for row in rows} == expected
        current = {
            row[1]: row
            for row in _markdown_table(_section(text, "## CURRENT-INVENTORY BUILD"), CURRENT_ROW_HEADERS)
        }
        for row in rows:
            material, modeled_oav, disposition, rationale, omission = row[1:]
            assert float(modeled_oav) < 1.0
            assert disposition in ALLOWED_SURVIVAL_DISPOSITIONS
            assert any(tag in rationale for tag in ("MATRIX", "FIXATION", "SUBRECOGNITION", "SKIN_TEXTURE"))
            assert "perceptible" not in rationale.casefold()
            assert "constant-total" in omission
            assert "carrier-matched" in omission
            assert f"{current[material][6]} uL" in omission


def test_lh03_lh04_lh05_source_dispositions_are_target_semantic_not_cycled() -> None:
    required_fragments = {
        LH03: {
            "Bergamot FCF oil Sicilian": "single red-mandarin peel pressure",
            "Dihydrojasmone": "transparent floral breathing plane",
            "Alpha Isomethyl Ionone": "violet tailored cloth",
            "Parmavert": "Green pith seam",
            "Leafovert": "Green pith seam",
            "Cedarwood EO": "cedar-vetiver echo",
            "Tonka Bean Absolute": "hayed tonka aperture",
            "Romandolide": "musk-free recurrence matrix",
        },
        LH04: {
            "Bergamot FCF oil Sicilian": "cool berry capsule",
            "Ginger EO": "Wet ginger incision",
            "Citral": "Wet ginger incision",
            "Parmavert": "Basil-green seam",
            "Basil EO (India, Ocimum Basilicum)": "Basil-green seam",
            "Leafovert": "Basil-green seam",
            "Scentenal": "Basil-green seam",
            "Alpha Isomethyl Ionone": "Violet tailored cloth",
            "Cedarwood EO": "Three-grain cedar field",
            "Vetiver EO (India)": "Root-dry residue",
            "Tonka Bean Absolute": "root-dry residue",
            "Romandolide": "zero-musk edge",
        },
        LH05: {
            "Bergamot FCF oil Sicilian": "humid reflective surface",
            "Ginger EO": "wet ginger cortex",
            "Parmavert": "Green mineral seam",
            "Scentenal": "Green mineral seam",
            "Alpha Isomethyl Ionone": "violet textile suspension",
            "Dihydrojasmone": "molecular air release",
            "Cedarwood EO": "cedar receiving wall",
            "Vetiver EO (India)": "Vetiver landing axis",
            "Tonka Bean Absolute": "yielding sandal interior",
            "Romandolide": "sole Romandolide cloth recurrence",
        },
    }
    forbidden_boilerplate = (
        "on the front-to-heart plane",
        "on the suspended-heart plane",
        "on the heart-to-base plane",
    )
    for path, expected in required_fragments.items():
        manifest = _manifest(path)
        source_rows = manifest["source_dispositions"]
        target_modules = {module.casefold() for module in manifest["target_modules"]}
        dispositions = {
            row["source_row"]: row["rationale"]
            for row in source_rows
        }
        assert len(source_rows) == 58
        for row in source_rows:
            if row["disposition"] in {"KEEP", "REBASE", "EXACT REPLACEMENT"}:
                owner = re.search(
                    r"by transferring it to the (.*?) in the ",
                    row["rationale"],
                    flags=re.IGNORECASE,
                )
                assert owner is not None, row["source_row"]
                assert owner.group(1).casefold() in target_modules, row["source_row"]
        for source_row, fragment in expected.items():
            assert fragment in dispositions[source_row]
        combined = "\n".join(dispositions.values())
        assert all(phrase not in combined for phrase in forbidden_boilerplate)


