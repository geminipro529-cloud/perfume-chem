**Files:**
- Create: `docs/research/donor_signatures/dhp_2025_niche_house_v1.json`
- Create: `docs/research/donor_signatures/opus_v_woods_symphony_v1.json`
- Create: `tests/test_lhomme_lndl_hedonic_flanker_suite_v1.py`
- Create: `verification_runs/20260902-lhomme-lndl-hedonic-flanker-suite-dhp2025-v1/AUTHORITY_RECEIPT.json`

**Interfaces:**
- Consumes: current repository bytes, `parse_inventory`, `parse_formula_markdown`, and `audit_donor_independence`.
- Produces: immutable source hashes, donor signature hashes, reusable test helpers `_section`, `_rows`, `_current_formula`, `_sha256`, `_assert_formula_contract`, and `CANDIDATES` metadata used by Tasks 2-17.

- [ ] **Step 1: Re-run the complete authority preflight and record exact hashes**

Run `Get-FileHash -Algorithm SHA256` for every authority and predecessor named in the design spec, `DHP_2025_Niche_House_30mL_EdP.md`, `Opus_V_Woods_Symphony_30mL_EdP.md`, and the existing White Fire signature. Record absolute path, Git object or working-tree state, byte size, SHA-256, read timestamp, branch, HEAD, and dirty exclusions in `AUTHORITY_RECEIPT.json` using `apply_patch`.

- [ ] **Step 2: Write donor-signature validation tests and shared formula helpers**

Add this concrete starting contract to `tests/test_lhomme_lndl_hedonic_flanker_suite_v1.py`:

```python
import hashlib
import json
from pathlib import Path

import pytest

from engine.pipeline.formula_state import build_formula_state
from engine.pipeline.preflight import run_release_preflight
from scripts.verify_formula_workflow import audit_donor_independence, parse_formula_markdown

ROOT = Path(__file__).resolve().parents[1]
FORMULAS = ROOT / "formulas"
RUN_ROOT = ROOT / "verification_runs" / "20260902-lhomme-lndl-hedonic-flanker-suite-dhp2025-v1"
SIGNATURES = ROOT / "docs" / "research" / "donor_signatures"
MUSKS = {
    "Ethylene Brassylate", "Habanolide", "Romandolide", "Exaltolide",
    "Ambrettolide", "Tonalide", "Macrolide", "Musk Ketone",
}
FORBIDDEN_CURRENT = {
    "Polysantol", "Ambrofix", "Bacdanol", "Guaiacwood EO 33%",
    "Benzyl Salicylate", "Tonalide", "Macrolide", "Musk Ketone",
}
CANDIDATES: list[dict[str, object]] = []
REQUIRED_SECTIONS = (
    "## Authority and status",
    "## Target identity",
    "## Functional architecture before dosing",
    "## Spatial, temporal, textural, transition, pressure/release, and recurrence maps",
    "## Source-lineage conservation ledger",
    "donor-independence-manifest",
    "## TARGET / IDEAL FORMULA",
    "## CURRENT-INVENTORY BUILD",
    "## Candidate-survival and omission audit",
    "## Inventory and stock audit",
    "## Working-stock preparation ledger",
    "## Missing-chemical impact gate",
    "## Future mixing order",
    "## Controlled blinded test plan",
    "## Pipeline Analysis",
    "## Claim ceiling",
)

def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest().upper()

def _section(text: str, heading: str) -> str:
    start = text.index(heading)
    end = text.find("\n## ", start + len(heading))
    return text[start:] if end == -1 else text[start:end]

def _rows(section: str) -> list[tuple[str, float]]:
    found = []
    for line in section.splitlines():
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 3 or not cells[0].isdigit():
            continue
        for cell in reversed(cells[2:]):
            try:
                amount = float(cell.replace(",", ""))
            except ValueError:
                continue
            found.append((cells[1], amount))
            break
    return found

def _current_formula(path: Path) -> dict:
    parsed = parse_formula_markdown(path)
    assert len(parsed) == 1
    return parsed[0]

def _assert_formula_contract(
    path: Path,
    *,
    required: set[str],
    forbidden: set[str],
    expected_musks: set[str],
    ideal_floor: int = 58,
    module_floor: int = 10,
) -> None:
    text = path.read_text(encoding="utf-8")
    assert all(section in text for section in REQUIRED_SECTIONS)
    ideal_rows = _rows(_section(text, "## TARGET / IDEAL FORMULA"))
    assert len(ideal_rows) >= ideal_floor
    assert sum(amount for _, amount in ideal_rows) == pytest.approx(6000.0)
    formula = _current_formula(path)
    amounts = formula["ingredients_ul"]
    assert sum(amounts.values()) == pytest.approx(6000.0)
    assert min(amounts.values()) >= 10.0
    assert required <= set(amounts)
    assert (FORBIDDEN_CURRENT | forbidden).isdisjoint(amounts)
    assert MUSKS & set(amounts) == expected_musks
    aromatic = {name: amount for name, amount in amounts.items() if name != "DPG carrier reserve"}
    dilutions = {name: formula.get("dilutions", {}).get(name, 1.0) for name in aromatic}
    state = build_formula_state(aromatic, dilutions=dilutions, batch_volume_ml=30.0)
    preflight = run_release_preflight(formula, state)
    availability = next(check for check in preflight.checks if check.name == "inventory_availability")
    assert availability.status == "PASS", availability.detail
    audit = audit_donor_independence(path, formula, project_root=ROOT)
    assert audit["status"] == "PASS", audit
    assert len(audit["data"]["target_modules"]) >= module_floor
    folded = text.casefold()
    assert "not tested" in folded
    assert "hold" in folded
    assert "no compounding" in folded
    assert "no release" in folded

@pytest.mark.parametrize("name,source", [
    ("dhp_2025_niche_house_v1.json", FORMULAS / "DHP_2025_Niche_House_30mL_EdP.md"),
    ("opus_v_woods_symphony_v1.json", FORMULAS / "Opus_V_Woods_Symphony_30mL_EdP.md"),
])
def test_theory_donor_signatures_bind_current_source_bytes(name: str, source: Path) -> None:
    signature = json.loads((SIGNATURES / name).read_text(encoding="utf-8"))
    assert signature["schema_version"] == "donor-signature-v1"
    assert signature["source_artifact"] == source.relative_to(ROOT).as_posix()
    assert signature["source_sha256"] == _sha256(source)
    assert signature["ordered_basket_headings"]
    assert signature["structural_materials"]
```

