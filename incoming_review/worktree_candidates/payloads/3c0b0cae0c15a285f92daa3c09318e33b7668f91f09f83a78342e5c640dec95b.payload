<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bergamot Prism v1.0</title><style>body{font-family:Inter,Segoe UI,Arial,sans-serif;background:#f3f0f6;color:#241f2e;margin:0}
