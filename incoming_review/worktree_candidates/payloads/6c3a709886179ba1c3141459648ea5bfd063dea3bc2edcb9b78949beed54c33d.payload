  "target_identity": {
    "north_star": "La Nuit's cool cardamom recognizer opening into a dimensional lavender heart—floral-honeyed, high-altitude fresh, and faintly camphoraceous—then braided directly into cedar, never barbershop, laundry-clean, or sweet fougere.",
    "functional_architecture": [
      "cardamom retained as the opening recognizer",
      "three-register lavender heart: floral body, fine aromatic lift, and trace camphor edge",
      "linalool/linalyl-acetate continuity without laundry volume",
      "literal cedar and vetiver receive the lavender transition without a musk curtain"
    ],
    "protected_identity": [
      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "dimensional lavender-heart expansion under an unchanged cardamom-to-cedar vertical",
    "variant_socket": {
      "active_ppm_w_w": 66666.667,
      "current_raw_ul": 300,
      "target_allocation": {
        "Lavender increment": 28000,
        "Linalool increment": 12000,
        "Linalyl Acetate module": 10000,
        "Cardamom increment": 8000,
        "Hedione increment": 6000,
        "Hedione HC": 2666.6666
      },
      "current_allocation_ul": {
        "Lavender EO (BONTAUX SAS)": 70,
        "Lavender EO High Altitude (angustifolia, France)": 45,
        "Spike Lavender EO": 10,
        "Linalool": 45,
        "Linalyl Acetate": 45,
        "Cardamom EO": 35,
        "Hedione": 50
      }
    },
    "selection_rationale": [
      "Bontaux lavender supplies soft floral-honeyed body; High Altitude supplies finer aromatic lift; a one-third-as-large Spike trace supplies a masculine camphor edge without taking over.",
      "Linalool and linalyl acetate extend constituent-level continuity from cardamom and bergamot into lavender instead of adding a generic muguet or laundry accord.",
      "Hedione stays below crowding and Hedione HC is ideal-only because it is absent from current inventory; current Hedione maps transition air with an explicit texture loss.",
      "EB remains the sole structural musk; Romandolide, Habanolide, Galaxolide, and extra Exaltolide were rejected because they would turn the lavender study into a musk-cleanliness study."
    ],
    "drift_risk": "Too much Spike, linalyl acetate, clean floral volume, coumarin, or musk would shift the perfume toward camphor, barbershop, laundry, or sweet fougere."
  },
