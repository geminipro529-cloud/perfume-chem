  "target_identity": {
    "north_star": "La Nuit's cool cardamom recognizer extended from opening into heart through aromatic esters and a yielding sandalwood-cedar texture, sensual and tactile without cineolic harshness, culinary spice, or musk padding.",
    "functional_architecture": [
      "cardamom-led cool ignition held below the native IFRA edge",
      "linalool/linalyl-acetate aromatic continuation",
      "lavender and literal cedar retained as the central braid",
      "fresh-light Sandalore core plus yielding Ebanol mapping for velvet texture"
    ],
