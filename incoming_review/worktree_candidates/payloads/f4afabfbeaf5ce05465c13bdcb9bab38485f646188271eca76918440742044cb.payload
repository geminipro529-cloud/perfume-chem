      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "cardamom continuity folded into a yielding cedar-sandalwood velvet seam",
    "variant_socket": {
      "active_ppm_w_w": 66666.667,
