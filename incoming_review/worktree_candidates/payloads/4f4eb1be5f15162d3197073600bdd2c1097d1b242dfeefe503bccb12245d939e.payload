  "target_identity": {
    "north_star": "La Nuit's cool cardamom recognizer extended from opening into heart through aromatic esters and a yielding sandalwood-cedar texture, sensual and tactile without cineolic harshness, culinary spice, or musk padding.",
    "functional_architecture": [
      "cardamom-led cool ignition held below the native IFRA edge",
      "linalool/linalyl-acetate aromatic continuation",
      "lavender and literal cedar retained as the central braid",
      "fresh-light Sandalore core plus yielding Ebanol mapping for velvet texture"
    ],
    "protected_identity": [
      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "cardamom continuity folded into a yielding cedar-sandalwood velvet seam",
    "variant_socket": {
      "active_ppm_w_w": 66666.667,
      "current_raw_ul": 300,
      "target_allocation": {
        "Cardamom Oil increment": 14000,
        "Linalool increment": 14000,
        "Linalyl Acetate module": 8000,
        "Sandalwood increment": 24666.6666,
        "Cedarwood Virginia increment": 6000
      },
      "current_allocation_ul": {
        "Cardamom EO": 55,
        "Linalool": 55,
        "Linalyl Acetate": 40,
        "Ebanol": 90,
        "Cedarwood oil Virginia": 30,
        "Hedione": 30
      }
    },
    "selection_rationale": [
      "Cardamom EO is the documented recognizer and is shaped by linalool/linalyl acetate rather than coriander, eucalyptus, or extra camphor.",
      "Ebanol supplies yielding creamy-soft velvet; Javanol was rejected as too mineral-dry and Bacdanol as too heavy, while Sandalore remains the lighter core.",
      "Literal cedar keeps the velvet textile attached to La Nuit's vertical structure.",
      "EB stays the sole musk; added musk would blur the material-led velvet axis."
    ],
    "drift_risk": "Cardamom overdose, eucalyptus-like cineole, sweet vanillic powder, or extra musk would turn recognizer continuity into culinary harshness or generic sensuality."
  },
