- [ ] **Step 1: Write RED tests for missing OAV and missing windows**

Create synthetic frames using `dataclasses.replace` so expectations are literal and independent of the simulator:

```python
def _frame_with_oavs(state, label, seconds, oavs):
    return SimulationFrame(
        label=label,
        t_seconds=seconds,
        state=replace(
            state,
            materials=tuple(replace(row, oav=oavs.get(row.name)) for row in state.materials),
        ),
    )

def test_named_ratio_holds_when_present_member_has_unknown_oav():
    state = build_formula_state({"Hexyl Acetate": 100.0, "Grapefruit FCF oil Sicilian": 100.0}, {})
    frames = (
        _frame_with_oavs(state, "opening", 0.0, {"Hexyl Acetate": 10.0, "Grapefruit FCF oil Sicilian": None}),
        _frame_with_oavs(state, "heart", 1800.0, {"Hexyl Acetate": 3.0, "Grapefruit FCF oil Sicilian": None}),
    )
    result = _gate_reference_temporal_relationships(state, frames, ReleaseGateConfig(family_archetype="sukhum_35.thai_aventus_adjacent"))
    check = next(row for row in result.data["checks"] if row["name"] == "s35_opening_fruit_not_over_citrus")
    assert check["status"] == "FAIL"
    assert check["ratio"] is None
    assert check["quantitative_authority"] == "HOLD"
    assert check["missing_oav_materials"] == ["Grapefruit FCF oil Sicilian"]

def test_named_perfume_knowledge_fails_when_drydown_frame_is_missing(monkeypatch):
    result = _gate_perfume_knowledge(state, named_config, frames_without_drydown)
    assert result.status == "FAIL"
    assert result.data["missing_simulation_windows"] == ["drydown"]
```

- [ ] **Step 2: Write RED tests for real family evaluation and claim ceiling**

```python
def test_static_profile_text_cannot_create_family_hedonic_pass():
    state = build_formula_state({"Iso E Super": 6000.0}, {})
    frames = tuple(simulate_formula({"Iso E Super": 6000.0}, {}, initial_state=state))
    result = _gate_family_hedonic(state, frames, ReleaseGateConfig(family_archetype="chypre_classical.coty_reference"))
    assert result.data["candidate_status"] == "FUTURE_CANDIDATE_NOT_VALIDATED"
    assert result.data["evaluated_criteria"] >= 0
    assert result.data["proves_liking"] is False
    assert result.data["proves_similarity"] is False
    assert result.status != "PASS"

def test_generic_family_drift_is_advisory_but_named_drift_is_blocking():
    generic = _apply_guideline_policy(_result("family_drift_detector", "FAIL", "miss"), ReleaseGateConfig(family_archetype="aromatic_fougere.classic_reference"))
    named = _apply_guideline_policy(_result("family_drift_detector", "FAIL", "miss"), ReleaseGateConfig(family_archetype="creed_aventus.reference"))
    assert generic.status == "WARN"
    assert named.status == "FAIL"
```

