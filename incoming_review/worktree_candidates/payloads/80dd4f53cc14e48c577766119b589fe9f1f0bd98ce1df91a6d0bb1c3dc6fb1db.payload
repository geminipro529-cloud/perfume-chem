```python
def test_four_reference_briefs_resolve_to_distinct_archetypes():
    expected = {
        "creed_aventus": "creed_aventus.reference",
        "creed_absolu_aventus": "creed_absolu_aventus.reference",
        "montblanc_explorer": "montblanc_explorer.reference",
        "montblanc_explorer_extreme": "montblanc_explorer_extreme.reference",
    }
    assert {brief: infer_archetype(brief) for brief in expected} == expected
    assert len({get_archetype(key) for key in expected.values()}) == 4

def test_every_named_reference_has_source_observations_and_temporal_rules():
    for key in (
        "creed_aventus.reference",
        "creed_absolu_aventus.reference",
        "montblanc_explorer.reference",
        "montblanc_explorer_extreme.reference",
    ):
        spec = get_archetype(key)
        assert spec.role == "named_reference"
        assert spec.evidence_tier == "OFFICIAL_NOTES_PLUS_DESIGN_HEURISTICS"
        assert spec.quantitative_authority == "INTERNAL_UNCALIBRATED_GUARDRAILS"
        assert spec.reference_observations
        assert spec.temporal_oav_rules
        assert all(rule.evidence_tier == "DESIGN_HEURISTIC" for rule in spec.temporal_oav_rules)
        assert all(rule.measured_reference_headspace is False for rule in spec.temporal_oav_rules)
```

