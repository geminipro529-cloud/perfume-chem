- [ ] **Step 1: Write RED tests**

```python
def test_all_four_named_targets_map_only_as_broad_compatibility():
    cases = {
        "creed_aventus.reference": "chypre",
        "creed_absolu_aventus.reference": "chypre",
        "montblanc_explorer.reference": "woody_amber",
        "montblanc_explorer_extreme.reference": "woody_amber",
    }
    for key, family in cases.items():
        result = _analyze({"Bergamot FCF oil Sicilian": 600.0, "Patchouli EO": 300.0, "Iso E Super": 5100.0}, key)
        assert result.mapped_family == family
        assert result.family_target_alignment["scope"] == "broad_family_compatibility_only"
        assert result.family_target_alignment["named_reference_similarity_evidence"] is False
        assert result.intelligence_status != "PASS"
        assert any("not named-reference similarity" in reason for reason in result.intelligence_warning_reasons)

def test_ambrofix_and_ambrox_super_are_not_collapsed_to_one_identity():
    result = _analyze({"Ambrofix": 100.0, "Ambrox Super": 100.0, "Iso E Super": 5800.0}, "montblanc_explorer.reference")
    serialized = result.as_dict()
    assert "Ambrofix" in str(serialized)
    assert "Ambrox Super" in str(serialized)
    assert not any(row.get("mapped_material") == "Ambroxan" for row in serialized["performance_projection"].get("materials", []) if row.get("material") in {"Ambrofix", "Ambrox Super"})
```

