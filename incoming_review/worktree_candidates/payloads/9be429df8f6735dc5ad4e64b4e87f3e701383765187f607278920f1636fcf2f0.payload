PROJECT_ROOT = Path(__file__).resolve().parents[1]
STUDY_DIR = PROJECT_ROOT / "formulas" / "classical_study"


def _formula(ingredients, archetype, brief):
    total = sum(ingredients.values()) or 1.0
    return {
        "number": 1,
        "name": "Archetype Test",
        "body": "Archetype Test",
        "family_archetype": archetype,
        "ingredients_ul": dict(ingredients),
        "ingredients_pct": {k: v / total * 100.0 for k, v in ingredients.items()},
        "dilutions": {},
    }


def _gate_map(report):
    return {gate.gate: gate for gate in report.gates}


def _assert_advisory_drift_failure(gate):
    assert gate.status == "WARN"
    assert gate.data["original_status"] == "FAIL"


def _assert_resolved_reference_drift(gate):
    assert "unknown family archetype" not in gate.detail.lower()
    assert gate.status in {"PASS", "WARN"}
    if gate.status == "WARN":
        assert gate.data["original_status"] == "FAIL"


def _formula_from_file(name: str):
    formulas = parse_formula_markdown(STUDY_DIR / name)
    assert formulas, name
    return formulas[0]


def test_family_registry_has_required_archetype_specs():
    specs = {spec.key: spec for spec in all_archetypes()}

    assert EXPECTED_ARCHETYPES <= set(specs)
    for key in EXPECTED_ARCHETYPES:
        spec = specs[key]
        assert spec.anchors
        assert spec.drift_limits
        assert spec.repair_pool
        assert spec.oav_targets


def test_woody_floral_musk_recognizes_dihydro_beta_ionone_as_iris_modifier():
    assert "Dihydro Beta Ionone" in WOODY_FLORAL_MUSK_IRIS


def test_woody_floral_musk_recognizes_available_macrocyclic_musks():
    assert {"Zenolide", "Exaltolide", "Ethylene Brassylate", "Ambrettolide"} <= set(
        WOODY_FLORAL_MUSK_MUSKS
    )


def test_active_family_rules_do_not_resurrect_ambrofix_30_percent_stock() -> None:
    assert "Ambrofix" in ORIENTAL_CLASSICAL_CORE
    assert "Ambrofix" in MODERN_AMBERWOOD_FLOOD
    assert all(
        "ambrofix" not in material.casefold()
        for spec in all_archetypes()
        for material in spec.repair_pool
    )
    assert all(
        "30%" not in material
        for material in (*ORIENTAL_CLASSICAL_CORE, *MODERN_AMBERWOOD_FLOOD)
        if "ambrofix" in material.casefold()
    )


def test_named_reference_briefs_resolve_to_distinct_evidence_bounded_specs() -> None:
    expected = {
        "creed_aventus": "creed_aventus.reference",
        "creed_absolu_aventus": "creed_absolu_aventus.reference",
        "montblanc_explorer": "montblanc_explorer.reference",
        "montblanc_explorer_extreme": "montblanc_explorer_extreme.reference",
        "sukhum_35": "sukhum_35.thai_aventus_adjacent",
    }
    assert {brief: infer_archetype(brief) for brief in expected} == expected

    for brief, key in expected.items():
        spec = get_archetype(key)
        assert spec is not None, brief
        assert spec.key == key
        assert spec.oav_targets
        assert spec.temporal_oav_rules
        assert spec.quantitative_authority == "INTERNAL_UNCALIBRATED_GUARDRAILS"
        assert all(not rule.measured_reference_headspace for rule in spec.temporal_oav_rules)

    named = [get_archetype(key) for key in tuple(expected.values())[:4]]
    assert all(spec is not None for spec in named)
    assert all(spec.role == "named_reference" for spec in named if spec is not None)
    assert all(
        spec.evidence_tier == "OFFICIAL_NOTES_PLUS_DESIGN_HEURISTICS"
        and spec.reference_observations
        for spec in named
        if spec is not None
    )
    sukhum = get_archetype(expected["sukhum_35"])
    assert sukhum is not None
    assert sukhum.role == "market_target"
    assert sukhum.evidence_tier == "USER_TARGET_PLUS_DESIGN_HEURISTICS"


def test_named_reference_temporal_contracts_preserve_target_specific_relations() -> None:
    expected = {
        "creed_aventus.reference": {
            "aventus_opening_fruit_under_citrus": (None, 0.85),
            "aventus_heart_bridge_over_fruit": (0.20, None),
            "aventus_late_heart_wood_overlap": (0.50, None),
            "aventus_drydown_fruit_under_wood": (None, 0.25),
        },
        "creed_absolu_aventus.reference": {
            "absolu_opening_fruit_under_citrus": (None, 0.75),
            "absolu_heart_spice_over_fruit": (0.10, 2.00),
            "absolu_late_heart_resin_root_overlap": (0.50, None),
            "absolu_drydown_fruit_under_resin_root": (None, 0.25),
        },
        "montblanc_explorer.reference": {
            "explorer_opening_fruit_under_aromatic_citrus": (None, 0.20),
            "explorer_heart_core_over_opening_residue": (0.30, None),
            "explorer_late_heart_base_overlap": (0.20, None),
            "explorer_drydown_fruit_under_base": (None, 0.05),
        },
        "montblanc_explorer_extreme.reference": {
            "explorer_extreme_opening_fruit_under_citrus": (None, 0.10),
            "explorer_extreme_heart_core_over_citrus": (0.50, None),
            "explorer_extreme_late_heart_warm_base_overlap": (0.30, None),
            "explorer_extreme_drydown_fruit_under_base": (None, 0.02),
        },
        "sukhum_35.thai_aventus_adjacent": {
            "s35_opening_fruit_not_over_citrus": (None, 0.85),
            "s35_fruit_release_by_heart": (None, 0.55),
            "s35_citrus_release_by_heart": (None, 0.70),
            "s35_heart_bridge_over_fruit": (0.25, None),
            "s35_late_heart_wood_overlap": (0.60, None),
            "s35_drydown_fruit_under_wood": (None, 0.15),
        },
    }

    for key, expected_rules in expected.items():
        spec = get_archetype(key)
        assert spec is not None
        rules = {rule.name: rule for rule in spec.temporal_oav_rules}
        assert set(rules) == set(expected_rules)
        assert {
            name: (rule.minimum_ratio, rule.maximum_ratio)
            for name, rule in rules.items()
        } == expected_rules
        assert all(rule.normalized_numerator_materials for rule in rules.values())
        assert all(rule.normalized_denominator_materials for rule in rules.values())


def test_named_targets_keep_unavailable_ambrofix_out_of_repair_pools() -> None:
    for key in (
        "montblanc_explorer.reference",
        "montblanc_explorer_extreme.reference",
    ):
        spec = get_archetype(key)
        assert spec is not None
        exact_axis = next(rule for rule in spec.anchors if "ambrofix_axis" in rule.name)
        assert exact_axis.materials == ("Ambrofix",)
        assert "Ambrofix" not in spec.repair_pool

    explorer = get_archetype("montblanc_explorer.reference")
    assert explorer is not None
    assert next(
        rule for rule in explorer.anchors if rule.name == "explorer_mahonial_axis"
    ).materials == ("Mahonial",)
    assert "Mahonial" not in explorer.repair_pool


def test_dhi_05443a_registry_uses_bounded_architecture_not_legacy_requirements() -> None:
    spec = get_archetype("iris_coumarin_amber.dhi2011")
    assert spec is not None
    assert spec.label == "Dior Homme Intense 2011 05443/A architecture control"
    assert {rule.name for rule in spec.anchors} == {
        "dominant_iris_orris_object",
        "ambrette_pear_talc_mediator",
        "lavender_opening",
        "restrained_amber_vanillic_warmth",
        "virginia_cedar_return",
        "vetiver_return",
        "negative_space_and_woody_frame",
    }
    assert {
        "leather_ghost",
        "coumarin_cocoa_base",
        "muguet_floral",
    }.isdisjoint(rule.name for rule in spec.anchors)
    assert {rule.name for rule in spec.drift_limits} >= {
        "not_gourmand_caricature",
        "not_leather_smoke_or_dhp_drift",
        "not_modern_ambrox_pressure",
    }
    assert spec.novelty_reference.endswith("formula-code scope 05443/A")
    assert "No formula-ratio or sensory-equivalence claim" in spec.novelty_message


def test_dhi_2025_preserves_ambrofix_identity_but_builds_with_ambrox_super() -> None:
    spec = get_archetype("iris_ambrox_amber.dhi2025")
    assert spec is not None

    iris_axis = next(rule for rule in spec.anchors if rule.name == "iris_ionone_axis")
    assert "Alpha Irone (10% w/w in DEP)" in iris_axis.materials
    assert "Alpha Irone (30% in DEP)" not in iris_axis.materials

    backbone = next(rule for rule in spec.anchors if rule.name == "ambrox_backbone")
    assert backbone.materials == ("Ambrox Super", "Ambrofix")
    assert spec.repair_pool["Ambrox Super"] == 1.2
    assert "Ambrofix" not in spec.repair_pool
    assert "functional build option" in backbone.detail
    assert "not a commercial-formula identity claim" in backbone.detail


def test_active_family_stock_labels_use_current_alpha_irone_and_bare_coumarin() -> None:
    active_materials = {
        material
        for spec in all_archetypes()
        for rule in (*spec.anchors, *spec.drift_limits)
        for material in rule.materials
    }
    active_repairs = {
        material for spec in all_archetypes() for material in spec.repair_pool
    }

    assert "Alpha Irone (30% in DEP)" not in active_materials
    assert "Alpha Irone (10% w/w in DEP)" in active_materials
    assert "Coumarin (20%)" not in active_materials | active_repairs
    assert "Coumarin" in active_materials | active_repairs


def test_alpha_irone_current_and_historical_labels_resolve_for_compatibility() -> None:
    current = "Alpha Irone (10% w/w in DEP)"
    historical = (
        "Alpha Irone (30% in DEP)",
        "Alpha Irone (30% w/w in IPM)",
    )

    assert normalize_name(current) == "alpha irone"
    assert all(normalize_name(label) == "alpha irone" for label in historical)
    current_profile = get_profile(current)
    assert current_profile is not None
    assert current_profile.name == "Alpha Irone"
    for label in historical:
        historical_profile = get_profile(label)
        assert historical_profile is not None
        assert historical_profile.name == "Alpha Irone"


def test_prada_lhomme_brief_resolves_and_requires_official_architecture_markers():
    key = "iris_amber_woody.prada_lhomme_reference"
    assert infer_archetype("prada_lhomme") == key
    formula = _formula(
        {
            "Neroli EO": 50.0,
            "Alpha Isomethyl Ionone (Methyl Ionone Pure)": 500.0,
            "Geranium EO (Pelargonium graveolens flower oil)": 20.0,
            "Black Pepper EO": 5.0,
            "Ambrofix": 100.0,
            "Cedarwood oil Virginia": 300.0,
            "Patchouli EO": 20.0,
            "Ethylene Brassylate": 200.0,
            "Zenolide": 200.0,
        },
        key,
        "prada_lhomme",
    )

    assert evaluate_family_archetype(formula, key).status == "PASS"
    formula["ingredients_ul"].pop("Patchouli EO")
    formula["ingredients_pct"].pop("Patchouli EO")
    assert evaluate_family_archetype(formula, key).status == "FAIL"


def test_family_weight_aliases_resolve_dotted_historical_keys():
    assert get_family_weights("citrus_classical.4711_reference") == get_family_weights("citrus_classical")
    assert get_family_weights("fougere_classical.fougere_royale_reference") == get_family_weights("fougere_classical")
    assert get_family_weights("chypre_classical.coty_reference") == get_family_weights("chypre_classical")
    assert get_family_weights("oriental_floral.lheure_bleue_reference") == get_family_weights("oriental_floral")


def test_classical_study_markdown_smoke_files_parse_and_gate_without_unknown_family():
    for name in (
        "01_Eau_de_Cologne_4711_30mL_EdC.md",
        "04_Floral_Bouquet_Quelques_Fleurs_30mL_EdP.md",
        "11_Classic_Fougere_Fougere_Royale_30mL_EdT.md",
        "13_Classic_Chypre_Coty_30mL_EdP.md",
        "18_Classic_Oriental_Shalimar_30mL_EdP.md",
    ):
        formula = _formula_from_file(name)
        total = sum(formula["ingredients_ul"].values())
        report = gate_formula(
            formula,
            ReleaseGateConfig(
                brief="generic",
                family_archetype=formula["family_archetype"],
                expected_concentrate_ul=total,
                audit_enabled=False,
            ),
        )
        gates = _gate_map(report)

        _assert_resolved_reference_drift(gates["family_drift_detector"])


def test_classic_fougere_passes_drift_but_warns_low_novelty():
    formula = _formula(
        {
            "Bergamot FCF": 1200.0,
            "Lavender EO": 700.0,
            "Linalyl Acetate": 600.0,
            "Hedione": 900.0,
            "Coumarin": 300.0,
            "Evernyl": 10.0,
            "Iso E Super": 1500.0,
            "Vetiver EO": 300.0,
            "Habanolide": 490.0,
        },
        "aromatic_fougere.classic_reference",
        "aromatic_fougere",
    )
    gates = _gate_map(gate_formula(formula, ReleaseGateConfig(brief="aromatic_fougere", audit_enabled=False)))

    assert gates["family_drift_detector"].status == "PASS"
    assert gates["novelty_vs_reference"].status == "WARN"


