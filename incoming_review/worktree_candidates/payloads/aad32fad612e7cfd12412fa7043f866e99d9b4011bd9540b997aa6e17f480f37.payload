def get_constituents(material_name: str) -> list[tuple] | None:
    """Return constituent list for a known natural mixture, or None."""
    key = material_name.lower().strip()
    return _ABSOLUTE_CONSTITUENTS.get(key)


@dataclass(frozen=True, slots=True)
class CompositeHeadspace:
    """Aggregate constituent headspace for one modeled natural mixture."""

    vapor_ppm: float
    oav: float
    effective_odt_ppm: float


def composite_headspace(
    material_name: str,
    active_g: float,
    total_moles_in_formula: float,
    gamma_estimate: float = 0.6,
    elapsed_seconds: float = 0.0,
) -> CompositeHeadspace | None:
    """Return aggregate vapor, OAV, and an effective mixture ODT.

    The effective ODT is ``sum(vapor_ppm) / sum(constituent OAV)``. It is a
    composition- and time-dependent diagnostic identity, not a measured
    whole-material detection threshold.
    """
    constituents = get_constituents(material_name)
    if constituents is None:
        return None

    p_atm = 101_325.0
    total_vapor_ppm = 0.0
    total_oav = 0.0
    for _name, fraction, mw, vp_pa, odt_ppb, gamma_value in constituents:
        gamma_used = gamma_value if gamma_value is not None else gamma_estimate
        loss_rate = min(
            2.5e-3,
            max(
                0.0,
                (gamma_used * vp_pa / math.sqrt(max(mw, 1.0))) * 2.0e-5,
            ),
        )
        remaining = math.exp(-loss_rate * max(elapsed_seconds, 0.0))
        constituent_mass_g = active_g * fraction * remaining
        if constituent_mass_g <= 0.0:
            continue
        moles = constituent_mass_g / mw
        x_i = moles / total_moles_in_formula if total_moles_in_formula > 0 else 0.0
        partial_pressure = gamma_used * x_i * vp_pa
        vapor_ppm = 1e6 * partial_pressure / p_atm
        odt_ppm = odt_ppb / 1000.0
        total_vapor_ppm += vapor_ppm
        if odt_ppm > 0.0:
            total_oav += vapor_ppm / odt_ppm

    if total_oav <= 0.0:
        return None
    return CompositeHeadspace(
        vapor_ppm=total_vapor_ppm,
        oav=total_oav,
        effective_odt_ppm=total_vapor_ppm / total_oav,
    )


def composite_oav(
    material_name: str,
    active_g: float,
    total_moles_in_formula: float,
    gamma_estimate: float = 0.6,
    elapsed_seconds: float = 0.0,
) -> float | None:
    """Compute the composite OAV for a natural mixture.

    Decomposes the mixture into its known GC-O constituents and sums
    the individual OAVs computed via modified Raoult's law.

    Args:
        material_name: canonical name (e.g. "osmanthus absolute")
        active_g: active mass in grams in the formula
        total_moles_in_formula: sum of moles of all formula materials
        gamma_estimate: default activity coefficient if none specified
        elapsed_seconds: heuristic finite-film aging time. Each constituent is
            depleted independently by its own VP, gamma, and MW so a natural
            does not retain its opening GC profile unchanged into drydown.

    Returns:
        Composite OAV as float, or None if material not known.
    """
    result = composite_headspace(
        material_name,
        active_g,
        total_moles_in_formula,
        gamma_estimate=gamma_estimate,
        elapsed_seconds=elapsed_seconds,
    )
    return result.oav if result is not None else None
