      "study_design": "Human psychophysical discrimination experiments with controlled within-sniff odor order.",
      "stimuli": "Two odorants delivered in one order and the reverse at controlled onset asynchronies.",
      "population": "229 participants across 649 sessions.",
      "apparatus": "Sniff-triggered odor-delivery apparatus with reported 18 millisecond control precision.",
      "endpoints": ["odor-order discrimination", "stimulus onset asynchrony"],
      "direct_result_summary": "Participants discriminated reversed within-sniff odor sequences at short onset asynchronies using the qualified apparatus.",
      "limitations": ["The result depends on specialized delivery hardware and does not validate ordinary blotter timing.", "Discrimination does not establish preference or perfume temporal depth."],
