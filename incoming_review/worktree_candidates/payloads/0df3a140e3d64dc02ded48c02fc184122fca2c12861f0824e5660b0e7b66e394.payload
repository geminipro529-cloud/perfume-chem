      "title": "Recognition of the Component Odors in Mixtures",
      "authors": ["Frank ME", "Fletcher DB", "Hettinger TP"],
      "publication_year": 2017,
      "retrieved_on": "2026-08-26",
      "source_kind": "PRIMARY_RESEARCH",
      "evidence_class": "GENERAL_OLFACTION_PSYCHOPHYSICS",
      "study_design": "Controlled human adapt-test experiment with water control and two-, three-, and four-component mixtures.",
      "stimuli": "Benzaldehyde, maltol, guaiacol, and methyl anthranilate in water-soluble odor mixtures.",
      "population": "Fourteen human assessors represented in the reported experimental analysis.",
      "apparatus": "Controlled sequential adapting-mixture and test-mixture odor presentations.",
      "endpoints": ["designated component-odor identification"],
      "direct_result_summary": "Selective adaptation reduced identification of adapted ambient components and changed recognition of unadapted mixture components in the tested simple mixtures.",
      "limitations": ["The water-soluble simple mixtures were not finished perfumes.", "Identification effects do not establish liking, richness, or depth."],
      "applicability": ["Supports component omission and adaptation hypotheses and the need for dynamic controls."],
