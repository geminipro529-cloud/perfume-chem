  "target_identity": {
    "north_star": "La Nuit's cardamom-lavender tension drawn down a clearly legible cedar-vetiver vertical: literal pencil-dry cedar, rooty vetiver, and a smooth cedar-amber bridge with enough aromatic air to remain sensual rather than smoky, austere, or an undifferentiated woody wall.",
    "functional_architecture": [
      "cardamom and lavender remain the top-to-heart recognizer braid",
      "literal Virginia cedar and vetiver form a vertical rather than a flat woody mass",
      "Vertofix supplies the persistent vetiver-wood bridge",
      "Azarbre rounds the cedar transition without crystalline amber, smoke, leather, or oud"
    ],
    "protected_identity": [
      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "literal cedar-vetiver vertical strengthened by smooth cedar-amber continuity",
    "variant_socket": {
      "active_ppm_w_w": 66666.667,
      "current_raw_ul": 300,
      "target_allocation": {
        "Cedarwood Virginia increment": 22000,
        "Vetiver Haiti increment": 18000,
        "Vertofix Coeur increment": 10000,
        "Azarbre": 8000,
        "Hedione increment": 4666.6666,
        "Cardamom increment": 4000
      },
      "current_allocation_ul": {
        "Cedarwood oil Virginia": 80,
        "Indian Vetiver EO (volume grade)": 60,
        "Vertofix": 50,
        "Azarbre": 60,
        "Hedione": 30,
        "Cardamom EO": 20
      }
    },
    "selection_rationale": [
      "Virginia cedar is retained for literal identity, while Vertofix carries the low-VP cedar/vetiver idea through time; neither is silently treated as the other.",
      "Indian Vetiver maps the target Haitian-vetiver function with an explicit origin/grade loss and is paired with cedar because both are dry woody-terpenic naturals.",
      "Azarbre was selected over Amberwood F for a warmer rounded cedar bridge; Timberol was rejected as too rigid, Kephalis as too tobacco-dark, and smoke/leather/oud materials as genre-changing.",
      "Hedione and the protected cardamom-lavender braid prevent woody austerity; EB stays the sole musk."
    ],
    "drift_risk": "Excess dry wood, Kephalis, smoke, leather, oud, or amberwood mass would erase the aromatic heart and turn the vertical into austerity or a generic woody wall."
  },
