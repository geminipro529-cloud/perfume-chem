{
  "perfume_id": "DHI12",
  "profile": {
    "perfume": "Dior Homme Intense — 2011 lineage / 2012 target",
    "house": "Dior",
    "scope": "A 2012 bottle or batch from the 2011-lineage Dior Homme Intense. Current Dior information supports iris, ambrette and Virginia cedar; the 2011/2012 lavender, pear and vetiver architecture is secondary historical evidence and must remain version-scoped.",
    "baseline_formula_id": "CB120-DIOR-H05-0346E1E846",
    "baseline_rows": 58,
    "baseline_complexity": "COMPLEX",
    "baseline_state": "COMPUTATIONAL CANDIDATE / ZERO EMPIRICAL SIMILARITY PASS",
    "official_summary": "Masculine iris, sensual amber, precious woods; Ecuadorian ambrette gives musky-fruity pear-liqueur and silk-talc facets; Virginia cedar supports the base.",
    "target_identity": "Tailored lavender-cool iris moving into a pear-ambrette silk-talc halo, then dry cedar-vetiver and intimate musky warmth.",
    "hedonic_tension": "Cosmetic softness versus tailored masculine dryness.",
    "source_urls": [
      "https://www.dior.com/en_th/beauty/products/dior-homme-intense-Y0479201.html",
      "https://www.fragrantica.com/perfume/Dior/Dior-Homme-Intense-2011-13016.html"
    ],
    "authority_note": "Current official source plus secondary historical version evidence; exact 2012 batch formula is not available."
  },
  "art_direction": {
    "art_title": "Tailored Silk Iris",
    "primary_motif": "A cool lavender-cut iris suit whose lining turns into pear-ambrette silk.",
    "secondary_motif": "A cacao-coffee amber shadow that appears only after the iris has become tactile.",
    "foreground": "Lavender tailoring, waxy iris, a pear-liquor glint and dry cedar grain.",
    "background": "Soft floral air, warm amber, faint cocoa, intimate macrocyclic skin.",
    "tension": "Cosmetic softness versus masculine tailoring.",
    "release": "The powder is dried by cedar and vetiver; the fruit melts into musk rather than remaining a note.",
    "negative_space": "Hedione, muguet air and restrained transparent wood keep the iris from becoming mauve paste.",
    "recurrence": "The pear impression vanishes after the opening, then returns as a fatty-fruity musk sheen in the late heart.",
    "texture_progression": "cold aromatic cloth → silk talc → waxy iris → cocoa suede → dry cedar skin",
    "spatial_identity": "Detailed and cool at close range; a smoother iris-musk aura at one arm’s length.",
    "late_residue": "Dry cedar-vetiver, orris wax, soft tonka and a skin-bound metallic-clean musk whisper.",
    "controlled_imperfection": "A hairline bitterness from petitgrain and a dark coffee-cocoa grain prevent cosmetic prettiness from becoming sterile.",
    "hedonic_hypothesis": "Desire comes from tactile luxury and contrast: the scent feels dressed, then unexpectedly intimate.",
    "forbidden": [
      "lipstick bomb",
      "pear shampoo",
      "laundry musk fog",
      "green carrot iris",
      "sweet cacao dessert",
      "generic Iso E cloud"
    ],
    "layers": [
      [
        "I. Tailored ignition",
        "Bergamot, high-altitude lavender, petitgrain, cool spice and aldehydic cloth-shimmer."
      ],
      [
        "II. Iris recognizer",
        "Distributed irone, orris product basis, Orivone, Irotyl, Koavone and violet-ionone geometries."
      ],
      [
        "III. Silk halo",
        "Pear/green-fruit traces and a multi-class musk architecture produce silk-talc rather than candy."
      ],
      [
        "IV. Amber shadow",
        "Cocoa, coffee, coumarin, tonka and restrained benzoin darken the iris without becoming gourmand."
      ],
      [
        "V. Structural tailoring",
        "Two cedars, vetiver routes, transparent woods and sandalwood turn softness into a masculine silhouette."
      ],
      [
        "VI. Refrain",
        "Orris wax, musk skin, hay and suede persist after the fruit and lavender are gone."
      ]
    ],
    "hedonic_tuning": [
      "Habanolide leads diffusion, while Zenolide, Exaltolide and Ambrettolide divide softness, skin and persistence instead of forming one laundry wall.",
      "Pear is distributed across ester, green and lactonic routes so no single shampoo ester owns the effect.",
      "Cacao and coffee are kept below the threshold of literal food; their job is grain, shade and sensual warmth.",
      "Cedar and vetiver are deliberately multi-source and multi-speed so the drydown feels tailored rather than merely woody."
    ]
  },
