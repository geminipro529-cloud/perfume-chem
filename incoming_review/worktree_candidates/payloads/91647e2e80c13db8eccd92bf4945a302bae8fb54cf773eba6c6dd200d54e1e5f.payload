"""Offline tests for the OpenAI-only local response cache."""

from __future__ import annotations

import email.message
import io
import json
import pathlib
import sys
import urllib.error
from contextlib import contextmanager
from unittest import mock

import pytest

_REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))


@pytest.fixture
def isolated_cache(tmp_path, monkeypatch):
    cache_dir = tmp_path / "llm_cache"
    cache_dir.mkdir(parents=True, exist_ok=True)
    monkeypatch.setenv("LLM_CACHE_DIR", str(cache_dir))
    if "engine.llm_cache" in sys.modules:
        del sys.modules["engine.llm_cache"]
    import engine.llm_cache as module

    assert pathlib.Path(module.CACHE_DIR) == cache_dir
    yield module
    if "engine.llm_cache" in sys.modules:
        del sys.modules["engine.llm_cache"]


def _fake_response(content: str = "ok") -> dict:
    return {
        "choices": [{"message": {"role": "assistant", "content": content}}],
        "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 10,
            "total_tokens": 110,
            "prompt_tokens_details": {"cached_tokens": 25},
        },
    }


@contextmanager
def _mock_urlopen(return_value: dict):
    call_count = {"n": 0}
    requests = []
    response_bytes = json.dumps(return_value).encode("utf-8")

    class _FakeContext:
        def __enter__(self):
            return self

        def __exit__(self, *exc):
            return False

        def read(self):
            return response_bytes

    def _fake_urlopen(request, timeout=None):
        del timeout
        call_count["n"] += 1
        requests.append(request)
        return _FakeContext()

    with mock.patch("urllib.request.urlopen", side_effect=_fake_urlopen) as patched:
        yield patched, call_count, requests


def _call(module, **overrides):
    args = {
        "model": "gpt-test",
        "messages": [{"role": "user", "content": "hello"}],
        "temperature": 0.0,
        "max_tokens": 4000,
    }
    args.update(overrides)
    return module.cached_chat(**args)


def test_provider_registry_is_openai_only(isolated_cache):
    module = isolated_cache
    assert set(module.PROVIDERS) == {"openai"}
    config = module.PROVIDERS["openai"]
    assert config.base_url == "https://api.openai.com/v1"
    assert config.api_key_env == "OPENAI_API_KEY"


def test_cache_key_is_deterministic_and_sensitive(isolated_cache):
    module = isolated_cache
    normalized = module._normalize_messages([{"role": "user", "content": "u"}])
    args = ("openai", "gpt-test", normalized, "", 0.0, 4000, 1.0, "auto", None, "auto")
    assert module._cache_key(*args) == module._cache_key(*args)
    changed = ("openai", "gpt-test", normalized, "", 0.7, 4000, 1.0, "auto", None, "auto")
    assert module._cache_key(*args) != module._cache_key(*changed)


def test_normalize_messages_keeps_historical_system_first_order(isolated_cache):
    module = isolated_cache
    messages = [
        {"role": "user", "content": "u"},
        {"role": "system", "content": "s1"},
        {"role": "assistant", "content": "a"},
        {"role": "system", "content": "s2"},
    ]
    parsed = json.loads(module._normalize_messages(messages))
    assert [message["role"] for message in parsed] == [
        "system",
        "system",
        "user",
        "assistant",
    ]
    assert [message["content"] for message in parsed[:2]] == ["s1", "s2"]


def test_payload_omits_legacy_thinking_envelope(isolated_cache):
    module = isolated_cache
    payload = module._build_payload(
        model="gpt-test",
        messages=[{"role": "user", "content": "x"}],
        temperature=0.0,
        max_tokens=100,
        top_p=1.0,
        thinking_mode="enabled",
        response_format=None,
        tools=None,
        service_tier="auto",
    )
    assert "thinking" not in payload
    assert payload["model"] == "gpt-test"


def test_unsupported_provider_fails_before_network(isolated_cache):
    module = isolated_cache
    with mock.patch("urllib.request.urlopen") as urlopen:
        with pytest.raises(ValueError, match="Only provider='openai'"):
            _call(module, provider="not-openai")
    urlopen.assert_not_called()


def test_cache_miss_then_hit_uses_openai_endpoint_once(monkeypatch, isolated_cache):
    module = isolated_cache
    monkeypatch.setenv("OPENAI_API_KEY", "test-key")
    with _mock_urlopen(_fake_response("hi")) as (_patched, calls, requests):
        first = _call(module)
        second = _call(module)

    assert first == second
    assert first["choices"][0]["message"]["content"] == "hi"
    assert calls["n"] == 1
    assert requests[0].full_url == "https://api.openai.com/v1/chat/completions"
    assert json.loads(requests[0].data)["model"] == "gpt-test"
    stats = module.get_stats()
    assert stats["hits"] == 1
    assert stats["misses"] == 1
    assert stats["cached_input_tokens"] == 25


def test_positive_temperature_bypasses_cache(monkeypatch, isolated_cache):
    module = isolated_cache
    monkeypatch.setenv("OPENAI_API_KEY", "test-key")
    with _mock_urlopen(_fake_response()) as (_patched, calls, _requests):
        _call(module, temperature=0.7)
        _call(module, temperature=0.7)

    assert calls["n"] == 2
    assert module.get_stats()["cache_entries"] == 0
    assert module.get_stats()["nocache_calls"] == 2


def test_expired_cache_entry_is_refreshed(monkeypatch, isolated_cache):
    module = isolated_cache
    monkeypatch.setenv("OPENAI_API_KEY", "test-key")
    with _mock_urlopen(_fake_response("v1")):
        _call(module)

    conn = module._connect()
    try:
        conn.execute("UPDATE cache SET created_at = '2000-01-01T00:00:00+00:00'")
    finally:
        conn.close()

    with _mock_urlopen(_fake_response("v2")) as (_patched, calls, _requests):
        refreshed = _call(module)
    assert calls["n"] == 1
    assert refreshed["choices"][0]["message"]["content"] == "v2"


def test_openai_http_error_is_not_cached(monkeypatch, isolated_cache):
    module = isolated_cache
    monkeypatch.setenv("OPENAI_API_KEY", "test-key")

    def _raise_http_error(request, timeout=None):
        del request, timeout
        raise urllib.error.HTTPError(
            url="https://api.openai.com/v1/chat/completions",
            code=401,
            msg="Unauthorized",
            hdrs=email.message.Message(),
            fp=io.BytesIO(b'{"error":"bad key"}'),
        )

    with mock.patch("urllib.request.urlopen", side_effect=_raise_http_error):
        with pytest.raises(RuntimeError, match="OpenAI returned HTTP 401"):
            _call(module)
    assert module.get_stats()["cache_entries"] == 0


def test_no_embedded_pricing_reports_zero_estimate(isolated_cache):
    module = isolated_cache
    assert module._estimate_savings("openai", "gpt-test", 100, 10, 25, "auto") == 0.0


def test_inspect_and_clear_cache(monkeypatch, isolated_cache):
    module = isolated_cache
    monkeypatch.setenv("OPENAI_API_KEY", "test-key")
    with _mock_urlopen(_fake_response()):
        _call(module)

    rows = module.inspect_cache(model="gpt-test", provider="openai")
    assert len(rows) == 1
    assert rows[0]["provider"] == "openai"
    assert rows[0]["model"] == "gpt-test"
    assert "response" not in rows[0]
    assert module.clear_cache(provider="openai") == 1
    assert module.get_stats()["cache_entries"] == 0
