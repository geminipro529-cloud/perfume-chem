{
  "schema_version": "complexity_construct_registry_v1",
  "constructs": [
    {
      "construct_id": "LIKING",
      "definition": "Scoped affective preference for one coded sample over another under the declared protocol, population, matrix, exposure, and time window.",
      "anchors": ["prefer left", "no preference", "prefer right"],
      "outcome_vocabulary": ["LEFT", "RIGHT", "NO_PREFERENCE", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "population", "matrix", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["beauty", "target fidelity", "richness", "depth", "safety", "release"]
    },
    {
      "construct_id": "PERCEIVED_RICHNESS",
      "definition": "Declared sensory judgment of differentiated yet integrated perceptual content; it is not ingredient count or chemical peak count.",
      "anchors": ["sparse or undifferentiated", "moderately differentiated", "richly differentiated and integrated"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "matrix", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "ingredient-count complexity", "chemical complexity", "safety", "release"]
    },
    {
      "construct_id": "PERCEIVED_DEPTH",
      "definition": "Declared sensory judgment of foreground-background, layering, persistence, and relational dimensionality within a time window.",
      "anchors": ["flat", "some foreground-background separation", "deeply layered"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "time_window", "protocol_sha256", "sample_sha256"],
      "forbidden_inferences": ["liking", "material count", "longevity", "safety", "release"]
    },
    {
      "construct_id": "CONFIGURATIONAL_INTEGRATION",
      "definition": "Declared perception that mixture elements form a coherent configuration rather than separately identifiable independent components.",
      "anchors": ["disjoint components", "partly integrated", "coherent configuration"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "mixture_identity", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "synergy mechanism", "molecular interaction", "safety", "release"]
    },
    {
      "construct_id": "HIERARCHY_CONTRAST",
      "definition": "Declared perceptual separation and relation among focal, supporting, and background functions at constant total composition.",
      "anchors": ["no discernible hierarchy", "moderate hierarchy", "clear focal-support-background hierarchy"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "constant_total_receipt", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "ingredient quality", "formula authority", "safety", "release"]
    },
    {
      "construct_id": "TEMPORAL_DIFFERENTIATION",
      "definition": "Observed or declared change in prespecified sensory endpoints across qualified, matched timepoints.",
      "anchors": ["no supported transition", "one supported transition", "multiple supported transitions"],
      "outcome_vocabulary": ["OBSERVED", "MISSING", "CONFLICTED", "PROTOCOL_HOLD"],
      "required_scope_fields": ["protocol_sha256", "sample_sha256", "assessor_id", "repeat_id", "timepoint", "endpoint"],
      "forbidden_inferences": ["predicted volatility as perception", "interpolated observations", "liking", "safety", "release"]
    },
    {
      "construct_id": "TARGET_FIDELITY",
      "definition": "Scoped judgment of correspondence to a frozen target identity or reference under the declared comparison protocol.",
      "anchors": ["poor match", "partial match", "close match"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE"],
      "required_scope_fields": ["target_sha256", "criterion_wording_sha256", "assessor_id", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "richness", "depth", "formula identity truth", "release"]
    },
    {
      "construct_id": "INTENSITY",
      "definition": "Declared perceived strength for one named sensory endpoint in one matrix and time window.",
      "anchors": ["not perceived", "moderate", "extremely strong"],
      "outcome_vocabulary": ["RATING", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["endpoint", "scale", "matrix", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "contribution percentage", "beauty", "safety", "release"]
    },
    {
      "construct_id": "FAMILIARITY",
      "definition": "Declared subjective familiarity with a coded odor presentation under the frozen wording and population.",
      "anchors": ["not familiar", "somewhat familiar", "very familiar"],
      "outcome_vocabulary": ["RATING", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "population", "sample_sha256", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "identity correctness", "quality", "safety", "release"]
    },
    {
      "construct_id": "DETECTABILITY",
      "definition": "Protocol-scoped ability to discriminate a declared stimulus contrast; it is distinct from preference and perceived intensity.",
      "anchors": ["not discriminated", "discriminated"],
      "outcome_vocabulary": ["CORRECT", "INCORRECT", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["contrast_sha256", "chance_baseline", "matrix", "exposure", "protocol_sha256"],
      "forbidden_inferences": ["liking", "no preference", "richness", "depth", "safety", "release"]
    },
    {
      "construct_id": "WANTING_TO_RESMELL",
      "definition": "Criterion-specific desire for another exposure to the same coded odor after the declared number, spacing, and duration of prior exposures; it is motivational and is not the same response as current liking.",
      "anchors": ["do not want another exposure", "indifferent about another exposure", "strongly want another exposure"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "sample_sha256", "exposure_schedule_sha256", "exposure_count", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "wear acceptance", "fascination", "purchase intent", "beauty", "release"]
    },
    {
      "construct_id": "WEAR_ACCEPTANCE",
      "definition": "Willingness to wear the exact coded sample under a declared body site, dose, duration, social setting, climate, and wearer/body-odor context after an actual qualified wear exposure.",
      "anchors": ["would not wear in the declared context", "uncertain or context-dependent", "would willingly wear in the declared context"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "wearer_id", "sample_sha256", "body_odor_context_sha256", "application_protocol_sha256", "wear_context_sha256", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["immediate strip liking", "universal wearability", "purchase intent", "safety", "stability", "release"]
    },
    {
      "construct_id": "COMFORT",
      "definition": "Reported affective and perceptual ease during a declared exposure, including softness or non-taxing character, measured independently from liking, familiarity, and physical safety.",
      "anchors": ["uncomfortable or taxing", "neutral", "deeply comfortable"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "sample_sha256", "exposure_schedule_sha256", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "familiarity", "safety", "non-irritancy", "therapeutic effect", "release"]
    },
    {
      "construct_id": "FASCINATION",
      "definition": "Sustained attentional pull, curiosity, or desire to inspect changing facets under a declared observation interval; fascination may coexist with tension or lower comfort and is not liking by another name.",
      "anchors": ["no attentional pull", "some curiosity", "sustained compelling attention"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "sample_sha256", "observation_interval_sha256", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "wanting-to-resmell", "complexity", "quality", "purchase intent", "release"]
    },
    {
      "construct_id": "TENSION",
      "definition": "Experienced unresolved contrast, pressure, instability, or expectancy within a declared temporal segment; it can be intentional, compelling, neutral, or aversive and therefore carries no fixed hedonic sign.",
      "anchors": ["no experienced tension", "moderate unresolved tension", "strong unresolved tension"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "sample_sha256", "endpoint", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["liking", "aversion", "failure", "fascination", "formula mechanism", "release"]
    },
    {
      "construct_id": "RELIEF",
      "definition": "Experienced release or resolution following a prespecified earlier tension observation in the same qualified temporal sequence; a static low-tension rating is not relief.",
      "anchors": ["no experienced resolution", "partial release", "strong experienced release"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "sample_sha256", "antecedent_tension_cell_sha256", "transition_window_sha256", "protocol_sha256"],
      "forbidden_inferences": ["liking", "comfort", "low intensity", "formula mechanism", "therapeutic effect", "release"]
    },
    {
      "construct_id": "FATIGUE",
      "definition": "Reported perceptual or evaluative weariness after a declared cumulative exposure schedule; it must be distinguished from adaptation, loss of detectability, boredom, irritation, and declining wanting.",
      "anchors": ["no fatigue", "moderate fatigue", "severe fatigue"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "sample_sha256", "exposure_schedule_sha256", "cumulative_exposure", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["adaptation", "detectability", "liking", "wanting-to-resmell", "irritation", "safety", "release"]
    },
    {
      "construct_id": "AVERSION",
      "definition": "Criterion-specific negative evaluation or avoidance response to the coded sample under the declared context; it is retained explicitly instead of being inferred from a low liking utility.",
      "anchors": ["no aversion", "moderate avoidance", "strong aversion"],
      "outcome_vocabulary": ["LOWER", "TIE", "HIGHER", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["criterion_wording_sha256", "assessor_id", "sample_sha256", "exposure_context_sha256", "time_window", "protocol_sha256"],
      "forbidden_inferences": ["one minus liking", "irritation", "toxicity", "safety", "universal rejection", "release"]
    },
    {
      "construct_id": "PERSISTENCE",
      "definition": "Continued observed perception of one prespecified sensory endpoint across qualified, matched timepoints for the exact sample and application context.",
      "anchors": ["endpoint absent", "endpoint intermittently or weakly present", "endpoint clearly present"],
      "outcome_vocabulary": ["OBSERVED", "MISSING", "CONFLICTED", "CANNOT_JUDGE", "PROTOCOL_ABORT"],
      "required_scope_fields": ["endpoint", "sample_sha256", "application_protocol_sha256", "assessor_id", "repeat_id", "timepoint", "protocol_sha256"],
      "forbidden_inferences": ["modeled volatility", "boiling point", "vapor pressure", "OAV trajectory", "longevity claim", "liking", "release"]
    }
  ],
  "authority_flags": {
    "formula": false,
    "inventory_mutation": false,
    "liking": false,
    "physical_execution": false,
    "publication": false,
    "purchase": false,
    "release": false,
    "runtime": false,
    "safety": false,
    "scientific_claim": false,
    "sensory": false
  }
}
