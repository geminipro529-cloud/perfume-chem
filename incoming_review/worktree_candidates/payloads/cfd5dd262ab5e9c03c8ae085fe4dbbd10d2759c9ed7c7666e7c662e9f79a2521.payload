]


def _build_profile(entry: dict[str, object]) -> CreativeDirectionProfile:
    family = str(entry["family"])
    base = FAMILY_BASES[family]
    return CreativeDirectionProfile(
        family=family,
        slug=str(entry["slug"]),
        label=str(entry["label"]),
        interpretations=tuple(entry["interpretations"]),  # type: ignore[arg-type]
        description=str(entry["description"]),
        anchor_materials=_merge_tuple_fields(
            base.get("anchor_materials", ()),
            entry.get("anchor_materials"),
        ),
        bridge_materials=_merge_tuple_fields(
            base.get("bridge_materials", ()),
            entry.get("bridge_materials"),
        ),
        accent_materials=_merge_tuple_fields(
            base.get("accent_materials", ()),
            entry.get("accent_materials"),
        ),
        avoid_materials=_merge_tuple_fields(
            base.get("avoid_materials", ()),
            entry.get("avoid_materials"),
        ),
        preferred_axes=_merge_tuple_fields(
            base.get("preferred_axes", ()),
            entry.get("preferred_axes"),
        ),
        observation_signals=_merge_tuple_fields(
            base.get("observation_signals", ()),
            entry.get("observation_signals"),
        ),
        preferred_modes=tuple(
            entry.get("preferred_modes", base.get("preferred_modes", ()))  # type: ignore[arg-type]
        ),
        mode_notes=_merge_mapping(
            base.get("mode_notes", {}),
            entry.get("mode_notes"),  # type: ignore[arg-type]
        ),
        signal_materials=_merge_mapping(
            base.get("signal_materials", {}),
            entry.get("signal_materials"),  # type: ignore[arg-type]
        ),
        signal_notes=_merge_mapping(
            base.get("signal_notes", {}),
            entry.get("signal_notes"),  # type: ignore[arg-type]
        ),
    )


def _build_rule(entry: dict[str, object]) -> ObservationInterventionRule:
    return ObservationInterventionRule(
        signal=str(entry["signal"]),
        label=str(entry["label"]),
        action=str(entry["action"]),
        description=str(entry["description"]),
        family_bias=tuple(entry.get("family_bias", ())),  # type: ignore[arg-type]
        preferred_axes=tuple(entry.get("preferred_axes", ())),  # type: ignore[arg-type]
        materials=tuple(entry.get("materials", ())),  # type: ignore[arg-type]
        avoid_materials=tuple(entry.get("avoid_materials", ())),  # type: ignore[arg-type]
        modes=tuple(entry.get("modes", ("pre_mix", "between_mix", "post_mix"))),  # type: ignore[arg-type]
        dose_style=str(entry.get("dose_style", "bridge")),
        notes=tuple(entry.get("notes", ())),  # type: ignore[arg-type]
    )


CREATIVE_DIRECTION_PROFILES: dict[str, tuple[CreativeDirectionProfile, ...]] = {}
PROFILE_INDEX: dict[str, CreativeDirectionProfile] = {}
PROFILE_ALIAS_INDEX: dict[str, CreativeDirectionProfile] = {}

for entry in PROFILE_VARIANTS:
    profile = _build_profile(entry)
    CREATIVE_DIRECTION_PROFILES[profile.family] = CREATIVE_DIRECTION_PROFILES.get(profile.family, ()) + (profile,)
    PROFILE_INDEX[profile.slug] = profile
    PROFILE_ALIAS_INDEX[_slugify(profile.label)] = profile
    PROFILE_ALIAS_INDEX[_slugify(profile.slug)] = profile
    for interpretation in profile.interpretations:
        PROFILE_ALIAS_INDEX[_slugify(interpretation)] = profile

OBSERVATION_RULES_BY_SIGNAL: dict[str, tuple[ObservationInterventionRule, ...]] = {}
for entry in OBSERVATION_RULES:
    rule = _build_rule({
        "signal": entry.signal,
        "label": entry.label,
        "action": entry.action,
        "description": entry.description,
        "family_bias": entry.family_bias,
        "preferred_axes": entry.preferred_axes,
        "materials": entry.materials,
        "avoid_materials": entry.avoid_materials,
        "modes": entry.modes,
        "dose_style": entry.dose_style,
        "notes": entry.notes,
    })
    OBSERVATION_RULES_BY_SIGNAL[rule.signal] = OBSERVATION_RULES_BY_SIGNAL.get(rule.signal, ()) + (rule,)


def _best_material_matches(values: Iterable[str], candidates: Iterable[str]) -> tuple[str, ...]:
    selected: list[str] = []
    available = list(candidates)
    for value in values:
        if any(_name_matches(value, item) for item in available):
            selected.append(value)
    return _dedupe(selected)


def _profile_materials_for_mode(
    profile: CreativeDirectionProfile,
    signal: str,
    mode: InterventionMode,
) -> tuple[str, ...]:
    materials: list[str] = list(profile.signal_materials.get(signal, ()))
    if mode == "pre_mix":
        materials.extend(profile.bridge_materials)
        materials.extend(profile.accent_materials)
    elif mode == "between_mix":
        materials.extend(profile.bridge_materials)
        materials.extend(profile.anchor_materials)
    else:
        materials.extend(profile.anchor_materials)
        materials.extend(profile.signal_materials.get(signal, ()))
    return _dedupe(materials)


def _rule_materials_for_mode(
    rule: ObservationInterventionRule,
    mode: InterventionMode,
) -> tuple[str, ...]:
    if mode not in rule.modes:
        return ()
    return rule.materials


def _score_candidate(
    signal: str,
    rule: ObservationInterventionRule,
    profile: CreativeDirectionProfile | None,
    family_key: str | None,
    mode: InterventionMode,
    available_materials: Iterable[str] | None,
    materials: tuple[str, ...],
) -> float:
    score = 0.35
    if profile is not None:
        if family_key and profile.family == family_key:
            score += 0.25
        if signal in profile.observation_signals:
            score += 0.15
        if mode in profile.preferred_modes:
            score += 0.10
        if signal in profile.signal_materials:
            score += 0.05
    if family_key and family_key in rule.family_bias:
        score += 0.10
    elif not rule.family_bias:
        score += 0.05
    if signal in rule.preferred_axes:
        score += 0.05
    if available_materials:
        filtered = _best_material_matches(materials, available_materials)
        if filtered:
            coverage = len(filtered) / max(len(materials), 1)
            score += min(coverage * 0.10, 0.10)
    return round(min(score, 1.0), 3)


FAMILY_INDEX: dict[str, tuple[CreativeDirectionProfile, ...]] = CREATIVE_DIRECTION_PROFILES


def get_family_profiles(family: str | None) -> tuple[CreativeDirectionProfile, ...]:
    """Return all profiles for a normalized family key."""
    family_key = normalize_family_key(family)
    if family_key is None:
        return ()
    return CREATIVE_DIRECTION_PROFILES.get(family_key, ())


def iter_profiles(family: str | None = None):
    """Yield profiles, optionally filtered to one family."""
    if family is None:
        for profiles in CREATIVE_DIRECTION_PROFILES.values():
            for profile in profiles:
                yield profile
        return
    for profile in get_family_profiles(family):
        yield profile


def get_profile(query: str | None) -> CreativeDirectionProfile | None:
    """Resolve a profile by slug, family label, label, or interpretation."""
    if query is None:
        return None
    raw = query.strip()
    if not raw:
        return None

    key = _slugify(raw)
    if key in PROFILE_INDEX:
        return PROFILE_INDEX[key]
    family = normalize_family_key(raw)
    if family and family in CREATIVE_DIRECTION_PROFILES:
        profiles = CREATIVE_DIRECTION_PROFILES[family]
        return profiles[0] if profiles else None
    if key in PROFILE_ALIAS_INDEX:
        return PROFILE_ALIAS_INDEX[key]
    return None


def search_profiles(
    query: str | None,
    family: str | None = None,
    limit: int = 10,
) -> list[CreativeDirectionProfile]:
    """Search profiles by label, slug, family, or interpretation text."""
    if query is None:
        return []
    raw = query.strip().lower()
    if not raw:
        return []

    family_key = normalize_family_key(family)
    tokens = [token for token in re.split(r"[^a-z0-9]+", raw) if token]
    results: list[tuple[float, CreativeDirectionProfile]] = []

    for profile in iter_profiles(family_key):
        text = " ".join(
            [
                profile.slug,
                profile.label,
                profile.family,
                profile.description,
                " ".join(profile.interpretations),
            ]
        ).lower()
        score = 0.0
        if raw in text:
            score += 3.0
        score += sum(0.5 for token in tokens if token in text)
        if family_key and profile.family == family_key:
            score += 1.0
        if score > 0:
            results.append((score, profile))

    results.sort(key=lambda item: (-item[0], item[1].label))
    return [profile for _, profile in results[:limit]]


def match_profiles(
    query: str | None,
    family: str | None = None,
    limit: int = 5,
) -> list[CreativeDirectionProfile]:
    """Alias for search_profiles, kept for easier downstream integration."""
    return search_profiles(query, family=family, limit=limit)


def family_names() -> tuple[str, ...]:
    """Return the available family slugs."""
    return tuple(CREATIVE_DIRECTION_PROFILES.keys())


def summarize_family(family: str) -> dict[str, object]:
    """Return a compact summary of one family and its profiles."""
    family_key = normalize_family_key(family)
    profiles = CREATIVE_DIRECTION_PROFILES.get(family_key or "", ())
    return {
        "family": family_key,
        "label": FAMILY_BASES.get(family_key or "", {}).get("label", family_key),
        "profiles": [
            {
                "slug": profile.slug,
                "label": profile.label,
                "interpretations": profile.interpretations,
                "description": profile.description,
            }
            for profile in profiles
        ],
    }


def get_observation_rules(signal: str | None) -> tuple[ObservationInterventionRule, ...]:
    """Return rules for a normalized observation signal."""
    if signal is None:
        return ()
    key = normalize_observation_signal(signal)
    return OBSERVATION_RULES_BY_SIGNAL.get(key, ())


def iter_observation_rules():
    """Yield every observation rule in the registry."""
    for rules in OBSERVATION_RULES_BY_SIGNAL.values():
        for rule in rules:
            yield rule


def suggest_interventions(
    observations: Iterable[str] | str | None = None,
    family: str | None = None,
    profile: str | None = None,
    mode: str | InterventionMode = "pre_mix",
    available_materials: Iterable[str] | None = None,
    limit: int = 5,
) -> list[InterventionRecommendation]:
    """Generate stage-aware intervention recommendations.

    The function is intentionally conservative:
      - it does not mutate formulas
      - it returns structured suggestions only
      - it can be used for pre_mix, between_mix, or post_mix contexts
    """
    mode_key = normalize_intervention_mode(mode)
    signals = normalize_observation_signals(observations)
    family_key = normalize_family_key(family)
    profile_obj = get_profile(profile) if profile else None

    if profile_obj is not None and family_key is None:
        family_key = profile_obj.family

    candidate_profiles: list[CreativeDirectionProfile]
    if profile_obj is not None:
        candidate_profiles = [profile_obj]
    elif family_key is not None:
        candidate_profiles = list(get_family_profiles(family_key))
    else:
        candidate_profiles = list(iter_profiles())

    if not candidate_profiles:
        candidate_profiles = list(iter_profiles())

    recommendations: list[InterventionRecommendation] = []
    seen: set[tuple[str, str | None, str | None, tuple[str, ...]]] = set()

    for signal in signals:
        rules = get_observation_rules(signal)
        if not rules:
            continue

        for rule in rules:
            if mode_key not in rule.modes:
                continue
            if family_key and rule.family_bias and family_key not in rule.family_bias:
                family_rule_ok = False
                if profile_obj is not None and profile_obj.family == family_key:
                    family_rule_ok = True
                if not family_rule_ok:
                    continue

            for candidate in candidate_profiles:
                if family_key and candidate.family != family_key and profile_obj is None:
                    if rule.family_bias and candidate.family not in rule.family_bias:
                        continue

                materials = list(_rule_materials_for_mode(rule, mode_key))
                materials.extend(_profile_materials_for_mode(candidate, signal, mode_key))
                materials = list(_dedupe(materials))
                if available_materials is not None:
                    filtered = _best_material_matches(materials, available_materials)
                    materials = list(filtered)
                if not materials:
                    continue

                key = (mode_key, candidate.family, candidate.slug, tuple(materials))
                if key in seen:
                    continue
                seen.add(key)

                notes = _merge_tuple_fields(
                    rule.notes,
                    candidate.mode_notes.get(mode_key, ()),
                    candidate.signal_notes.get(signal, ()),
                )
                rationale_bits = [
                    rule.description,
                    candidate.description,
                ]
                if notes:
                    rationale_bits.append(notes[0])
                if candidate.interpretations:
                    rationale_bits.append(
                        "Interpretations: " + ", ".join(candidate.interpretations[:3])
                    )
                confidence = _score_candidate(
                    signal,
                    rule,
                    candidate,
                    family_key,
                    mode_key,
                    available_materials,
                    tuple(materials),
                )
                recommendations.append(
                    InterventionRecommendation(
                        family=candidate.family,
                        profile=candidate.slug,
                        profile_label=candidate.label,
                        signal=signal,
                        mode=mode_key,
                        action=rule.action,
                        materials=tuple(materials),
                        rationale=" ".join(rationale_bits),
                        confidence=confidence,
                        dose_style=rule.dose_style,
                        matched_signals=(signal,),
                        notes=notes,
                    )
                )

    recommendations.sort(
        key=lambda item: (
            -item.confidence,
            item.family or "",
            item.profile or "",
            item.action,
        )
    )
    return recommendations[:limit]


