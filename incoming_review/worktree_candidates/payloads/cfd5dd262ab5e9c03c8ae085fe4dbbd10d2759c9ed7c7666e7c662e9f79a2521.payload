def normalize_family_key(value: str | None) -> str | None:
    """Normalize family labels to stable slugs."""
    if value is None:
        return None
    raw = value.strip().lower()
    if not raw:
        return None
    if raw in _FAMILY_ALIASES:
        return _FAMILY_ALIASES[raw]
    key = _slugify(raw)
    return _FAMILY_ALIASES.get(key, key)


def normalize_observation_signal(value: str) -> str:
    """Normalize a free-text observation into a stable signal key."""
    raw = re.sub(r"\s+", " ", value.strip().lower())
    if raw in _OBSERVATION_ALIASES:
        raw = _OBSERVATION_ALIASES[raw]
    raw = normalize_observation_tag(raw)
    if raw in _OBSERVATION_ALIASES:
        raw = _OBSERVATION_ALIASES[raw]
    return raw


def normalize_observation_signals(
    values: Iterable[str] | str | None,
) -> list[str]:
    """Normalize and deduplicate observations from free text or a list."""
    if values is None:
        return []
    if isinstance(values, str):
        values = [values]
    normalized: list[str] = []
    seen: set[str] = set()
    for value in values:
        signal = normalize_observation_signal(value)
        if not signal or signal in seen:
            continue
        seen.add(signal)
        normalized.append(signal)
    return normalized


@dataclass(frozen=True, slots=True)
class CreativeDirectionProfile:
    """A perfume-family direction with several creative interpretations."""

    family: str
    slug: str
    label: str
    interpretations: tuple[str, ...]
    description: str
    anchor_materials: tuple[str, ...] = ()
    bridge_materials: tuple[str, ...] = ()
    accent_materials: tuple[str, ...] = ()
    avoid_materials: tuple[str, ...] = ()
    preferred_axes: tuple[str, ...] = ()
    observation_signals: tuple[str, ...] = ()
    preferred_modes: tuple[InterventionMode, ...] = (
        "pre_mix",
        "between_mix",
        "post_mix",
    )
    mode_notes: dict[InterventionMode, tuple[str, ...]] = field(default_factory=dict)
    signal_materials: dict[str, tuple[str, ...]] = field(default_factory=dict)
    signal_notes: dict[str, tuple[str, ...]] = field(default_factory=dict)


@dataclass(frozen=True, slots=True)
class ObservationInterventionRule:
    """Generic observation -> intervention mapping."""

    signal: str
    label: str
    action: str
    description: str
    family_bias: tuple[str, ...] = ()
    preferred_axes: tuple[str, ...] = ()
    materials: tuple[str, ...] = ()
    avoid_materials: tuple[str, ...] = ()
    modes: tuple[InterventionMode, ...] = (
        "pre_mix",
        "between_mix",
        "post_mix",
    )
    dose_style: str = "bridge"
    notes: tuple[str, ...] = ()


@dataclass(frozen=True, slots=True)
class InterventionRecommendation:
    """Structured recommendation output for downstream rendering."""

    family: str | None
    profile: str | None
    profile_label: str | None
    signal: str
    mode: InterventionMode
    action: str
    materials: tuple[str, ...]
    rationale: str
    confidence: float
    dose_style: str = "bridge"
    matched_signals: tuple[str, ...] = ()
    notes: tuple[str, ...] = ()


