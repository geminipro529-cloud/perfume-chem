"""Creative direction profiles and intervention heuristics.

This module is intentionally data-oriented. It provides:
  - family-level creative direction profiles with multiple interpretations
  - observation-to-intervention heuristics for pre_mix, between_mix, post_mix
  - lookup helpers so the main agent can integrate this without reworking
    the existing recommendation stack

The module is standalone and does not modify any existing pipeline behavior.
It is designed to be imported by future recommendation surfaces, including
post-mix and between-mix workflows.
"""

from __future__ import annotations

import re
from dataclasses import dataclass, field
from typing import Iterable

from .intervention_context import (
    InterventionMode,
    normalize_intervention_mode,
    normalize_observation_tag,
)


def _slugify(text: str) -> str:
    raw = text.strip().lower()
    raw = re.sub(r"[^a-z0-9]+", "_", raw)
    raw = re.sub(r"_+", "_", raw).strip("_")
    return raw


def _dedupe(values: Iterable[str]) -> tuple[str, ...]:
    seen: set[str] = set()
    ordered: list[str] = []
    for value in values:
        item = value.strip()
        if not item:
            continue
        key = _slugify(item)
        if key in seen:
            continue
        seen.add(key)
        ordered.append(item)
    return tuple(ordered)


def _merge_tuple_fields(*parts: Iterable[str] | None) -> tuple[str, ...]:
    merged: list[str] = []
    for part in parts:
        if not part:
            continue
        merged.extend(part)
    return _dedupe(merged)


def _merge_mapping(
    base: dict[str, tuple[str, ...]] | None,
    override: dict[str, Iterable[str]] | None,
) -> dict[str, tuple[str, ...]]:
    merged: dict[str, tuple[str, ...]] = {}
    base = base or {}
    override = override or {}
    keys = set(base) | set(override)
    for key in keys:
        merged[key] = _merge_tuple_fields(base.get(key), override.get(key))
    return merged


def _material_key(name: str) -> str:
    return _slugify(name)


def _name_matches(candidate: str, target: str) -> bool:
    cand = _material_key(candidate)
    targ = _material_key(target)
    return cand == targ or cand in targ or targ in cand


