OBSERVATION_RULES: list[ObservationInterventionRule] = [
    ObservationInterventionRule(
        signal="top_fades_fast",
        label="Restore opening bloom",
        action="restore_opening_bloom",
        description=(
            "The opening disappears too quickly; add lift, top continuity, or a floral bridge."
        ),
        family_bias=("white_floral", "citrus_floral", "muguet", "aquatic"),
        preferred_axes=("freshness", "radiance", "diffusion"),
        materials=("Bergamot FCF oil Sicilian", "Cedrat FCF oil Sicilian", "Linalool"),
        dose_style="bridge",
        notes=("Post-mix use should be very small and delayed until the bottle settles.",),
    ),
    ObservationInterventionRule(
        signal="top_weak",
        label="Strengthen top note",
        action="strengthen_top_note",
        description=(
            "The opening is underpowered; reinforce the first impression without making it harsh."
        ),
        family_bias=("white_floral", "citrus_floral", "aquatic", "muguet"),
        preferred_axes=("freshness", "radiance"),
        materials=("Bergamot FCF oil Sicilian", "Aldehyde C10", "Linalool"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_sharp",
        label="Soften sharpness",
        action="soften_edge",
        description=(
            "The composition feels piercing, acidic, or overly citrus-bright."
        ),
        family_bias=("white_floral", "citrus_floral", "muguet", "iris", "aquatic"),
        preferred_axes=("diffusion", "softness", "texture"),
        materials=("Hedione", "Benzyl Salicylate", "Hydroxycitronellal", "Florol"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_sweet",
        label="Dry out sweetness",
        action="dry_out_sweetness",
        description=(
            "The sweet axis dominates; add dryness, lift, or a contrasting structural edge."
        ),
        family_bias=("gourmand", "amber", "skin_scent", "leather", "chypre"),
        preferred_axes=("structure", "contrast", "drydown"),
        materials=("Iso E Super", "Vetiver EO", "Patchouli EO", "Cedrat FCF oil Sicilian"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_heavy",
        label="Lighten density",
        action="lighten_density",
        description=(
            "The blend feels too dense or slow; open the composition and reintroduce air."
        ),
        family_bias=("amber", "gourmand", "leather", "chypre"),
        preferred_axes=("freshness", "radiance", "lift"),
        materials=("Bergamot FCF oil Sicilian", "Linalool", "Hedione", "Nympheal"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_flat",
        label="Add contour",
        action="add_contour",
        description=(
            "The formula has lost shape and needs a clearer silhouette or more contrast."
        ),
        family_bias=("white_floral", "iris", "muguet", "chypre", "gourmand"),
        preferred_axes=("structure", "contrast", "signature"),
        materials=("Peonile", "Heliotropal", "Evernyl", "Blackcurrant FTEC"),
        dose_style="structural",
    ),
    ObservationInterventionRule(
        signal="too_loud",
        label="Reduce projection",
        action="reduce_projection",
        description=(
            "The scent is too loud or too close to the skin for the intended brief."
        ),
        family_bias=("skin_scent", "amber", "woody"),
        preferred_axes=("texture", "softness", "skin"),
        materials=("Benzyl Salicylate", "Galaxolide (80%)", "Cashmeran (20%)", "Ambrox Super"),
        dose_style="micro",
    ),
    ObservationInterventionRule(
        signal="too_soft",
        label="Increase presence",
        action="increase_presence",
        description=(
            "The composition is too diffused or too weak in the center."
        ),
        family_bias=("skin_scent", "aquatic", "amber", "citrus_floral"),
        preferred_axes=("radiance", "diffusion", "presence"),
        materials=("Hedione", "Iso E Super", "Aldehyde C10", "Ambrox Super"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_powdery",
        label="Reduce powder",
        action="reduce_powder",
        description=(
            "The iris/powder impression overwhelms the rest of the structure."
        ),
        family_bias=("iris", "skin_scent", "muguet"),
        preferred_axes=("freshness", "clarity", "lift"),
        materials=("Dihydromyrcenol", "Bergamot FCF oil Sicilian", "Linalool", "Nympheal"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_soapy",
        label="Break soapiness",
        action="break_soapiness",
        description=(
            "The blend reads too soap-like or detergent-like."
        ),
        family_bias=("white_floral", "muguet", "skin_scent"),
        preferred_axes=("identity", "depth", "texture"),
        materials=("Jasmine FO", "Peonile", "Vetiver EO", "Labdanum Absolute (10%)"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_cosmetic",
        label="Make it more natural",
        action="make_more_natural",
        description=(
            "The profile feels overly cosmetic or makeup-like and needs more life."
        ),
        family_bias=("white_floral", "citrus_floral", "muguet", "iris"),
        preferred_axes=("freshness", "naturalness", "transparency"),
        materials=("Neroli EO", "Bergamot FCF oil Sicilian", "Freesia HDI", "Jasmine FO"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_woody",
        label="Open the wood",
        action="open_wood",
        description=(
            "The woody side dominates and the composition needs air or floral relief."
        ),
        family_bias=("white_floral", "citrus_floral", "muguet", "aquatic"),
        preferred_axes=("radiance", "lift", "contrast"),
        materials=("Hedione", "Neroli EO", "Hydroxycitronellal", "Peonile"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="too_musky",
        label="Clarify musk",
        action="clarify_musk",
        description=(
            "The musk effect is too thick or too dominant for the intended style."
        ),
        family_bias=("skin_scent", "iris", "muguet"),
        preferred_axes=("clarity", "freshness", "lift"),
        materials=("Bergamot FCF oil Sicilian", "Hydroxycitronellal", "Freesia HDI", "Linalool"),
        dose_style="micro",
    ),
    ObservationInterventionRule(
        signal="drydown_thin",
        label="Anchor the drydown",
        action="anchor_drydown",
        description=(
            "The base is too thin and needs a more convincing drydown anchor."
        ),
        family_bias=("amber", "leather", "chypre", "skin_scent", "gourmand", "iris"),
        preferred_axes=("depth", "longevity", "texture"),
        materials=(
            "Ambrox Super",
            "Labdanum Absolute (10%)",
            "Benzoin Sumatra Resinoid (10%)",
            "Patchouli EO",
            "Evernyl",
        ),
        dose_style="structural",
    ),
    ObservationInterventionRule(
        signal="drydown_heavy",
        label="Lighten the drydown",
        action="lighten_drydown",
        description=(
            "The base is too heavy, sticky, or resin-loaded."
        ),
        family_bias=("amber", "gourmand", "leather"),
        preferred_axes=("lift", "freshness", "radiance"),
        materials=("Hedione", "Linalool", "Bergamot FCF oil Sicilian", "Iso E Super"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="heart_thin",
        label="Inflate the heart",
        action="inflate_heart",
        description=(
            "The heart is underdeveloped and needs more body or bloom."
        ),
        family_bias=("white_floral", "citrus_floral", "muguet", "aquatic"),
        preferred_axes=("diffusion", "floral", "texture"),
        materials=("Hedione", "Benzyl Salicylate", "Nympheal", "Lilyreal ND", "Florol"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="heart_heavy",
        label="Thin the heart",
        action="thin_heart",
        description=(
            "The center feels too dense and needs more air between materials."
        ),
        family_bias=("white_floral", "citrus_floral", "muguet"),
        preferred_axes=("freshness", "lift", "radiance"),
        materials=("Linalool", "Bergamot FCF oil Sicilian", "Neroli EO", "Dihydromyrcenol"),
        dose_style="bridge",
    ),
    ObservationInterventionRule(
        signal="needs_lift",
        label="Add lift",
        action="add_lift",
        description=(
            "The formula needs more top sparkle or upward motion."
        ),
