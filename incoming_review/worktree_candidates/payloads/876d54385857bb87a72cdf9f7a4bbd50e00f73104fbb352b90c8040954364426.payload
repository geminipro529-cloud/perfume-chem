from __future__ import annotations

import hashlib
import json
from pathlib import Path

import pytest

from engine.inventory_parser import (
    CURRENT_USER_INVENTORY_AUTHORITY,
    CURRENT_USER_INVENTORY_OVERLAY_PATH,
    PREDECESSOR_USER_INVENTORY_OVERLAY_PATH,
    load_current_user_inventory_overlay,
    parse_current_inventory,
    parse_inventory,
)


ROOT = Path(__file__).resolve().parents[1]
INVENTORY = ROOT / "inventory.txt"


def _normalized_sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes().replace(b"\r\n", b"\n")).hexdigest()


def test_20260904_overlay_is_the_pinned_non_mutating_current_successor() -> None:
    assert CURRENT_USER_INVENTORY_OVERLAY_PATH.name == (
        "inventory_user_authority_overlay_20260904.json"
    )
    assert PREDECESSOR_USER_INVENTORY_OVERLAY_PATH.name == (
        "inventory_user_authority_overlay_20260901.json"
    )
    assert CURRENT_USER_INVENTORY_AUTHORITY == (
        "USER_CURRENT_PHYSICAL_INVENTORY_AUTHORITY_20260904"
    )

    payload = json.loads(
        CURRENT_USER_INVENTORY_OVERLAY_PATH.read_text(encoding="utf-8")
    )
    assert payload["schema_version"] == (
        "perfume_chem_user_inventory_authority_successor_v4"
    )
    assert payload["successor_id"] == "INVENTORY-USER-AUTHORITY-20260904-001"
    assert payload["effective_date"] == "2026-09-04"
    assert payload["predecessor"] == {
        "path": "data/governance/inventory_user_authority_overlay_20260901.json",
        "normalized_text_sha256": _normalized_sha256(
            PREDECESSOR_USER_INVENTORY_OVERLAY_PATH
        ),
        "authority": "USER_CURRENT_PHYSICAL_INVENTORY_AUTHORITY",
        "effective_date": "2026-09-01",
    }
    assert payload["policy"]["predecessor_immutable"] is True
    assert payload["policy"]["historical_formula_bytes_immutable"] is True
    assert payload["policy"]["formula_rebase_authorized"] is False
    assert payload["policy"]["general_substitution_authorized"] is False
    assert payload["policy"]["unknown_metadata_fails_closed"] is True


def test_20260904_overlay_records_exact_bacdanol_and_guaiacwood_contracts() -> None:
    payload = load_current_user_inventory_overlay()
    records = {record["canonical_name"]: record for record in payload["records"]}

    bacdanol = records["Bacdanol"]
    assert bacdanol["stock"] == {
        "fraction": 1.0,
        "fraction_basis": "neat",
        "carrier": "",
        "fraction_authority": "EXPLICIT_USER_CURRENT_STOCK_CORRECTION",
        "execution_ready": True,
    }
    assert bacdanol["aliases"] == ["Bacnadol"]
    assert bacdanol["authority_limits"]["availability_confirmed"] is True
    assert bacdanol["authority_limits"]["stock_fraction_known"] is True
    assert bacdanol["authority_limits"]["density_asserted"] is False
    assert bacdanol["authority_limits"]["safety_asserted"] is False
    assert bacdanol["authority_limits"]["sensory_equivalence_asserted"] is False

    guaiacwood = records["Guaiacwood EO"]
    assert guaiacwood["stock"] == {
        "fraction": pytest.approx(1.0 / 3.0),
        "fraction_exact": "1/3",
        "fraction_basis": "mass_fraction",
        "carrier": "",
        "fraction_authority": "EXPLICIT_USER_CURRENT_STOCK_CORRECTION",
        "execution_ready": False,
        "execution_hold_reason": "REMAINING_TWO_THIRDS_COMPOSITION_AND_CARRIER_UNRESOLVED",
    }
    limits = guaiacwood["authority_limits"]
    assert limits["stock_fraction_known"] is True
    assert limits["fraction_basis_known"] is True
    assert limits["carrier_known"] is False
    assert limits["remaining_two_thirds_composition_known"] is False
    assert limits["quantitative_dosing_ready"] is False
    assert limits["active_ul_ppm_oav_math_authorized"] is False
    assert limits["density_asserted"] is False
    assert limits["safety_asserted"] is False
    assert limits["sensory_equivalence_asserted"] is False

    historical = {
        record["historical_record_id"]: record
        for record in payload["historical_stock_records"]
    }
    assert historical["INV-HIST-20260904-BACDANOL-UNSPECIFIED"][
        "current_execution_authority"
    ] is False
    assert historical["INV-HIST-20260904-GUAIACWOOD-NOMINAL-33"]["stock"] == {
        "fraction": 0.33,
        "fraction_basis": "unspecified",
        "carrier": "",
    }
    assert all(
        record["historical_formula_rewrite_authorized"] is False
        for record in historical.values()
    )


def test_legacy_inventory_exposes_latest_stock_truth_without_inventing_carrier() -> None:
    rows = parse_inventory(
        INVENTORY,
        unique=False,
        include_solvents=True,
        include_unavailable=True,
    )
    bacdanol = next(row for row in rows if row.name == "Bacdanol")
    assert (bacdanol.status, bacdanol.dilution, bacdanol.fraction_basis) == (
        "owned",
        pytest.approx(1.0),
        "neat",
    )
    assert bacdanol.carrier == ""
    assert bacdanol.execution_ready is True

    guaiacwood = next(row for row in rows if row.name == "Guaiacwood EO")
    assert guaiacwood.status == "owned"
    assert guaiacwood.dilution == pytest.approx(1.0 / 3.0)
    assert guaiacwood.fraction_basis == "mass_fraction"
    assert guaiacwood.carrier == ""
    assert guaiacwood.execution_ready is False
    assert guaiacwood.execution_hold_reason == (
        "REMAINING_TWO_THIRDS_COMPOSITION_AND_CARRIER_UNRESOLVED"
    )


def test_current_materialization_uses_only_the_20260904_replacements() -> None:
    rows = parse_current_inventory(unique=False, include_unavailable=True)

    bacdanol = [row for row in rows if row.name == "Bacdanol"]
    assert len(bacdanol) == 1
    assert (
        bacdanol[0].dilution,
        bacdanol[0].fraction_basis,
        bacdanol[0].carrier,
        bacdanol[0].execution_ready,
    ) == (pytest.approx(1.0), "neat", "", True)
    assert bacdanol[0].source_ref.endswith("#INV-USER-20260904-001")

    guaiacwood = [row for row in rows if row.name == "Guaiacwood EO"]
    assert len(guaiacwood) == 1
    assert (
        guaiacwood[0].dilution,
        guaiacwood[0].fraction_basis,
        guaiacwood[0].carrier,
        guaiacwood[0].execution_ready,
    ) == (pytest.approx(1.0 / 3.0), "mass_fraction", "", False)
    assert guaiacwood[0].execution_hold_reason == (
        "REMAINING_TWO_THIRDS_COMPOSITION_AND_CARRIER_UNRESOLVED"
    )
    assert guaiacwood[0].source_ref.endswith("#INV-USER-20260904-002")
