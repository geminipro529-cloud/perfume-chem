def _rule(
    name: str,
    materials: tuple[str, ...],
    *,
    basis: str = "active",
    minimum=None,
    maximum=None,
    detail="",
) -> GroupRule:
    return GroupRule(
        name=name,
        materials=materials,
        basis=basis,
        minimum=minimum,
        maximum=maximum,
        detail=detail,
    )


def _reference_spec(
    *,
    key: str,
    family: str,
    label: str,
    anchors: tuple[GroupRule, ...],
    drift_limits: tuple[GroupRule, ...],
    forbidden_materials: tuple[str, ...] = OPAQUE_PREBLENDS,
    forbidden_tokens: tuple[str, ...] = (),
    oav_targets: Mapping[str, Mapping[str, float]],
    repair_pool: Mapping[str, float],
    novelty_reference: str = "",
    novelty_message: str = "",
) -> ArchetypeSpec:
    return ArchetypeSpec(
        key=key,
        family=family,
        label=label,
        role="reference_control",
        anchors=anchors,
        drift_limits=drift_limits,
        forbidden_materials=forbidden_materials,
        forbidden_tokens=forbidden_tokens,
        oav_targets=oav_targets,
        repair_pool=repair_pool,
        novelty_reference=novelty_reference,
        novelty_message=novelty_message or "Reference/control archetype; familiar by design.",
    )


