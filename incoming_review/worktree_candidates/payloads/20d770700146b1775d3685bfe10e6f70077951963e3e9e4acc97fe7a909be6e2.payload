  "target_identity": {
    "north_star": "La Nuit's cardamom recognizer carrying a historically plausible caraway shadow through lavender and cedar: cool, aromatic, slightly seed-spiced, but never savory rye, cumin-like, culinary, or louder than cardamom.",
    "functional_architecture": [
      "cardamom remains the primary spice recognizer",
      "caraway sits as a low-dose shadow with an explicit zero-caraway control",
      "lavender, linalool, and Hedione prevent a savory gap between seed spice and cedar",
      "literal cedar and Vertofix preserve the dark vertical into drydown"
    ],
    "protected_identity": [
      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "controlled caraway shadow under cardamom with aromatic continuity into cedar",
    "variant_socket": {
      "active_ppm_w_w": 66666.667,
      "current_raw_ul": 300,
      "target_allocation": {
        "Caraway increment": 3800,
        "Cardamom increment": 12000,
        "Lavender increment": 10000,
        "Cedarwood Virginia increment": 10000,
        "Linalool increment": 8000,
        "Hedione increment": 10000,
        "Vertofix Coeur increment": 8000,
        "Iso E Super increment": 4866.6666
      },
      "current_allocation_ul": {
        "Caraway Seed Oil (10% w/w in DPG)": 30,
        "Cardamom EO": 50,
        "Lavender EO (BONTAUX SAS)": 50,
        "Cedarwood oil Virginia": 50,
        "Linalool": 40,
        "Hedione": 40,
        "Vertofix": 20,
        "Iso E Super": 20
      }
    },
    "selection_rationale": [
      "The known 10% w/w Caraway stock permits exact active accounting; 40 uL total stock equals only 4 uL active in the concentrate.",
      "Cardamom remains over fifty times larger by raw active dose, while lavender/linalool/Hedione frame the caraway as an aromatic shadow instead of a food spice.",
      "Cedar and Vertofix were selected as dry continuations; coriander, anise, clove, cumin-like materials, tobacco, and balsams were rejected as culinary or genre-changing.",
      "EB stays the sole structural musk and is not increased."
    ],
    "drift_risk": "Any larger caraway, coriander/anise reinforcement, sweet balsam, or missing cardamom contrast could produce savory rye, cumin, or culinary drift."
  },
