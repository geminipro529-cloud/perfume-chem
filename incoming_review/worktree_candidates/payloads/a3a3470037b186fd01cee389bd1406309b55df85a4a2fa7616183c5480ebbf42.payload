def _write_registry_payload(path: Path, payload: dict[str, object]) -> None:
    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")


def _copy_v8_project(tmp_path: Path) -> tuple[Path, Path]:
    project = tmp_path / "project"
    registry_paths = tuple(
        REGISTRY_DIR / f"complexity_module_registry_v{version}.json"
        for version in range(1, 9)
    )
    relative_paths = {
        path.relative_to(ROOT).as_posix() for path in registry_paths
    }
    for registry_path in registry_paths:
        payload = json.loads(registry_path.read_text(encoding="utf-8"))
        for key in (
            "admission_evidence",
            "source_bindings",
            "runtime_bindings",
            "current_source_bindings",
            "required_evidence",
        ):
            rows = payload.get(key, [])
            if isinstance(rows, list):
                for row in rows:
                    if isinstance(row, dict) and isinstance(row.get("path"), str):
                        relative_paths.add(row["path"])
        for key in ("modules", "module_additions"):
            rows = payload.get(key, [])
            if not isinstance(rows, list):
                continue
            for row in rows:
                if not isinstance(row, dict):
                    continue
                if isinstance(row.get("path"), str):
                    relative_paths.add(row["path"])
                for reference in row.get("evidence_refs", []):
                    if isinstance(reference, str) and reference.startswith(
                        ("configs/", "data/", "docs/", "tests/")
                    ):
                        relative_paths.add(reference)
        rebindings = payload.get("compatibility_rebindings", [])
        if isinstance(rebindings, list):
            for row in rebindings:
                if not isinstance(row, dict):
                    continue
                for key in ("historical", "current"):
                    record = row.get(key)
                    if isinstance(record, dict) and isinstance(
                        record.get("path"), str
                    ):
                        relative_paths.add(record["path"])

    relative_paths.update(
        path.relative_to(ROOT).as_posix()
        for path in (ROOT / "data/materials").glob("*.yaml")
    )
    for relative in sorted(relative_paths):
        source = ROOT / relative
        if not source.is_file():
            continue
        target = project / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, target)
    return project, project / V8.relative_to(ROOT)


def _load_v8_as_v9_predecessor(
    project: Path,
    registry_path: Path,
) -> HarmonicRuntimeRegistryV8:
    v9_payload = json.loads(V9.read_text(encoding="utf-8"))
    successor_source_digests = {
        row["historical"]["path"]: row["current"]["sha256"]
        for row in v9_payload["compatibility_rebindings"]
        if row["historical"]["path"] == row["current"]["path"]
    }
    return _load_harmonic_runtime_registry_v8(
        project.resolve(),
        registry_path.resolve(),
        successor_source_digests=successor_source_digests,
        successor_material_data_digest=v9_payload["material_data_fingerprint"],
    )


def test_v8_is_frozen_predecessor_of_the_default_v9_successor() -> None:
    assert hashlib.sha256(V7.read_bytes()).hexdigest() == FROZEN_V7_SHA256
    assert hashlib.sha256(V8.read_bytes()).hexdigest() == FROZEN_V8_SHA256
    assert CURRENT_HARMONIC_RUNTIME_REGISTRY_PATH == V9_REGISTRY_PATH

    payload = json.loads(V8.read_text(encoding="utf-8"))
    assert payload["predecessor_registry"] == {
        "path": "configs/complexity/complexity_module_registry_v7.json",
        "sha256": FROZEN_V7_SHA256,
    }
    current = load_harmonic_runtime_registry(ROOT)
    historical = _load_v8_as_v9_predecessor(ROOT, V8)
    assert isinstance(current, HarmonicRuntimeRegistryV9)
    assert current.schema_version == "complexity_module_registry_v9"
    assert historical.schema_version == "complexity_module_registry_v8"
    assert historical.registry_sha256 == FROZEN_V8_SHA256
    assert historical.predecessor_registry_sha256 == FROZEN_V7_SHA256
    assert historical.base_registry_sha256 == FROZEN_V7_SHA256
    assert historical.hash_policy == {
        "registry_bytes": "RAW_SHA256",
        "utf8_text_bindings": "CRLF_TO_LF_THEN_SHA256",
        "bare_cr": "REJECT",
    }


def test_v8_replays_exact_v7_runtime_and_authority_without_promotion() -> None:
    registry = _load_v8_as_v9_predecessor(ROOT, V8)
    assert tuple(item.module_id for item in registry.modules) == EXPECTED_MODULE_IDS
    assert len(registry.modules) == len(set(EXPECTED_MODULE_IDS)) == 34
    assert registry.admitted_architecture_module_ids == (
        V8_ADMITTED_ARCHITECTURE_MODULE_IDS
    )
    assert registry.evidence_only_module_ids == V8_EVIDENCE_ONLY_MODULE_IDS
    assert registry.guardrail_module_ids == V8_GUARDRAIL_MODULE_IDS
    assert registry.admitted_scope == {
        "cypress_target_architecture": True,
        "target_variant_rebuild": True,
        "inventory_and_authority_guarding": True,
        "experiment_design": True,
        "evidence_only_request_routing": False,
    }
    assert registry.authority_flags == ALL_FALSE_AUTHORITY
    assert registry.full_gate == {
        "case_count": 6,
        "wins_vs_plain": 6,
        "wins_vs_placebo": 5,
        "median_gain_vs_plain": 10,
        "median_gain_vs_placebo": 13.5,
        "integrated_critical_errors": [],
    }

    modules = {item.module_id: item for item in registry.modules}
    assert modules["temporal-sensory-ledger"].state is (
        ModuleState.EVIDENCE_ONLY_NOT_ADMITTED
    )
    assert modules["temporal-sensory-ledger"].import_path is None
    assert modules["hedonic-preference-learner"].state is (
        ModuleState.EVIDENCE_ONLY_NOT_ADMITTED
    )
    assert modules["hedonic-preference-learner"].import_path is None
    assert "advanced-musk-intelligence" in registry.nonruntime_base_module_ids


def test_v8_declares_every_current_compatibility_rebinding() -> None:
    v7_payload = json.loads(V7.read_text(encoding="utf-8"))
    v8_payload = json.loads(V8.read_text(encoding="utf-8"))
    registry = _load_v8_as_v9_predecessor(ROOT, V8)
    v7_sources = {
        row["path"]: row["sha256"] for row in v7_payload["current_source_bindings"]
    }
    v8_sources = {
        row["path"]: row["sha256"] for row in v8_payload["current_source_bindings"]
    }
    expected_paths = (
        set(v7_sources)
        - {"data/governance/inventory_user_authority_overlay_20260831.json"}
    ) | {
        "data/governance/inventory_user_authority_overlay_20260904.json",
        "engine/formula_analyzer.py",
        "scripts/intervention_recommend.py",
        "scripts/score_collection_formulas.py",
        "scripts/score_designer_prestige_18.py",
        "scripts/verify_formula_workflow.py",
        "tests/test_advisory_unknown_strength_firewall.py",
    }
    assert set(v8_sources) == expected_paths
    successor_paths = {
        row["historical"]["path"]
        for row in json.loads(V9.read_text(encoding="utf-8"))[
            "compatibility_rebindings"
        ]
        if row["historical"]["path"] == row["current"]["path"]
    }
    for relative, digest in v8_sources.items():
        if relative in successor_paths:
            continue
        assert _normalized_utf8_sha256(ROOT / relative) == digest

    rebindings = {
        row["binding_id"]: row for row in v8_payload["compatibility_rebindings"]
    }
    assert set(rebindings) == {
        "inventory-overlay",
        "ingredient-catalog",
        "inventory-parser",
        "name-aliases",
        "legacy-inventory-text",
        "harmonic-registry-loader",
        "advisory-unknown-strength-firewall",
    }
    for row in rebindings.values():
        assert row["authority_effect"] == "NONE"
        if row["binding_id"] == "advisory-unknown-strength-firewall":
            assert row["historical"] == {
                "path": "scripts/intervention_recommend.py",
                "sha256": (
                    "abcf6f2f21ea965aedde8f0de531db08058005bcef2b4b57ed1872fb9b59c727"
                ),
            }
            assert row["change_class"] == (
                "FAIL_CLOSED_UNKNOWN_STOCK_STRENGTH_FIREWALL"
            )
        else:
            assert v7_sources[row["historical"]["path"]] == row["historical"][
                "sha256"
            ]
        assert v8_sources[row["current"]["path"]] == row["current"]["sha256"]

    assert v8_sources["engine/inventory_parser.py"] == (
        "80112066592ae0146ebf55d276667287335b36d80ad719abd4531a0d88d6a561"
    )
    assert registry.material_data_fingerprint == v8_payload[
        "material_data_fingerprint"
    ]
    assert _material_data_fingerprint(ROOT) == json.loads(
        V9.read_text(encoding="utf-8")
    )["material_data_fingerprint"]
    assert v8_payload["material_data_rebinding"] == {
        "historical_sha256": v7_payload["material_data_fingerprint"],
        "current_sha256": registry.material_data_fingerprint,
        "change_class": "MATERIAL_IDENTITY_ALIAS_AND_STOCK_METADATA_SUCCESSOR",
        "change_reason": (
            "EXPLICIT_ALIAS_IDENTITY_AND_AMBER_MATERIAL_RECORD_REFRESH_"
            "WITHOUT_RUNTIME_OR_AUTHORITY_PROMOTION"
        ),
        "authority_effect": "NONE",
    }
    assert v8_payload["admission_evidence"] == v7_payload["admission_evidence"]


def test_v8_rejects_policy_authority_and_predecessor_tampering(
    tmp_path: Path,
) -> None:
    payload = json.loads(V8.read_text(encoding="utf-8"))
    payload["authority_flags"]["physical_execution"] = True
    authority_path = tmp_path / "authority-v8.json"
    _write_registry_payload(authority_path, payload)
    with pytest.raises(ValueError, match="V8 authority flags"):
        _load_v8_as_v9_predecessor(ROOT, authority_path)

    payload = json.loads(V8.read_text(encoding="utf-8"))
    payload["compatibility_rebindings"][0]["authority_effect"] = "PROMOTE"
    rebinding_path = tmp_path / "rebinding-v8.json"
    _write_registry_payload(rebinding_path, payload)
    with pytest.raises(ValueError, match="V8 compatibility rebinding contract drifted"):
        _load_v8_as_v9_predecessor(ROOT, rebinding_path)

    payload = json.loads(V8.read_text(encoding="utf-8"))
    payload["predecessor_registry"]["sha256"] = "0" * 64
    predecessor_path = tmp_path / "predecessor-v8.json"
    _write_registry_payload(predecessor_path, payload)
    with pytest.raises(ValueError, match="V8 predecessor registry hash mismatch"):
        _load_v8_as_v9_predecessor(ROOT, predecessor_path)


def test_v8_current_inventory_source_tampering_fails_closed(tmp_path: Path) -> None:
    project, registry_path = _copy_v8_project(tmp_path)
    assert _load_v8_as_v9_predecessor(
        project,
        registry_path,
    ).schema_version == "complexity_module_registry_v8"
    overlay = (
        project / "data/governance/inventory_user_authority_overlay_20260904.json"
    )
    overlay.write_bytes(overlay.read_bytes() + b"\n ")
    with pytest.raises(ValueError, match="V8 current source binding hash mismatch"):
        _load_v8_as_v9_predecessor(project, registry_path)


def test_v8_current_unknown_strength_firewall_tampering_fails_closed(
    tmp_path: Path,
) -> None:
    project, registry_path = _copy_v8_project(tmp_path)
    intervention = project / "scripts/intervention_recommend.py"
    intervention.write_bytes(intervention.read_bytes() + b"\n# undeclared drift\n")
    with pytest.raises(
        ValueError,
        match=(
            "V8 current source binding hash mismatch: "
            "scripts/intervention_recommend.py"
        ),
    ):
        _load_v8_as_v9_predecessor(project, registry_path)


def test_v8_rejects_rehashed_undeclared_shared_source_drift(tmp_path: Path) -> None:
    project, registry_path = _copy_v8_project(tmp_path)
    payload = json.loads(registry_path.read_text(encoding="utf-8"))
    source = project / "engine/perception/architecture_contracts.py"
    source.write_bytes(source.read_bytes() + b"\n# undeclared semantic drift\n")
    next(
        row
        for row in payload["current_source_bindings"]
        if row["path"] == "engine/perception/architecture_contracts.py"
    )["sha256"] = _normalized_utf8_sha256(source)
    _write_registry_payload(registry_path, payload)
    with pytest.raises(ValueError, match="V8 undeclared historical source drift"):
        _load_v8_as_v9_predecessor(project, registry_path)


def test_v8_rejects_rehashed_v7_authority_promotion(tmp_path: Path) -> None:
    project, registry_path = _copy_v8_project(tmp_path)
    v7_path = project / V7.relative_to(ROOT)
    v7_payload = json.loads(v7_path.read_text(encoding="utf-8"))
    v7_payload["authority_flags"]["release"] = True
    _write_registry_payload(v7_path, v7_payload)
    payload = json.loads(registry_path.read_text(encoding="utf-8"))
    payload["predecessor_registry"]["sha256"] = hashlib.sha256(
        v7_path.read_bytes()
    ).hexdigest()
    _write_registry_payload(registry_path, payload)
    with pytest.raises(
        ValueError,
        match="frozen V7 predecessor policy, authority, or scope drifted",
    ):
        _load_v8_as_v9_predecessor(project, registry_path)
