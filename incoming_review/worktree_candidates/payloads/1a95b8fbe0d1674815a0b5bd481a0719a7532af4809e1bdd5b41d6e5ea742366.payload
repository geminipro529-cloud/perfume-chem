from engine.optimizer import models


class _BroadAliasFirst(set):
    """Model a hash-seed order that yields a broad alias before the exact key."""

    def __iter__(self):
        yield "test sicilian"
        yield "test oil sicilian"


def test_lookup_material_prefers_exact_normalized_name_over_alias_iteration_order(
    monkeypatch,
):
    exact = {"name": "Test Oil Sicilian", "mw": 170.0}
    broad = {"name": "Test Sicilian", "mw": 136.0}
    monkeypatch.setattr(
        models,
        "get_materials_db",
        lambda: {
            "test oil sicilian": exact,
            "test sicilian": broad,
        },
    )
    monkeypatch.setattr(
        models,
        "_material_alias_keys",
        lambda _name: _BroadAliasFirst(
            {"test oil sicilian", "test sicilian"}
        ),
    )

    resolved = models._lookup_material("Test Oil Sicilian")

    assert resolved is exact


def test_lookup_material_preserves_exact_product_identity_before_legacy_alias(
    monkeypatch,
):
    ambrofix = {"name": "Ambrofix", "mw": 296.5}
    ambrox = {"name": "Ambrox Super", "mw": 236.4}
    monkeypatch.setattr(
        models,
        "get_materials_db",
        lambda: {
            "ambrofix": ambrofix,
            "ambrox super": ambrox,
        },
    )

    resolved = models._lookup_material("  AMBROFIX  ")

    assert resolved is ambrofix


def test_lookup_material_fails_closed_when_broadened_aliases_are_ambiguous(
    monkeypatch,
):
    first = {"name": "First Candidate", "mw": 100.0}
    second = {"name": "Second Candidate", "mw": 200.0}
    monkeypatch.setattr(
        models,
        "get_materials_db",
        lambda: {
            "first candidate": first,
            "second candidate": second,
        },
    )
    monkeypatch.setattr(
        models,
        "_material_alias_keys",
        lambda _name: ("first candidate", "second candidate"),
    )

    assert models._lookup_material("Unindexed Label") is None
