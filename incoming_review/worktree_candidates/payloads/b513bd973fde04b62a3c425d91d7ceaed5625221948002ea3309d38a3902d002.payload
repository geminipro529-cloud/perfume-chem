    cas: str = "32388-55-9"
    vp_pa: float = 0.001
    logp: float = 4.5
    odt_ppb: float = 5.0       # estimated
    ifra_cat4_max: str = "Not limited"
    character: str = (
        "Warm precious-wood, musky amber-undertone. Long-lasting and diffusive. "
        "More powerful and tenacious than Cedramber. Cedar-musky warmth."
    )
    synergy_partner: str = "Iso E Super (mutual amplification)"
    typical_dose_pct: float = 1.0   # in concentrate
    usage_contexts: tuple[str, ...] = ("woody", "amber", "fougère", "chypre", "masculine")
    key_insight: str = (
        "+IsoESuper is its primary synergy partner. The synergistic trio: "
        "Norlimbanol 0.5% + Vertofix Coeur 1.0% + Iso E Super 3.0% creates "
        "the 'expensive dry-wood' atmosphere in PDM, Roja Dove, and Tom Ford Private Blend."
    )


VERTOFIX_COEUR = VertofixCoeurProfile()


# ---------------------------------------------------------------------------
# Synergistic Trio — "Expensive Dry-Wood" Platform
# ---------------------------------------------------------------------------

@dataclass(frozen=True, slots=True)
class WoodyInfrastructureTrio:
    """The three-infrastructure-material platform for niche woody depth."""
    norlimbanol_pct: float = 0.5
    vertofix_coeur_pct: float = 1.0
    iso_e_super_pct: float = 3.0
    description: str = (
        "This trio creates the 'expensive dry-wood' atmosphere present in most "
        "PDM, Roja Dove, and Tom Ford Private Blend fragrances. "
        "Norlimbanol provides the dry-woody depth amplifier across the entire pyramid. "
        "Vertofix Coeur provides warm cedar-musky amber undertone. "
        "Iso E Super provides woody sillage and mutual amplification with Vertofix."
    )
    effect: str = "Expensive dry-wood atmosphere — not identifiable as individual notes"
    build_instructions: str = (
        "Add these three at the percentages above to any woody, amber, or oriental "
        "formula. They function as invisible infrastructure — perceived as quality "
        "and cohesion, not as identifiable materials."
    )


WOODY_INFRASTRUCTURE_TRIO = WoodyInfrastructureTrio()


# ---------------------------------------------------------------------------
# "Invisible Infrastructure" concept
# ---------------------------------------------------------------------------

INFRASTRUCTURE_MATERIALS: tuple[tuple[str, str, str], ...] = (
    ("Norlimbanol", "0.1-0.5%", "Dry woody depth amplifier across entire pyramid"),
    ("Vertofix Coeur", "0.5-2.0%", "Warm precious-wood musky amber undertone"),
    ("Cashmeran", "0.5-3.0%", "Spicy-musk-apple texture bridge across families"),
    ("Helional", "0.1-1.0%", "Marine-metallic brightness that bridges citrus and fresh"),
    ("Florol", "0.5-4.0%", "Transparent watery-floral veil — sheer luxury quality"),
    ("Cyclamen Aldehyde", "0.1-2.0%", "Diffusion amplifier — radiant soapy-fresh projection"),
    ("Ambrettolide", "0.5-3.0%", "Fruity-musky base with natural ambrette character"),
    ("Ethylene Brassylate", "3.0-10.0%", "Invisible linear musk base — cruelty-free"),
)


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

def get_musk_class_profile(class_name: str) -> MuskClassProfile | None:
    """Return a musk class profile by name."""
    for mc in MUSK_CLASSES:
        if mc.class_name.lower() == class_name.lower():
            return mc
    return None


def get_all_musk_classes() -> tuple[MuskClassProfile, ...]:
    """Return all six musk structural classes."""
    return MUSK_CLASSES


def get_universal_musks() -> tuple[MuskClassProfile, ...]:
    """Return musk classes with universal perception (no significant anosmia)."""
    return tuple(mc for mc in MUSK_CLASSES if mc.universally_perceived)


def get_east_asian_caution_musks() -> tuple[MuskClassProfile, ...]:
    """Return musk classes with elevated East Asian anosmia risk."""
    return tuple(mc for mc in MUSK_CLASSES if mc.anosmia_pct >= 15.0)


def get_helvetolide_profile() -> HelvetolideProfile:
    """Return the complete Helvetolide profile."""
    return HELVETOLIDE


def get_romandolide_profile() -> RomandolideProfile:
    """Return the complete Romandolide profile."""
    return ROMANDOLIDE


def get_cashmeran_profile() -> CashmeranProfile:
    """Return the complete Cashmeran profile."""
    return CASHMERAN


def get_norlimbanol_profile() -> NorlimbanolProfile:
    """Return the complete Norlimbanol profile."""
    return NORLIMBANOL


def get_vertofix_coeur_profile() -> VertofixCoeurProfile:
    """Return the complete Vertofix Coeur profile."""
    return VERTOFIX_COEUR


def get_woody_infrastructure_trio() -> WoodyInfrastructureTrio:
    """Return the Norlimbanol + Vertofix Coeur + Iso E Super synergistic trio."""
    return WOODY_INFRASTRUCTURE_TRIO


def get_infrastructure_materials() -> tuple[tuple[str, str, str], ...]:
    """Return the invisible infrastructure materials list."""
    return INFRASTRUCTURE_MATERIALS


def recommend_thai_musk_platform() -> tuple[str, ...]:
    """Recommend a musk platform for Thai/East Asian market (avoiding Ambroxan risk)."""
    return (
        "Romandolide 5-20% (universal Galaxolide substitute)",
        "Habanolide 3-10% (transparent macrocyclic)",
        "Ambrettolide 2-5% (fruity-musky base)",
        "Ethylene Brassylate 5-10% (invisible linear base)",
        "Cashmeran 0.5-2% (spicy-apple texture)",
        "Reduce or avoid Ambroxan above 5% due to OR7A17 East Asian risk",
    )
