  "target_identity": {
    "north_star": "La Nuit's cool cardamom-lavender-cedar architecture settling into a dry coumarinic skin warmth: hay-like, tactile, and intimate, with transparent woods and no vanilla dessert, almond powder, balsamic sweetness, or musk curtain.",
    "functional_architecture": [
      "cardamom and lavender remain the fresh aromatic recognizers",
      "dry coumarin and tonka form a tactile hay-skin register rather than a gourmand base",
      "Iso E, Vertofix, and literal cedar keep the sweetness ventilated and vertical",
      "one EB musk supplies restrained skin continuity without powdery padding"
    ],
    "protected_identity": [
      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "dry coumarin-tonka skin warmth ventilated by transparent cedar-vetiver structure",
    "variant_socket": {
      "active_ppm_w_w": 66666.667,
      "current_raw_ul": 300,
      "target_allocation": {
        "Coumarin increment": 22000,
        "Tonka increment": 8000,
        "Hay Absolute": 9000,
        "Iso E Super increment": 9000,
        "Vertofix Coeur increment": 8000,
        "Cedarwood Virginia increment": 6000,
        "Cardamom increment": 4666.6666
      },
      "current_allocation_ul": {
        "Tonkarome (20% w/w in TEC)": 130,
        "Iso E Super": 60,
        "Vertofix": 50,
        "Cedarwood oil Virginia": 40,
        "Cardamom EO": 20
      }
    },
    "selection_rationale": [
      "The ideal uses Coumarin plus Hay Absolute for distinct dry crystal and natural hay facets; the current build omits Hay because its stock basis and composite model are unresolved.",
      "Known 20% w/w Tonkarome is used as the executable coumarin-tonka body; the ambiguous saturated Coumarin stock is rejected and owned neat Coumarin is reserved for a separately prepared 10% w/w TEC stock.",
      "Iso E and Vertofix were selected over Benzyl Salicylate, Ambermax, or balsams because they ventilate the skin register without cosmetic wax or oriental warmth.",
      "Vanillin remains only the target's inherited 500 ppm trace; no current vanilla, ethyl maltol, heliotrope, tincture, or extra musk is added."
    ],
    "drift_risk": "Vanillin, ethyl maltol, almond-heliotrope, balsams, excess hay, or powdery musk would turn dry skin warmth into dessert or powder."
  },
