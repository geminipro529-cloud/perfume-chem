import json
from pathlib import Path

from engine.data_spine import load_registry
from engine.ingredient_catalog import build_ingredient_catalog, find_ingredient
from engine.ingredient_intelligence import get_profile
from engine.inventory_parser import parse_inventory, resolve_inventory_material
from engine.name_utils import normalize_name
from engine.odor_thresholds import ODT_DATA
from engine.pipeline.formula_state import build_formula_state
from engine.pipeline.preflight import run_release_preflight


PROJECT_ROOT = Path(__file__).resolve().parents[1]


def _stock_tuples(material_name: str) -> set[tuple[float, str, str]]:
    return {
        (record.dilution, record.concentration_basis, record.carrier)
        for record in parse_inventory(unique=False, include_unavailable=True)
        if record.name == material_name
    }


def test_approximate_parenthetical_percent_is_not_silently_treated_as_neat(
    tmp_path: Path,
):
    inventory_path = tmp_path / "inventory.txt"
    inventory_path.write_text(
        "--- WOODS, WOOD MODIFIERS, AMBERS & VETIVER ---\n"
        "- Ambrox Test (~33% w/v in DEP:EtOH 53:47)\n",
        encoding="utf-8",
    )

    stock = parse_inventory(inventory_path, unique=False)[0]

    assert stock.dilution == 0.33


def test_colon_separated_dep_etoh_carrier_preserves_both_solvents(tmp_path: Path):
    inventory_path = tmp_path / "inventory.txt"
    inventory_path.write_text(
        "--- WOODS, WOOD MODIFIERS, AMBERS & VETIVER ---\n"
        "- Ambrox Test (~33% w/v in DEP:EtOH 53:47)\n",
        encoding="utf-8",
    )

    stock = parse_inventory(inventory_path, unique=False)[0]

    assert stock.carrier == "DEP/ETHANOL"


def test_new_bottle_labels_resolve_to_existing_owned_materials_without_duplicates():
    expected = {
        "Virginian Cedarwood": ("cedarwood virginia", "Cedarwood Virginia EO"),
        "Red Mandarin Oil": ("red mandarin eo", "Red Mandarin EO"),
        "Rose Otto Oil": ("rose essential oil", "Rose Essential Oil"),
        "Steam Distilled Rose Damascena": (
            "rose essential oil",
            "Rose Essential Oil",
        ),
        "Rose Samascena": ("rose essential oil", "Rose Essential Oil"),
    }
    registry = load_registry()

    for bottle_label, (normalized_name, canonical_name) in expected.items():
        assert normalize_name(bottle_label) == normalized_name
        material = registry.get(bottle_label)
        assert material is not None, bottle_label
        assert material.canonical_name == canonical_name
        assert material.user_in_inventory is True
        if canonical_name == "Rose Essential Oil":
            assert "10% w/w" in str(material.user_stock_dilution)
        else:
            assert material.user_stock_dilution == 1.0

        stock = resolve_inventory_material(bottle_label)
        assert stock is not None, bottle_label
        assert stock.dilution == (0.10 if canonical_name == "Rose Essential Oil" else 1.0)


def test_user_confirmed_stock_forms_are_recorded_with_latest_w_w_authority():
    assert _stock_tuples("Alpha Irone") == {(0.10, "w/w", "DEP")}
    assert _stock_tuples("Opoponax Resinoid") == {
        (0.40, "w/w", "DEP/ETHANOL")
    }
    assert _stock_tuples("Myrrh EO") == {(0.50, "w/w", "DEP")}
    assert _stock_tuples("Osmanthus Absolute") == {(0.10, "w/w", "DPG")}
    assert _stock_tuples("Rose de Mai Absolute") == {(0.10, "w/w", "DPG")}
    assert _stock_tuples("Rose Essential Oil (Rosa Damascena, India)") == {
        (0.10, "w/w", "")
    }
    assert _stock_tuples("Neroli EO") == {(1.00, "w/w", "")}
    assert (1.00, "unspecified", "") in _stock_tuples("Lemon FCF oil Sicilian")
    assert (1.00, "unspecified", "") in _stock_tuples("Clearwood")
    assert (1.00, "unspecified", "") in _stock_tuples("Alpha-Isomethyl Ionone")


def test_ambrofix_saturated_stock_is_clear_but_mass_dose_only():
    records = [
        record
        for record in parse_inventory(unique=False, include_unavailable=True)
        if record.name == "Ambrofix"
    ]

    assert len(records) == 1
    stock = records[0]
    assert stock.status == "owned"
    assert stock.dilution == 0.07
    assert "dep" in stock.carrier.casefold()
    assert "etoh" in stock.carrier.casefold() or "ethanol" in stock.carrier.casefold()
    assert stock.concentration_basis == "w/w"
    assert stock.execution_ready is False
    assert stock.execution_hold_reason == "MASS_DOSE_ONLY_DENSITY_AND_VOLUME_MATH_HOLD"
    assert "saturated solution" in stock.raw_name.casefold()
    assert "no visible crystals" in stock.raw_name.casefold()
    assert "mass dosing only" in stock.raw_name.casefold()
    assert "3 g in 10 ml" not in stock.raw_name.casefold()


def test_unquantified_ambrofix_stock_blocks_superseded_thirty_percent_formula_math():
    formula = {
        "name": "Superseded Ambrofix stock",
        "ingredients_ul": {"Ambrofix": 200.0},
        "dilutions": {"Ambrofix": 0.30},
    }
    state = build_formula_state(
        formula["ingredients_ul"], formula["dilutions"], batch_volume_ml=30.0
    )

    report = run_release_preflight(formula, state).as_dict()
    stock = next(
        check
        for check in report["checks"]
        if check["check_name"] == "inventory_stock_contract"
    )

    assert stock["status"] == "FAIL"
    assert stock["data"]["issues"] == [
        {"material": "Ambrofix", "reason": "stock_basis_verify_first"}
    ]


def test_semantic_volume_grade_qualifier_is_not_collapsed_into_premium_stock():
    assert _stock_tuples("Osmanthus Absolute") == {(0.10, "w/w", "DPG")}
    assert _stock_tuples("Osmanthus Absolute (volume grade)") == {
        (1.00, "unspecified", "")
    }
    assert _stock_tuples("Tuberose Absolute (volume grade)") == {
        (1.00, "unspecified", "")
    }
    premium = resolve_inventory_material("Osmanthus Absolute")
    assert premium is not None
    assert premium.dilution == 0.10
    assert premium.carrier == "DPG"


def test_current_executable_stocks_pass_the_declared_inventory_contract():
    dilutions = {
        "Alpha Irone": 0.10,
        "Myrrh EO": 0.50,
        "Osmanthus Absolute": 0.10,
        "Lemon FCF oil Sicilian": 1.00,
        "Clearwood": 1.00,
        "Alpha-Isomethyl Ionone": 1.00,
        "Neroli EO": 1.00,
    }
    formula = {
        "name": "User-confirmed stock contract 2026-08-28",
        "ingredients_ul": {name: 100.0 for name in dilutions},
        "dilutions": dilutions,
    }
    state = build_formula_state(
        formula["ingredients_ul"], formula["dilutions"], batch_volume_ml=30.0
    )

    report = run_release_preflight(formula, state).as_dict()
    stock = next(
        check
        for check in report["checks"]
        if check["check_name"] == "inventory_stock_contract"
    )

    assert stock["status"] == "PASS", stock["data"]
    matched = {row["material"]: row for row in stock["data"]["matched_stocks"]}
    assert matched["Alpha Irone"]["carrier"] == "DEP"
    assert matched["Alpha Irone"]["concentration_basis"] == "w/w"
    assert matched["Myrrh EO"]["carrier"] == "DEP"
    assert matched["Osmanthus Absolute"]["carrier"] == "DPG"
    assert matched["Neroli EO"]["concentration_basis"] == "w/w"


def test_sensory_rejected_rose_eo_fails_the_inventory_contract():
    formula = {
        "name": "Rejected Rose EO stock must not be dosed again",
        "ingredients_ul": {
            "Rose Essential Oil (Rosa Damascena, India)": 100.0
        },
        "dilutions": {
            "Rose Essential Oil (Rosa Damascena, India)": 0.10
        },
    }
    state = build_formula_state(
        formula["ingredients_ul"], formula["dilutions"], batch_volume_ml=30.0
    )

    report = run_release_preflight(formula, state).as_dict()
    stock = next(
        check
        for check in report["checks"]
        if check["check_name"] == "inventory_stock_contract"
    )

    assert stock["status"] == "FAIL"
    assert stock["data"]["issues"] == [
        {
            "material": "Rose Essential Oil (Rosa Damascena, India)",
            "reason": "inventory_stock_unavailable",
        }
    ]


