# UNIFIED KNOWLEDGE ENGINE
# ═══════════════════════════════════════════════════════════════════════════════


@dataclass(frozen=True, slots=True)
class PerfumeKnowledge:
    """Unified access to the complete perfume knowledge system.

    Provides taxonomy lookup, accord retrieval, soliflore structures,
    pyramid ratios, OAV targets, and cross-family compatibility.
    """

    families: tuple[str, ...] = field(
        default_factory=lambda: tuple(f.value for f in all_families())
    )
    subfamilies: tuple[str, ...] = field(
        default_factory=lambda: tuple(s.value for s in all_subfamilies())
    )
    accord_names: tuple[str, ...] = field(
        default_factory=lambda: tuple(a.name for a in all_accords())
    )
    soliflore_names: tuple[str, ...] = field(
        default_factory=lambda: tuple(
            s.value for s in SolifloreType.__members__.values()
        )
    )

    def get_family_description(self, name: str) -> str:
        return get_family_description(name)

    def get_subfamilies(self, family: str) -> tuple[str, ...]:
        subs = get_subfamilies(family)
        return tuple(s.value for s in subs)

    def get_subfamily_description(self, name: str) -> str:
        return get_subfamily_description(name)

    def get_parent_family(self, subfamily: str) -> str | None:
        parent = get_parent_family(subfamily)
        return parent.value if parent else None

    def get_accord(self, name: str) -> AccordRecipe | None:
        return get_accord(name)

    def get_soliflore(self, name: str) -> SolifloreStructure | None:
        return get_soliflore(name)

    def get_pyramid(
        self, family_key: str, bracket: str = "EdP"
    ) -> dict[str, Any] | None:
        br = self._parse_bracket(bracket)
        ratio = get_pyramid(family_key, br)
        if ratio is None:
            return None
        return {
            "top": ratio.top,
            "heart": ratio.heart,
            "base": ratio.base,
            "bracket": ratio.bracket.value,
            "description": ratio.description,
        }

    def get_oav_targets(self, family_key: str) -> dict[str, dict[str, float]]:
        return get_oav_targets(family_key)

    def get_compatibility(self, family_a: str, family_b: str) -> str:
        return get_compatibility(family_a, family_b)

    @staticmethod
    def _parse_bracket(bracket: str) -> ConcentrationBracket:
        mapping = {
            "edc": ConcentrationBracket.EDC,
            "edt": ConcentrationBracket.EDT,
            "edp": ConcentrationBracket.EDP,
            "extrait": ConcentrationBracket.EXTRAIT,
            "body_spray": ConcentrationBracket.BODY_SPRAY,
        }
        return mapping.get(bracket.lower(), ConcentrationBracket.EDP)


# Singleton instance
perfume_knowledge = PerfumeKnowledge()


