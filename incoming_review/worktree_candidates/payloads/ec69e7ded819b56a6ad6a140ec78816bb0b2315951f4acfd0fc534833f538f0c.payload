def resolve_family_key(family: str) -> str:
    """Resolve a family name string to a canonical key used in PYRAMID_RATIOS and OAV_TARGETS."""
    token = family.lower().strip().replace("_", " ").replace("-", " ")
    # Strip archetype suffix (e.g., "iris_amber_woody.classic" → "iris_amber_woody")
    if "." in token:
        token = token.split(".")[0].strip()
    if token in _FAMILY_TOKEN_MAP:
        return _FAMILY_TOKEN_MAP[token]
    # Longest-match-first to prevent substring collisions (e.g. "amber" matching before "iris amber woody")
    candidates = sorted(
        [
            (search_key, mapped)
            for search_key, mapped in _FAMILY_TOKEN_MAP.items()
            if search_key in token
        ],
        key=lambda x: -len(x[0]),
    )
    if candidates:
        return candidates[0][1]
    return token.replace(" ", "_")


@dataclass(frozen=True, slots=True)
class PyramidEvaluation:
    """Result of evaluating a formula's pyramid balance against family targets."""

    family_key: str
    bracket: str
    target_top: float
    target_heart: float
    target_base: float
    actual_top: float
    actual_heart: float
    actual_base: float
    top_deviation: float
    heart_deviation: float
    base_deviation: float
    overall_fit: float  # 0.0-1.0 where 1.0 = perfect match
    status: str  # "optimal", "acceptable", "needs_improvement", "off_target"
    details: str

    def as_dict(self) -> dict[str, Any]:
        return {
            "family_key": self.family_key,
            "bracket": self.bracket,
            "target_top": self.target_top,
            "target_heart": self.target_heart,
            "target_base": self.target_base,
            "actual_top": self.actual_top,
            "actual_heart": self.actual_heart,
            "actual_base": self.actual_base,
            "top_deviation": round(self.top_deviation, 4),
            "heart_deviation": round(self.heart_deviation, 4),
            "base_deviation": round(self.base_deviation, 4),
            "overall_fit": round(self.overall_fit, 4),
            "status": self.status,
            "details": self.details,
        }


def evaluate_pyramid_balance(
    formula_raw_pct: dict[str, float],
    family: str = "floral",
    bracket: str = "EdP",
    note_map: dict[str, str] | None = None,
) -> PyramidEvaluation:
    """Evaluate a formula's top/heart/base balance against the target pyramid for its family.

    Args:
        formula_raw_pct: {material_name: % of concentrate}
        family: family key string
        bracket: concentration bracket ("EdC", "EdT", "EdP", "Extrait")
        note_map: optional {material_name: "top"|"heart"|"base"} mapping.
                  If not provided, uses a heuristic based on known materials.

    Returns:
        PyramidEvaluation with fit assessment
    """
    resolved = resolve_family_key(family)
    br = perfume_knowledge._parse_bracket(bracket)
    target = get_pyramid(resolved, br) or get_pyramid("floral", br)
    if target is None:
        target = DEFAULT_PYRAMID.get(br, DEFAULT_PYRAMID[ConcentrationBracket.EDP])

    if note_map is None:
        note_map = _default_note_map()

    top_pct = sum(
        pct
        for mat, pct in formula_raw_pct.items()
        if note_map.get(normalize_name(mat), "heart") == "top"
    )
    heart_pct = sum(
        pct
        for mat, pct in formula_raw_pct.items()
        if note_map.get(normalize_name(mat), "heart") == "heart"
    )
    base_pct = sum(
        pct
        for mat, pct in formula_raw_pct.items()
        if note_map.get(normalize_name(mat), "heart") == "base"
    )
    total = top_pct + heart_pct + base_pct or 1.0
    actual_top = (top_pct / total) * 100.0
    actual_heart = (heart_pct / total) * 100.0
    actual_base = (base_pct / total) * 100.0

    top_dev = abs(actual_top - target.top) / max(target.top, 1.0)
    heart_dev = abs(actual_heart - target.heart) / max(target.heart, 1.0)
    base_dev = abs(actual_base - target.base) / max(target.base, 1.0)

    avg_dev = (top_dev + heart_dev + base_dev) / 3.0
    fit = max(0.0, 1.0 - avg_dev)

    if fit >= 0.90:
        status = "optimal"
    elif fit >= 0.70:
        status = "acceptable"
    elif fit >= 0.50:
        status = "needs_improvement"
    else:
        status = "off_target"

    details = (
        f"Expected T:{target.top:.0f}% H:{target.heart:.0f}% B:{target.base:.0f}%, "
        f"Actual T:{actual_top:.1f}% H:{actual_heart:.1f}% B:{actual_base:.1f}%"
    )

    return PyramidEvaluation(
        family_key=resolved,
        bracket=br.value,
        target_top=target.top,
        target_heart=target.heart,
        target_base=target.base,
        actual_top=round(actual_top, 2),
        actual_heart=round(actual_heart, 2),
        actual_base=round(actual_base, 2),
        top_deviation=top_dev,
        heart_deviation=heart_dev,
        base_deviation=base_dev,
        overall_fit=round(fit, 4),
        status=status,
        details=details,
    )


@dataclass(frozen=True, slots=True)
class OAVFamilyEvaluation:
    """Result of evaluating formula OAVs against family targets."""

    family_key: str
    time_window: str
    targets: dict[str, float]  # odour_family → target OAV
    actuals: dict[str, float]  # odour_family → actual summed OAV
    hits: tuple[dict[str, Any], ...]  # per-target evaluation
    overall_fit: float
    status: str

    def as_dict(self) -> dict[str, Any]:
        return {
            "family_key": self.family_key,
            "time_window": self.time_window,
            "targets": dict(self.targets),
            "actuals": dict(self.actuals),
            "hits": [dict(h) for h in self.hits],
            "overall_fit": round(self.overall_fit, 4),
            "status": self.status,
        }


def evaluate_oav_family_targets(
    material_oavs: dict[str, float],
    material_families: dict[str, str],
    family: str,
    time_window: str = "heart",
    *,
    target_override: Mapping[str, Mapping[str, float]] | None = None,
    target_key: str | None = None,
) -> OAVFamilyEvaluation:
    """Evaluate formula OAVs against per-family, per-window OAV targets.

    Args:
        material_oavs: {material_name: computed OAV}
        material_families: {material_name: odour_family tag}
        family: target perfume family key
        time_window: "top" | "heart" | "base"
        target_override: optional exact-archetype target map. When omitted,
            the broad family knowledge table remains authoritative.
        target_key: reporting key used with ``target_override``.

    Returns:
        OAVFamilyEvaluation with per-odour-family fit assessment
    """
    resolved = str(target_key or resolve_family_key(family))
    target_map = target_override if target_override is not None else get_oav_targets(resolved)
    window_targets = target_map.get(time_window.lower(), {})

    if not window_targets:
        return OAVFamilyEvaluation(
            family_key=resolved,
            time_window=time_window,
            targets={},
            actuals={},
            hits=(),
            overall_fit=0.0,
            status="no_targets_defined",
        )

    actuals: dict[str, float] = {}
    for material, oav in material_oavs.items():
        odour_family = material_families.get(material, "unknown").lower()
        actuals[odour_family] = actuals.get(odour_family, 0.0) + oav

    hits: list[dict[str, Any]] = []
    scores: list[float] = []

    for odour_family, target in window_targets.items():
        actual = actuals.get(odour_family, 0.0)
        ratio = actual / target if target > 0 else float("inf")
        if 0.5 <= ratio <= 2.0:
            hit_status = "within_range"
            score = 1.0
        elif 0.3 <= ratio <= 3.0:
            hit_status = "moderate_deviation"
            score = 0.6
        else:
            hit_status = "off_target"
            score = 0.0
        scores.append(score)
        hits.append(
            {
                "odour_family": odour_family,
                "target_oav": target,
                "actual_oav": round(actual, 2),
                "ratio": round(ratio, 3),
                "status": hit_status,
                "score": score,
            }
        )

    overall = sum(scores) / len(scores) if scores else 0.0
    if overall >= 0.85:
        status = "optimal"
    elif overall >= 0.60:
        status = "acceptable"
    elif overall >= 0.30:
        status = "needs_improvement"
    else:
        status = "off_target"

    return OAVFamilyEvaluation(
        family_key=resolved,
        time_window=time_window,
        targets=dict(window_targets),
        actuals={k: round(v, 2) for k, v in actuals.items()},
        hits=tuple(hits),
        overall_fit=round(overall, 4),
        status=status,
    )


@dataclass(frozen=True, slots=True)
class AccordSuggestion:
    """A suggested accord with fit score for bridging a formula gap."""

    accord_name: str
    accord_type: str
    fit_score: float  # 0.0-1.0
    reason: str
    materials: tuple[dict[str, Any], ...]

    def as_dict(self) -> dict[str, Any]:
        return {
            "accord_name": self.accord_name,
            "accord_type": self.accord_type,
            "fit_score": round(self.fit_score, 4),
            "reason": self.reason,
            "materials": [dict(m) for m in self.materials],
        }


def suggest_accord(
    missing_odour_families: list[str],
    desired_family: str = "",
) -> list[AccordSuggestion]:
    """Suggest accords to fill missing odour families in a formula.

    Args:
        missing_odour_families: list of odour family tags missing from formula
        desired_family: optional target perfume family for filtering

    Returns:
        List of AccordSuggestion ranked by fit score
    """
    if not missing_odour_families:
        return []

    suggestions: list[AccordSuggestion] = []
    for accord in all_accords():
        accord_type = accord.accord_type.value.replace("_accord", "")

        matches = 0
        for missing in missing_odour_families:
            if missing.lower() in accord_type.lower():
                matches += 1
            elif missing.lower() in accord.description.lower():
                matches += 0.5

        if matches > 0:
            fit = min(matches / len(missing_odour_families), 1.0)
            if desired_family and accord.family:
                if desired_family.lower().replace(" ", "_") == accord.family.value:
                    fit += 0.2

            suggestions.append(
                AccordSuggestion(
                    accord_name=accord.name,
                    accord_type=accord.accord_type.value,
                    fit_score=min(fit, 1.0),
                    reason=f"Fills {int(matches)} of {len(missing_odour_families)} missing odour families",
                    materials=tuple(
                        {
                            "material": m.material,
                            "percent": m.percent,
                            "role": m.role,
                            "target_oav": m.target_oav,
                        }
                        for m in accord.materials
                    ),
                )
            )

    suggestions.sort(key=lambda s: -s.fit_score)
    return suggestions[:5]


def get_family_for_formula(
    formula_pct: dict[str, float],
    material_families: dict[str, str],
) -> dict[str, float]:
    """Infer the dominant perfume family for a formula based on material proportions.

    Returns a dict of family → proportion score (0.0-1.0).
    """
    scores: dict[str, float] = {}
    total = sum(formula_pct.values()) or 1.0

    for material, pct in formula_pct.items():
        odour_family = material_families.get(material, "").lower()
        if not odour_family:
            continue
        weight = pct / total

        # Map odour families to root perfume families
        for perfume_family in PerfumeFamily.__members__.values():
            if (
                odour_family in perfume_family.value
                or perfume_family.value in odour_family
            ):
                scores[perfume_family.value] = (
                    scores.get(perfume_family.value, 0.0) + weight
                )
                break
        else:
            scores[odour_family] = scores.get(odour_family, 0.0) + weight

    # Normalize
    score_total = sum(scores.values()) or 1.0
    return {k: round(v / score_total, 4) for k, v in scores.items()}


# ═══════════════════════════════════════════════════════════════════════════════
# HEURISTIC NOTE MAP
# ═══════════════════════════════════════════════════════════════════════════════


class SubstringNoteMap(dict[str, str]):
    """A dict that falls back to substring matching when exact key lookup fails.

    If ``d.get("bergamot fcf", "heart")`` doesn't find "bergamot fcf" exactly,
    it searches for any token in ``top_tokens`` or ``base_tokens`` within the key,
    then caches the result for O(1) subsequent access.
    """

    top_tokens: frozenset[str] = frozenset()
    heart_tokens: frozenset[str] = frozenset()
    base_tokens: frozenset[str] = frozenset()

    def __missing__(self, key: str) -> str:
        result = self._resolve(key)
        self[key] = result
        return result

    def get(self, key: str, default: str | None = None) -> str | None:
        if key in self:
            return self[key]
        result = self._resolve(key)
        if result is not None:
            self[key] = result
            return result
        return default

    def _resolve(self, key: str) -> str | None:
        lower = key.lower()
        if any(t in lower for t in self.top_tokens):
            return "top"
        if any(t in lower for t in self.heart_tokens):
            return "heart"
        if any(t in lower for t in self.base_tokens):
            return "base"
        return None


def _default_note_map() -> SubstringNoteMap:
    """Build a SubstringNoteMap that handles inventory-suffixed names
    like "Bergamot FCF" and "Vetiver EO (India)" automatically.

    Substring matching means you never need to maintain an exhaustive
    list of every inventory variant.
    """
    m = SubstringNoteMap()
    m.top_tokens = frozenset(
        {
            "bergamot",
            "cedrat",
            "citron",
            "lemon",
            "lime",
            "grapefruit",
            "mandarin",
            "blood orange",
            "sweet orange",
            "neroli",
            "petitgrain",
            "limonene",
            "d-limonene",
            "dihydromyrcenol",
            "calone",
            "floralozone",
            "aldehyde c10",
            "aldehyde c11",
            "aldehyde c12 mna",
            "cis-3-hexenol",
            "hexyl acetate",
            "ethyl 2-methylbutyrate",
            "allyl amyl glycolate",
            "methyl pamplemousse",
            "linalool",
            "linalyl acetate",
            "benzyl acetate",
            "benzyl alcohol",
            "galbanum",
            "dynascone",
            "leafovert",
            "verdox",
            "parmavert",
            "scentenal",
            "triplal",
            "apritone",
            "terpinyl acetate",
            "lemonile",
        }
    )
    m.heart_tokens = frozenset(
        {
            "hedione",
            "flower",
