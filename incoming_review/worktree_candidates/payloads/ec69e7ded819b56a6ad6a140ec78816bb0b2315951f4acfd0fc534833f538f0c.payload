"""Perfume knowledge integration module — unified API for the pipeline.

**RULE 1: All perfume calculations must use ppm, ODT, and OAV.**

This module provides a single import point for the complete perfume knowledge
system and bridges it to the pipeline's formula evaluation, scoring,
and optimization workflows.

Usage:
    from engine.knowledge.perfume_knowledge import (
        PerfumeKnowledge,
        get_family_for_formula,
        evaluate_pyramid_balance,
        suggest_accord,
        evaluate_oav_family_targets,
    )
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Mapping

from engine.knowledge.accord_library import (
    AccordMaterial,
    AccordRecipe,
    accords_by_family,
    accords_by_type,
    all_accords,
    get_accord,
)
from engine.knowledge.perfume_taxonomy import (
    AccordType,
    ConcentrationBracket,
    PerfumeFamily,
    PerfumeSubfamily,
    SolifloreType,
    all_families,
    all_subfamilies,
    get_family_description,
    get_parent_family,
    get_subfamilies,
    get_subfamily_description,
    taxonomy_tree,
)
from engine.knowledge.pyramid_targets import (
    CROSS_FAMILY_COMPATIBILITY,
    DEFAULT_PYRAMID,
    MATERIAL_ROLE_RATIOS,
    OAV_TARGETS_BY_FAMILY,
    PYRAMID_RATIOS,
    PyramidRatio,
    get_compatibility,
    get_material_role_range,
    get_oav_target,
    get_oav_targets,
    get_pyramid,
)
from engine.knowledge.soliflore_structures import (
    SolifloreComponent,
    SolifloreStructure,
    all_soliflores,
    get_soliflore,
    soliflore_material_list,
)
from engine.name_utils import normalize_name

