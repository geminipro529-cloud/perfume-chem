  "module_packet_overrides": {
    "architectural_delta": {
      "operating_contract_append": [
        "Evaluate target-function coverage before defects in a rejected proposal: when every target function is covered, a count- or prestige-only expansion resolves to NO_CHANGE even if inventory must later be reparsed for execution.",
        "Reserve HOLD for a specific target-inverting intervention, unresolved evidence needed to decide the ideal architecture, or an unsupported interaction claim; ordinary redundancy is NO_CHANGE."
      ],
      "evidence_refs_append": ["architectural-delta-state-precedence-repair-v2"]
    },
    "temporal_sensory_ledger": {
      "operating_contract_append": [
        "A directly observed, scope-matched answer is COMPLETE even when no further comparison is needed; a single nonconflicting absent cell is INCOMPLETE rather than HOLD.",
        "The next-action count does not determine state: state follows evidence completeness, conflict, and protocol validity."
      ],
      "evidence_refs_append": ["temporal-ledger-state-precedence-repair-v2"]
    },
    "hedonic_preference_learner": {
      "operating_contract_append": [
        "A recommended bridge pair does not validate a disconnected graph: report WITHHELD; a measurable perfect position effect is DIAGNOSTIC; only a fully passing scoped fit is VALIDATED.",
        "State describes current evidence, never the usefulness of the proposed next comparison."
      ],
      "evidence_refs_append": ["hedonic-preference-state-precedence-repair-v2"]
    }
  },
