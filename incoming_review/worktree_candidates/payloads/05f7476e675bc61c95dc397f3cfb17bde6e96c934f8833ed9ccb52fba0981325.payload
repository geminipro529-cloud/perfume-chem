def _evidence_hold_reason(spec: _EvidenceSpec) -> str | None:
    receipt_paths = validate_receipt_pins(*spec.receipts)
    local_paths = tuple(PROJECT_ROOT / path for path in spec.local_paths)
    return local_evidence_hold_reason(*receipt_paths, *local_paths)


def pytest_sessionstart() -> None:
    """Materialize only exact tracked historical governance evidence."""

    try:
        validate_v5_historical_compatibility()
        materialize_historical_governance_evidence()
    except Exception as exc:
        raise pytest.UsageError(
            f"HISTORICAL_GOVERNANCE_COMPATIBILITY_ERROR: {exc}"
        ) from exc


def pytest_collection_modifyitems(items: list[pytest.Item]) -> None:
    """Mark only proven absent local evidence as HOLD after metadata validation."""

    evaluated: dict[_EvidenceSpec, str | None] = {}
    for item in items:
        item_key = item.nodeid.split("[", 1)[0].replace("\\", "/")
        module_key = item_key.split("::", 1)[0]
        spec = _ITEM_SPECS.get(item_key, _MODULE_SPECS.get(module_key))
        if spec is None:
            continue
        try:
            if spec not in evaluated:
                evaluated[spec] = _evidence_hold_reason(spec)
            reason = evaluated[spec]
        except Exception as exc:
            raise pytest.UsageError(
                f"EXTERNAL_EVIDENCE_POLICY_ERROR for {item_key}: {exc}"
            ) from exc
        if reason is not None:
            item.add_marker(pytest.mark.skip(reason=reason))
