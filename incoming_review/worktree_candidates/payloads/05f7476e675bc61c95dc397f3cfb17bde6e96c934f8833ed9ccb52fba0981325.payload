"""Repository-wide pytest policy for optional local evidence replay."""

from __future__ import annotations

from dataclasses import dataclass

import pytest

from external_evidence_pytest import (
    PROJECT_ROOT,
    ReceiptEvidencePin,
    local_evidence_hold_reason,
    materialize_historical_governance_evidence,
    validate_receipt_pins,
    validate_v5_historical_compatibility,
)


@dataclass(frozen=True, slots=True)
class _EvidenceSpec:
    receipts: tuple[ReceiptEvidencePin, ...] = ()
    local_paths: tuple[str, ...] = ()


def _receipt(file_name: str, receipt_sha256: str, package_sha256: str) -> ReceiptEvidencePin:
    return ReceiptEvidencePin(
        path=PROJECT_ROOT / "data" / "governance" / file_name,
        receipt_sha256=receipt_sha256,
        package_sha256=package_sha256,
    )


