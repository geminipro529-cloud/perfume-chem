      },
      "metric_units": {
        "wall_clock_seconds": "seconds",
        "time_to_first_executable_formula_seconds": "seconds",
        "static_preflight_seconds": "seconds",
        "full_gate_seconds": "seconds",
        "cache_hit_rate": "fraction_0_1",
        "model_or_provider_cost": "usd",
        "iteration_count": "count",
        "manual_intervention_count": "count",
        "unknown_or_unavailable_stock_count": "count",
        "stock_fraction_mismatch_count": "count",
        "sub_10_ul_violation_count": "count",
        "exact_subtotal_failure_count": "count",
