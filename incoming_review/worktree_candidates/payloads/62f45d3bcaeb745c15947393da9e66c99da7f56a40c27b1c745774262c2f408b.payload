{
  "schema": "perfume-chem-ysl-blind-protocol-v1",
  "protocol_id": "YSL20-BLIND-v1",
  "status": "PROTOCOL_ONLY_NOT_EXECUTED",
  "study_scope": "Twenty target-first formula hypotheses, two family controls, and two frozen Sol comparison baselines",
  "claim_ceiling": "The protocol defines future observations. It contains no physical result and authorizes no claim of liking, similarity, stability, safety, measured headspace, or release.",
  "engineering_benchmark": {
    "benchmark_id": "YSL-XHIGH-PROGRAM-LIFT-v1",
    "status": "PROTOCOL_ONLY_NOT_EXECUTED",
    "purpose": "Separate program lift from model lift under matched formula-generation and validation conditions.",
    "arms": [
      {
        "arm_id": "A_XHIGH_ALONE",
        "required": true,
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh",
        "program_condition": "No Perfume-Chem repair or optimization feedback before output lock"
      },
      {
        "arm_id": "B_XHIGH_CURRENT_PROGRAM",
        "required": true,
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh",
        "program_condition": "Current frozen pipeline and inventory contracts"
      },
      {
        "arm_id": "C_XHIGH_UPGRADED_PROGRAM",
        "required": true,
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh",
        "program_condition": "Staged static preflight, content-addressed cache, timing telemetry, and target-first controlled discovery"
      },
      {
        "arm_id": "D_ULTRA_UPGRADED_PROGRAM_OPTIONAL",
        "required": false,
        "model": "gpt-5.6-sol",
        "reasoning_effort": "ultra",
        "program_condition": "Same upgraded program as arm C; optional model-lift comparison"
      }
    ],
    "causal_contrasts": {
      "program_lift": "C_XHIGH_UPGRADED_PROGRAM minus A_XHIGH_ALONE and B_XHIGH_CURRENT_PROGRAM",
      "model_lift": "D_ULTRA_UPGRADED_PROGRAM_OPTIONAL minus C_XHIGH_UPGRADED_PROGRAM"
    },
    "causal_contrast_pairs": [
      {
        "contrast_id": "program_vs_alone",
        "baseline_arm_id": "A_XHIGH_ALONE",
        "candidate_arm_id": "C_XHIGH_UPGRADED_PROGRAM"
      },
      {
        "contrast_id": "program_vs_current",
        "baseline_arm_id": "B_XHIGH_CURRENT_PROGRAM",
        "candidate_arm_id": "C_XHIGH_UPGRADED_PROGRAM"
      },
      {
        "contrast_id": "model_lift_optional",
        "baseline_arm_id": "C_XHIGH_UPGRADED_PROGRAM",
        "candidate_arm_id": "D_ULTRA_UPGRADED_PROGRAM_OPTIONAL",
        "optional": true
      }
    ],
    "matched_controls": {
      "same_inventory_bytes": true,
      "same_stock_basis_and_lost_tincture_overlay": true,
      "same_prompt_and_target_contract": true,
      "same_concentrate_and_application_basis": true,
      "same_temperature_and_pipeline_source_hash": true,
      "same_time_budget": true,
      "same_missing_chemical_policy": true,
      "same_output_schema": true,
      "same_seed_when_supported": true,
      "no_external_feedback_before_output_lock": true
    },
    "pilot": {
      "briefs": [
        "ysl_lhomme",
        "ysl_la_nuit_de_lhomme",
        "unrelated_family_control"
      ],
      "independent_runs_per_brief_per_arm": 3,
      "minimum_formula_generation_cells_per_required_arm": 9,
      "expansion_rule": "Expand only after the engineering pilot is complete and frozen; do not select a showcase run post hoc."
    },
    "metrics": {
      "engineering": [
        "wall_clock_seconds",
        "time_to_first_executable_formula_seconds",
        "static_preflight_seconds",
        "full_gate_seconds",
        "cache_hit_rate",
        "model_or_provider_cost",
        "iteration_count",
        "manual_intervention_count",
        "unknown_or_unavailable_stock_count",
        "stock_fraction_mismatch_count",
        "sub_10_ul_violation_count",
        "exact_subtotal_failure_count",
        "family_drift_failure_count",
        "stale_receipt_count"
      ],
      "discovery": [
        "identity_retaining_target_linked_axes",
        "nonredundant_missing_functions_identified",
        "constant_total_one_axis_variant_rate",
        "redundant_material_or_function_rate"
      ],
      "sensory": [
        "family_identity_pass",
        "protected_anchor_presence",
        "named_axis_fit",
        "opening_heart_drydown_transition",
        "depth_richness_and_relationships",
        "identity_retaining_paired_preference",
        "no_preference_or_tie",
        "defect_flags"
      ]
    },
