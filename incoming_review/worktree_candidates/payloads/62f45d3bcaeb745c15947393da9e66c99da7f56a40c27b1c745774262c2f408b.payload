    },
    "phase_2_family_comparison": {
      "status": "LOCKED_PENDING_PHASE_1_AND_AUTHORITY_REPAIR",
      "purpose": "Compare the family control, top two eligible variants selected after decoding Phase 1, and the frozen Sol baseline at matched active concentration.",
      "lhomme_arms": [
        "LH-01",
        "TOP_TWO_ELIGIBLE_LH_VARIANTS_POST_PHASE_1",
        "SOL-LH-FROZEN"
      ],
      "la_nuit_arms": [
        "LN-01",
        "TOP_TWO_ELIGIBLE_LN_VARIANTS_POST_PHASE_1",
        "SOL-LN-FROZEN"
      ],
      "selection_lock": "No current arm is predeclared a sensory finalist. LH-04, LN-01, and LN-05 remain mandatory inclusions in the appropriate family evidence package regardless of screening rank."
    }
  },
  "decision_rules": {
    "identity_gate": "An arm cannot advance on liking alone if repeated blinded observations show protected-family loss or the named drift failure.",
    "hedonic_rule": "Among identity-retaining arms, preserve assessor-level paired preference and no-preference responses; do not turn a numerical mean into a universal liking claim.",
    "ties": "RETAIN_AS_TIE_OR_INCONCLUSIVE",
    "missing_cells": "DO_NOT_IMPUTE",
    "protocol_deviation": "Record before decoding; affected comparisons remain HOLD unless a predeclared valid repeat replaces the cell.",
    "negative_result": "Retain the failed or nonpreferred arm and its receipt; do not silently optimize after decoding.",
    "advancement_authority": "A future evidence-bound decision only; this protocol itself advances nothing."
  },
  "missing_chemical_microtrial_templates": [
    {
      "template_id": "MC-EXACT-IDENTITY-v1",
      "scope": "Exact cedrat, white pepper, violet leaf, Haitian vetiver, target sandalwood, Vertofix Coeur, Ambroxide, or other target-identity material",
      "arm_types": ["CONTROL", "ADDITION", "OMISSION", "RATIO"],
      "constant_total": true,
      "carrier_matched": true,
      "minimum_true_replicates": 2,
      "expected_cells_locked_before_observation": true,
      "design": "Fund addition and ratio arms by a predeclared function-adjacent donor; return equivalent carrier and mass in control and omission arms; change no second target axis.",
      "tie_or_missing_result": "INCONCLUSIVE",
      "execution_authorized": false
    },
    {
      "template_id": "MC-TEXTURE-SPECIALIST-v1",
      "scope": "Exaltolide, Hedione HC, or another exact texture specialist after stock basis and nonredundancy are established",
      "arm_types": ["CONTROL", "ADDITION", "OMISSION", "RATIO"],
      "constant_total": true,
      "carrier_matched": true,
      "minimum_true_replicates": 2,
      "expected_cells_locked_before_observation": true,
      "design": "Hold total musk or radiance function mass constant across arms; compare the specialist with the current single-function substitute and an omission without adding a second uncontrolled musk chord.",
      "tie_or_missing_result": "HOLD",
      "execution_authorized": false
    },
    {
      "template_id": "MC-IMMORTELLE-MODULE-v1",
      "scope": "LN-05 verified Immortelle Absolute, Helichrysum, Hay, and Maple module",
      "arm_types": ["CONTROL", "ADDITION", "OMISSION", "RATIO"],
      "constant_total": true,
      "carrier_matched": true,
      "minimum_true_replicates": 2,
      "expected_cells_locked_before_observation": true,
      "design": "Compare the verified module with a full carrier-matched omission and a predeclared low/high ratio while holding the protected cardamom-lavender-cedar chassis constant; score curry, maple, gourmand, tobacco, and balsamic drift explicitly.",
      "tie_or_missing_result": "INCONCLUSIVE",
      "execution_authorized": false
    }
  ],
