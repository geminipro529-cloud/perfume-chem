  "target_identity": {
    "north_star": "La Nuit's cardamom recognizer carrying a historically plausible caraway shadow through lavender and cedar: cool, aromatic, slightly seed-spiced, but never savory rye, cumin-like, culinary, or louder than cardamom.",
    "functional_architecture": [
      "cardamom remains the primary spice recognizer",
      "caraway sits as a low-dose shadow with an explicit zero-caraway control",
      "lavender, linalool, and Hedione prevent a savory gap between seed spice and cedar",
      "literal cedar and Vertofix preserve the dark vertical into drydown"
    ],
    "protected_identity": [
      "Cardamom Oil",
      "Lavender",
      "Cedarwood Virginia",
      "Vetiver Haiti",
      "Coumarin"
    ],
    "primary_axis": "controlled caraway shadow under cardamom with aromatic continuity into cedar",
