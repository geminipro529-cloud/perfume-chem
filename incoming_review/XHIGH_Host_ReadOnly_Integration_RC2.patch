@@ -0,0 +1,394 @@
+"""Host-independent qualification tests for the XHIGH read-only provider."""
+
+from __future__ import annotations
+
+import hashlib
+import sqlite3
+import zipfile
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from app.external_evidence.errors import (
+    ExternalEvidenceDisabledError,
+    ExternalEvidenceIntegrityError,
+    ExternalEvidenceMutationDeniedError,
+    ExternalEvidenceQueryError,
+    ExternalEvidenceSelectionError,
+)
+from app.external_evidence.hashing import canonical_json_bytes, sha256_file
+from app.external_evidence.provider import ExternalEvidenceProvider
+from app.external_evidence.release_selector import select_release
+
+RELEASE_ID = "XHIGH-TEST-RC1"
+RELEASE_STATE = "XHIGH_FROZEN_FOR_PRO_REVIEW"
+GENERATED_AT_UTC = "2026-08-08T00:00:00+00:00"
+MEMBER_ROOT = "Perfume_Chem_External_Evidence_XHIGH_TEST_RELEASE"
+
+
+def _make_external_database(path: Path, *, marker: str = "TEST") -> None:
+    connection = sqlite3.connect(path)
+    try:
+        connection.executescript(
+            """
+            PRAGMA foreign_keys=ON;
+            CREATE TABLE ee_claim (
+                claim_id TEXT PRIMARY KEY,
+                claim_scope TEXT NOT NULL,
+                evidence_class TEXT NOT NULL,
+                statement TEXT NOT NULL
+            );
+            CREATE TABLE ee_experiment (
+                experiment_id TEXT PRIMARY KEY,
+                status TEXT NOT NULL,
+                title TEXT NOT NULL
+            );
+            INSERT INTO ee_claim VALUES
+                ('CLM-1', 'HUMAN_MIXTURE_PERCEPTION', 'PRIMARY', 'Masking is context dependent'),
+                ('CLM-2', 'RECEPTOR_MECHANISM', 'EXTERNAL_RECEPTOR_ASSAY', 'Mechanism only');
+            INSERT INTO ee_experiment VALUES
+                ('EXP-1', 'PROPOSED', 'Binary ratio screen'),
+                ('EXP-2', 'LOCKED_DESIGN', 'Maturation time course');
+            """
+        )
+        connection.execute(
+            "UPDATE ee_claim SET statement = statement || ? WHERE claim_id = 'CLM-2'",
+            (f" [{marker}]",),
+        )
+        connection.commit()
+    finally:
+        connection.close()
+
+
+def _artifact(path: Path, artifact_id: str, *, relative_to: Path) -> dict[str, object]:
+    return {
+        "artifact_id": artifact_id,
+        "path": str(path.relative_to(relative_to)),
+        "sha256": sha256_file(path),
+        "byte_size": path.stat().st_size,
+        "verification": "VERIFIED",
+    }
+
+
+def _write_archive(
+    archive: Path,
+    manifest: Path,
+    database: Path,
+    ledger: Path,
+    *,
+    member_root: str = MEMBER_ROOT,
+) -> None:
+    with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED) as handle:
+        for member in (manifest, database, ledger):
+            handle.write(member, f"{member_root}/{member.name}")
+
+
+def build_release_fixture(
+    root: Path,
+    *,
+    include_stale_collision: bool = False,
+    authorize_supersession: bool = False,
+) -> tuple[Path, Path]:
+    current = root / "current"
+    current.mkdir(parents=True)
+    database = current / "XHIGH_EXTERNAL_EVIDENCE_TEST.sqlite"
+    manifest = current / "XHIGH_MODULE_MANIFEST_TEST.json"
+    ledger = current / "XHIGH_SHA256SUMS_TEST.json"
+    archive = current / "Perfume_Chem_External_Evidence_XHIGH_RELEASE_CANDIDATE.zip"
+
+    _make_external_database(database)
+    manifest.write_bytes(
+        canonical_json_bytes(
+            {
+                "release_candidate_version": RELEASE_ID,
+                "freeze_state": RELEASE_STATE,
+                "generated_at_utc": GENERATED_AT_UTC,
+                "database": [database.name],
+                "sha256_ledger": ledger.name,
+            }
+        )
+    )
+    ledger.write_bytes(
+        canonical_json_bytes(
+            {
+                "generated_at_utc": GENERATED_AT_UTC,
+                "files": [
+                    {
+                        "path": manifest.name,
+                        "bytes": manifest.stat().st_size,
+                        "sha256": sha256_file(manifest),
+                    },
+                    {
+                        "path": database.name,
+                        "bytes": database.stat().st_size,
+                        "sha256": sha256_file(database),
+                    },
+                ],
+            }
+        )
+    )
+    _write_archive(archive, manifest, database, ledger)
+
+    current_release: dict[str, object] = {
+        "release_id": RELEASE_ID,
+        "canonical": True,
+        "state": RELEASE_STATE,
+        "generated_at_utc": GENERATED_AT_UTC,
+        "archive": _artifact(archive, "ART-XHIGH-TEST-ARCHIVE", relative_to=root),
+        "manifest": _artifact(
+            manifest, "ART-XHIGH-TEST-MANIFEST", relative_to=root
+        ),
+        "database": _artifact(
+            database, "ART-XHIGH-TEST-DATABASE", relative_to=root
+        ),
+        "archive_closure": {
+            "member_root": MEMBER_ROOT,
+            "manifest_member": manifest.name,
+            "database_member": database.name,
+            "sha256_ledger_member": ledger.name,
+        },
+        "supersedes_artifact_ids": (
+            [
+                "ART-XHIGH-OLD-ARCHIVE",
+                "ART-XHIGH-OLD-MANIFEST",
+                "ART-XHIGH-OLD-DATABASE",
+            ]
+            if authorize_supersession
+            else []
+        ),
+    }
+
+    releases = [current_release]
+    if include_stale_collision:
+        ancestry = root / "ancestry"
+        ancestry.mkdir()
+        stale_archive = ancestry / archive.name
+        stale_manifest = ancestry / manifest.name
+        stale_database = ancestry / database.name
+        stale_archive.write_bytes(b"stale archive")
+        stale_manifest.write_bytes(b'{"state":"XHIGH_NOT_FROZEN"}\n')
+        stale_database.write_bytes(b"not a sqlite database")
+        releases.append(
+            {
+                "release_id": "XHIGH-TEST-OLD",
+                "canonical": False,
+                "state": "XHIGH_NOT_FROZEN",
+                "generated_at_utc": "2026-08-07T00:00:00+00:00",
+                "archive": _artifact(
+                    stale_archive, "ART-XHIGH-OLD-ARCHIVE", relative_to=root
+                ),
+                "manifest": _artifact(
+                    stale_manifest, "ART-XHIGH-OLD-MANIFEST", relative_to=root
+                ),
+                "database": _artifact(
+                    stale_database, "ART-XHIGH-OLD-DATABASE", relative_to=root
+                ),
+                "supersedes_artifact_ids": [],
+            }
+        )
+
+    index = root / "XHIGH_RELEASE_INDEX.json"
+    index.write_bytes(
+        canonical_json_bytes(
+            {
+                "schema_version": "2.0",
+                "index_id": "IDX-XHIGH-TEST-RC1",
+                "releases": releases,
+            }
+        )
+    )
+    return index, database
+
+
+def _settings(index: Path, *, enabled: bool = True) -> SimpleNamespace:
+    return SimpleNamespace(
+        PERFUME_CHEM_EXTERNAL_EVIDENCE_ENABLED=enabled,
+        PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ROOT=str(index.parent),
+        PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX=str(index),
+        PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX_SHA256=sha256_file(index),
+        PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ID=RELEASE_ID,
+        PERFUME_CHEM_EXTERNAL_EVIDENCE_MAX_QUERY_ROWS=200,
+    )
+
+
+def _select(index: Path):
+    return select_release(
+        index,
+        RELEASE_ID,
+        expected_index_sha256=sha256_file(index),
+        release_root=index.parent,
+    )
+
+
+def _table_hashes(path: Path) -> dict[str, str]:
+    connection = sqlite3.connect(path)
+    connection.row_factory = sqlite3.Row
+    try:
+        names = [
+            row[0]
+            for row in connection.execute(
+                "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
+            )
+            if not str(row[0]).startswith("sqlite_")
+        ]
+        result: dict[str, str] = {}
+        for name in names:
+            rows = [
+                dict(row)
+                for row in connection.execute(
+                    f'SELECT * FROM "{name}" ORDER BY 1'
+                ).fetchall()
+            ]
+            result[name] = hashlib.sha256(canonical_json_bytes(rows)).hexdigest()
+        return result
+    finally:
+        connection.close()
+
+
+def test_feature_flag_defaults_to_disabled(tmp_path: Path) -> None:
+    index, _database = build_release_fixture(tmp_path)
+    with pytest.raises(ExternalEvidenceDisabledError):
+        ExternalEvidenceProvider.from_settings(_settings(index, enabled=False))
+
+
+def test_release_selection_and_deterministic_reads(tmp_path: Path) -> None:
+    index, _database = build_release_fixture(tmp_path)
+    provider = ExternalEvidenceProvider.from_settings(_settings(index))
+
+    health = provider.health()
+    assert health["access_mode"] == "READ_ONLY"
+    assert health["query_only"] is True
+    assert health["quick_check"] == "ok"
+    assert health["foreign_key_violations"] == 0
+    assert health["archive_crc_verified"] is True
+    assert health["archive_member_count"] == 3
+    assert health["archive_ledger_entries_verified"] == 2
+
+    first = provider.query_evidence("ee_claim", limit=100)
+    second = provider.query_evidence("ee_claim", limit=100)
+    assert first == second
+    assert first["row_count"] == 2
+    assert first["rows_sha256"] == second["rows_sha256"]
+
+    experiments = provider.query_controlled_experiments(status="PROPOSED")
+    assert [row["experiment_id"] for row in experiments["rows"]] == ["EXP-1"]
+
+
+def test_all_mutation_and_promotion_operations_fail_closed(tmp_path: Path) -> None:
+    index, _database = build_release_fixture(tmp_path)
+    provider = ExternalEvidenceProvider.from_settings(_settings(index))
+    forbidden = (
+        "write_formula",
+        "append_inventory_event",
+        "write_bottle",
+        "promote_observation",
