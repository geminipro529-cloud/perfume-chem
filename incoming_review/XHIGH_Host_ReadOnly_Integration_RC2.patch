+def _load_index(index: Path) -> dict:
+    return json.loads(index.read_text(encoding="utf-8"))
+
+
+def _write_index(index: Path, payload: dict) -> str:
+    index.write_bytes(canonical_json_bytes(payload))
+    return sha256_file(index)
+
+
+def _select(index: Path, expected_index_sha256: str):
+    return select_release(
+        index,
+        RELEASE_ID,
+        expected_index_sha256=expected_index_sha256,
+        release_root=index.parent,
+    )
+
+
+def _selected(payload: dict) -> dict:
+    return payload["releases"][0]
+
+
+def _refresh_artifact_descriptor(descriptor: dict, path: Path, root: Path) -> None:
+    descriptor.update(
+        {
+            "path": str(path.relative_to(root)),
+            "sha256": sha256_file(path),
+            "byte_size": path.stat().st_size,
+            "verification": "VERIFIED",
+        }
+    )
+
