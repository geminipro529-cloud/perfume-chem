+++ b/backend/app/external_evidence/provider.py
@@ -0,0 +1,173 @@
+"""Repository-facing read-only provider for XHIGH external evidence."""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from app.core.config import Settings
+from app.external_evidence.contracts import ReleaseBinding
+from app.external_evidence.errors import (
+    ExternalEvidenceConfigurationError,
+    ExternalEvidenceDisabledError,
+    ExternalEvidenceMutationDeniedError,
+    ExternalEvidenceQueryError,
+)
+from app.external_evidence.release_selector import select_release
+from app.external_evidence.sqlite_store import ReadOnlySQLiteStore
+
+_READ_OPERATIONS = frozenset(
+    {
+        "health",
+        "list_objects",
+        "query_evidence",
+        "query_controlled_experiments",
+    }
+)
+
+
+class ExternalEvidenceProvider:
+    """Read-only facade with no dependency on canonical host write services."""
+
+    def __init__(
+        self,
+        binding: ReleaseBinding,
+        *,
+        max_query_rows: int = 200,
+    ):
+        self.binding = binding
+        self.store = ReadOnlySQLiteStore(
+            binding.database.path,
+            binding.database.sha256,
+            max_query_rows=max_query_rows,
+        )
+
+    @classmethod
+    def from_settings(cls, settings: Settings) -> "ExternalEvidenceProvider":
+        if not settings.PERFUME_CHEM_EXTERNAL_EVIDENCE_ENABLED:
+            raise ExternalEvidenceDisabledError(
+                "PERFUME_CHEM_EXTERNAL_EVIDENCE_ENABLED is false"
+            )
+        release_root = settings.PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ROOT
+        index_path = settings.PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX
+        index_sha256 = settings.PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX_SHA256
+        if not release_root:
+            raise ExternalEvidenceConfigurationError(
+                "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ROOT is required when enabled"
+            )
+        if not index_path:
+            raise ExternalEvidenceConfigurationError(
+                "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX is required when enabled"
+            )
+        if not index_sha256:
+            raise ExternalEvidenceConfigurationError(
+                "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX_SHA256 is required when enabled"
+            )
+
+        binding = select_release(
+            index_path,
+            settings.PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ID,
+            expected_index_sha256=index_sha256,
+            release_root=release_root,
+        )
+        return cls(
+            binding,
+            max_query_rows=settings.PERFUME_CHEM_EXTERNAL_EVIDENCE_MAX_QUERY_ROWS,
+        )
+
+    def health(self) -> dict[str, Any]:
+        result = self.store.health()
+        result.update(
+            {
+                "enabled": True,
+                "access_mode": "READ_ONLY",
+                "release_id": self.binding.release_id,
+                "release_state": self.binding.state,
+                "release_generated_at_utc": self.binding.generated_at_utc,
+                "release_index_sha256": self.binding.index_sha256,
+                "archive_sha256": self.binding.archive.sha256,
+                "manifest_sha256": self.binding.manifest.sha256,
+                "archive_crc_verified": self.binding.archive_closure.crc_verified,
+                "archive_member_count": self.binding.archive_closure.archive_member_count,
+                "archive_ledger_entries_verified": (
+                    self.binding.archive_closure.ledger_entries_verified
+                ),
+                "archive_sha256_ledger_sha256": (
+                    self.binding.archive_closure.sha256_ledger_sha256
+                ),
+            }
+        )
+        return result
+
+    def list_objects(self) -> dict[str, Any]:
+        objects = self.store.list_objects()
+        return {
+            "release_id": self.binding.release_id,
+            "object_count": len(objects),
+            "objects": objects,
+        }
+
+    def query_evidence(
+        self,
+        object_name: str,
+        filters: Mapping[str, Any] | None = None,
+        *,
+        limit: int = 100,
+        offset: int = 0,
+    ) -> dict[str, Any]:
+        result = self.store.query(
+            object_name,
+            filters,
+            limit=limit,
+            offset=offset,
+        )
+        result["release_id"] = self.binding.release_id
+        return result
+
+    def query_controlled_experiments(
+        self,
+        *,
+        status: str | None = None,
+        limit: int = 100,
+        offset: int = 0,
+    ) -> dict[str, Any]:
+        objects = {item["name"] for item in self.store.list_objects()}
+        object_name = next(
+            (
+                candidate
+                for candidate in (
+                    "ee_experiment",
+                    "ee_experiments",
+                    "ee_controlled_experiment",
+                    "ee_controlled_experiments",
+                )
+                if candidate in objects
+            ),
+            None,
+        )
+        if object_name is None:
+            raise ExternalEvidenceQueryError(
+                "the selected release has no controlled-experiment object"
+            )
+        filters = {"status": status} if status is not None else None
+        return self.query_evidence(
+            object_name,
+            filters,
+            limit=limit,
+            offset=offset,
+        )
+
+    def dispatch(self, operation: str, **kwargs: Any) -> dict[str, Any]:
+        """Expose an explicit operation allowlist and deny everything else."""
+        if operation not in _READ_OPERATIONS:
+            raise ExternalEvidenceMutationDeniedError(
+                f"operation {operation!r} is not in the read-only allowlist"
+            )
+        if operation == "health":
+            return self.health()
+        if operation == "list_objects":
+            return self.list_objects()
+        if operation == "query_evidence":
+            return self.query_evidence(**kwargs)
+        if operation == "query_controlled_experiments":
+            return self.query_controlled_experiments(**kwargs)
+        raise AssertionError("unreachable read operation")
diff --git a/backend/app/external_evidence/release_selector.py b/backend/app/external_evidence/release_selector.py
new file mode 100644
index 0000000000000000000000000000000000000000..9337bb3a9d48d63fdd3a2d72cebdb85ff51cedb2
--- /dev/null
+++ b/backend/app/external_evidence/release_selector.py
@@ -0,0 +1,291 @@
+"""Fail-closed release selection for one externally pinned XHIGH release."""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+from typing import Any, Mapping
+
+from app.external_evidence.archive_verifier import verify_archive_closure
+from app.external_evidence.contracts import ArchiveClosure, ArtifactRef, ReleaseBinding
+from app.external_evidence.errors import (
+    ExternalEvidenceConfigurationError,
+    ExternalEvidenceIntegrityError,
+    ExternalEvidenceSelectionError,
+)
+from app.external_evidence.hashing import sha256_bytes, sha256_file
+from app.external_evidence.path_security import (
+    resolve_artifact_path,
+    resolve_index_path,
+    resolve_release_root,
+)
+
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+_ALLOWED_RELEASE_STATES = {
+    "XHIGH_FROZEN_FOR_PRO_REVIEW",
+    "REMEDIATION_READY_FOR_INDEPENDENT_PRO_RERUN",
+}
+_ALLOWED_ANCESTRY_STATES = {
+    "ANCESTRY_ONLY",
+    "SUPERSEDED",
+    "XHIGH_NOT_FROZEN",
+}
+_ARTIFACT_KINDS = ("archive", "manifest", "database")
+
+
+def _require_mapping(value: Any, label: str) -> Mapping[str, Any]:
+    if not isinstance(value, Mapping):
+        raise ExternalEvidenceSelectionError(f"{label} must be an object")
+    return value
+
+
+def _normalize_expected_sha256(value: str | None, label: str) -> str:
+    normalized = str(value or "").strip().lower()
+    if not normalized:
+        raise ExternalEvidenceConfigurationError(f"{label} is required when enabled")
+    if not _SHA256_RE.fullmatch(normalized):
+        raise ExternalEvidenceConfigurationError(
+            f"{label} must be 64 hexadecimal characters"
+        )
+    return normalized
+
+
+def _artifact_metadata(raw: Mapping[str, Any], kind: str) -> tuple[str, str, str]:
+    artifact = _require_mapping(raw.get(kind), f"{kind} descriptor")
+    artifact_id = str(artifact.get("artifact_id", "")).strip()
+    path_text = str(artifact.get("path", "")).strip()
+    sha256 = str(artifact.get("sha256", "")).strip().lower()
+    if not artifact_id:
+        raise ExternalEvidenceSelectionError(f"{kind}.artifact_id is required")
+    if not path_text:
+        raise ExternalEvidenceSelectionError(f"{kind}.path is required")
+    if not _SHA256_RE.fullmatch(sha256):
+        raise ExternalEvidenceSelectionError(
+            f"{kind}.sha256 must be 64 lowercase hex characters"
+        )
+    return artifact_id, path_text, sha256
+
+
+def _resolve_artifact(
+    release_root: Path,
+    raw: Mapping[str, Any],
+    kind: str,
+) -> ArtifactRef:
+    artifact = _require_mapping(raw.get(kind), f"{kind} descriptor")
+    artifact_id, path_text, expected_sha256 = _artifact_metadata(raw, kind)
+    verification = str(artifact.get("verification", "")).strip()
+    if verification != "VERIFIED":
+        raise ExternalEvidenceIntegrityError(
+            f"{kind} {artifact_id} is not marked VERIFIED"
+        )
+
+    declared_size = artifact.get("byte_size")
+    if not isinstance(declared_size, int) or declared_size < 0:
+        raise ExternalEvidenceSelectionError(
+            f"{kind}.byte_size must be a nonnegative integer"
+        )
+
+    path = resolve_artifact_path(release_root, path_text, kind)
+    observed_size = path.stat().st_size
+    if observed_size != declared_size:
+        raise ExternalEvidenceIntegrityError(
+            f"{kind} byte-size mismatch: expected {declared_size}, "
+            f"observed {observed_size}"
+        )
+
+    observed_sha256 = sha256_file(path)
+    if observed_sha256 != expected_sha256:
+        raise ExternalEvidenceIntegrityError(
+            f"{kind} SHA-256 mismatch: expected {expected_sha256}, "
+            f"observed {observed_sha256}"
+        )
+
+    return ArtifactRef(
+        artifact_id=artifact_id,
+        path=path,
+        sha256=observed_sha256,
+        byte_size=observed_size,
+        verification=verification,
+    )
+
+
+def _validate_index_collisions(
+    releases: list[Mapping[str, Any]],
+    selected: Mapping[str, Any],
+) -> None:
+    """Reject unresolved same-basename ancestry and duplicate artifact IDs."""
+    selected_artifact_ids = {
+        kind: _artifact_metadata(selected, kind)[0] for kind in _ARTIFACT_KINDS
+    }
+    selected_supersedes = {
+        str(item)
+        for item in selected.get("supersedes_artifact_ids", [])
+        if str(item).strip()
+    }
+
+    seen_ids: dict[str, tuple[str, str]] = {}
+    records: list[tuple[str, str, str, str, bool, str]] = []
+
+    for release in releases:
+        state = str(release.get("state", "")).strip()
+        canonical = release.get("canonical") is True
+        for kind in _ARTIFACT_KINDS:
+            artifact_id, path_text, sha256 = _artifact_metadata(release, kind)
+            prior = seen_ids.get(artifact_id)
+            identity = (kind, sha256)
+            if prior is not None and prior != identity:
+                raise ExternalEvidenceSelectionError(
+                    f"artifact_id {artifact_id!r} is reused with different content"
+                )
+            seen_ids[artifact_id] = identity
+            records.append(
+                (
+                    kind,
+                    Path(path_text).name,
+                    artifact_id,
+                    sha256,
+                    canonical,
+                    state,
+                )
+            )
+
+    for kind, selected_id in selected_artifact_ids.items():
+        selected_record = next(
+            record for record in records if record[0] == kind and record[2] == selected_id
+        )
+        selected_basename = selected_record[1]
+        for record in records:
+            other_kind, basename, artifact_id, _sha256, canonical, state = record
+            if (
+                other_kind != kind
+                or basename != selected_basename
+                or artifact_id == selected_id
+            ):
+                continue
+            if canonical:
+                raise ExternalEvidenceSelectionError(
+                    f"multiple canonical {kind} artifacts share basename "
+                    f"{basename!r}"
+                )
+            if (
+                artifact_id not in selected_supersedes
+                or state not in _ALLOWED_ANCESTRY_STATES
+            ):
+                raise ExternalEvidenceSelectionError(
+                    f"unresolved stale {kind} basename collision for "
+                    f"{basename!r}: {artifact_id!r}"
+                )
+
+
+def select_release(
+    index_path: str | Path,
+    release_id: str,
+    *,
+    expected_index_sha256: str | None,
+    release_root: str | Path | None,
+) -> ReleaseBinding:
+    """Select exactly one XHIGH release using an external index trust anchor."""
+    root_path = resolve_release_root(release_root)
+    path = resolve_index_path(root_path, index_path)
+    expected_index_hash = _normalize_expected_sha256(
+        expected_index_sha256,
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX_SHA256",
+    )
+
+    try:
+        index_bytes = path.read_bytes()
+    except OSError as exc:
+        raise ExternalEvidenceSelectionError(
+            f"release index cannot be read: {exc}"
+        ) from exc
+    observed_index_hash = sha256_bytes(index_bytes)
+    if observed_index_hash != expected_index_hash:
+        raise ExternalEvidenceIntegrityError(
+            "release index SHA-256 does not match the external trust anchor"
+        )
+
+    try:
+        payload = json.loads(index_bytes.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ExternalEvidenceSelectionError(
+            f"release index cannot be parsed: {exc}"
+        ) from exc
+
+    root = _require_mapping(payload, "release index")
+    if str(root.get("schema_version", "")).strip() != "2.0":
+        raise ExternalEvidenceSelectionError(
+            "release index schema_version must be exactly '2.0'"
+        )
+    if not str(root.get("index_id", "")).strip():
+        raise ExternalEvidenceSelectionError("release index index_id is required")
+    releases_raw = root.get("releases")
+    if not isinstance(releases_raw, list) or not releases_raw:
+        raise ExternalEvidenceSelectionError(
+            "release index must contain a nonempty releases array"
+        )
+
+    releases = [_require_mapping(item, "release entry") for item in releases_raw]
+    matches = [
+        item
+        for item in releases
+        if str(item.get("release_id", "")).strip() == release_id
+    ]
+    if len(matches) != 1:
+        raise ExternalEvidenceSelectionError(
+            f"release_id {release_id!r} resolved {len(matches)} candidates; "
+            "exactly one is required"
+        )
+
+    selected = matches[0]
+    if selected.get("canonical") is not True:
+        raise ExternalEvidenceSelectionError("selected release is not canonical")
+
+    state = str(selected.get("state", "")).strip()
+    if state not in _ALLOWED_RELEASE_STATES:
+        raise ExternalEvidenceSelectionError(
+            f"selected release state {state!r} is not deployable"
+        )
+
+    generated_at_utc = str(selected.get("generated_at_utc", "")).strip()
+    if not generated_at_utc:
+        raise ExternalEvidenceSelectionError(
+            "selected release generated_at_utc is required"
+        )
+
+    _validate_index_collisions(releases, selected)
+
+    archive = _resolve_artifact(root_path, selected, "archive")
+    manifest = _resolve_artifact(root_path, selected, "manifest")
+    database = _resolve_artifact(root_path, selected, "database")
+    closure_receipt = verify_archive_closure(
+        raw_release=selected,
+        release_id=release_id,
+        state=state,
+        generated_at_utc=generated_at_utc,
+        archive_ref=archive,
+        manifest_ref=manifest,
+        database_ref=database,
+    )
+
+    return ReleaseBinding(
+        release_id=release_id,
+        state=state,
+        generated_at_utc=generated_at_utc,
+        release_root=root_path,
+        index_path=path,
+        index_sha256=observed_index_hash,
+        archive=archive,
+        manifest=manifest,
+        database=database,
+        archive_closure=ArchiveClosure(
+            member_root=closure_receipt.member_root,
+            manifest_member=closure_receipt.manifest_member,
+            database_member=closure_receipt.database_member,
+            sha256_ledger_member=closure_receipt.sha256_ledger_member,
+            sha256_ledger_sha256=closure_receipt.sha256_ledger_sha256,
+            archive_member_count=closure_receipt.archive_member_count,
+            ledger_entries_verified=closure_receipt.ledger_entries_verified,
+            crc_verified=closure_receipt.crc_verified,
+        ),
+    )
