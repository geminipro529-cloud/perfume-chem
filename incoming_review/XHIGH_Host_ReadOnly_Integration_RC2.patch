+def test_archive_crc_corruption_fails_closed(tmp_path: Path) -> None:
+    index, database = build_release_fixture(tmp_path)
+    current = tmp_path / "current"
+    manifest = current / "XHIGH_MODULE_MANIFEST_TEST.json"
+    ledger = current / "XHIGH_SHA256SUMS_TEST.json"
+    archive = current / "Perfume_Chem_External_Evidence_XHIGH_RELEASE_CANDIDATE.zip"
+
+    with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_STORED) as handle:
+        for member in (manifest, database, ledger):
+            handle.write(member, f"{MEMBER_ROOT}/{member.name}")
+
+    database_member = f"{MEMBER_ROOT}/{database.name}"
+    with zipfile.ZipFile(archive, "r") as handle:
+        info = handle.getinfo(database_member)
+        header_offset = info.header_offset
+
+    with archive.open("r+b") as handle:
+        handle.seek(header_offset)
+        header = handle.read(30)
+        (
+            signature,
+            _version,
+            _flags,
+            _compression,
+            _time,
+            _date,
+            _crc,
+            _compressed_size,
+            _file_size,
+            filename_length,
+            extra_length,
+        ) = struct.unpack("<IHHHHHIIIHH", header)
+        assert signature == 0x04034B50
+        data_offset = header_offset + 30 + filename_length + extra_length
+        handle.seek(data_offset)
+        original = handle.read(1)
+        assert original
+        handle.seek(data_offset)
+        handle.write(bytes([original[0] ^ 0x01]))
+
+    payload = _load_index(index)
+    release = _selected(payload)
+    _refresh_artifact_descriptor(release["archive"], archive, tmp_path)
+    trusted_sha256 = _write_index(index, payload)
+
+    with pytest.raises(ExternalEvidenceIntegrityError, match="CRC"):
+        _select(index, trusted_sha256)
