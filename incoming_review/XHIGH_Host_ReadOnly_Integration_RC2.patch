+    """Raised when an exact file hash, byte size, or SQLite check fails."""
+
+
+class ExternalEvidenceSelectionError(ExternalEvidenceError):
+    """Raised when immutable release selection is ambiguous or stale."""
+
+
+class ExternalEvidenceQueryError(ExternalEvidenceError):
