index 0000000000000000000000000000000000000000..b13782cf60d81b102fa963e600a7e4d8c068ee1b
--- /dev/null
+++ b/backend/app/external_evidence/path_security.py
@@ -0,0 +1,114 @@
+"""Path confinement and symlink rejection for immutable XHIGH releases."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from app.external_evidence.errors import (
+    ExternalEvidenceConfigurationError,
+    ExternalEvidenceIntegrityError,
+    ExternalEvidenceSelectionError,
+)
+
+
+def resolve_release_root(value: str | Path | None) -> Path:
+    """Resolve one configured directory without accepting a symlink root."""
+    if value is None or not str(value).strip():
+        raise ExternalEvidenceConfigurationError(
+            "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ROOT is required when enabled"
+        )
+    raw = Path(value).expanduser()
+    if raw.is_symlink():
+        raise ExternalEvidenceConfigurationError("release root cannot be a symlink")
+    try:
+        resolved = raw.resolve(strict=True)
+    except OSError as exc:
+        raise ExternalEvidenceConfigurationError(
+            f"release root cannot be resolved: {exc}"
+        ) from exc
+    if not resolved.is_dir():
+        raise ExternalEvidenceConfigurationError(
+            f"release root is not a directory: {resolved}"
+        )
+    return resolved
+
+
+def _reject_symlink_chain(root: Path, target: Path, label: str) -> None:
+    try:
+        relative = target.relative_to(root)
+    except ValueError as exc:
+        raise ExternalEvidenceSelectionError(
+            f"{label} escapes configured release root"
+        ) from exc
+
+    current = root
+    for part in relative.parts:
+        current = current / part
+        try:
+            os.lstat(current)
+        except OSError as exc:
+            raise ExternalEvidenceIntegrityError(
+                f"cannot inspect {label} path component {current}: {exc}"
+            ) from exc
+        if os.path.islink(current):
+            raise ExternalEvidenceSelectionError(
+                f"{label} path contains a symlink: {current}"
+            )
+
+
+def resolve_index_path(release_root: Path, value: str | Path) -> Path:
+    """Resolve the configured index, requiring it to live inside release_root."""
+    raw = Path(value).expanduser()
+    if any(part == ".." for part in raw.parts):
+        raise ExternalEvidenceSelectionError("release index path cannot contain '..'")
+    candidate = raw if raw.is_absolute() else release_root / raw
+    try:
+        lexical = candidate.absolute()
+        lexical.relative_to(release_root)
+    except ValueError as exc:
+        raise ExternalEvidenceSelectionError(
+            "release index is outside configured release root"
+        ) from exc
+    _reject_symlink_chain(release_root, lexical, "release index")
+    try:
+        resolved = lexical.resolve(strict=True)
+    except OSError as exc:
+        raise ExternalEvidenceSelectionError(
+            f"release index cannot be resolved: {exc}"
+        ) from exc
+    if not resolved.is_file():
+        raise ExternalEvidenceSelectionError(f"release index is not a file: {resolved}")
+    return resolved
+
+
+def resolve_artifact_path(release_root: Path, path_text: str, kind: str) -> Path:
+    """Resolve a relative artifact path inside the immutable release root."""
+    if "\x00" in path_text or "\\" in path_text:
+        raise ExternalEvidenceSelectionError(
+            f"{kind}.path must use safe platform-native separators"
+        )
+    raw = Path(path_text)
+    if raw.is_absolute():
+        raise ExternalEvidenceSelectionError(f"{kind}.path must be relative to release root")
+    if any(part in {"", ".", ".."} for part in raw.parts):
+        raise ExternalEvidenceSelectionError(
+            f"{kind}.path is not a safe relative path"
+        )
+    candidate = (release_root / raw).absolute()
+    try:
+        candidate.relative_to(release_root)
+    except ValueError as exc:
+        raise ExternalEvidenceSelectionError(
+            f"{kind}.path escapes configured release root"
+        ) from exc
+    _reject_symlink_chain(release_root, candidate, f"{kind} artifact")
+    try:
+        resolved = candidate.resolve(strict=True)
+    except OSError as exc:
+        raise ExternalEvidenceIntegrityError(
+            f"{kind} file cannot be resolved: {exc}"
+        ) from exc
+    if not resolved.is_file():
+        raise ExternalEvidenceIntegrityError(f"{kind} file does not exist: {resolved}")
+    return resolved
