@@ -0,0 +1,106 @@
+"""GET-only API endpoints for one exact XHIGH external-evidence release."""
+
+from __future__ import annotations
+
+from functools import lru_cache
+from typing import Any
+
+from fastapi import APIRouter, Depends, HTTPException, Query
+
+from app.core.config import get_settings
+from app.external_evidence import (
+    ExternalEvidenceConfigurationError,
+    ExternalEvidenceDisabledError,
+    ExternalEvidenceIntegrityError,
+    ExternalEvidenceProvider,
+    ExternalEvidenceQueryError,
+    ExternalEvidenceSelectionError,
+)
+
+router = APIRouter()
+
+
+@lru_cache(maxsize=1)
+def get_external_evidence_provider() -> ExternalEvidenceProvider:
+    """Build the provider only after the route has been enabled at startup."""
+    return ExternalEvidenceProvider.from_settings(get_settings())
+
+
+def _translate_error(exc: Exception) -> HTTPException:
+    if isinstance(exc, ExternalEvidenceDisabledError):
+        return HTTPException(status_code=404, detail="External evidence is disabled")
+    if isinstance(
+        exc,
+        (
+            ExternalEvidenceConfigurationError,
+            ExternalEvidenceIntegrityError,
+            ExternalEvidenceSelectionError,
+        ),
+    ):
+        return HTTPException(status_code=503, detail=str(exc))
+    if isinstance(exc, ExternalEvidenceQueryError):
+        return HTTPException(status_code=400, detail=str(exc))
+    return HTTPException(status_code=500, detail="External evidence query failed")
+
+
+@router.get("/health")
+def external_evidence_health(
+    provider: ExternalEvidenceProvider = Depends(get_external_evidence_provider),
+) -> dict[str, Any]:
+    try:
+        return provider.health()
+    except Exception as exc:
+        raise _translate_error(exc) from exc
+
+
+@router.get("/objects")
+def external_evidence_objects(
+    provider: ExternalEvidenceProvider = Depends(get_external_evidence_provider),
+) -> dict[str, Any]:
+    try:
+        return provider.list_objects()
+    except Exception as exc:
+        raise _translate_error(exc) from exc
+
+
+@router.get("/records/{object_name}")
+def external_evidence_records(
+    object_name: str,
+    field: str | None = Query(default=None),
+    value: str | None = Query(default=None),
+    limit: int = Query(default=100, ge=1, le=500),
+    offset: int = Query(default=0, ge=0),
+    provider: ExternalEvidenceProvider = Depends(get_external_evidence_provider),
+) -> dict[str, Any]:
+    if (field is None) != (value is None):
+        raise HTTPException(
+            status_code=400,
+            detail="field and value must be supplied together",
+        )
+    filters = {field: value} if field is not None and value is not None else None
+    try:
+        return provider.query_evidence(
+            object_name,
+            filters,
+            limit=limit,
+            offset=offset,
+        )
+    except Exception as exc:
+        raise _translate_error(exc) from exc
+
+
+@router.get("/experiments")
+def external_evidence_experiments(
+    status: str | None = Query(default=None),
+    limit: int = Query(default=100, ge=1, le=500),
+    offset: int = Query(default=0, ge=0),
+    provider: ExternalEvidenceProvider = Depends(get_external_evidence_provider),
+) -> dict[str, Any]:
+    try:
+        return provider.query_controlled_experiments(
+            status=status,
+            limit=limit,
+            offset=offset,
+        )
+    except Exception as exc:
+        raise _translate_error(exc) from exc
