diff --git a/backend/app/external_evidence/archive_verifier.py b/backend/app/external_evidence/archive_verifier.py
new file mode 100644
index 0000000000000000000000000000000000000000..0ab823c03a703887172880549e3768444a8d9838
--- /dev/null
+++ b/backend/app/external_evidence/archive_verifier.py
@@ -0,0 +1,347 @@
+"""Sealed-archive verification for one exact XHIGH release."""
+
+from __future__ import annotations
+
+import json
+import re
+import zipfile
+from dataclasses import dataclass
+from pathlib import PurePosixPath
+from typing import Any, Mapping
+
+from app.external_evidence.contracts import ArtifactRef
+from app.external_evidence.errors import (
+    ExternalEvidenceIntegrityError,
+    ExternalEvidenceSelectionError,
+)
+from app.external_evidence.hashing import sha256_bytes, sha256_file, sha256_stream
+
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+
+
+@dataclass(frozen=True)
+class ArchiveClosureReceipt:
+    """Proof that the external artifacts belong to one sealed ZIP release."""
+
+    member_root: str
+    manifest_member: str
+    database_member: str
+    sha256_ledger_member: str
+    sha256_ledger_sha256: str
+    archive_member_count: int
+    ledger_entries_verified: int
+    crc_verified: bool
+
+
+def _require_mapping(value: Any, label: str) -> Mapping[str, Any]:
+    if not isinstance(value, Mapping):
+        raise ExternalEvidenceSelectionError(f"{label} must be an object")
+    return value
+
+
+def _safe_member_path(value: Any, label: str) -> str:
+    text = str(value or "").strip()
+    if not text:
+        raise ExternalEvidenceSelectionError(f"{label} is required")
+    if "\\" in text or "\x00" in text:
+        raise ExternalEvidenceSelectionError(f"{label} must use safe POSIX separators")
+    if text.startswith("/"):
+        raise ExternalEvidenceSelectionError(f"{label} must be relative")
+    text = text.rstrip("/")
+    path = PurePosixPath(text)
+    if (
+        path.is_absolute()
+        or any(part in {"", ".", ".."} for part in path.parts)
+        or (path.parts and path.parts[0].endswith(":"))
+    ):
+        raise ExternalEvidenceSelectionError(
+            f"{label} is not a safe relative member path"
+        )
+    return path.as_posix()
+
+
+def _parse_closure(raw_release: Mapping[str, Any]) -> tuple[str, str, str, str]:
+    closure = _require_mapping(raw_release.get("archive_closure"), "archive_closure")
+    member_root = _safe_member_path(closure.get("member_root"), "archive_closure.member_root")
+    manifest_member = _safe_member_path(
+        closure.get("manifest_member"), "archive_closure.manifest_member"
+    )
+    database_member = _safe_member_path(
+        closure.get("database_member"), "archive_closure.database_member"
+    )
+    ledger_member = _safe_member_path(
+        closure.get("sha256_ledger_member"),
+        "archive_closure.sha256_ledger_member",
+    )
+    return member_root, manifest_member, database_member, ledger_member
+
+
+def _full_member(member_root: str, relative_member: str) -> str:
+    return f"{member_root.rstrip('/')}/{relative_member}"
+
+
+def _validate_archive_names(
+    infos: list[zipfile.ZipInfo],
+    member_root: str,
+) -> dict[str, zipfile.ZipInfo]:
+    prefix = member_root.rstrip("/") + "/"
+    by_relative_path: dict[str, zipfile.ZipInfo] = {}
+    seen_full_names: set[str] = set()
+
+    for info in infos:
+        full_name = info.filename
+        if full_name in seen_full_names:
+            raise ExternalEvidenceIntegrityError(
+                f"archive contains duplicate member name: {full_name!r}"
+            )
+        seen_full_names.add(full_name)
+        if info.is_dir():
+            continue
+        if "\\" in full_name or not full_name.startswith(prefix):
+            raise ExternalEvidenceIntegrityError(
+                f"archive member is outside the declared member root: {full_name!r}"
+            )
+        relative = full_name[len(prefix) :]
+        safe_relative = _safe_member_path(relative, f"archive member {full_name!r}")
+        if safe_relative in by_relative_path:
+            raise ExternalEvidenceIntegrityError(
+                f"archive contains duplicate relative member: {safe_relative!r}"
+            )
+        by_relative_path[safe_relative] = info
+
+    if not by_relative_path:
+        raise ExternalEvidenceIntegrityError("archive contains no files under member_root")
+    return by_relative_path
+
+
+def _read_json_member(
+    archive: zipfile.ZipFile,
+    member_name: str,
+    label: str,
+) -> tuple[Mapping[str, Any], bytes]:
+    try:
+        raw = archive.read(member_name)
+    except (KeyError, OSError, zipfile.BadZipFile) as exc:
+        raise ExternalEvidenceIntegrityError(
+            f"cannot read {label} archive member {member_name!r}: {exc}"
+        ) from exc
+    try:
+        payload = json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ExternalEvidenceIntegrityError(
+            f"{label} archive member is not valid UTF-8 JSON: {exc}"
+        ) from exc
+    return _require_mapping(payload, f"{label} archive member"), raw
+
+
+def _ledger_records(payload: Mapping[str, Any]) -> dict[str, tuple[int, str]]:
+    rows = payload.get("files")
+    if not isinstance(rows, list):
+        raise ExternalEvidenceIntegrityError("archive SHA-256 ledger must contain files[]")
+
+    records: dict[str, tuple[int, str]] = {}
+    for index, raw_row in enumerate(rows):
+        row = _require_mapping(raw_row, f"archive SHA-256 ledger row {index}")
+        path = _safe_member_path(row.get("path"), f"archive SHA-256 ledger row {index}.path")
+        byte_size = row.get("bytes")
+        sha256 = str(row.get("sha256", "")).strip().lower()
+        if not isinstance(byte_size, int) or byte_size < 0:
+            raise ExternalEvidenceIntegrityError(
+                f"archive SHA-256 ledger row {index}.bytes must be nonnegative integer"
+            )
+        if not _SHA256_RE.fullmatch(sha256):
+            raise ExternalEvidenceIntegrityError(
+                f"archive SHA-256 ledger row {index}.sha256 is invalid"
+            )
+        if path in records:
+            raise ExternalEvidenceIntegrityError(
+                f"archive SHA-256 ledger duplicates path {path!r}"
+            )
+        records[path] = (byte_size, sha256)
+    return records
+
+
+def _hash_zip_member(archive: zipfile.ZipFile, info: zipfile.ZipInfo) -> str:
+    try:
+        with archive.open(info, "r") as handle:
+            return sha256_stream(handle)
+    except (OSError, RuntimeError, zipfile.BadZipFile) as exc:
+        raise ExternalEvidenceIntegrityError(
+            f"cannot hash archive member {info.filename!r}: {exc}"
+        ) from exc
+
+
+def _validate_manifest_identity(
+    payload: Mapping[str, Any],
+    *,
+    release_id: str,
+    state: str,
+    generated_at_utc: str,
+    database_member: str,
+    ledger_member: str,
+) -> None:
+    release_values = {
+        str(payload[key]).strip()
+        for key in ("release_candidate_version", "release_id")
+        if key in payload and str(payload[key]).strip()
+    }
+    state_values = {
+        str(payload[key]).strip()
+        for key in ("freeze_state", "state")
+        if key in payload and str(payload[key]).strip()
+    }
+    if release_values != {release_id}:
+        raise ExternalEvidenceIntegrityError(
+            "manifest release identity does not match selected release_id"
+        )
+    if state_values != {state}:
+        raise ExternalEvidenceIntegrityError(
+            "manifest release state does not match selected release state"
+        )
+
+    manifest_generated_at = str(payload.get("generated_at_utc", "")).strip()
+    if manifest_generated_at != generated_at_utc:
+        raise ExternalEvidenceIntegrityError(
+            "manifest generated_at_utc does not match selected release"
+        )
+
+    declared_ledger = str(payload.get("sha256_ledger", "")).strip()
+    if declared_ledger != PurePosixPath(ledger_member).name:
+        raise ExternalEvidenceIntegrityError(
+            "manifest sha256_ledger does not match archive closure"
+        )
+
+    declared_database = payload.get("database")
+    if not isinstance(declared_database, list):
+        raise ExternalEvidenceIntegrityError(
+            "manifest database must be a list containing the selected member"
+        )
+    names = {str(item).strip() for item in declared_database}
+    if PurePosixPath(database_member).name not in names:
+        raise ExternalEvidenceIntegrityError(
+            "manifest database list does not contain the selected database member"
+        )
+
+
+def verify_archive_closure(
+    *,
+    raw_release: Mapping[str, Any],
+    release_id: str,
+    state: str,
+    generated_at_utc: str,
+    archive_ref: ArtifactRef,
+    manifest_ref: ArtifactRef,
+    database_ref: ArtifactRef,
+) -> ArchiveClosureReceipt:
+    """Verify CRC, full member ledger, and archive/external artifact closure."""
+    member_root, manifest_member, database_member, ledger_member = _parse_closure(
+        raw_release
+    )
+    manifest_full = _full_member(member_root, manifest_member)
+    ledger_full = _full_member(member_root, ledger_member)
+
+    try:
+        archive = zipfile.ZipFile(archive_ref.path, "r")
+    except (OSError, zipfile.BadZipFile) as exc:
+        raise ExternalEvidenceIntegrityError(f"cannot open release archive: {exc}") from exc
+
+    with archive:
+        try:
+            bad_member = archive.testzip()
+        except (OSError, RuntimeError, zipfile.BadZipFile) as exc:
+            raise ExternalEvidenceIntegrityError(
+                f"release archive CRC verification failed: {exc}"
+            ) from exc
+        if bad_member is not None:
+            raise ExternalEvidenceIntegrityError(
+                f"release archive CRC mismatch at member {bad_member!r}"
+            )
+
+        member_infos = _validate_archive_names(archive.infolist(), member_root)
+        for required in (manifest_member, database_member, ledger_member):
+            if required not in member_infos:
+                raise ExternalEvidenceIntegrityError(
+                    f"release archive is missing required member {required!r}"
+                )
+
+        ledger_payload, ledger_bytes = _read_json_member(
+            archive, ledger_full, "SHA-256 ledger"
+        )
+        ledger_records = _ledger_records(ledger_payload)
+        if ledger_member in ledger_records:
+            raise ExternalEvidenceIntegrityError(
+                "archive SHA-256 ledger cannot self-list its own member"
+            )
+
+        expected_ledger_paths = set(member_infos) - {ledger_member}
+        if set(ledger_records) != expected_ledger_paths:
+            missing = sorted(expected_ledger_paths - set(ledger_records))
+            extra = sorted(set(ledger_records) - expected_ledger_paths)
+            raise ExternalEvidenceIntegrityError(
+                "archive SHA-256 ledger member closure failed: "
+                f"missing={missing}, extra={extra}"
+            )
+
+        for relative_path, (declared_size, declared_sha256) in sorted(
+            ledger_records.items()
+        ):
+            info = member_infos[relative_path]
+            if info.file_size != declared_size:
+                raise ExternalEvidenceIntegrityError(
+                    f"archive member size mismatch for {relative_path!r}: "
+                    f"ledger={declared_size}, archive={info.file_size}"
+                )
+            observed_sha256 = _hash_zip_member(archive, info)
+            if observed_sha256 != declared_sha256:
+                raise ExternalEvidenceIntegrityError(
+                    f"archive member SHA-256 mismatch for {relative_path!r}"
+                )
+
+        manifest_size, manifest_sha256 = ledger_records[manifest_member]
+        database_size, database_sha256 = ledger_records[database_member]
+        if (manifest_size, manifest_sha256) != (
+            manifest_ref.byte_size,
+            manifest_ref.sha256,
+        ):
+            raise ExternalEvidenceIntegrityError(
+                "external manifest does not match the sealed archive member"
+            )
+        if (database_size, database_sha256) != (
+            database_ref.byte_size,
+            database_ref.sha256,
+        ):
+            raise ExternalEvidenceIntegrityError(
+                "external database does not match the sealed archive member"
+            )
+
+        manifest_payload, manifest_bytes = _read_json_member(
+            archive, manifest_full, "manifest"
+        )
+        if sha256_bytes(manifest_bytes) != manifest_ref.sha256:
+            raise ExternalEvidenceIntegrityError(
+                "manifest archive member hash does not match external manifest"
+            )
+        _validate_manifest_identity(
+            manifest_payload,
+            release_id=release_id,
+            state=state,
+            generated_at_utc=generated_at_utc,
+            database_member=database_member,
+            ledger_member=ledger_member,
+        )
+
+    if sha256_file(archive_ref.path) != archive_ref.sha256:
+        raise ExternalEvidenceIntegrityError(
+            "release archive SHA-256 changed during closure verification"
+        )
+
+    return ArchiveClosureReceipt(
+        member_root=member_root,
+        manifest_member=manifest_member,
+        database_member=database_member,
+        sha256_ledger_member=ledger_member,
+        sha256_ledger_sha256=sha256_bytes(ledger_bytes),
+        archive_member_count=len(member_infos),
+        ledger_entries_verified=len(ledger_records),
+        crc_verified=True,
+    )
