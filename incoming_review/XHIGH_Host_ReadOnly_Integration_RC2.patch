+"""GET-only route tests for XHIGH external evidence."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import httpx
+import pytest
+from fastapi import FastAPI
+
+from app.api.v1.endpoints.external_evidence import (
+    get_external_evidence_provider,
+    router,
+)
+from app.core.config import get_settings
+from app.external_evidence.hashing import sha256_file
+from app.external_evidence.provider import ExternalEvidenceProvider
+from tests.test_external_evidence_adapter import RELEASE_ID, build_release_fixture
+
+
+@pytest.mark.asyncio
+async def test_get_only_api_surface_and_queries(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    index, _database = build_release_fixture(tmp_path)
+    monkeypatch.setenv("PERFUME_CHEM_EXTERNAL_EVIDENCE_ENABLED", "true")
+    monkeypatch.setenv(
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ROOT",
+        str(index.parent),
+    )
+    monkeypatch.setenv(
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX",
+        str(index),
+    )
+    monkeypatch.setenv(
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX_SHA256",
+        sha256_file(index),
+    )
+    monkeypatch.setenv(
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ID",
+        RELEASE_ID,
+    )
+    get_settings.cache_clear()
+    get_external_evidence_provider.cache_clear()
+
+    app = FastAPI()
+    app.include_router(router, prefix="/external-evidence")
+    for route in app.routes:
+        if getattr(route, "path", "").startswith("/external-evidence"):
+            assert set(route.methods or ()) <= {"GET"}
+
+    transport = httpx.ASGITransport(app=app)
+    async with httpx.AsyncClient(
+        transport=transport,
+        base_url="http://test",
+    ) as client:
+        health = await client.get("/external-evidence/health")
+        assert health.status_code == 200
+        assert health.json()["access_mode"] == "READ_ONLY"
+
+        records = await client.get(
+            "/external-evidence/records/ee_claim",
+            params={"field": "claim_scope", "value": "RECEPTOR_MECHANISM"},
+        )
+        assert records.status_code == 200
+        assert records.json()["row_count"] == 1
+
+        experiments = await client.get(
+            "/external-evidence/experiments",
+            params={"status": "LOCKED_DESIGN"},
+        )
+        assert experiments.status_code == 200
+        assert experiments.json()["rows"][0]["experiment_id"] == "EXP-2"
+
+        assert (await client.post("/external-evidence/health")).status_code == 405
+        assert (await client.delete("/external-evidence/records/ee_claim")).status_code == 405
+
+    get_settings.cache_clear()
+    get_external_evidence_provider.cache_clear()
+
+
+def test_default_settings_are_off(monkeypatch: pytest.MonkeyPatch) -> None:
+    for name in (
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_ENABLED",
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ROOT",
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX",
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_INDEX_SHA256",
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_RELEASE_ID",
+        "PERFUME_CHEM_EXTERNAL_EVIDENCE_MAX_QUERY_ROWS",
+    ):
+        monkeypatch.delenv(name, raising=False)
+    get_settings.cache_clear()
+    settings = get_settings()
+    assert settings.PERFUME_CHEM_EXTERNAL_EVIDENCE_ENABLED is False
+    with pytest.raises(Exception):
+        ExternalEvidenceProvider.from_settings(settings)
+    get_settings.cache_clear()
