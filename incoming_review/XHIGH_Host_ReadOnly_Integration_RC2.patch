+++ b/backend/app/external_evidence/hashing.py
@@ -0,0 +1,49 @@
+"""Deterministic hashing helpers for release and query verification."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, BinaryIO, Iterable, Mapping
+
+
+def sha256_stream(handle: BinaryIO) -> str:
+    """Return SHA-256 for bytes read from a binary stream."""
+    digest = hashlib.sha256()
+    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+        digest.update(chunk)
+    return digest.hexdigest()
+
+
+def sha256_bytes(value: bytes) -> str:
+    """Return SHA-256 for one exact byte string."""
+    return hashlib.sha256(value).hexdigest()
+
+
+def sha256_file(path: Path) -> str:
+    """Return SHA-256 for exact file bytes."""
+    with path.open("rb") as handle:
+        return sha256_stream(handle)
+
+
+def canonical_json_bytes(value: Any) -> bytes:
+    """Serialize stable JSON for local receipts.
+
+    Exact scientific decimals must remain strings in upstream records. This
+    helper does not reinterpret numeric values.
+    """
+    return (
+        json.dumps(
+            value,
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        + "\n"
+    ).encode("utf-8")
+
+
+def canonical_rows_sha256(rows: Iterable[Mapping[str, Any]]) -> str:
+    """Hash a deterministic row sequence without changing row values."""
+    return hashlib.sha256(canonical_json_bytes(list(rows))).hexdigest()
