@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Verify one XHIGH release index and its read-only external database."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+BACKEND_ROOT = Path(__file__).resolve().parents[1]
+if str(BACKEND_ROOT) not in sys.path:
+    sys.path.insert(0, str(BACKEND_ROOT))
+
+from app.external_evidence.release_selector import select_release  # noqa: E402
+from app.external_evidence.sqlite_store import ReadOnlySQLiteStore  # noqa: E402
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--index", required=True, help="Path to immutable release index JSON")
+    parser.add_argument("--release-id", required=True)
+    parser.add_argument(
+        "--release-root",
+        required=True,
+        help="Configured immutable release root containing the index and artifacts",
+    )
+    parser.add_argument(
+        "--index-sha256",
+        required=True,
+        help="Externally pinned SHA-256 of the exact release index bytes",
+    )
+    args = parser.parse_args()
+
+    binding = select_release(
+        args.index,
+        args.release_id,
+        expected_index_sha256=args.index_sha256,
+        release_root=args.release_root,
+    )
+    store = ReadOnlySQLiteStore(binding.database.path, binding.database.sha256)
+    result = {
+        "release_id": binding.release_id,
+        "release_state": binding.state,
+        "index_sha256": binding.index_sha256,
+        "archive_sha256": binding.archive.sha256,
+        "manifest_sha256": binding.manifest.sha256,
+        "database_sha256": binding.database.sha256,
+        "archive_crc_verified": binding.archive_closure.crc_verified,
+        "archive_member_count": binding.archive_closure.archive_member_count,
+        "archive_ledger_entries_verified": (
+            binding.archive_closure.ledger_entries_verified
+        ),
+        "archive_sha256_ledger_sha256": (
+            binding.archive_closure.sha256_ledger_sha256
+        ),
+        "database_health": store.health(),
+        "objects": store.list_objects(),
+    }
+    print(json.dumps(result, sort_keys=True, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
