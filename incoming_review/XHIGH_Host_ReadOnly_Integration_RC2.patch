index 0000000000000000000000000000000000000000..670364a2978ca87c82ce17d57614f8c9a16f3918
--- /dev/null
+++ b/.github/workflows/xhigh-readonly-integration.yml
@@ -0,0 +1,73 @@
+name: XHIGH Read-Only Integration
+
+on:
+  pull_request:
+    branches:
+      - codex/add-inventory-materials
+    paths:
+      - ".github/workflows/xhigh-readonly-integration.yml"
+      - ".env.example"
+      - "backend/app/core/config.py"
+      - "backend/app/api/v1/router.py"
+      - "backend/app/api/v1/endpoints/external_evidence.py"
+      - "backend/app/external_evidence/**"
+      - "backend/scripts/verify_xhigh_release.py"
+      - "backend/tests/test_external_evidence_*.py"
+      - "docs/xhigh_external_evidence_readonly_integration.md"
+      - "data/external_evidence/XHIGH_RELEASE_INDEX.template.json"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  readonly-contract:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+
+    steps:
+      - name: Check out exact candidate
+        uses: actions/checkout@v4
+
+      - name: Set up Python 3.11
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+
+      - name: Install Poetry
+        run: pipx install poetry
+
+      - name: Install backend dependencies
+        working-directory: backend
+        run: poetry install --with dev
+
+      - name: Lint bounded XHIGH surface
+        working-directory: backend
+        run: |
+          poetry run ruff check \
+            app/external_evidence \
+            app/api/v1/endpoints/external_evidence.py \
+            app/api/v1/router.py \
+            app/core/config.py \
+            scripts/verify_xhigh_release.py \
+            tests/test_external_evidence_adapter.py \
+            tests/test_external_evidence_api.py \
+            tests/test_external_evidence_release_security.py
+
+      - name: Run read-only integration qualification
+        working-directory: backend
+        env:
+          PERFUME_CHEM_EXTERNAL_EVIDENCE_ENABLED: "false"
+        run: |
+          poetry run pytest -q \
+            tests/test_external_evidence_adapter.py \
+            tests/test_external_evidence_api.py \
+            tests/test_external_evidence_release_security.py
+
+      - name: Compile bounded integration
+        working-directory: backend
+        run: |
+          poetry run python -m compileall -q \
+            app/external_evidence \
+            app/api/v1/endpoints/external_evidence.py \
+            scripts/verify_xhigh_release.py
