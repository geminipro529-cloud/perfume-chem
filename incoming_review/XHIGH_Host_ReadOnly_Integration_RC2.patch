index 0000000000000000000000000000000000000000..cb3078ab344a1bb5a676b6776780e79074826576
--- /dev/null
+++ b/backend/app/external_evidence/sqlite_store.py
@@ -0,0 +1,210 @@
+"""Read-only SQLite access for the frozen external `ee_*` namespace."""
+
+from __future__ import annotations
+
+import re
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Any, Iterator, Mapping
+from urllib.parse import quote
+
+from app.external_evidence.errors import (
+    ExternalEvidenceIntegrityError,
+    ExternalEvidenceMutationDeniedError,
+    ExternalEvidenceQueryError,
+)
+from app.external_evidence.hashing import canonical_rows_sha256, sha256_file
+
+_IDENTIFIER_RE = re.compile(r"^ee_[a-z][a-z0-9_]*$")
+
+
+def _quote_identifier(identifier: str) -> str:
+    if not _IDENTIFIER_RE.fullmatch(identifier):
+        raise ExternalEvidenceQueryError(f"unsafe external object identifier: {identifier!r}")
+    return '"' + identifier.replace('"', '""') + '"'
+
+
+class ReadOnlySQLiteStore:
+    """Open one exact external database with two independent write barriers."""
+
+    def __init__(self, database_path: Path, expected_sha256: str, max_query_rows: int = 200):
+        self.database_path = database_path.resolve()
+        self.expected_sha256 = expected_sha256
+        if max_query_rows < 1 or max_query_rows > 500:
+            raise ValueError("max_query_rows must be between 1 and 500")
+        self.max_query_rows = max_query_rows
+
+    def _verify_database(self) -> None:
+        if not self.database_path.is_file():
+            raise ExternalEvidenceIntegrityError(
+                f"external evidence database is missing: {self.database_path}"
+            )
+        observed_sha256 = sha256_file(self.database_path)
+        if observed_sha256 != self.expected_sha256:
+            raise ExternalEvidenceIntegrityError(
+                "external evidence database SHA-256 changed after release selection"
+            )
+
+    @contextmanager
+    def connection(self) -> Iterator[sqlite3.Connection]:
+        """Yield a URI read-only connection with SQLite query_only enabled."""
+        self._verify_database()
+        encoded = quote(self.database_path.as_posix(), safe="/:")
+        uri = f"file:{encoded}?mode=ro&immutable=1"
+        try:
+            connection = sqlite3.connect(uri, uri=True)
+        except sqlite3.Error as exc:
+            raise ExternalEvidenceIntegrityError(
+                f"cannot open external SQLite in read-only mode: {exc}"
+            ) from exc
+
+        connection.row_factory = sqlite3.Row
+        try:
+            connection.execute("PRAGMA query_only=ON")
+            connection.execute("PRAGMA foreign_keys=ON")
+            yield connection
+        finally:
+            connection.close()
+
+    @staticmethod
+    def _schema_objects(connection: sqlite3.Connection) -> list[dict[str, str]]:
+        rows = connection.execute(
+            """
+            SELECT name, type
+            FROM sqlite_master
+            WHERE type IN ('table', 'view')
+              AND name LIKE 'ee_%'
+            ORDER BY name, type
+            """
+        ).fetchall()
+        objects: list[dict[str, str]] = []
+        for row in rows:
+            name = str(row["name"])
+            if not _IDENTIFIER_RE.fullmatch(name):
+                raise ExternalEvidenceIntegrityError(
+                    f"external schema contains unsafe object name: {name!r}"
+                )
+            objects.append({"name": name, "type": str(row["type"])})
+        return objects
+
+    def health(self) -> dict[str, Any]:
+        """Return integrity and object-count data without changing the database."""
+        with self.connection() as connection:
+            quick_check = str(connection.execute("PRAGMA quick_check").fetchone()[0])
+            foreign_key_violations = len(
+                connection.execute("PRAGMA foreign_key_check").fetchall()
+            )
+            query_only = bool(connection.execute("PRAGMA query_only").fetchone()[0])
+            objects = self._schema_objects(connection)
+
+        if quick_check != "ok":
+            raise ExternalEvidenceIntegrityError(
+                f"external SQLite quick_check returned {quick_check!r}"
+            )
+        if foreign_key_violations:
+            raise ExternalEvidenceIntegrityError(
+                f"external SQLite has {foreign_key_violations} foreign-key violations"
+            )
+        if not query_only:
+            raise ExternalEvidenceIntegrityError("SQLite query_only did not remain enabled")
+
+        table_count = sum(item["type"] == "table" for item in objects)
+        view_count = sum(item["type"] == "view" for item in objects)
+        return {
+            "database_sha256": self.expected_sha256,
+            "quick_check": quick_check,
+            "foreign_key_violations": foreign_key_violations,
+            "query_only": query_only,
+            "table_count": table_count,
+            "view_count": view_count,
+            "object_count": len(objects),
+        }
+
+    def list_objects(self) -> list[dict[str, str]]:
+        """List only external tables and views."""
+        with self.connection() as connection:
+            return self._schema_objects(connection)
+
+    @staticmethod
+    def _columns(connection: sqlite3.Connection, object_name: str) -> list[sqlite3.Row]:
+        quoted = _quote_identifier(object_name)
+        return connection.execute(f"PRAGMA table_info({quoted})").fetchall()
+
+    def query(
+        self,
+        object_name: str,
+        filters: Mapping[str, Any] | None = None,
+        *,
+        limit: int = 100,
+        offset: int = 0,
+    ) -> dict[str, Any]:
+        """Run a bounded parameterized SELECT against an existing `ee_*` object."""
+        if limit < 1 or limit > self.max_query_rows:
+            raise ExternalEvidenceQueryError(
+                f"limit must be between 1 and {self.max_query_rows}"
+            )
+        if offset < 0:
+            raise ExternalEvidenceQueryError("offset cannot be negative")
+
+        quoted_object = _quote_identifier(object_name)
+        with self.connection() as connection:
+            available = {item["name"] for item in self._schema_objects(connection)}
+            if object_name not in available:
+                raise ExternalEvidenceQueryError(
+                    f"external object {object_name!r} does not exist"
+                )
+
+            column_rows = self._columns(connection, object_name)
+            columns = [str(row["name"]) for row in column_rows]
+            if not columns:
+                raise ExternalEvidenceQueryError(
+                    f"external object {object_name!r} has no readable columns"
+                )
+
+            primary_keys = [
+                (int(row["pk"]), str(row["name"]))
+                for row in column_rows
+                if int(row["pk"]) > 0
+            ]
+            primary_keys.sort()
+            order_columns = [name for _position, name in primary_keys] or [columns[0]]
+
+            clauses: list[str] = []
+            parameters: list[Any] = []
+            for column, value in sorted((filters or {}).items()):
+                if column not in columns:
+                    raise ExternalEvidenceQueryError(
+                        f"unknown filter column {column!r} for {object_name!r}"
+                    )
+                safe_column = '"' + column.replace('"', '""') + '"'
+                clauses.append(f"{safe_column} = ?")
+                parameters.append(value)
+
+            where_sql = " WHERE " + " AND ".join(clauses) if clauses else ""
+            order_sql = ", ".join(
+                '"' + column.replace('"', '""') + '"' for column in order_columns
+            )
+            sql = (
+                f"SELECT * FROM {quoted_object}{where_sql} "
+                f"ORDER BY {order_sql} LIMIT ? OFFSET ?"
+            )
+            parameters.extend([limit, offset])
+            rows = [dict(row) for row in connection.execute(sql, parameters).fetchall()]
+
+        return {
+            "object_name": object_name,
+            "filters": dict(filters or {}),
+            "limit": limit,
+            "offset": offset,
+            "row_count": len(rows),
+            "rows": rows,
+            "rows_sha256": canonical_rows_sha256(rows),
+        }
+
+    @staticmethod
+    def deny_mutation(operation: str) -> None:
+        """Reject every non-read operation at the adapter boundary."""
+        raise ExternalEvidenceMutationDeniedError(
+            f"operation {operation!r} is outside the read-only external-evidence contract"
+        )
