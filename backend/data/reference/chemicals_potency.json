  "potency_categories": {
    "extreme": {
      "max_allowed": 1.0,
      "warning_threshold": 0.5,
      "description": "Ultra-potent materials. Use at trace levels only (0.1-0.5%). Can overwhelm entire formula."
    },
    "high": {
      "max_allowed": 5.0,
      "warning_threshold": 2.0,
      "description": "Strong impact materials. Use sparingly (0.5-2%). Effective as modifiers and accents."
    },
    "medium": {
      "max_allowed": 15.0,
      "warning_threshold": 10.0,
      "description": "Standard impact materials. Normal usage range (5-15%). Form core of most accords."
    },
    "low": {
      "max_allowed": 50.0,
      "warning_threshold": 30.0,
      "description": "Foundation materials. Can be used liberally (10-50%). Provide structure and volume."
    }
