# RULE: Optimize for the name, not just the numbers. The formula name is the north star.
# Numerical gates are floors to meet, not ceilings to chase.
# When optimizing, the original brief/bottle name is the target.
# Backend runner environment
# Used when starting the API from inside `backend/`, for example:
#   cd backend
#   poetry run uvicorn app.main:app --reload
#
# If you run `python run_api_server.py` from the repo root instead,
# use the root `.env.example` / `.env` files.

# AI Provider Selection
# Change this to switch providers: "cerebras", "openai", "baseten", "huggingface", "ollama", "deepseek", or "llamacpp"
AI_PROVIDER=cerebras

# Application
APP_NAME=Perfume Chemistry API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite+aiosqlite:///./perfume_chem.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=False

# Redis Cache (optional)
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# AI Services
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Azure OpenAI (optional)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Cerebras AI (Free tier: 30 RPM, 64k TPM) - MODEL AGNOSTIC
CEREBRAS_API_KEY=your-cerebras-api-key-here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# Any Cerebras model works: llama3.1-8b, llama3.1-70b, qwen-3-235b-a22b-instruct-2507, etc.
CEREBRAS_MODEL=llama3.1-8b

# Baseten AI
BASETEN_API_KEY=your-baseten-api-key-here
BASETEN_MODEL_ID=your-baseten-model-id-here

# DeepSeek AI (OpenAI-compatible API)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Hugging Face AI
HF_API_KEY=your-huggingface-token-here
# Model ID from Hugging Face Hub (e.g., ehartford/dolphin-2.5-mixtral-8x7b)
HF_MODEL=ehartford/dolphin-2.5-mixtral-8x7b
HF_BASE_URL=https://api-inference.huggingface.co/v1/
# Optional: Local model path for Transformers inference
# This must point to a model directory, not a single file.
# HF_LOCAL_MODEL_PATH=D:/models/llama3_8b_chat_uncensored

# Ollama AI (local/remote Ollama instance)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Model name for Ollama (e.g., llama3.2:3b, mistral:latest, dolphin-mixtral:latest, llama3.1:latest)
OLLAMA_MODEL=llama3.2:3b
# Optional: TLS skip verify for self-signed certificates
# OLLAMA_TLS_SKIP_VERIFY=1
# Optional: API key placeholder (Ollama doesn't require API key)
# OLLAMA_API_KEY=not-required

# llama.cpp AI (local GGUF file)
# This must point to a single `.gguf` file.
# LLAMA_CPP_MODEL_PATH=D:/models/OpenAi-GPT-oss-20b.gguf
# LLAMA_CPP_N_CTX=2048
# LLAMA_CPP_N_GPU_LAYERS=0
# LLAMA_CPP_SEED=-1
# LLAMA_CPP_VERBOSE=False

# Rate Limiting
# RATE_LIMIT_CONFIG_PATH=  # Optional: custom path to rate_limits.yaml

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Perfumery Settings
DEFAULT_DILUTION_SOLVENT=ethanol
DEFAULT_DROP_SIZE_ML=0.05
IFRA_COMPLIANCE_CHECK=True
ENABLE_AI_SUGGESTIONS=True

# File Storage
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
