.mean(geos),+        "stdev": statistics.stdev(geos) if len(geos) > 1 else 0.0,+        "min": min(geos),+        "max": max(geos),+        "n": len(geos),+    }+++def main():+    print("โ•" * 78)+    print("  VALIDATE v6 vs v3 โ€” multi-run")+    print("โ•" * 78)+    v6 = make_v6()+    print(f"\n  v3 concentrate: {sum(IRL_V3.values()):.0f} ยตL")+    print(f"  v6 concentrate: {sum(v6.values()):.0f} ยตL")+    print(f"  ฮ” concentrate : {sum(v6.values()) - sum(IRL_V3.values()):+.0f} ยตL")+    print(f"\n  Changes (v3 โ’ v6):")+    for k, d in V6_DELTAS.items():+        v0 = IRL_V3.get(k, 0.0)+        print(f"    {k:28s} {v0:7.1f} โ’ {v0+d:7.1f}  ฮ”{d:+7.1f}")++    print(f"\n  Scoring v3 ร—{N_RUNS} ...")+    v3_geos, v3_axes = multi_score("v3", IRL_V3, IRL_DIL_BASE, N_RUNS)+    print(f"\n  Scoring v6 ร—{N_RUNS} ...")+    v6_geos, v6_axes = multi_score("v6", v6,    IRL_DIL_BASE, N_RUNS)++    s3 = summarize("v3", v3_geos)+    s6 = summarize("v6", v6_geos)++    print("\n" + "โ•" * 78)+    print("  GEO SUMMARY")+    print("โ•" * 78)+    print(f"\n  {'label':>6s} {'n':>3s} {'mean':>8s} {'stdev':>7s} "+          f"{'min':>8s} {'max':>8s}")+    for s in (s3, s6):+        print(f"  {s['label']:>6s} {s['n']:3d} {s['mean']:8.3f} "+              f"{s['stdev']:7.3f} {s['min']:8.3f} {s['max']:8.3f}")+    d_mean = s6["mean"] - s3["mean"]+    pooled_stdev = (s3["stdev"]**2 + s6["stdev"]**2) ** 0.5+    print(f"\n  ฮ” mean (v6 โ’ v3): {d_mean:+.3f}")+    print(f"  Pooled stdev    : {pooled_stdev:.3f}")+    if pooled_stdev > 0.001:+        print(f"  Signal-to-noise : {d_mean/pooled_stdev:+.2f}ฯ")++    print("\n" + "โ•" * 78)+    print("  AXIS MEANS (v3 โ’ v6)")+    print("โ•" * 78)+    print(f"\n  {'axis':24s} {'v3 mean':>9s} {'v6 mean':>9s} {'ฮ”':>8s}")+    for a in AXES:+        m3 = statistics.mean(v3_axes[a])+        m6 = statistics.mean(v6_axes[a])+        d = m6 - m3+        mark = "โ‘" if d > 0.05 else ("โ“" if d < -0.05 else " ")+        print(f"  {mark} {a:22s} {m3: