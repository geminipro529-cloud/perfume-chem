-candy: citral spike+    "Petitgrain EO":            0.80,  # anti-candy: green-bitter (reduced from original)+    +    # Backbone โ€” 18% of concentrate+    "Hedione":                 10.00,+    "Hedione HC":               2.00,+    "Ethyl Linalool":           4.00,+    "Linalyl Acetate":          2.00,+    +    # Transparency โ€” 3% of concentrate+    "Dihydromyrcenol":          3.00,  # opens up, prevents density+    +    # Iris โ€” 1.5% of concentrate+    "Alpha Irone":              1.50,  # 30% stock = 0.45% active+    +    # Musk/Amber โ€” 11.5% of concentrate+    "Galaxolide":               8.00,  # 50% stock = 4.0% active+    "Habanolide":               2.00,+    "Ambrofix":                 2.50,  # 30% stock = 0.75% active+}++# Verify total+TOTAL_PCT = sum(FINAL_FORMULA.values())+assert abs(TOTAL_PCT - 100.0) < 0.1, f"Formula totals {TOTAL_PCT}%, must be 100%"++# Stock dilution mapping: material -> (stock_concentration, unit)+# For calculating raw ยตL from active ยตL+STOCK_DILUTION = {+    "Aldehyde C10 (1%)": (0.01, "1% stock"),+    "Alpha Irone": (0.30, "30% in DEP"),+    "Galaxolide": (0.50, "50% in DEP"),+    "Ambrofix": (0.30, "30% w/v"),+}++def generate_batch(target_mL: float) -> dict:+    """Generate a complete DHC A Lemon batch at any volume.+    +    Returns dict with:+        - target_mL: final volume+        - concentration: % v/v+        - total_concentrate_ยตL: total concentrate volume+        - materials: list of (name, active_ยตL, raw_ยตL, dilution_info)+        - ethanol_mL: ethanol to add+    """+    concentrate_mL = target_mL * 0.12  # 12% concentration+    concentrate_ยตL = concentrate_mL * 1000+    +    materials = []+    for name, pct in FINAL_FORMULA.items():+        active_ยตL = concentrate_ยตL * (pct / 100.0)+        if name in STOCK_DILUTION:+            stock_pct, stock_label = STOCK_DILUTION[name]+            raw_ยตL = active_ยตL / stock_pct+            dilution = stock_label+        else:+            raw_ยตL = active_ยตL+            dilution = "neat"+        materials.append((name, active_ยตL, raw_ยตL, dilution, pct))+    +    total_raw_ยตL = sum(m[2] for m in materials)+    total_active_ยตL = sum(m[1] for m in materials)+    ethanol_mL = target_mL - (total_raw_ยตL / 1000)+    +    return {+        "target_mL": target_mL,+        "concentration": 12.0,+        "total_concentrate_ยตL": total_active_ยตL,+        "total_raw_ยตL": total_raw_ยตL,+        "materials": materials,+        "ethanol_mL": ethanol_mL,+    }++def generate_correction(existing_batch_mL: float, target_mL: float,+                        existing_materials: dict[str, float]) -> dict:+    """Generate correction for an existing mixed batch.+    +    Args:+        existing_batch_mL: volume of already-mixed batch+        target_mL: desired final volume (must be >= existing_batch_mL)+        existing_materials: dict of {material_name: active_ยตL} already in batch+        +    Returns dict with materials to ADD and ethanol to add.+    """+    if target_mL < existing_batch_mL:+        raise ValueError("target_mL must be >= existing_batch_mL")+    +    # Calculate what the final batch should have+    final = generate_batch(target_mL)+    +    # Calculate what we need to add+    to_add = []+    for name, active_ยตL, raw_ยตL, dilution, pct in final["materials"]:+        existing = existing_materials.get(name, 0)+        needed_active = active_ยตL - existing+        if needed_active <= 0:+            continue  # already have enough or more+        +        if name in STOCK_DILUTION:+            stock_pct, stock_label = STOCK_DILUTION[name]+            needed_raw = needed_active / stock_pct+        else:+            needed_raw = needed_active+            stock_label = "neat"+        +        to_add.append((name, needed_active, needed_raw, stock_label, pct))+    +    # Calculate ethanol+    total_raw_to_add = sum(m[2] for m in to_add)+    ethanol_mL = target_mL - existing_batch_mL - (total_raw_to_add / 1000)+    +    return {+        "existing_batch_mL": existing_batch_mL,+        "target_mL": target_mL,+        "to_add": to_add,+        "ethanol_mL": ethanol_mL,+        "final_concentration": 12.0,+    }++# โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•+# YOUR EXISTING LEMON DHC (30 mL Veritas batch)+# These are the ACTIVE ยตL amounts already in your bottle+# โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•++YOUR_EXISTING_BATCH = {+    "Lemon FCF oil Sicilian": 3900.0,+    "Hedione": 630.0,+    "Hedione HC": 270.0,+    "Ethyl Linalool": 330.0,+    "Linalyl Acetate": 48.0,+    "Hydroxycitronellal": 6.0,+    "Nympheal": 3.6,+    "Scentenal": 0.012,+    "Floralozone": 0.09,+    "Petitgrain EO": 330.0,+    "Iso E Super": 300.0,+    "Romandolide": 288.0,+    "Ethylene Brassylate": 228.0,+    "Ambrofix": 10.8,+    "Norlimbanol Dextro": 25.2,+    "Vetival": 24.0,+    "Javanol": 9.6,+    "Cardamom EO": 3.0,+}++# โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•+# CLI / Script execution+# โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•โ•++if __name__ == "__main__":+    # Default: generate correction for your existing 30 mL -> 50 mL+    existing_mL = 30.0+    target_mL = 50.0+    +    if len(sys.argv) > 1:+        target_mL = float(sys.argv[1])+    if len(sys.argv) > 2:+        existing_mL = float(sys.argv[2])+    +    print(f"=" * 60)+    print(f"DHC A Lemon Universal Formula Generator")+    print(f"=" * 60)+    print(f"\nTarget volume: {target_mL} mL")+    print(f"Target concentration: 12% v/v")+    print(f"\n{