Enum+from typing import Mapping+++# ---------------------------------------------------------------------------+# Enums+# ---------------------------------------------------------------------------++class ConcentrationBracket(StrEnum):+    """Fine fragrance concentration brackets (% w/w in ethanol)."""+    EDC = "EdC"          # 3โ€“5%+    EDT = "EdT"          # 8โ€“12%+    EDP = "EdP"          # 15โ€“20%+    EXTRAIT = "Extrait"  # 20%++    BODY_SPRAY = "Body Spray"  # ~3%+++class FragranceFamily(StrEnum):+    """Eleven fragrance families as codified in formulation science."""+    CITRUS = "citrus"+    AROMATIC_FOUGERE = "aromatic_fougere"+    FLORAL_ROSE = "floral_rose"+    FLORAL_JASMINE = "floral_jasmine"+    CHYPRE = "chypre"+    AMBER_ORIENTAL = "amber_oriental"+    WOODY_AMBER = "woody_amber"+    GOURMAND = "gourmand"+    MARINE_AQUATIC = "marine_aquatic"+    LEATHER = "leather"+    MUSK = "musk"+++class NoteTier(StrEnum):+    """Volatility-based note tier (VP ranges at 25ยฐC)."""+    TOP = "top"      # VP > 50 Pa+    HEART = "heart"  # VP 0.5โ€“50 Pa+    BASE = "base"    # VP < 0.5 Pa+++class TextureLayer(StrEnum):+    """Texture layers in modern perfumery (Ellena system)."""+    LIFT = "lift"          # Ambient projection (>200 cm), very brief+    DIFFUSION = "diffusion"  # Sillage (50โ€“200 cm)+    CUSHION = "cushion"      # Personal space (15โ€“50 cm)+    COCOON = "cocoon"        # Intimate (<15 cm)+    SKIN_EFFECT = "skin_effect"  # On-skin (<5 cm)+    VEIL = "veil"            # Transparent overlay+    HALO = "halo"            # Radiant presence at arm's length+++class DiffusionLayer(StrEnum):+    """Diffusion distance layers."""+    INTIMATE = "intimate"    # 0โ€“15 cm+    PERSONAL = "personal"    # 15โ€“50 cm+    SILLAGE = "sillage"      # 50โ€“200 cm+    AMBIENT = "ambient"      # >200 cm+++class HedonicCategory(StrEnum):+    """Hedonic valence classification for materials."""+    BEAUTIFUL = "beautiful"        # +3 to +5+    INTERESTING = "interesting