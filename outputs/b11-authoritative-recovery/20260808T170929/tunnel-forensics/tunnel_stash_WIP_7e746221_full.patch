oses, balanced by pleasant materials.++**High-hedonic materials (โฅ 0.80):** Vanillin, Ethyl Vanillin, Linalool, Linalyl Acetate, PEA, Heliotropin, Coumarin, Maple Lactone, Gamma Decalactone, Raspberry Ketone, Hedione+**Medium-hedonic (0.60โ€“0.79):** Ionones, Geraniol, Citronellol, Benzyl Acetate, Benzyl Salicylate, Sandalore, Iso E Super, Ambrox, Galaxolide, Cashmeran+**Low-hedonic (< 0.60 โ€” use as trace accent only):** Indole, Birch Tar, Guaiacol, IBQ, Skatole, Geosmindiff --git a/data/vp_corrections.json b/data/vp_corrections.jsonnew file mode 100644index 0000000..ec67658--- /dev/null+++ b/data/vp_corrections.json@@ -0,0 +1,174 @@+{+  "_meta": {+    "description": "VP corrections from Perplexity audit (2026-05-10)",+    "action": "Replace these VP values in material_properties.json and ingredient_intelligence.py",+    "unit": "Pa at 25C unless stated"+  },++  "corrections_material_properties_json": {+    "HEXYL ACETATE": {+      "old_vp": 150.0,+      "new_vp": 194.0,+      "unit": "Pa",+      "source": "ScenTree / EPI suite",+      "note": "1.388 mmHg = 185 Pa. Use 194 Pa."+    },+    "DIPROPYLENE GLYCOL": {+      "old_vp": 190.0,+      "new_vp": 2.1,+      "unit": "Pa",+      "source": "ScenTree",+      "note": "0.016 mmHg = 2.1 Pa. Old value 190 was mmHg."+    },+    "LINALOOL": {+      "old_vp": 22.0,+      "new_vp": 22.7,+      "unit": "Pa",+      "source": "BASF / ScenTree",+      "note": "0.17 mmHg = 22.7 Pa. Old value 22 was actually close but wrong reasoning."+    },+    "LINALYL ACETATE": {+      "old_vp": 10.0,+      "new_vp": 17.5,+      "unit": "Pa",+      "source": "ScenTree",+      "note": "0.131 mmHg = 17.5 Pa."+    },+    "FLOROL": {+      "old_vp": 6.0,+      "new_vp": 0.007,+      "unit": "Pa",+      "source": "ScenTree (20C)",+      "note": "0.0000534 mmHg at 20C = 0.007 Pa. Old value 6.0 was wrong."+    },+    "DIHYDROMYRCENOL": {+      "old_vp": 10.0,+      "new_vp": 14.8,+      "unit": "Pa",+      "source": "ScenTree / literature",+    