lbutyrate": 0.15,+        "Cardamom FTEC":          4.0,+        # Heart+        "Hedione":                9.5,   # โ“ from 12; frees luxury budget+        "Benzyl Acetate":         2.5,+        "Dihydrojasmone":         1.0,+        "Geraniol":               2.0,+        "Alpha Isomethyl Ionone": 2.5,+        "Phenethyl Alcohol":      1.5,+        "Benzyl Salicylate":      2.0,   # NEW โ€” floral cushion fixative+        # Base+        "Iso E Super":            5.0,+        "Javanol":                4.0,+        "Sandalore":              3.0,+        "Cashmeran":              1.5,   # NEW โ€” creamy cashmere drydown+        "Ambrox Super":           9.0,+        "Vanillin":              14.0,   # slightly โ“ from 15; EV takes over+        "Ethyl Vanillin":         1.5,   # โ‘ from 0.5 โ€” KEY vanilla upgrade+        "Coumarin":               4.0,+        "Benzoin Resinoid":       3.5,+        "Habanolide":             4.0,+        "Galaxolide":             3.5,+        "Romandolide":            2.0,+        "Ethylene Brassylate":    1.5,+    },+    "envelope": {+        "top": {+            "citrus":    2400, "aromatic": 1000, "fruity": 650,+            "spice":       90, "radiance":   25, "floral":  20,+        },+        "heart": {+            "aromatic":   800, "radiance":   55, "citrus":  500,+            "fruity":     260, "geranium":   55, "powdery": 170,+            "amber":      320, "spice":      55, "floral":   25,+        },+        "base": {+            "amber":      420, "gourmand":  280, "balsamic":  95,+            "wood":        95, "coumarin":   55, "musk":      65,+            "powdery":    115,+        },+    },+}++IDENTITY_FLOOR_PCT: dict[str, float] = {+    "Bergamot FCF":           6.5,+    "Lavender EO":            6.5,   # โ“ floor to allow trim+    "Dihydromyrcenol":        2.0,+    "Apritone":               4.0,+    "Hexyl Acetate":          2.2,+    "Cardamom FTEC":          3.0,+    "Hedione":                8.0,+    "Alpha Isomethyl