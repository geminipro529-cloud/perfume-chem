mbination: set each trace at best OAV from its sweep โ”€โ”€+print("\n" + "="*72)+print(" OPTIMISTIC COMBINATION (each trace at its lux-maximizing OAV")+print("                         subject to synergy >= 94.5)")+print("="*72)+best_oavs = {}+for tname, data in sweep_results.items():+    # pick highest-luxury point with synergy >= SYNERGY_FLOOR and od=0+    viable = [(oav, lux, syn, geo, od) for oav, lux, syn, geo, od in data+              if syn >= SYNERGY_FLOOR and od == 0]+    if viable:+        best = max(viable, key=lambda x: x[1])+        best_oavs[tname] = best[0]+        print(f"  {tname}: best OAV={best[0]} โ’ lux={best[1]:.1f} syn={best[2]:.1f}")+    else:+        best_oavs[tname] = 0.3+        print(f"  {tname}: no viable escalation โ€” fallback OAV=0.3")++trial = copy.deepcopy(SPEC)+for tname, tt in TRACE_MATERIALS.items():+    trial[tname] = {"ppm": tt["odt"] * best_oavs[tname], "dil": tt["dil"], "role": tt["role"]}+r_combo = score_spec(trial, 10.0)+print_result("v4 optimistic combination", r_combo, trial)+# accept only if synergy holds and no overdoses+if r_combo["axes"]["synergy"] >= SYNERGY_FLOOR and len(r_combo["overdosed"]) == 0:+    spec, res = trial, r_combo+    print("  โ’ ACCEPTED as v4 final")+else:+    print("  โ’ REJECTED (synergy or overdose violation)")++# โ”€โ”€ Final audit: confirm all traces are still sub-ODT โ”€โ”€+print("\nโ”€โ”€ Sub-ODT audit โ”€โ”€")+all_sub = True+for name in TRACE_MATERIALS:+    if name in spec:+        oav = trace_oav(spec, name)+        flag = "โ“" if oav < 1.0 else "โ— ABOVE ODT"+        print(f"  {name:25s} ppm={spec[name]['ppm']:.5f}  OAV={oav:.3f}  {flag}")+        if oav >= 1.0:+            all_sub = False+print(f"  All traces sub-ODT: {all_sub}")++# โ”€โ”€ Comparison table โ”€โ”€+print("\n" + "="*72)+print(" v3 vs v4 BRIEF-MARKER COMPARISON")+print("="*72)+print(f"  {'marker':<20} {'v3':>8} {'v4':>8} {'ฮ”':>7}")+for a in ["luxury","longevity","sillage","texture","stacking_depth","synergy",+          "