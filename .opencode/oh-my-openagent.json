{
  "$schema": "https://oh-my-openagent.ai/config.json",
  "disabled_providers": ["anthropic", "google", "github-copilot", "venice", "vercel", "openai", "codex-chatgpt", "opencode", "opencode-go", "openrouter"],
  "disabled_mcps": ["codegraph"],
  "disabled_hooks": ["webfetch-redirect-guard", "claude-code-hooks", "auto-update-checker", "legacy-plugin-toast", "fsync-skip-warning", "bash-file-read-guard", "question-label-truncator"],
  "model_fallback": true,
  "auto_update": false,
  "hashline_edit": false,
  "sisyphus_agent": { "tdd": false, "replace_plan": false, "default_builder_enabled": true, "planner_enabled": true },
  "default_mode": { "ultrawork": true, "ralph_loop": false },
  "runtime_fallback": { "enabled": true, "max_fallback_attempts": 3, "cooldown_seconds": 5, "notify_on_fallback": true },
  "background_task": {
    "defaultConcurrency": 15,
    "maxDepth": 3,
    "maxToolCalls": 120,
    "staleTimeoutMs": 600000,
    "messageStalenessTimeoutMs": 120000,
    "taskTtlMs": 900000,
    "providerConcurrency": { "deepseek": 2, "openai": 0, "deepinfra": 12 },
    "circuitBreaker": { "enabled": true, "maxToolCalls": 120, "consecutiveThreshold": 6 }
  },
  "monitor": {
    "enabled": true, "live_mode_enabled": true,
    "max_monitors_per_session": 4, "max_runtime_ms": 2700000,
    "allowed_commands": ["python", "pytest", "ruff", "mypy", "bash", "powershell"]
  },
  "experimental": {
    "dynamic_context_pruning": { "enabled": true, "notification": "minimal", "turn_protection": { "enabled": true, "turns": 3 }, "strategies": { "deduplication": { "enabled": true }, "supersede_writes": { "enabled": true, "aggressive": false }, "purge_errors": { "enabled": true, "turns": 5 } } },
    "preemptive_compaction": true,
    "truncate_all_tool_outputs": true,
    "max_tools": 30,
    "safe_hook_creation": true,
    "model_fallback_title": true,
    "task_system": true,
    "plugin_load_timeout_ms": 15000
  },
"categories": {
    "reader": { "model": "deepinfra/zai-org/GLM-5.2", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 8000, "thinking": { "type": "enabled", "budgetTokens": 4000 } },
    "driver": { "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 16000, "thinking": { "type": "enabled", "budgetTokens": 8000 } },
    "engineer": { "model": "deepinfra/zai-org/GLM-5.2", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 24000, "thinking": { "type": "enabled", "budgetTokens": 12000 } },
    "ultrabrain": { "model": "deepinfra/zai-org/GLM-5.2", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 24000, "thinking": { "type": "enabled", "budgetTokens": 12000 } },
    "deep": { "model": "deepinfra/zai-org/GLM-5.2", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 16000, "thinking": { "type": "enabled", "budgetTokens": 8000 } },
    "quick": { "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 4000, "thinking": { "type": "disabled" } },
    "artistry": { "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 16000, "thinking": { "type": "enabled", "budgetTokens": 8000 } },
    "unspecified-low": { "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 4000, "thinking": { "type": "disabled" } },
    "unspecified-high": { "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 16000, "thinking": { "type": "enabled", "budgetTokens": 8000 } },
    "visual-engineering": { "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 8000, "thinking": { "type": "disabled" } },
    "writing": { "model": "deepinfra/zai-org/GLM-5.2", "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"], "maxTokens": 12000, "thinking": { "type": "enabled", "budgetTokens": 4000 } }
  },
  "agents": {
    "sisyphus": {
      "model": "deepinfra/zai-org/GLM-5.2",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "prometheus": {
      "model": "deepinfra/zai-org/GLM-5.2",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "sisyphus-junior": {
      "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "oracle": {
      "model": "deepinfra/zai-org/GLM-5.2",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "metis": {
      "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "momus": {
      "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "librarian": {
      "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "explore": {
      "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "multimodal-looker": {
      "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "atlas": {
      "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "build": {
      "model": "deepseek/deepseek-v4-pro",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    },
    "OpenCode-Builder": {
      "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
      "fallback_models": ["deepinfra/deepseek-ai/DeepSeek-V4-Pro"]
    }
  }
}
